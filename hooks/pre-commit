#!/usr/bin/env bash
# pre-commit: syntax check + auto-refresh checksums
set -euo pipefail
ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

for f in install.sh bin/setup bin/schedule lib/script-helpers.sh; do
    zsh -n "$f" || { echo "Syntax error in $f — commit blocked" >&2; exit 1; }
done
while IFS=$'\t' read -r _module _target mode source _audience _platform; do
    [[ "$mode" == script ]] || continue
    zsh -n "$source" || { echo "Syntax error in $source — commit blocked" >&2; exit 1; }
done < manifest.tsv

# bin/setup and bin/schedule are zsh; they are checked with zsh -n above.
for f in bin/*; do
    [[ -f "$f" ]] || continue
    [[ "$f" == bin/setup || "$f" == bin/schedule ]] && continue
    bash -n "$f" || { echo "Syntax error in $f — commit blocked" >&2; exit 1; }
done

for f in files/auth files/harnesses files/providers files/opencodex; do
    [[ -f "$f" ]] || continue
    python3 -c "import py_compile; py_compile.compile('$f', doraise=True)" || exit 1
done

# Every skill must declare its visibility with an audience line, so the agents
# installer can decide whether the skill lands on a given machine. A missing
# line silently hides nothing today but reads as "unset", which is how skills
# drift into the wrong audience; fail the commit instead.
while IFS= read -r f; do
    grep -q '^audience:' "$f" || { echo "missing audience: tag in $f — commit blocked" >&2; exit 1; }
done < <(find agents/skills -name SKILL.md -type f | sort)

scripts/checksums
git add checksums.tsv
