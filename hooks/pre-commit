#!/usr/bin/env bash
# pre-commit: syntax check + auto-refresh checksums
set -euo pipefail
ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

for f in install.sh bin/setup bin/schedule lib/script-helpers.sh; do
    zsh -n "$f" || { echo "Syntax error in $f — commit blocked" >&2; exit 1; }
done
while IFS=$'\t' read -r _module _target mode source _audience _platform; do
    [[ "$mode" == script ]] || continue
    zsh -n "$source" </dev/null || { echo "Syntax error in $source — commit blocked" >&2; exit 1; }
done < <(awk -F '\t' '$7 != "retired"' manifest.tsv)  # retired rows have no source

# bin/setup and bin/schedule are zsh; they are checked with zsh -n above.
for f in bin/*; do
    [[ -f "$f" ]] || continue
    [[ "$f" == bin/setup || "$f" == bin/schedule ]] && continue
    bash -n "$f" || { echo "Syntax error in $f — commit blocked" >&2; exit 1; }
done

for f in files/auth files/passage files/providers files/opencodex; do
    [[ -f "$f" ]] || continue
    python3 -c "import py_compile; py_compile.compile('$f', doraise=True)" || exit 1
done

scripts/checksums
git add checksums.tsv
