#!/usr/bin/env bash
# pre-commit: syntax check + auto-refresh checksums
set -euo pipefail
ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

for f in install.sh bin/setup bin/schedule lib/script-helpers.sh; do
    zsh -n "$f" || { echo "Syntax error in $f — commit blocked" >&2; exit 1; }
done
while IFS=$'\t' read -r _module _target mode source _audience _platform; do
    [[ "$mode" == script ]] || continue
    zsh -n "$source" || { echo "Syntax error in $source — commit blocked" >&2; exit 1; }
done < manifest.tsv

# bin/setup and bin/schedule are zsh; they are checked with zsh -n above.
for f in bin/*; do
    [[ -f "$f" ]] || continue
    [[ "$f" == bin/setup || "$f" == bin/schedule ]] && continue
    bash -n "$f" || { echo "Syntax error in $f — commit blocked" >&2; exit 1; }
done

for f in files/auth files/passage files/harnesses files/providers files/opencodex; do
    [[ -f "$f" ]] || continue
    python3 -c "import py_compile; py_compile.compile('$f', doraise=True)" || exit 1
done

# The modules fleet replaced stay fetchable, unchanged, until every machine
# has swapped: their clients still fetch these from main and would misread
# an edit. The account now holds the agent instructions and skills, so an
# edit under agents/ would never reach it. Deleting them is allowed.
frozen=(agents/ files/agents.sh files/harnesses.sh files/harnesses files/harnesses-manifest.json
        files/miniharness.sh files/ssh-aliases.sh)
while IFS= read -r f; do
    for path in "${frozen[@]}"; do
        if [[ "$f" == "$path" || ( "$path" == */ && "$f" == "$path"* ) ]]; then
            echo "$f belongs to a module fleet replaced and stays as it is — commit blocked" >&2
            [[ "$path" == agents/ ]] && echo "  agent instructions and skills live in the account now: edit ~/.agents and run fleet sync" >&2
            exit 1
        fi
    done
done < <(git diff --cached --name-only --diff-filter=d)

scripts/checksums
git add checksums.tsv
