def harnesses_present(clear=False):
    """Which harnesses get settings: {name: present}. claude's value is its
    binary, for the MCP commands. Taking settings back, a harness the
    manifest does not list is looked for on PATH."""
    specs = harness_specs()

    def found(name):
        if name in specs:
            return harness_resolve(name, specs[name])
        return shutil.which(name) if clear else None
    return {"claude": found("claude"), "codex": bool(found("codex") or CODEX_DIR.is_dir()),
            "t3": bool(found("t3") or T3_SETTINGS.parent.is_dir()),
            "hermes": HERMES_CONFIG.is_file(), "kimi": KIMI_CONFIG.is_file()}


def _retired_env_vars():
    return ({re.sub(r"[^A-Za-z0-9]+", "_", n).upper() + "_MCP_TOKEN"
             for n in manifest().get("retiredMcpServers") or []}
            | set(manifest().get("retiredEnvVars") or []))


def _applied_record():
    """fleet's record of what it rendered. One there but unreadable fails
    the render: read as none, everything fleet wrote would turn the user's."""
    try:
        value = json.loads(APPLIED.read_text())
    except FileNotFoundError:
        return {}
    except (OSError, ValueError) as exc:
        raise ConfigError(f"cannot read {APPLIED} ({exc}); fix or remove it by hand")
    if not isinstance(value, dict):
        raise ConfigError(f"cannot read {APPLIED}: not a JSON object; fix or remove it by hand")
    return value


def _t3_models(tier, opencodex):
    models = {}
    for row in (manifest().get("opencodex", {}).get("t3", {}).get("claudeCustomModels", [])
                if opencodex else []):
        models[row["slug"]] = row
    for row in tier["t3"]:
        models[row["slug"]] = row
    return list(models.values())


@_config_locked()
def harness_render(force=False, clear=False):
    """Render the harnesses' settings, keepout hooks and MCP servers from the
    three tiers. 0 done or unchanged, 1 a part failed, 3 no answer from Auth.

    Without a completed pull this run, the tier fleet last applied is used
    again, so nothing is removed on a guess. Without the hub's service list
    nothing renders: the lost.plus servers would read as removed.

    With clear, everything fleet rendered is taken back, for uninstalling
    it: claude's MCP entries call fleet itself for their tokens.

    Under the config lock: a sync running alongside would load the same
    record and read what the other adds as the user's."""
    previous = _applied_record()
    if clear:
        # While setup's old modules run, what is rendered is still theirs.
        if not previous or not config_sync_enabled():
            return 0
        try:
            manifest()
        except ConfigError as exc:
            # The record names what was written; the manifest only adds
            # retired entries to clear, which can wait for a reinstall.
            eprint(f"fleet: {exc}; taking back what fleet's record names")
            _MANIFEST.update(_digest=None)
        return _harness_apply(previous.get("account"), None, empty_tier(), [], [], previous, True, True)
    if not config_sync_enabled():
        return 0
    state, account = _session()
    # With no session, a machine known not to be the operator's is rendered
    # as if it had pulled an empty account, so the operator's settings and
    # MCP entries the old client wrote come off. Without a session it gets
    # no lost.plus servers either. Only Auth saying there is no login counts:
    # a store it cannot read leaves what is rendered alone.
    friend = state == "out" and not_the_operators()
    if account is None and not friend:
        return 3
    origin, subject = account.split(" ", 1) if account else (None, None)
    context = {"origin": origin, "subject": subject} if account else None
    warnings = []
    if friend:
        tier = empty_tier()
    elif PULL["outcome"] == "synced":
        tier = read_tier(subject, warnings)
    elif PULL["outcome"] == "pending":
        tier = empty_tier()
    elif previous.get("account") == account and isinstance(previous.get("tier"), dict):
        tier, warnings = previous["tier"], list(previous.get("warnings") or [])
    else:
        return 0
    try:
        hub = [] if friend else hub_servers()
    except ConfigError as exc:
        eprint(f"fleet: harness settings not rendered: cannot read the lost.plus services: {exc}")
        return 3
    return _harness_apply(account, context, tier, warnings, hub, previous, force, False)


def _harness_inputs(account, tier, hub, clear):
    """(manifest, present, opencodex, servers, digest): what a render reads,
    and its hash, which a render unchanged since the last one matches."""
    m = {} if clear else manifest()
    present = harnesses_present(clear)
    opencodex = not clear and os.access(OPENCODEX, os.X_OK)
    servers = {}
    # A later tier wins a name: manifest, local plugins, hub, the account.
    for server in [] if clear else [*m.get("mcpServers", []), *local_plugin_servers(), *hub, *tier["mcp"]]:
        servers[server["name"]] = server
    if clear:
        return m, present, opencodex, servers, None
    block = managed_exports()
    env_values = {mcp_env_var(s): os.environ.get(mcp_env_var(s)) or block.get(mcp_env_var(s), "")
                  for s in servers.values() if s.get("credentialSource") == "env"}
    digest = hashlib.sha256(json.dumps({
        "account": account, "tier": tier, "manifest": m["_digest"], "servers": servers,
        "env": env_values, "present": present, "opencodex": opencodex, "fleet": _self_path(),
        "self": hashlib.sha256(pathlib.Path(__file__).read_bytes()).hexdigest(),
    }, sort_keys=True).encode()).hexdigest()
    return m, present, opencodex, servers, digest


def harness_outdated():
    """Whether a sync would render the harnesses' settings (for setup's
    status): a failed render, or inputs changed since the last one. A tier
    the account changed shows in config_outdated instead."""
    if not config_sync_enabled():
        return False
    account = _context()
    if account is None:
        return False
    previous = _load_json(APPLIED, {})
    if previous.get("account") != account or not isinstance(previous.get("tier"), dict):
        return True
    try:
        digest = _harness_inputs(account, previous["tier"], hub_servers(), False)[4]
    except ConfigError:
        return False
    return previous.get("hash") != digest


def _prospective_mcp(previous, servers, present):
    """The previous mcp records, plus fleet's ownership of each entry this run
    adds where claude or hermes has none of that name."""
    mcp = {name: dict(r) for name, r in (previous.get("mcp") or {}).items()}
    hermes = None
    if present["hermes"]:
        try:
            lines = HERMES_CONFIG.read_text().split("\n")
            start, end = _yaml_block(lines, "mcp_servers")
            hermes = set() if start is None else {n for n, _, _ in _hermes_entries(lines, start, end)}
        except (OSError, ConfigError):
            pass
    for s in servers.values():
        surfaces = mcp_surfaces(s)
        if (r := mcp.get(s["name"])) is not None and s.get("url") and s["url"] != r.get("url"):
            # A server fleet owns keeps its old URL, and its new one is kept
            # beside it: a run stopped after the write left the new.
            r["urlNext"] = s["url"]
        new = set()
        if present["claude"] and "claude" in surfaces and _claude_user_entry(s["name"]) is None:
            new.add("claude")
        if hermes is not None and "hermes" in surfaces and s["name"] not in hermes:
            new.add("hermes")
        if not new:
            continue
        r = mcp.setdefault(s["name"], {"url": s.get("url"), "rendered": [],
                                       "claude": _claude_mcp_entry(s) if "claude" in surfaces else None})
        # A record without "rendered" already counts on every surface.
        if "rendered" in r:
            r["rendered"] = sorted(set(r["rendered"]) | new)
        users = [u for u in r.get("users") or [] if u not in new]
        r.pop("users", None)
        if users:
            r["users"] = users
    return mcp


def _prospective_settings(previous, desired, allow, t3_models, present):
    """The previous claude, allow and t3 records, plus what this run adds: a
    run stopped after writing them still owns them, and the next run does
    not read them as the user's."""
    def dig(value, *keys):
        for key in keys:
            value = value.get(key) if isinstance(value, dict) else None
        return value
    out = {}
    if present["claude"]:
        # A leaf fleet already owns keeps its old value, and its new one is
        # kept beside it: a run stopped before the write leaves the old value
        # in place, one stopped after it the new. A leaf the user already has
        # at the wanted value is not fleet's.
        current = load_json(CLAUDE_SETTINGS)
        recorded_leaves = previous.get("claude") or {}
        leaves = _leaves(desired)
        out["claude"] = {**recorded_leaves, **{
            k: v for k, v in leaves.items()
            if k not in recorded_leaves and _get_path(current, json.loads(k)) != v}}
        out["claudeAfter"] = {**(previous.get("claudeAfter") or {}), **{
            k: v for k, v in leaves.items() if k in recorded_leaves and recorded_leaves[k] != v}}
        existing = dig(current, "permissions", "allow")
        existing = existing if isinstance(existing, list) else []
        recorded = previous.get("allow") or []
        out["allow"] = recorded + [e for e in allow if e not in recorded and e not in existing]
    if present["t3"]:
        rows = dig(load_json(T3_SETTINGS), "providerInstances", "claudeAgent", "config", "customModels")
        have = {r.get("slug") if isinstance(r, dict) else r for r in rows if isinstance(r, (dict, str))} \
            if isinstance(rows, list) else set()
        out["t3"] = dict(previous.get("t3") or {})
        out["t3Provider"] = bool(previous.get("t3Provider") or (
            t3_models and "claudeAgent" not in (load_json(T3_SETTINGS).get("providerInstances") or {})))
        out["t3Next"] = dict(previous.get("t3Next") or {})
        for model in t3_models:
            row = {k: v for k, v in model.items() if k != "effortsFrom"}
            if model["slug"] not in have and model["slug"] not in out["t3"]:
                out["t3"][model["slug"]] = row
            elif (mine := out["t3"].get(model["slug"])) is not None and not mine.get("user") and mine != row:
                # Like an owned claude leaf: the new row beside the old.
                out["t3Next"][model["slug"]] = row
    if present["hermes"] and HERMES_CONFIG.is_file():
        lines = HERMES_CONFIG.read_text().split("\n")
        out["hermesSkills"] = previous.get("hermesSkills") or _hermes_skills(lines, warn=False)
        try:
            out["hermesBlock"] = bool(previous.get("hermesBlock")) or _yaml_block(lines, "mcp_servers")[0] is None
        except ConfigError:
            out["hermesBlock"] = bool(previous.get("hermesBlock"))
    return out


def _harness_apply(account, context, tier, warnings, hub, previous, force, clear):
    m, present, opencodex, servers, digest = _harness_inputs(account, tier, hub, clear)
    retired = set(m.get("retiredMcpServers") or []) - set(servers)
    # A credential Auth had none for may have come since: the inputs hash
    # does not show it, so such a render is never taken as current.
    if not clear and not force and previous.get("hash") == digest and not previous.get("absent"):
        return 0
    for warning in warnings:
        eprint(f"fleet: {warning}")
    command = _keepout_command() if tier["keepout"] else None
    rc = 0
    with _consumer_sync_lock():
        try:
            exports, drop, skipped, missing = ({}, set(), [], set()) if clear else \
                resolve_tokens(list(servers.values()), context, warnings)
        except Changed:
            eprint("fleet: the login changed during the sync; run: fleet sync")
            return 3
        # Servers needing no token look nothing up; recheck the login the
        # hub list and the account's tier were read under.
        if not clear and _context() != account:
            eprint("fleet: the login changed during the sync; run: fleet sync")
            return 3
        absent = {n for n in skipped if servers[n].get("credentialSource") in ("common-auth", "passage")}
        for name in skipped:
            servers.pop(name)
        # What this run adds is fleet's only once a record says so, or the
        # next run reads it as the user's and never takes it off. So the
        # record must save before any harness file changes, already owning
        # what this run will add; marked unrendered, a run stopped partway
        # renders again.
        def on(surface):
            return [s for s in servers.values() if surface in mcp_surfaces(s)]
        desired = deep_merge(m.get("opencodex", {}).get("claude", {}) if opencodex else {}, tier["claude"])
        allow = list(tier["allow"])
        allow += [g for g in (f"mcp__{s['name']}__*" for s in on("claude")) if g not in allow]
        t3_models = _t3_models(tier, opencodex)
        try:
            _save_json(APPLIED, dict(previous, hash=None,
                                     mcp=_prospective_mcp(previous, servers, present),
                                     **({} if clear else _prospective_settings(
                                         previous, desired, allow, t3_models, present))))
        except OSError as exc:
            eprint(f"fleet: harness settings: {exc}")
            return 1
        rc = 1 if missing else rc
        live = {mcp_env_var(s) for s in servers.values() if s["auth"] != "none"}
        drop |= {r["env"] for r in (previous.get("mcp") or {}).values() if r.get("env")} - live
        retired_env = set() if clear else _retired_env_vars() - live
        try:
            if clear:
                _remove_zshenv_block()
            else:
                _mirror_zshenv(exports, drop, context, retired_env)
        except ConfigError as exc:
            eprint(f"fleet: {exc}")
            return 1

        record = {"account": account, "tier": tier, "warnings": warnings,
                  "claude": previous.get("claude") or {}, "allow": previous.get("allow") or [],
                  "t3": previous.get("t3") or {}, "t3Provider": previous.get("t3Provider", False),
                  "t3Next": previous.get("t3Next") or {},
                  "hermesSkills": previous.get("hermesSkills", False),
                  "hermesBlock": previous.get("hermesBlock", False),
                  "codexReclaimed": previous.get("codexReclaimed", False)}
        kept_mcp, users, rendered, hermes_urls, missed, claude_was = {}, {}, set(), {}, set(), {}
        kept_hermes = {}
        prev_mcp = previous.get("mcp") or {}
        try:
            # Taking settings back needs no claude: its files are edited.
            if present["claude"] or (clear and (CLAUDE_SETTINGS.exists() or _claude_json().exists())):
                record["claude"], record["allow"] = render_claude(desired, allow, previous, command)
                claude_ok, kept_mcp, found, missed, claude_was = render_claude_mcp(
                    present["claude"], {s["name"]: s for s in on("claude")}, previous, retired)
                rendered.add("claude")
                for name in found:
                    users.setdefault(name, set()).add("claude")
                rc = rc if claude_ok else 1
            else:
                # Nothing took claude's servers off: keep owning the ones fleet
                # put there, so the run that finds claude again (or an
                # uninstall) still removes them.
                wanted = {s["name"] for s in on("claude")}
                # Seeded records carry only the URL, which removal also matches.
                kept_mcp = {name: r for name, r in (previous.get("mcp") or {}).items()
                            if (r.get("claude") or r.get("url")) and _rendered_on(r, "claude")
                            and name not in wanted}
                claude_was = {name: r["claudeWas"] for name, r in prev_mcp.items()
                              if name in wanted and r.get("claudeWas")}
            if present["codex"]:
                if render_codex_mcp(on("codex"), previous, retired):
                    record["codexReclaimed"] = True
                else:
                    rc = 1
                rendered.add("codex")
                if CODEX_DIR.is_dir():
                    # codex loads ~/.codex/.env however it was started.
                    _mirror_dotenv(CODEX_DIR/".env", exports, retired_env)
                rc = rc if render_codex_keepout(command) else 1
            if present["t3"]:
                record["t3"], record["t3Provider"] = render_t3(t3_models, previous)
                record["t3Next"] = {}
            hermes = None
            if present["hermes"]:
                try:
                    hermes = render_hermes(on("hermes"), previous, retired, clear)
                except ConfigError as exc:
                    eprint(f"fleet: {exc}")
                    rc = 1
                    # Its file untouched, fleet keeps owning what it put
                    # there, so the run after the fix still removes it.
                    wanted = {s["name"] for s in on("hermes")}
                    for name, r in prev_mcp.items():
                        if name not in wanted and r.get("url") and _rendered_on(r, "hermes"):
                            kept_hermes[name] = r
                        elif name in wanted and _rendered_on(r, "hermes"):
                            # And knows the URL it left there, should the
                            # account have moved the server meanwhile.
                            hermes_urls[name] = r.get("hermesUrl") or r.get("url")
            if hermes:
                rendered.add("hermes")
                changed, record["hermesSkills"], found, record["hermesBlock"] = hermes
                for name in found:
                    users.setdefault(name, set()).add("hermes")
                if _mirror_dotenv(HERMES_ENV, exports, retired_env) or changed:
                    # A live hermes gateway restarts only on the nightly pass,
                    # never under an agent mid-turn.
                    HERMES_RESTART.parent.mkdir(parents=True, exist_ok=True)
                    HERMES_RESTART.touch()
                    if not clear:
                        _report("hermes config changed; the nightly pass restarts its gateway "
                                "(or now: fleet schedule run)")
                # Uninstalling leaves no nightly pass to restart it.
                if clear and not restart_hermes():
                    rc = 1
            elif not present["hermes"] and clear and HERMES_ENV.exists():
                # Its config gone, hermes still has the tokens fleet wrote.
                _mirror_dotenv(HERMES_ENV, exports, retired_env)
            if present["kimi"]:
                render_kimi()
        except (OSError, ConfigError) as exc:
            eprint(f"fleet: harness settings: {exc}")
            return 1
        record["mcp"] = {s["name"]: {"url": s.get("url"),
                                     "env": mcp_env_var(s) if s["auth"] != "none" else None,
                                     "claude": _claude_mcp_entry(s) if "claude" in mcp_surfaces(s) else None,
                                     # Where fleet put it: this run's surfaces, and
                                     # those a harness absent now got before.
                                     "rendered": sorted((set(mcp_surfaces(s)) & rendered
                                                         - ({"claude"} if s["name"] in missed else set())) | {
                                         x for x in SURFACES if x not in rendered
                                         and _rendered_on(prev_mcp.get(s["name"]), x)})}
                         for s in servers.values()}
        # A server still wanted on another surface keeps this run's record,
        # which also goes on owning what fleet could not take off this one.
        for surface, kept in (("claude", kept_mcp), ("hermes", kept_hermes)):
            for name, r in kept.items():
                current = record["mcp"].setdefault(name, r)
                if current is not r:
                    current["rendered"] = sorted(set(current["rendered"]) | {surface})
                    if surface == "claude":
                        claude_was.setdefault(name, r.get("claude") or r.get("claudeWas"))
                    else:
                        hermes_urls.setdefault(name, r.get("hermesUrl") or r.get("url"))
        for name, url in hermes_urls.items():
            if url and url != record["mcp"][name]["url"]:
                record["mcp"][name]["hermesUrl"] = url
        for name, entry in claude_was.items():
            if isinstance(entry, dict) and name in record["mcp"]:
                record["mcp"][name]["claudeWas"] = entry
        # An entry the user already had stays theirs while fleet wants it.
        # Where this run rendered, the renderer said whose it still is; on a
        # harness absent now, the last answer stands.
        for name, entry in record["mcp"].items():
            mine = users.get(name, set()) | {x for x in (previous.get("mcp") or {}).get(name, {}).get("users") or []
                                             if x not in rendered}
            if mine:
                entry["users"] = sorted(mine)
        # A failed part renders again on the next run.
        record["hash"] = digest if rc == 0 else None
        record["absent"] = sorted(absent)
        if clear and rc == 0:
            APPLIED.unlink(missing_ok=True)
        else:
            _save_json(APPLIED, record)
    return rc


def restart_hermes():
    """False when the gateway's restart failed; the marker then stays, so the
    next pass tries again."""
    if not HERMES_RESTART.exists():
        return True
    if shutil.which("systemctl"):
        result = subprocess.run(["systemctl", "--user", "try-restart", "hermes-gateway.service"],
                                capture_output=True, text=True)
        if result.returncode == 0:
            print("fleet: restarted the hermes gateway")
            HERMES_RESTART.unlink(missing_ok=True)
            return True
        # 5: no such unit here, so nothing to retry.
        if result.returncode != 5:
            eprint("fleet: could not restart the hermes gateway: " + (result.stderr.strip() or f"exit {result.returncode}"))
            return False
    eprint("fleet: hermes config changed; restart hermes to pick it up")
    HERMES_RESTART.unlink(missing_ok=True)
    return True


def _harnesses_is_alias():
    try:
        return HARNESSES_ALIAS_MARK in HARNESSES_BIN.read_text()
    except (OSError, UnicodeDecodeError):
        return False


def _harnesses_timer():
    if sys.platform == "darwin":
        return HARNESSES_PLIST.exists()
    return (SYSTEMD_USER_DIR/f"{HARNESSES_TIMER}.timer").exists()


def harnesses_left():
    """What of the old harnesses client is still installed."""
    left = []
    if (HARNESSES_BIN.exists() or HARNESSES_BIN.is_symlink()) and not _harnesses_is_alias():
        left.append(str(HARNESSES_BIN))
    if _harnesses_timer():
        left.append("its nightly timer")
    return left


def harness_takeover():
    """Take over from the harnesses client: its timer becomes fleet's, its
    command becomes an alias that forwards claude's headersHelper calls, and
    on its machines fleet records what it wrote as fleet's own, so what the
    account does not carry comes off."""
    seed = (not APPLIED.exists()
            and (HARNESSES_CONFIG.exists() or ((HARNESSES_BIN.exists() or HARNESSES_BIN.is_symlink())
                                               and not _harnesses_is_alias())))
    if seed:
        seeded = manifest().get("seededRemovals", {})
        _save_json(APPLIED, {
            "claude": _leaves(seeded.get("claude", {})), "allow": seeded.get("allow", []),
            "mcp": {s["name"]: {"url": s["url"], "env": mcp_env_var(s)} for s in seeded.get("mcpServers", [])}})
    if _harnesses_timer():
        if (not schedule_installed() or schedule_stale()) and schedule_enable() != 0:
            eprint("fleet: could not take over the harnesses timer; run: fleet schedule")
            return 1
        if sys.platform == "darwin":
            target = f"gui/{os.getuid()}/com.lost.plus.{HARNESSES_TIMER}"
            # bootout also fails on an agent that was never loaded; only one
            # still loaded keeps its plist, so a later run retries.
            if subprocess.run(["launchctl", "bootout", target], capture_output=True).returncode != 0 \
                    and subprocess.run(["launchctl", "print", target], capture_output=True).returncode == 0:
                eprint("fleet: could not unload the harnesses timer; run: fleet schedule")
                return 1
            HARNESSES_PLIST.unlink(missing_ok=True)
        elif _run_schedule("uninstall-timer", "user", HARNESSES_TIMER) != 0:
            eprint("fleet: could not remove the harnesses timer")
            return 1
        print("fleet: the nightly harness pass is fleet's now")
    if harnesses_left():
        alias = ("#!/bin/sh\n" + HARNESSES_ALIAS_MARK + "\n"
                 f'[ "$1" = mcp-headers ] && exec {shlex.quote(_self_path())} "$@"\n'
                 'echo "harnesses moved into fleet; run: fleet" >&2\nexit 2\n')
        temporary = HARNESSES_BIN.with_name(f".harnesses.{os.getpid()}")
        temporary.write_text(alias)
        temporary.chmod(0o755)
        # Replaces a symlink itself, never the file it points at.
        os.replace(temporary, HARNESSES_BIN)
    (HARNESSES_CONFIG/"manifest.json").unlink(missing_ok=True)
    try:
        HARNESSES_CONFIG.rmdir()
    except OSError:
        pass
    return 0


def harness_pass(force=False):
    if not config_sync_enabled():
        return 0
    return harness_takeover() or harness_render(force)


def heavy_pass():
    """The nightly pass, in the order the harnesses timer ran it: the
    opencodex proxy first (T3's models come from it), then sync and a full
    render, then each harness's own updater, then a pending hermes restart."""
    failed = []
    opencodex = os.access(OPENCODEX, os.X_OK)
    if opencodex and subprocess.run([sys.executable, str(OPENCODEX), "__apply"]).returncode:
        failed.append("opencodex apply")
    if opencodex:
        # Written only while the proxy runs, never removed here: a proxy
        # caught mid-restart must keep the route.
        if subprocess.run([sys.executable, str(OPENCODEX), "__export"]).returncode:
            failed.append("opencodex export")
    rc = cmd_sync(direct=False, force=True)
    if harness_update():
        failed.append("harness updates")
    if not restart_hermes():
        failed.append("hermes restart")
    if failed:
        eprint("fleet: " + ", ".join(failed) + " failed")
        return 1
    return rc


ACTIONS = ["sync", "status", "install", "skills", "skills --market", "schedule run", "schedule on", "schedule off"]


def menu():
    if not (shutil.which("fzf") and sys.stdin.isatty()):
        print(USAGE)
        return 2
    # Only stdout is captured: fzf draws on stderr in --height mode.
    choice = subprocess.run(["fzf", "--prompt", "fleet > ", "--height=40%", "--reverse"],
                            input="\n".join(ACTIONS), text=True, stdout=subprocess.PIPE).stdout.strip()
    if choice == "install":
        return _pick_install()
    return dispatch(choice.split()) if choice else 0


# --- commands ------------------------------------------------------------

def cmd_sync(check=False, direct=True, force=False):
    """Write the SSH blocks, pull the account config, and render the
    harnesses' settings and MCP when their inputs changed (always, with
    force); a direct run (a user or an agent, not setup or the timer) also
    uploads local config changes. With --check, exit 1 instead when any of it
    would change. Exit 3 when Auth gave no authoritative answer, 1 when a run
    left something unsent or unwritten."""
    try:
        config_lines, keys_lines, info = planned()
    except Unavailable as exc:
        eprint(f"fleet: {exc}; keeping the current SSH blocks")
        if check:
            return 3
        ssh_rc = 3
    else:
        if check:
            if not is_current(config_lines, keys_lines):
                return 1
            outdated = config_outdated()
            if outdated or (config_sync_enabled() and harnesses_left()) or harness_outdated():
                return 1
            return 3 if outdated is None else 0
        changed = _write(SSH_CONFIG, config_lines) | _write(AUTHORIZED_KEYS, keys_lines)
        try:
            SSH_DIR.chmod(0o700)
        except OSError:
            pass
        _save_state(info)
        verb = "updated" if changed else "current"
        print(f"fleet: SSH blocks {verb} ({info['hosts']} hosts, {info['keys']} keys)")
        _warn_self(info.get("fleet"))
        ssh_rc = 0
    if direct and schedule_stale():
        # A timer written before uploads existed runs plain `fleet sync`;
        # this run may be it, so it only pulls.
        # Either way this run only pulls: a failed replacement may leave the
        # old timer running plain `fleet sync`.
        direct = False
        try:
            rc = schedule_enable()
        except (SystemExit, OSError) as exc:
            # A missing helper exits, timer files may not write; the pull
            # still runs.
            eprint(f"fleet: {exc}")
            rc = 1
        if rc != 0:
            eprint("fleet: could not replace the nightly timer; run fleet schedule, then fleet sync")
            ssh_rc = 1
        else:
            eprint("fleet: updated the nightly timer; this run only pulled, run fleet sync again to upload")
    config_rc = config_sync(direct)
    try:
        harness_rc = harness_pass(force)
    except ConfigError as exc:
        eprint(f"fleet: {exc}")
        harness_rc = 1
    rcs = (ssh_rc, config_rc, harness_rc)
    return 1 if 1 in rcs else max(rcs)


@_config_locked()
def cmd_onboard():
    if not config_sync_enabled():
        eprint("fleet: account config waits until setup swaps out the old agents and harnesses modules")
        return 1
    if AGENTS_DIR.is_symlink():
        eprint(f"fleet: refusing a symlinked {AGENTS_DIR}")
        return 1
    if os.path.lexists(AGENTS_DIR) and not AGENTS_DIR.is_dir():
        eprint(f"fleet: {AGENTS_DIR} is not a folder")
        return 1
    account = _context()
    if account is None:
        eprint("fleet: no session; run: auth login")
        return 3
    try:
        # As in a sync: the old module's payload is the operator's, never
        # another account's starting copy.
        operator = account.split(" ", 1)[1] == OPERATOR_SUBJECT
        if operator:
            settle_old_agents(operator=True)
        outcome, _, _ = pull(account, settle_old=not operator)
        if outcome != "pending":
            print("fleet: this account already has its agent config; fleet sync keeps it in step")
            refresh_links()
            return 0
        onboard(account)
    except (ConfigError, OSError) as exc:
        eprint(f"fleet: {exc}")
        return 1
    return 0


# --- marketplace ---------------------------------------------------------
# Installs, like publishes, belong to the account and live in Auth: each
# command acts on Auth, then pulls, which writes the installed copies.

SKILL_ID = re.compile(r"[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}", re.I)


def _is_skill(arg):
    """A skill id or `<author>/<skill>`; any other name is a harness."""
    parts = arg.split("/")
    return bool(SKILL_ID.fullmatch(arg)) or (len(parts) == 2 and all(parts))


def _marketplace():
    """The '<origin> <subject>' a skill change is pinned to."""
    if not config_sync_enabled():
        raise ConfigError("account config waits until setup swaps out the old agents and harnesses modules")
    account = _context()
    if account is None:
        raise ConfigError("no session; run: auth login")
    return account


def _skill_change(account, action, body):
    """A marketplace change for `account` only: the auth CLI refuses a login
    from another origin, and Auth refuses another subject, so one signed in
    to since, say during publish's sync, is not changed instead."""
    origin, subject = account.split(" ", 1)
    try:
        return _request("POST", f"/api/fleet/skills/{action}", {**body, "subject": subject}, origin=origin)
    except HttpError as exc:
        if exc.status == 409 and str(exc) == "account changed":
            raise ConfigError("the session changed; nothing was changed") from None
        raise


def _origin(author, folder):
    """`<author>/<skill>`; an author without a usable name shows as `?`."""
    return f"{author or '?'}/{folder or '(unpublished)'}"


def _market():
    return [s for s in _request("GET", "/api/fleet/skills").get("skills") or [] if isinstance(s, dict)]


def cmd_install_args(args):
    """fleet install: a skill by its shape, else harnesses, else a picker."""
    local_name = None
    if "--as" in args:
        at = args.index("--as")
        if at + 1 >= len(args):
            eprint(USAGE)
            return 2
        local_name, args = args[at + 1], args[:at] + args[at + 2:]
        if local_name.startswith("."):
            eprint("fleet: --as cannot start with a dot; such a skill would stay hidden")
            return 2
    if not any(_is_skill(arg) for arg in args):
        if local_name is not None:
            eprint("fleet: --as names an installed skill")
            return 2
        return cmd_install(args) if args else _pick_install()
    if len(args) != 1:
        eprint("fleet: install one skill at a time")
        return 2
    account = _marketplace()
    body = {"skill": args[0], **({"as": local_name} if local_name is not None else {})}
    value = _skill_change(account, "install", body)
    print(f"fleet: installed {value.get('name')}" if value.get("installed")
          else f"fleet: already installed as {value.get('name')}")
    return config_sync(direct=False)


def _pick_install():
    if not (shutil.which("fzf") and sys.stdin.isatty()):
        return cmd_install([])
    choices = {f"harness  {name}": name for name in harness_specs()}
    try:
        _marketplace()
        for skill in _market():
            if not skill.get("own"):
                line = f"skill    {_origin(skill.get('author'), skill.get('folder'))}  {skill.get('description') or ''}"
                choices[line if line not in choices else f"{line} ({skill.get('id')})"] = skill.get("id")
    except ConfigError as exc:
        eprint(f"fleet: no marketplace skills: {exc}")
    choice = subprocess.run(["fzf", "--prompt", "install > ", "--height=40%", "--reverse"],
                            input="\n".join(choices), text=True, stdout=subprocess.PIPE).stdout.strip()
    if choice not in choices:
        return 0
    return cmd_install_args([choices[choice]]) if choice.startswith("skill") else cmd_install([choices[choice]])


def cmd_uninstall(args):
    if len(args) != 1:
        eprint("usage: fleet uninstall <skill>")
        return 2
    account = _marketplace()
    _skill_change(account, "uninstall", {"skill": args[0]})
    print(f"fleet: uninstalled {args[0]}")
    return config_sync(direct=False)


def cmd_publish(args):
    skill_id = None
    if len(args) == 3 and args[1] == "--id":
        args, skill_id = args[:1], args[2]
    if len(args) != 1:
        eprint("usage: fleet publish <skill> [--id <id>]")
        return 2
    account = _marketplace()
    # Auth publishes the account's copy, so this machine's edits go up first.
    rc = config_sync(direct=True)
    if rc:
        eprint("fleet: not publishing until the sync goes through")
        return rc
    body = {"folder": args[0], **({"id": skill_id} if skill_id else {})}
    value = _skill_change(account, "publish", body)
    print(f"fleet: published {value.get('folder')} as {value.get('id')}")
    return 0


def cmd_unpublish(args):
    if len(args) != 1:
        eprint("usage: fleet unpublish <skill>")
        return 2
    account = _marketplace()
    _skill_change(account, "unpublish", {"skill": args[0]})
    print(f"fleet: unpublished {args[0]}; installers keep their last copy")
    return 0


def cmd_skills(args):
    if args not in ([], ["--market"]):
        eprint("usage: fleet skills [--market]")
        return 2
    _marketplace()
    if args:
        for skill in _market():
            mine = "  (yours)" if skill.get("own") else ""
            print(f"{_origin(skill.get('author'), skill.get('folder'))}  {skill.get('id')}  "
                  f"{skill.get('installs')} installs{mine}")
            if skill.get("description"):
                print(f"    {skill['description']}")
        return 0
    _, _, _, installs, own = _listing()
    for skill in own:
        print(f"{skill.get('folder') or '(deleted folder)'}  {skill.get('id')}  "
              + ("published" if skill.get("published") else "unpublished"))
    edited = set(_edited_installs())
    for name, install in sorted(installs.items()):
        notes = [] if install.get("updating") else ["no longer updated"]
        if name in edited:
            notes.append("changed here; the next sync puts it back")
        print(f"{name}  installed from {_origin(install.get('author'), install.get('skill'))}  "
              f"{install['id']}" + "".join(f"  ({note})" for note in notes))
    if not own and not installs:
        print("fleet: no published or installed skills; see fleet skills --market")
    return 0


def _warn_self(fleet):
    me = (fleet or {}).get("self") or {}
    if fleet and not me.get("served"):
        eprint("fleet: this machine's key is waiting for confirmation in the Fleet tab")
    if me.get("key_mismatch"):
        eprint("fleet: this machine's key changed; log in again: auth login")


def cmd_status():
    state = _load_state()
    try:
        config_lines, keys_lines, info = planned()
    except Unavailable as exc:
        print(f"fleet: {exc}")
        info = None
    if info:
        current = is_current(config_lines, keys_lines)
        source = "Auth" if info["source"] == "auth" else "FLEET table and GitHub keys (before cutover)"
        print(f"fleet: SSH blocks {'current' if current else 'outdated; run: fleet sync'}"
              f" ({info['hosts']} hosts, {info['keys']} keys from {source})")
        _warn_self(info.get("fleet"))
        if info.get("missing"):
            print("fleet: not yet served by Auth as in FLEET: " + ", ".join(info["missing"]))
    if state.get("synced_at"):
        print("fleet: last sync " + time.strftime("%Y-%m-%d %H:%M %Z", time.localtime(state["synced_at"])))
    print(f"fleet: nightly sync {'on' if schedule_installed() else 'off; run: fleet schedule on'}")
    config_status()
    harness_status()
    return 0


def harness_status():
    if not config_sync_enabled():
        return
    left = harnesses_left()
    if left:
        print("fleet: the old harnesses client is still here (" + ", ".join(left) + "); run: fleet sync")
    applied = _load_json(APPLIED, {})
    for warning in applied.get("warnings") or []:
        print(f"fleet: skipped: {warning}")
    if HERMES_RESTART.exists():
        print("fleet: hermes config changed; its gateway restarts on the nightly pass (or: fleet schedule run)")


# --- schedule ------------------------------------------------------------

def _schedule_bin():
    configured = os.environ.get("SCHEDULE_BIN")
    if configured:
        return configured
    candidate = pathlib.Path(__file__).resolve().parent.parent/"bin"/"schedule"
    return str(candidate) if candidate.exists() else str(HOME/".local/bin/schedule")


def _run_schedule(*args, quiet=False):
    path = _schedule_bin()
    if not os.access(path, os.X_OK):
        raise SystemExit(f"schedule helper not found at {path}; run: setup install schedule")
    return subprocess.run([path, *args], capture_output=quiet).returncode


def _plist_path():
    return LAUNCHD_DIR/f"{PLIST_NAME}.plist"


def schedule_installed():
    if sys.platform == "darwin":
        return _plist_path().exists()
    try:
        return _run_schedule("status", "user", TIMER_NAME, quiet=True) == 0
    except SystemExit:
        return False


def schedule_stale():
    """Whether the installed timer runs something other than today's pass."""
    try:
        if sys.platform == "darwin":
            text = _plist_path().read_text()
            return "<string>run</string>" not in text or f"<integer>{SCHEDULE_HOUR}</integer>" not in text
        units = [SYSTEMD_USER_DIR/f"{TIMER_NAME}.service", SYSTEMD_USER_DIR/f"{TIMER_NAME}.timer"]
        service, timer = (unit.read_text() for unit in units)
    except FileNotFoundError:
        # Half a timer is a broken one: only none at all is no timer.
        return sys.platform != "darwin" and any(os.path.lexists(unit) for unit in units)
    except OSError:
        # One that cannot be read may be the old timer all the same.
        return True
    return "fleet schedule run" not in service or f"{SCHEDULE_HOUR:02d}:00:00" not in timer


def schedule_enable():
    # A temporary copy standing in for the installed one (uninstall's retry)
    # names it in FLEET_PATH: the copy is deleted once it has run.
    if sys.platform == "darwin":
        LAUNCHD_DIR.mkdir(parents=True, exist_ok=True)
        log = STATE.parent/"sync.log"
        log.parent.mkdir(parents=True, exist_ok=True)
        _plist_path().write_text(f"""<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>{PLIST_NAME}</string>
    <key>ProgramArguments</key>
    <array>
        <string>{os.environ.get("FLEET_PATH") or os.path.abspath(sys.argv[0])}</string>
        <string>schedule</string>
        <string>run</string>
    </array>
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key><integer>{SCHEDULE_HOUR}</integer>
        <key>Minute</key><integer>0</integer>
    </dict>
    <key>StandardOutPath</key>
    <string>{log}</string>
    <key>StandardErrorPath</key>
    <string>{log}</string>
</dict>
</plist>
""")
        uid = os.getuid()
        subprocess.run(["launchctl", "bootout", f"gui/{uid}/{PLIST_NAME}"], capture_output=True)
        result = subprocess.run(["launchctl", "bootstrap", f"gui/{uid}", str(_plist_path())],
                                capture_output=True)
        # 125: no GUI session (over SSH). The agent loads at the next login.
        if result.returncode == 125:
            print(f"fleet: nightly sync installed at {_plist_path()}")
            print("  no GUI session; it loads at the next login on the Mac's screen")
            return 0
        if result.returncode != 0:
            eprint(f"fleet: launchd enable failed (rc={result.returncode})")
            return 1
        print(f"fleet: nightly sync scheduled at {SCHEDULE_HOUR:02d}:00 (launchd)")
        return 0
    # Persistent=true replays a run missed while the machine was off.
    with tempfile.NamedTemporaryFile("w", suffix=".lines", delete=False) as handle:
        handle.write("Persistent=true\n")
        timer_extra = handle.name
    try:
        rc = _run_schedule("install-timer", "user", TIMER_NAME, "Nightly fleet SSH sync",
                           "%h/.local/bin/fleet schedule run", f"*-*-* {SCHEDULE_HOUR:02d}:00:00",
                           "", timer_extra)
    finally:
        os.unlink(timer_extra)
    if rc == 0:
        print(f"fleet: nightly sync scheduled at {SCHEDULE_HOUR:02d}:00 (systemd)")
    return rc


def schedule_disable():
    if sys.platform == "darwin":
        subprocess.run(["launchctl", "bootout", f"gui/{os.getuid()}/{PLIST_NAME}"], capture_output=True)
        _plist_path().unlink(missing_ok=True)
    # A timer that is not installed is already off; the helper refuses one it
    # cannot find. An installed one goes whether or not it is running.
    elif any((SYSTEMD_USER_DIR/f"{TIMER_NAME}.{kind}").exists() for kind in ("timer", "service")):
        rc = _run_schedule("uninstall-timer", "user", TIMER_NAME)
        if rc:
            return rc
    print("fleet: nightly sync off")
    return 0


USAGE = ("Usage: fleet [sync [--check] | status | onboard | install <harness>..."
         " | install <author>/<skill>|<id> [--as <name>] | uninstall <skill>"
         " | skills [--market] | publish <skill> [--id <id>] | unpublish <skill>"
         " | schedule [on|off|status|run]]")


def main():
    _heal_path()
    try:
        return dispatch(sys.argv[1:])
    except ConfigError as exc:
        eprint(f"fleet: {exc}")
        return 1


def dispatch(args):
    if not args:
        return menu()
    if args in (["-h"], ["--help"], ["help"]):
        print(USAGE)
        return 0
    if args[0] == "install":
        return cmd_install_args(args[1:])
    if args[0] == "uninstall":
        return cmd_uninstall(args[1:])
    if args[0] == "skills":
        return cmd_skills(args[1:])
    if args[0] == "publish":
        return cmd_publish(args[1:])
    if args[0] == "unpublish":
        return cmd_unpublish(args[1:])
    # claude's headersHelper, through the stable path in each MCP entry.
    if args[0] == "mcp-headers":
        return cmd_mcp_headers(args[1:])
    if args in (["sync"], ["sync", "--check"]):
        return cmd_sync(check=len(args) == 2)
    # setup's runs: pull only.
    if args == ["sync", "--pull"]:
        return cmd_sync(direct=False)
    if args == ["status"]:
        return cmd_status()
    if args == ["onboard"]:
        return cmd_onboard()
    if args in (["schedule"], ["schedule", "on"], ["schedule", "enable"]):
        return schedule_enable()
    if args in (["schedule", "off"], ["schedule", "disable"]):
        return schedule_disable()
    if args == ["schedule", "run"]:
        return heavy_pass()
    # setup uninstall fleet: drop the harness links, restoring what they replaced.
    if args == ["__unlink"]:
        try:
            remove_links()
        except ConfigError as exc:
            eprint(f"fleet: {exc}")
            return 1
        return 0
    if args == ["__unrender"]:
        return harness_render(clear=True)
    if args == ["schedule", "status"]:
        print(f"fleet: nightly sync {'on' if schedule_installed() else 'off'}")
        return 0
    eprint(USAGE)
    return 2


if __name__ == "__main__":
    sys.exit(main())
