HERMES_CONFIG = HOME/".hermes/config.yaml"


def _hermes_entry(server):
    lines = [f"  {server['name']}:", "    type: remote", f"    url: {server['url']}", "    oauth: false"]
    var = mcp_env_var(server["name"])
    if server["auth"] == "bearer":
        lines += ["    headers:", f"      Authorization: Bearer ${{{var}}}"]
    elif server["auth"] == "x-api-key":
        lines += ["    headers:", f"      X-API-Key: ${{{var}}}"]
    return lines


def _hermes_block(lines):
    for i, line in enumerate(lines):
        if re.match(r"^mcp_servers:\s*(#.*)?$", line):
            j = i + 1
            while j < len(lines) and (not lines[j].strip() or lines[j][0] in " \t#"):
                j += 1
            return i, j
    return None, None


def render_hermes(common, servers, tokens, record):
    if not HERMES_CONFIG.exists():
        return
    original = HERMES_CONFIG.read_text()
    lines = original.split("\n")
    start, end = _hermes_block(lines)
    if start is None:
        lines += ([""] if lines[-1].strip() else []) + ["mcp_servers:"]
        start, end = len(lines) - 1, len(lines)
    wanted = {s["name"]: s for s in servers}
    ours = set(record.get("hermes", [])) | set(common.get("retiredMcpServers", []))
    heads = [k for k in range(start + 1, end) if re.match(r"^  [^\s#][^:]*:\s*$", lines[k])]
    seen = set()
    for n in reversed(range(len(heads))):
        k = heads[n]
        stop = heads[n + 1] if n + 1 < len(heads) else end
        while stop > k + 1 and not lines[stop - 1].strip():
            stop -= 1
        name = lines[k].strip()[:-1]
        server = wanted.get(name)
        if server is None:
            if name in ours:
                del lines[k:stop]
            continue
        # An entry we never wrote stays the operator's unless it is the same server.
        if name in ours or f"    url: {server['url']}" in lines[k:stop]:
            lines[k:stop] = _hermes_entry(server)
        seen.add(name)
    start, end = _hermes_block(lines)
    while end > start + 1 and not lines[end - 1].strip():
        end -= 1
    lines[end:end] = [line for s in servers if s["name"] not in seen for line in _hermes_entry(s)]
    text = "\n".join(lines)
    changed = text != original
    if changed:
        save_text(HERMES_CONFIG, text)
        print(f"fleet: wrote {HERMES_CONFIG}")
    hermes_tokens = {v: t for v, t in tokens.items() if v in {mcp_env_var(n) for n in wanted}}
    if write_dotenv(HOME/".hermes/.env", hermes_tokens, retired_env_vars(common)) or changed:
        if shutil.which("systemctl"):
            subprocess.run(["systemctl", "--user", "try-restart", "hermes-gateway.service"], capture_output=True)
    record["hermes"] = sorted(wanted)


# --- t3 ------------------------------------------------------------------

T3_SETTINGS = HOME/".t3/userdata/settings.json"


def _effort_descriptors():
    """slug -> t3's reasoning selector, from the opencodex proxy's catalog."""
    opencodex = HOME/".local/bin/opencodex"
    try:
        url = subprocess.run([sys.executable, str(opencodex), "__proxy-url"], capture_output=True,
                             text=True, timeout=15).stdout.strip()
        with urllib.request.urlopen(url + "/v1/models", timeout=15) as response:
            rows = json.load(response).get("data") or []
    except (OSError, ValueError, subprocess.SubprocessError, AttributeError):
        return {}
    out = {}
    for row in rows:
        options = []
        for level in row.get("reasoning_efforts") or [] if isinstance(row, dict) else []:
            if isinstance(level, dict) and isinstance(level.get("value"), str):
                label = str(level.get("label") or level["value"]).removesuffix(" Effort")
                options.append({"id": level["value"], "label": label, **({"isDefault": True} if level.get("default") is True else {})})
        if options:
            out[row["id"]] = {"id": "effort", "label": "Reasoning", "type": "select", "options": options}
    return out


def render_t3(common, record):
    if not T3_SETTINGS.exists():
        return
    models = personal("t3.json").get("claudeCustomModels", [])
    descriptors = _effort_descriptors()
    wanted = {}
    for model in models:
        entry = dict(model)
        sibling = entry.pop("effortsFrom", None)  # listed late by the proxy: borrow a sibling's ladder
        descriptor = descriptors.get(entry["slug"]) or descriptors.get(sibling)
        if descriptor:
            entry["capabilities"] = {"optionDescriptors": [descriptor]}
        wanted[entry["slug"]] = entry
    drop = (set(record.get("t3", [])) | set(common.get("retiredT3Models", []))) - set(wanted)
    settings = load_json(T3_SETTINGS)
    before = json.dumps(settings)
    config = (settings.setdefault("providerInstances", {})
              .setdefault("claudeAgent", {"driver": "claudeAgent", "enabled": True, "config": {}})
              .setdefault("config", {}))
    out = []
    for row in config.get("customModels", []):
        slug = row.get("slug") if isinstance(row, dict) else row
        if slug in drop:
            continue
        out.append({**(row if isinstance(row, dict) else {"slug": slug}), **wanted.pop(slug)} if slug in wanted else row)
    config["customModels"] = out + list(wanted.values())
    if json.dumps(settings) != before:
        save_json(T3_SETTINGS, settings)
        print(f"fleet: wrote {T3_SETTINGS}")
    record["t3"] = [m["slug"] for m in models]


