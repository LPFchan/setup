def sync_ssh(check):
    """Write the SSH blocks; 0, 1 (check: they would change) or 3 (no answer)."""
    try:
        files, info = planned()
    except Unavailable as exc:
        eprint(f"fleet: {exc}; keeping the current SSH blocks")
        return 3
    if check:
        return 0 if is_current(files) else 1
    changed = False
    for path, lines in files.items():
        changed |= _write(path, lines)
    try:
        SSH_DIR.chmod(0o700)
    except OSError:
        pass
    _save_state(info)
    if changed:
        print(f"fleet: SSH blocks updated ({info['hosts']} hosts, {info['keys']} keys)")
    _warn_self(info.get("fleet"))
    return 0


def cmd_sync(check=False, pull=False):
    """Exit 0 when done, 1 for a conflict or (with --check) pending changes,
    3 when Auth gave no answer and what is on disk stays."""
    with _fleet_lock():
        rc = sync_ssh(check)
        if check:
            try:
                config = _api("GET", "/api/fleet/config")
            except ApiError:
                return 3
            state = _load_json_quiet(AGENTS_STATE)
            if rc == 0 and (config["counter"] != state.get("counter") or pending_local()
                            or not sync_builtin_skill(check=True)
                            or not WINDOWS and any(_builtin(f["path"]) for f in config["files"])):
                rc = 1
            return rc
        engine = provider_engine()
        if engine is not None:
            context_rc, raw = _auth("context")
            if context_rc == 0:
                context = json.loads(raw)
                if context.get("origin") and context.get("subject"):
                    engine.bind_account(context)
            elif context_rc == 4:
                engine.bind_account(None)
        try:
            if sync_agents(push=not pull):
                rc = rc or 1
        except ApiError as exc:
            if exc.status == 401:
                engine = provider_engine()
                if engine is not None:
                    engine.bind_account(None)
            eprint(f"fleet: account tree not synced: {exc}")
            rc = 3
        sync_builtin_skill()
        sync_links()
        if not render_harnesses() and rc == 0:
            rc = 3
        if rc != 3:
            try:
                sync_provider_credentials()
            except (ApiError, OSError, ValueError, RuntimeError) as exc:
                eprint(f"fleet: provider credentials not synced: {exc}")
                rc = 3
        return rc


def _warn_self(fleet):
    me = (fleet or {}).get("self") or {}
    if me.get("key_mismatch"):
        eprint("fleet: this machine's key changed; log in again: auth login")


def cmd_status():
    try:
        files, info = planned()
        current = is_current(files)
        print(f"fleet: SSH blocks {'current' if current else 'outdated'}"
              f" ({info['hosts']} hosts, {info['keys']} keys from Auth)")
        _warn_self(info.get("fleet"))
    except Unavailable as exc:
        print(f"fleet: {exc}")
    pending = pending_local()
    if pending is None:
        print(f"fleet: {AGENTS} has not synced yet; run: fleet sync")
    elif pending:
        print(f"fleet: {len(pending)} local change(s) to push; run: fleet sync")
    state = _load_state()
    if state.get("synced_at"):
        print("fleet: last sync " + time.strftime("%Y-%m-%d %H:%M %Z", time.localtime(state["synced_at"])))
    print(f"fleet: nightly pass {'on' if schedule_installed() else 'off; run: fleet schedule'}")
    return 0


def _source_base():
    """Like bin/setup: resolve main once, so every file comes from one commit."""
    if os.environ.get("SOURCE_URL"):
        return os.environ["SOURCE_URL"]
    try:
        with urllib.request.urlopen("https://api.github.com/repos/LPFchan/setup/git/ref/heads/main",
                                    timeout=30) as response:
            sha = json.load(response)["object"]["sha"]
        if re.fullmatch(r"[0-9a-f]{40}", sha):
            return f"https://raw.githubusercontent.com/LPFchan/setup/{sha}"
    except (OSError, ValueError, KeyError, TypeError):
        pass
    return "https://raw.githubusercontent.com/LPFchan/setup/main"


def _self_update():
    """Windows has no setup module to refresh fleet: it fetches itself, auth and
    the manifest. All three must download and parse, or none is replaced."""
    bin_dir = HOME/".local/bin"
    base, fetched = _source_base(), []
    for name, target, check in (("fleet", bin_dir/"fleet", ast.parse), ("auth", bin_dir/"auth", ast.parse),
                                ("fleet-manifest.json", MANIFEST_PATH, json.loads),
                                ("fleet-providers.py", PROVIDER_ENGINE, ast.parse),
                                ("provider-registry.json", PROVIDER_DEFAULTS, json.loads)):
        if not target.exists():
            continue
        try:
            with urllib.request.urlopen(f"{base}/files/{name}", timeout=30) as response:
                data = response.read()
            check(data.decode())
        except (OSError, ValueError, SyntaxError) as exc:
            eprint(f"fleet: not updated, {name}: {exc}")
            return
        fetched.append((target, data))
    for target, data in fetched:
        if target.read_bytes() != data:
            save_text(target, data)
            print(f"fleet: updated {target}")


def cmd_nightly():
    """The scheduled pass: proxy, pull sync, harness updates, proxy route."""
    if WINDOWS:
        _self_update()
    opencodex = HOME/".local/bin/opencodex"
    if opencodex.exists():
        subprocess.run([sys.executable, str(opencodex), "__apply"])
    rc = cmd_sync(pull=True)
    rc = cmd_update([]) or rc
    if opencodex.exists():
        subprocess.run([sys.executable, str(opencodex), "__export"])
    return 0 if rc == 3 else rc


# --- schedule ------------------------------------------------------------

def _schedule_bin():
    configured = os.environ.get("SCHEDULE_BIN")
    if configured:
        return configured
    candidate = pathlib.Path(__file__).resolve().parent.parent/"bin"/"schedule"
    return str(candidate) if candidate.exists() else str(HOME/".local/bin/schedule")


def _run_schedule(*args, quiet=False):
    path = _schedule_bin()
    if not os.access(path, os.X_OK):
        raise SystemExit(f"schedule helper not found at {path}; run: setup install schedule")
    return subprocess.run([path, *args], capture_output=quiet).returncode


def _plist_path():
    return LAUNCHD_DIR/f"{PLIST_NAME}.plist"


def _schtasks(*args):
    return subprocess.run(["schtasks", *args], capture_output=True, text=True).returncode


def _ps_quote(value):
    return "'" + str(value).replace("'", "''") + "'"


def _windows_schedule():
    """A Task Scheduler task running fleet under pythonw, so no console opens."""
    pythonw = pathlib.Path(sys.executable).with_name("pythonw.exe")  # the Python fleet runs on now
    pythonw = str(pythonw) if pythonw.exists() else shutil.which("pyw") or str(pythonw)
    action = f'-X utf8 "{os.path.abspath(sys.argv[0])}" nightly'
    script = "; ".join([
        f"$action = New-ScheduledTaskAction -Execute {_ps_quote(pythonw)} -Argument {_ps_quote(action)}",
        f"$trigger = New-ScheduledTaskTrigger -Daily -At '{SCHEDULE_HOUR:02d}:00'",
        # StartWhenAvailable replays a run missed while the machine was off.
        "$settings = New-ScheduledTaskSettingsSet -StartWhenAvailable -AllowStartIfOnBatteries "
        "-DontStopIfGoingOnBatteries -ExecutionTimeLimit (New-TimeSpan -Hours 2)",
        f"Register-ScheduledTask -TaskName {_ps_quote(TIMER_NAME)} -Action $action -Trigger $trigger "
        "-Settings $settings -Description 'Nightly fleet sync and harness update' -Force | Out-Null",
    ])
    if subprocess.run(_shell(script), env=_shell_env()).returncode:
        eprint("fleet: Task Scheduler enable failed")
        return 1
    print(f"fleet: nightly pass scheduled at {SCHEDULE_HOUR:02d}:00 (Task Scheduler)")
    return 0


def provider_schedule(enable):
    """Fleet owns the hourly model refresh and retires the old providers job."""
    script = os.path.abspath(sys.argv[0])
    name, label = "fleet-providers", "com.lost.plus.fleet-providers"
    if WINDOWS:
        if not enable:
            if _schtasks("/Query", "/TN", name) == 0:
                return _schtasks("/Delete", "/TN", name, "/F")
            return 0
        pythonw = pathlib.Path(sys.executable).with_name("pythonw.exe")
        return _schtasks("/Create", "/TN", name, "/SC", "HOURLY", "/MO", "1", "/F",
                         "/TR", f'"{pythonw}" -X utf8 "{script}" providers refresh')
    if sys.platform == "darwin":
        import plistlib
        uid = os.getuid()
        # The old launch agent otherwise keeps invoking a removed executable.
        subprocess.run(["launchctl", "bootout", f"gui/{uid}/com.lost.plus.providers"], capture_output=True)
        (LAUNCHD_DIR/"com.lost.plus.providers.plist").unlink(missing_ok=True)
        path = LAUNCHD_DIR/(label + ".plist")
        subprocess.run(["launchctl", "bootout", f"gui/{uid}/{label}"], capture_output=True)
        if not enable:
            path.unlink(missing_ok=True)
            return 0
        LAUNCHD_DIR.mkdir(parents=True, exist_ok=True)
        log = FLEET_STATE/"providers.log"
        log.parent.mkdir(parents=True, exist_ok=True)
        save_text(path, plistlib.dumps({"Label": label, "ProgramArguments": [script, "providers", "refresh"],
            "StartCalendarInterval": {"Minute": 0}, "StandardOutPath": str(log), "StandardErrorPath": str(log)}).decode())
        result = subprocess.run(["launchctl", "bootstrap", f"gui/{uid}", str(path)], capture_output=True)
        return 0 if result.returncode == 125 else result.returncode
    _run_schedule("uninstall-timer", "user", "providers", quiet=True)
    if not enable:
        return _run_schedule("uninstall-timer", "user", name)
    with tempfile.NamedTemporaryFile("w", suffix=".lines", delete=False) as handle:
        handle.write("Persistent=true\n")
        extra = handle.name
    try:
        return _run_schedule("install-timer", "user", name, "Refresh fleet provider models",
                             f"{script} providers refresh", "hourly", "", extra)
    finally:
        os.unlink(extra)


def schedule_installed():
    if WINDOWS:
        # A task that exists but is disabled never runs; schtasks /Query cannot tell.
        script = f"if ((Get-ScheduledTask -TaskName {_ps_quote(TIMER_NAME)}).State -eq 'Disabled') {{ exit 1 }}"
        return subprocess.run(_shell(script), env=_shell_env(), capture_output=True).returncode == 0
    if sys.platform == "darwin":
        return _plist_path().exists()
    try:
        return _run_schedule("status", "user", TIMER_NAME, quiet=True) == 0
    except SystemExit:
        return False


def schedule_enable():
    if provider_engine() is not None:
        rc = provider_schedule(True)
        if rc:
            eprint("fleet: hourly provider schedule failed")
            return rc
    if WINDOWS:
        return _windows_schedule()
    if sys.platform == "darwin":
        LAUNCHD_DIR.mkdir(parents=True, exist_ok=True)
        log = STATE.parent/"sync.log"
        log.parent.mkdir(parents=True, exist_ok=True)
        _plist_path().write_text(f"""<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>{PLIST_NAME}</string>
    <key>ProgramArguments</key>
    <array>
        <string>{os.path.abspath(sys.argv[0])}</string>
        <string>nightly</string>
    </array>
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key><integer>{SCHEDULE_HOUR}</integer>
        <key>Minute</key><integer>0</integer>
    </dict>
    <key>StandardOutPath</key>
    <string>{log}</string>
    <key>StandardErrorPath</key>
    <string>{log}</string>
</dict>
</plist>
""")
        uid = os.getuid()
        subprocess.run(["launchctl", "bootout", f"gui/{uid}/{PLIST_NAME}"], capture_output=True)
        result = subprocess.run(["launchctl", "bootstrap", f"gui/{uid}", str(_plist_path())],
                                capture_output=True)
        # 125: no GUI session (over SSH). The agent loads at the next login.
        if result.returncode == 125:
            print(f"fleet: nightly pass installed at {_plist_path()}")
            print("  no GUI session; it loads at the next login on the Mac's screen")
            return 0
        if result.returncode != 0:
            eprint(f"fleet: launchd enable failed (rc={result.returncode})")
            return 1
        print(f"fleet: nightly pass scheduled at {SCHEDULE_HOUR:02d}:00 (launchd)")
        return 0
    # Persistent=true replays a run missed while the machine was off. The path
    # is absolute: systemd 219 (Synology DSM 7) does not expand %h in ExecStart.
    with tempfile.NamedTemporaryFile("w", suffix=".lines", delete=False) as handle:
        handle.write("Persistent=true\n")
        timer_extra = handle.name
    try:
        rc = _run_schedule("install-timer", "user", TIMER_NAME, "Nightly fleet sync and harness update",
                           f"{os.path.abspath(sys.argv[0])} nightly", f"*-*-* {SCHEDULE_HOUR:02d}:00:00",
                           "", timer_extra)
    finally:
        os.unlink(timer_extra)
    if rc == 0:
        print(f"fleet: nightly pass scheduled at {SCHEDULE_HOUR:02d}:00 (systemd)")
    return rc


def schedule_disable():
    if provider_engine() is not None:
        rc = provider_schedule(False)
        if rc:
            return rc
    if WINDOWS:
        if _schtasks("/Query", "/TN", TIMER_NAME) == 0 and _schtasks("/Delete", "/TN", TIMER_NAME, "/F"):
            eprint("fleet: Task Scheduler disable failed")
            return 1
    elif sys.platform == "darwin":
        subprocess.run(["launchctl", "bootout", f"gui/{os.getuid()}/{PLIST_NAME}"], capture_output=True)
        _plist_path().unlink(missing_ok=True)
    else:
        rc = _run_schedule("uninstall-timer", "user", TIMER_NAME)
        if rc:
            return rc
    print("fleet: nightly pass off")
    return 0


USAGE = """Usage: fleet sync [--check|--pull]     account tree, SSH blocks, credentials and settings
       fleet providers [add|enable|disable|refresh|capabilities]
       fleet status
       fleet install [harness...]          asks which when none named
       fleet update [harness...]           every installed harness when none named
       fleet skills [list|install|uninstall|publish|unpublish] ...
       fleet schedule [enable|disable|status]
       fleet nightly                       what the schedule runs"""


def main():
    args = sys.argv[1:]
    command, rest = (args[0], args[1:]) if args else (None, [])
    if command in ("install", "update", "nightly", "sync"):
        _heal_path()
    if command == "sync" and rest in ([], ["--check"], ["--pull"]):
        return cmd_sync(check=rest == ["--check"], pull=rest == ["--pull"])
    if args == ["status"]:
        return cmd_status()
    if command == "install":
        return cmd_install(rest)
    if command == "update":
        return cmd_update(rest)
    if command == "providers":
        return cmd_providers(rest)
    if command == "skills":
        return cmd_skills(rest)
    if command == "mcp-headers":
        return cmd_mcp_headers(rest)
    if args == ["nightly"]:
        return cmd_nightly()
    if args in (["schedule"], ["schedule", "enable"]):
        return schedule_enable()
    if args == ["schedule", "disable"]:
        return schedule_disable()
    if args == ["schedule", "status"]:
        print(f"fleet: nightly pass {'on' if schedule_installed() else 'off'}")
        return 0
    eprint(USAGE)
    return 2


def _windows_entry():
    """Windows: read and write UTF-8 whatever the code page, and under pythonw (the
    nightly task) log to a file and keep every child's console window hidden."""
    if not sys.flags.utf8_mode:
        sys.exit(subprocess.run([sys.executable, "-X", "utf8", *sys.argv]).returncode)
    if sys.stdout is not None:
        return
    FLEET_STATE.mkdir(parents=True, exist_ok=True)
    log = open(FLEET_STATE/"sync.log", "a", encoding="utf-8", buffering=1)
    sys.stdout = sys.stderr = log
    print(time.strftime("--- %Y-%m-%d %H:%M:%S"))
    popen = subprocess.Popen.__init__

    def hidden(self, *args, **kwargs):
        kwargs["creationflags"] = kwargs.get("creationflags", 0) | subprocess.CREATE_NO_WINDOW
        for stream in ("stdout", "stderr"):
            kwargs.setdefault(stream, log)
        kwargs.setdefault("stdin", subprocess.DEVNULL)
        popen(self, *args, **kwargs)
    subprocess.Popen.__init__ = hidden


if __name__ == "__main__":
    if WINDOWS:
        _windows_entry()
    sys.exit(main())
