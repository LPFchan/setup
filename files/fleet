PROVIDER_SETTINGS = AGENTS/"settings/providers.json"
_PROVIDER_SOURCE = pathlib.Path(__file__).resolve().parent
PROVIDER_DEFAULTS = pathlib.Path(os.environ.get("FLEET_PROVIDER_DEFAULTS",
    _PROVIDER_SOURCE/"provider-registry.json" if (_PROVIDER_SOURCE/"provider-registry.json").exists()
    else HOME/".config/fleet/provider-defaults.json"))
PROVIDER_ENGINE = pathlib.Path(os.environ.get("FLEET_PROVIDER_ENGINE", _PROVIDER_SOURCE/"fleet-providers.py"))


def provider_engine():
    if not PROVIDER_ENGINE.exists():
        return None
    spec = importlib.util.spec_from_file_location("fleet_providers", PROVIDER_ENGINE)
    engine = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(engine)
    engine.SETTINGS_PATH = str(PROVIDER_SETTINGS)
    engine.DEFAULTS_PATH = str(PROVIDER_DEFAULTS)
    engine.AUTH_BIN = _auth_bin() or str(HOME/".local/bin/auth")
    return engine


def sync_provider_credentials():
    engine = provider_engine()
    if engine is None:
        return
    rc, raw = _auth("context")
    if rc:
        return
    context = json.loads(raw)
    if not context.get("origin") or not context.get("subject"):
        raise ValueError("invalid provider account context")
    engine.sync_credentials(context, lambda: _api("GET", "/api/fleet/providers/catalog"))


def cmd_providers(args):
    engine = provider_engine()
    if engine is None:
        eprint("fleet: provider support is missing; run: setup update fleet")
        return 1
    if args and args[0] == "capabilities":
        try:
            engine.cmd_capabilities(args[1:])
            return 0
        except (OSError, ValueError, LookupError) as exc:
            eprint(f"fleet providers: {exc}")
            return 1
    if args in (["help"], ["--help"], ["-h"]):
        engine._usage()
        return 0
    if args and args[0] not in ("add", "enable", "disable", "refresh"):
        eprint("Usage: fleet providers [add|enable|disable|refresh|capabilities]")
        return 2
    rc = cmd_sync(pull=True)
    if rc:
        return rc
    if not PROVIDER_SETTINGS.exists():
        engine.bootstrap(str(PROVIDER_SETTINGS), str(PROVIDER_DEFAULTS))
    before = PROVIDER_SETTINGS.read_bytes()
    context_rc, context_raw = _auth("context")
    if context_rc:
        return 3
    expected_context = json.loads(context_raw)
    read_context = engine.common_auth_context
    def bound_context():
        context = read_context()
        if context != expected_context:
            raise engine.CommonAuthContextChanged("account changed during provider command")
        return context
    engine.common_auth_context = bound_context
    old = sys.argv
    try:
        sys.argv = [old[0], *args]
        engine.main()
    except SystemExit as exc:
        return exc.code or 0
    except (OSError, ValueError, engine.VaultError) as exc:
        eprint(f"fleet providers: {exc}")
        return 1
    finally:
        sys.argv = old
    context_rc, context_raw = _auth("context")
    if context_rc or json.loads(context_raw) != expected_context:
        eprint("fleet: account changed during provider command; settings were not uploaded")
        return 1
    if PROVIDER_SETTINGS.read_bytes() != before:
        return cmd_sync()
    return 0


# --- harnesses -----------------------------------------------------------

def _heal_path():
    """A timer starts us without the user's PATH; put their bins back first."""
    npm = pathlib.Path(os.environ.get("APPDATA") or HOME)/"npm"  # Windows npm's global bin
    mine = [str(d) for d in (HOME/".local/bin", HOME/".opencode/bin", *([npm] if WINDOWS else [])) if d.is_dir()]
    tools = [str(d) for d in sorted((HOME/".nvm/versions/node").glob("*/bin"), reverse=True)]
    tools += [d for d in ("/opt/homebrew/bin", "/usr/local/bin") if os.path.isdir(d)]
    current = [p for p in os.environ.get("PATH", "").split(os.pathsep) if p and p not in mine]
    os.environ["PATH"] = os.pathsep.join(mine + current + [d for d in tools if d not in current])


def _resolve(spec):
    found = shutil.which(spec["name"])
    if found:
        return found
    for pattern in spec.get("candidates", []):
        for path in sorted(glob.glob(os.path.expanduser(pattern)), reverse=True):
            if os.access(path, os.X_OK):
                return path
    return None


def _version(binary):
    try:
        out = subprocess.run([binary, "--version"], capture_output=True, text=True,
                             stdin=subprocess.DEVNULL, timeout=20)
    except (OSError, subprocess.SubprocessError):
        return None
    lines = (out.stdout or out.stderr).strip().splitlines() if out.returncode == 0 else []
    return lines[0].strip() if lines else None


def _node_bin(binary):
    """The bin/ of the node install npm put this harness under: its own
    updater runs `npm install -g`, which must land in that same install."""
    for parent in pathlib.Path(os.path.realpath(binary)).parents:
        if parent.name == "node_modules" and parent.parent.name == "lib" and (parent.parent.parent/"bin/npm").exists():
            return str(parent.parent.parent/"bin")
    return None


def _harnesses(names):
    harnesses = manifest().get("harnesses", [])
    if WINDOWS:  # a harness runs on Windows only as its windows block says
        harnesses = [{"name": h["name"], **h["windows"]} for h in harnesses if "windows" in h]
    specs = {h["name"]: h for h in harnesses}
    unknown = [n for n in names if n not in specs]
    if unknown:
        raise SystemExit(f"fleet: unknown harness: {' '.join(unknown)} (known: {' '.join(specs)})")
    return [specs[n] for n in names] if names else None, specs


def _pick(specs):
    if not sys.stdin.isatty():
        raise SystemExit("fleet: name the harnesses to install, e.g. fleet install claude codex")
    for name, spec in specs.items():
        print(f"  {name}{'  (installed)' if _resolve(spec) else ''}")
    try:
        names = input("fleet: install which? ").replace(",", " ").split()
    except EOFError:
        names = []
    return _harnesses(names)[0] or []


def _shell(command):
    """argv running a manifest command: bash, or Windows PowerShell."""
    if not WINDOWS:
        # pipefail: a failed download piped into sh otherwise exits 0
        return ["bash", "-o", "pipefail", "-c", command]
    script = "$ErrorActionPreference = 'Stop'; " + command
    return ["powershell", "-NoProfile", "-NonInteractive", "-ExecutionPolicy", "Bypass",
            "-EncodedCommand", base64.b64encode(script.encode("utf-16-le")).decode()]


def _shell_env():
    env = dict(os.environ)
    if WINDOWS:
        # pwsh's module path breaks Windows PowerShell's own modules (Get-FileHash).
        env.pop("PSModulePath", None)
    return env


def cmd_install(names):
    chosen, specs = _harnesses(names)
    rc = 0
    for spec in chosen or _pick(specs):
        if _resolve(spec) and not spec.get("rerunWhenInstalled"):
            print(f"fleet: {spec['name']} already installed")
            continue
        print(f"fleet: installing {spec['name']}")
        if subprocess.run(_shell(spec["install"]), env=_shell_env()).returncode:
            eprint(f"fleet: {spec['name']} install failed")
            rc = 1
    return rc


def cmd_update(names):
    chosen, specs = _harnesses(names)
    failed = []
    for spec in chosen or specs.values():
        binary = _resolve(spec)
        if not binary:
            if chosen:
                eprint(f"fleet: {spec['name']} is not installed")
                failed.append(spec["name"])
            continue
        env = _shell_env()
        lead = [p for p in (_node_bin(binary), os.path.dirname(binary)) if p]
        env["PATH"] = os.pathsep.join(lead + [env.get("PATH", "")])
        if spec["name"] == "claude":
            env["CLAUDE_CODE_SIMPLE"] = "1"
        argv = (_shell(spec["update"]) if spec.get("update")
                else [binary, *spec.get("updateArgs", "update").split()])
        before = _version(binary)
        try:
            ok = subprocess.run(argv, stdin=subprocess.DEVNULL, env=env, timeout=900).returncode == 0
        except subprocess.TimeoutExpired:
            ok = False
        after = _version(binary)
        if not ok:
            failed.append(spec["name"])
        elif before and after and before != after:
            print(f"fleet: {spec['name']} {before} -> {after}")
        else:
            print(f"fleet: {spec['name']} {after or 'updated'} (unchanged)")
    if failed:
        eprint(f"fleet: could not update: {' '.join(failed)}")
    return 1 if failed else 0


