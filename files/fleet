class ConfigError(Exception):
    """The config sync could not finish; nothing past the failure was written."""


class Changed(Exception):
    """The account changed while it was read; the pull starts over."""


def _setup_modules():
    """The modules setup records as installed here, None when unread."""
    try:
        rows = SETUP_STATE.read_text().splitlines()
    except FileNotFoundError:
        return set()
    except OSError:
        return None
    return {row.split("\t", 1)[0] for row in rows}


def config_sync_enabled():
    modules = _setup_modules()
    # Unread, the old modules may still own ~/.agents: wait.
    return modules is not None and not modules & set(PREDECESSOR_MODULES)


def config_path(rel):
    """Whether `rel` is a path Auth stores, as it checks them."""
    try:
        # A name that is not UTF-8 reaches here surrogate-escaped.
        rel.encode()
    except UnicodeEncodeError:
        return False
    if len(rel.encode()) > MAX_PATH_BYTES or re.search(r"[\x00-\x1f\x7f\\]", rel):
        return False
    segments = rel.split("/")
    for segment in segments:
        if segment in ("", ".", "..") or len(segment.encode()) > MAX_SEGMENT_BYTES:
            return False
        if segment.casefold() in SKIPPED_NAMES:
            return False
    if len(segments) == 1:
        return rel in ("AGENTS.md", "mcp.json")
    return segments[0] in ("skills", "settings")


def _digest(path):
    data = path.read_bytes()
    return [hashlib.sha256(data).hexdigest(), bool(path.stat().st_mode & 0o100)]


def _unreadable(exc):
    raise ConfigError(f"cannot read {exc.filename}: {exc.strerror}")


def scan_local():
    """({path: [sha256, executable]}, symlinks skipped) under ~/.agents/.
    Installed skills are the account's installs, not its own files."""
    files, symlinks = {}, []
    # Normalized: HFS+ gives an installed folder's name back decomposed,
    # and its files would then read as the account's own. Case it keeps, so
    # a folder differing in case is the account's (and refused as a clash).
    nfc = lambda name: unicodedata.normalize("NFC", name)
    installed = {nfc(name): name for name in _load_json(INSTALLED, {})}

    def is_install(base, name):
        # Another spelling is the install only when it is the same folder:
        # a disk that keeps both spellings can hold an owned one beside it.
        key = installed.get(nfc(name))
        if key is None or key == name:
            return key is not None
        if not os.path.lexists(base/key):
            # Two other spellings cannot both be the install: neither is
            # known to be, so both stay the account's (and clash).
            return sum(nfc(n) == nfc(name) for n in os.listdir(base)) == 1
        here, there = os.lstat(base/name), os.lstat(base/key)
        return (here.st_dev, here.st_ino) == (there.st_dev, there.st_ino)

    def add(path, rel):
        if path.is_symlink():
            symlinks.append(rel)
        elif config_path(rel) and os.path.lexists(path):
            # A folder or device here cannot be synced; skipped, the file it
            # replaced would read as deleted on every machine.
            if not path.is_file():
                raise ConfigError(f"{path} is not a regular file")
            files[rel] = _digest(path)

    for name in ("AGENTS.md", "mcp.json"):
        add(AGENTS_DIR/name, name)
    for top in ("skills", "settings"):
        root = AGENTS_DIR/top
        if root.is_symlink():
            symlinks.append(top)
            continue
        if not os.path.lexists(root):
            continue
        # An unreadable folder fails the scan: skipped, its files would read
        # as deleted and the deletions would reach every machine.
        for folder, dirs, names in os.walk(root, onerror=_unreadable):
            base = pathlib.Path(folder)
            for name in list(dirs):
                if name.casefold() in SKIPPED_NAMES or (base == AGENTS_DIR/"skills" and is_install(base, name)):
                    dirs.remove(name)
                elif (base/name).is_symlink():
                    dirs.remove(name)
                    symlinks.append((base/name).relative_to(AGENTS_DIR).as_posix())
            for name in names:
                if name.casefold() not in SKIPPED_NAMES:
                    add(base/name, (base/name).relative_to(AGENTS_DIR).as_posix())
    return files, sorted(symlinks)


def _safe_target(rel):
    """Where `rel` lands, refusing a path that leaves ~/.agents/ or passes
    through a symlink."""
    if not config_path(rel):
        raise ConfigError(f"Auth served a path outside ~/.agents/: {rel!r}")
    target = AGENTS_DIR/rel
    # The parents up to and including ~/.agents itself.
    for parent in list(target.parents)[:len(rel.split("/"))]:
        if parent.is_symlink():
            raise ConfigError(f"refusing to write through a symlink: {parent}")
    return target


def _request(method, path, body=None, expect=dict, origin=None):
    """The parsed answer of a session-authenticated request. Raises Rejected
    for a refused session, ConfigError for anything else. With `origin`, a
    login that moved to another Auth origin raises ConfigError."""
    args = ["request", method, path] + (["-"] if body is not None else [])
    stdin = json.dumps(body) if body is not None else None
    for attempt in range(3):
        rc, out = _auth(*args, stdin=stdin, timeout=300, origin=origin)
        if rc == 4:
            _set_login_marker(True)
            raise Rejected()
        if rc == 5 and origin:
            raise ConfigError("the session changed during the sync")
        try:
            value = json.loads(out) if out.strip() else None
        except ValueError:
            value = None
        if rc == 0 and isinstance(value, expect):
            return value
        if rc == 6 and isinstance(value, dict):
            if value.get("status") == 503 and attempt < 2:
                time.sleep(1 + attempt)
                continue
            raise HttpError(value)
        raise Unreachable("Auth is unreachable")
    raise Unreachable("Auth is unreachable")


class Unreachable(ConfigError):
    pass


class Rejected(ConfigError):
    def __init__(self):
        super().__init__("no session; run: auth login")


class HttpError(ConfigError):
    def __init__(self, value):
        self.status = value.get("status")
        self.retry_after = value.get("retry_after")
        super().__init__(str(value.get("error") or f"Auth answered {self.status}"))


def _listed_files(entries, prefix=""):
    files = {}
    for entry in entries or []:
        rel = entry.get("path") if isinstance(entry, dict) else None
        if not isinstance(rel, str) or not config_path(prefix + rel):
            raise ConfigError(f"Auth listed a path outside ~/.agents/: {prefix}{rel!r}")
        files[rel] = [entry.get("sha256"), bool(entry.get("executable"))]
    return files


def _listing():
    """(counter, version, the account's own files, its installs by local
    name, its own skills)."""
    value = _request("GET", "/api/fleet/config")
    files = _listed_files(value.get("files"))
    installs = {}
    for entry in value.get("installs") or []:
        name = entry.get("name") if isinstance(entry, dict) else None
        # A dot folder would never be linked, like the account's own dot folders.
        if not isinstance(name, str) or "/" in name or name.startswith(".") \
                or not config_path(f"skills/{name}/SKILL.md") or not isinstance(entry.get("id"), str):
            raise ConfigError(f"Auth listed an install outside ~/.agents/skills/: {name!r}")
        installs[name] = {"id": entry["id"], "server": _listed_files(entry.get("files"), f"skills/{name}/"),
                          **{key: entry.get(key) for key in ("skill", "author", "author_name", "updating")}}
    # An install in a folder the account also owns would replace the owned
    # files, and a later sync would then delete them from Auth.
    fold = lambda path: unicodedata.normalize("NFC", path).casefold()
    owned = {fold("/".join(rel.split("/")[:2])) for rel in files if rel.startswith("skills/")}
    overlap = sorted(name for name in installs if fold(f"skills/{name}") in owned)
    if overlap:
        raise ConfigError("the account owns files in the folder of an installed skill: " + ", ".join(overlap))
    clashes = _collisions(set(files) | {f"skills/{name}/{rel}" for name, install in installs.items()
                                        for rel in install["server"]})
    if clashes:
        raise ConfigError("the account has paths that a case-insensitive disk would merge into "
                          "one file: " + "; ".join(clashes))
    counter, version = value.get("counter"), value.get("version")
    if not isinstance(counter, int) or not isinstance(version, int):
        raise ConfigError("Auth answered without a counter")
    own = [s for s in value.get("skills") or [] if isinstance(s, dict)]
    return counter, version, files, installs, own


def _collisions(paths):
    """Groups of spellings that are one file or folder on macOS's default
    disk: they differ only in letter case or Unicode normalization. Folders
    count too, since skills/Foo/a and skills/foo/b would share one."""
    groups = {}
    for rel in paths:
        parts = rel.split("/")
        for end in range(1, len(parts) + 1):
            prefix = "/".join(parts[:end])
            groups.setdefault(unicodedata.normalize("NFC", prefix).casefold(), set()).add(prefix)
    return sorted(", ".join(sorted(g)) for g in groups.values() if len(g) > 1)


def fetch_contents(paths, counter, server):
    """{path: bytes} for `paths`, all from the snapshot at `counter`."""
    contents, pending = {}, sorted(paths)
    while pending:
        value = _request("POST", "/api/fleet/config/fetch", {"paths": pending})
        if value.get("counter") != counter or value.get("missing"):
            raise Changed()
        _take_fetched(value, server, contents)
        pending = _remaining(value, pending)
    if set(contents) != set(paths):
        raise ConfigError("Auth's fetch left out requested files")
    return contents


def _take_fetched(value, server, contents):
    """Add a fetch's files to `contents`; Changed when one is not as listed."""
    for entry in value.get("files") or []:
        rel = entry.get("path")
        try:
            data = base64.b64decode(entry.get("content") or "", validate=True)
        except (ValueError, TypeError):
            raise ConfigError(f"Auth sent unreadable content for {rel!r}") from None
        if rel not in server or hashlib.sha256(data).hexdigest() != server[rel][0]:
            raise Changed()
        contents[rel] = data


def _remaining(value, pending):
    remaining = value.get("remaining") or []
    if len(remaining) >= len(pending):
        raise ConfigError("Auth returned no files for a fetch")
    return remaining


# --- installed skills ----------------------------------------------------

def _fetch_skill(install):
    """{path: bytes} of an installed skill's copy, as listed. The skill fetch
    carries no counter, so each file is checked against the listing."""
    contents, pending = {}, sorted(install["server"])
    while pending:
        value = _request("POST", "/api/fleet/skills/fetch", {"id": install["id"], "paths": pending})
        if value.get("missing"):
            raise Changed()
        _take_fetched(value, install["server"], contents)
        pending = _remaining(value, pending)
    if set(contents) != set(install["server"]):
        raise ConfigError("Auth's fetch left out requested files")
    return contents


def _with_name(data, name):
    """SKILL.md with its frontmatter `name:` set to the local name, so
    harnesses tell two installs of same-named skills apart."""
    lines = data.split(b"\n")
    if lines[0].rstrip(b"\r") != b"---":
        return data
    end = next((i for i in range(1, len(lines)) if lines[i].rstrip(b"\r") == b"---"), None)
    if end is None:
        return data
    # Plain only when no YAML reader takes it for a number, bool or null.
    plain = (re.fullmatch(r"[A-Za-z][\w.-]*", name)
             and name.lower() not in {"y", "n", "yes", "no", "on", "off", "true", "false", "null"})
    line = b"name: " + (name if plain else json.dumps(name, ensure_ascii=False)).encode()
    # The top-level key however YAML spells it, and an indented value
    # continuing on the lines after it.
    key = re.compile(rb"""(?:name|"name"|'name')[ \t]*:(?:[ \t]|\r?$)""")
    for i in range(1, end):
        if key.match(lines[i]):
            # Blank lines can sit inside the value; trailing ones are not its.
            stop = last = i + 1
            while stop < end and (lines[stop][:1] in (b" ", b"\t") or not lines[stop].strip()):
                stop += 1
                if lines[stop - 1].strip():
                    last = stop
            lines[i:last] = [line + (b"\r" if lines[i].endswith(b"\r") else b"")]
            break
    else:
        lines.insert(1, line)
    return b"\n".join(lines)


def _scan_folder(folder):
    """{path: [sha256, executable]} of every file under `folder`, a symlink as
    None and what cannot be read as "unreadable" (or is not a regular
    file), which never matches what pull wrote; None for a folder that is not a real folder."""
    if folder.is_symlink() or not folder.is_dir():
        return None
    found = {}

    def unreadable(exc):
        found[pathlib.Path(exc.filename).relative_to(folder).as_posix()] = "unreadable"
    for base, dirs, names in os.walk(folder, onerror=unreadable):
        for name in dirs + names:
            path = pathlib.Path(base)/name
            if path.is_symlink():
                found[path.relative_to(folder).as_posix()] = None
            elif name in names and not path.is_file():
                # A FIFO would block a read until something writes to it.
                found[path.relative_to(folder).as_posix()] = "not a file"
            elif name in names:
                try:
                    found[path.relative_to(folder).as_posix()] = _digest(path)
                except OSError:
                    found[path.relative_to(folder).as_posix()] = "unreadable"
    return found


def _install_folder(name):
    """An installed skill's folder as the disk spells it: gone under its
    recorded name, the one other spelling of that name is it (as scan_local
    reads it), so an edit there is found and a pull replaces it."""
    path = AGENTS_DIR/"skills"/name
    if os.path.lexists(path):
        return path
    want = unicodedata.normalize("NFC", name)
    try:
        others = sorted(e.name for e in path.parent.iterdir() if unicodedata.normalize("NFC", e.name) == want)
    except OSError:
        others = []
    # Two others: neither is known to be it (scan_local keeps both).
    return path.parent/others[0] if len(others) == 1 else path


def _edited_installs():
    """Installed skills changed here since pull wrote them."""
    return sorted(name for name, entry in _load_json(INSTALLED, {}).items()
                  if not isinstance(entry, dict) or _scan_folder(_install_folder(name)) != entry.get("local"))


def _install_plan(installs, fresh=False):
    """(names to write, names to remove): an install is written when it is
    new, renamed, changed in the account, or changed here. fresh: nothing
    here is this account's."""
    mine = {} if fresh else _load_json(INSTALLED, {})
    edited = set() if fresh else set(_edited_installs())
    write = [name for name, install in installs.items()
             if not isinstance(mine.get(name), dict) or name in edited
             or [mine[name].get("id"), mine[name].get("server")] != [install["id"], install["server"]]]
    return sorted(write), sorted(set(mine) - set(installs))


def _apply_installs(installs, write, remove, contents, backup):
    """Write the fetched installs and remove the uninstalled ones. A folder
    that is not what pull last wrote goes to the backup; installed.json
    follows each folder, so a failure partway leaves it true."""
    mine = _load_json(INSTALLED, {})
    kept = []
    try:
        left = STAGING.read_text().split("\n")
    except FileNotFoundError:
        left = []
    for stale in left:
        if stale.startswith(".installing-") and "/" not in stale:
            shutil.rmtree(AGENTS_DIR/stale, ignore_errors=True)
    STAGING.unlink(missing_ok=True)

    def clear(name):
        # The folder itself may be a symlink put here; it is what gets replaced.
        target = _safe_target(f"skills/{_install_folder(name).name}")
        if not os.path.lexists(target):
            return
        entry = mine.get(name)
        # Moved out of the way before it is compared: an edit saved during
        # the comparison lands in the copy that is checked, never in one
        # deleted unseen. A run stopped here leaves it aside, not deleted.
        aside = pathlib.Path(tempfile.mkdtemp(prefix=".replacing-", dir=AGENTS_DIR))
        os.rename(target, aside/name)
        if isinstance(entry, dict) and _scan_folder(aside/name) == entry.get("local"):
            shutil.rmtree(aside)
        else:
            backup.move(aside/name, f"installed/{name}")
            aside.rmdir()
            kept.append(name)

    def save():
        if mine:
            _save_json(INSTALLED, mine)
        else:
            INSTALLED.unlink(missing_ok=True)

    for name in remove:
        clear(name)
        mine.pop(name, None)
        save()
    for name in write:
        install = installs[name]
        AGENTS_DIR.mkdir(parents=True, exist_ok=True)
        staging = pathlib.Path(tempfile.mkdtemp(prefix=".installing-", dir=AGENTS_DIR))
        try:
            STAGING.parent.mkdir(parents=True, exist_ok=True)
            with open(STAGING, "a") as record:
                record.write(staging.name + "\n")
            for rel, data in contents[name].items():
                path = staging/rel
                path.parent.mkdir(parents=True, exist_ok=True)
                # Like the account's own files: readable by the owner only.
                fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL,
                             0o700 if install["server"][rel][1] else 0o600)
                with os.fdopen(fd, "wb") as handle:
                    handle.write(_with_name(data, name) if rel == "SKILL.md" else data)
            written = _scan_folder(staging)
            clear(name)
            target = _safe_target(f"skills/{name}")
            target.parent.mkdir(parents=True, exist_ok=True)
            os.rename(staging, target)
        finally:
            shutil.rmtree(staging, ignore_errors=True)
        mine[name] = {"id": install["id"], "server": install["server"], "local": written}
        save()
    if kept:
        _report(f"put installed skills back as the account has them (what was here is in "
                f"{backup.root}): " + ", ".join(kept))


class Backup:
    """One run's backup folder, made on first use."""

    def __init__(self):
        self.root = None

    def _dir(self):
        if self.root is None:
            stamp = datetime.datetime.now().strftime("%Y%m%d-%H%M%S")
            root = BACKUP_DIR/stamp
            n = 1
            while root.exists():
                n += 1
                root = BACKUP_DIR/f"{stamp}-{n}"
            # Server copies can hold credentials: owner-only.
            BACKUP_DIR.mkdir(parents=True, exist_ok=True)
            BACKUP_DIR.chmod(0o700)
            root.mkdir(mode=0o700)
            self.root = root
        return self.root

    def move(self, path, label):
        """Move `path` (file, folder, or link) under `label` in the backup."""
        destination = self._dir()/label
        # A folder replaced by a file can back up a descendant first; give the
        # folder its own name rather than moving it inside that copy.
        n = 1
        while os.path.lexists(destination):
            n += 1
            destination = self._dir()/f"{label}.{n}"
        destination.parent.mkdir(parents=True, exist_ok=True)
        # A rename or nothing: shutil.move's copy-then-delete can fail halfway
        # (a folder it may not empty), leaving the original gutted.
        try:
            os.rename(path, destination)
        except OSError as exc:
            if exc.errno != errno.EXDEV:
                raise
            shutil.move(str(path), str(destination))
        return destination

    def save(self, data, label):
        destination = self._dir()/label
        destination.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
        fd = os.open(destination, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
        with os.fdopen(fd, "wb") as handle:
            handle.write(data)


def _write_file(rel, data, executable):
    target = _safe_target(rel)
    target.parent.mkdir(parents=True, exist_ok=True)
    fd, temporary = tempfile.mkstemp(prefix=f".{target.name}.", dir=target.parent)
    try:
        with os.fdopen(fd, "wb") as handle:
            handle.write(data)
        # Account files can hold credentials: readable by the owner only.
        os.chmod(temporary, 0o700 if executable else 0o600)
        os.replace(temporary, target)
    except BaseException:
        pathlib.Path(temporary).unlink(missing_ok=True)
        raise


def _remove_file(rel):
    target = _safe_target(rel)
    target.unlink(missing_ok=True)
    for parent in target.parents:
        if parent == AGENTS_DIR or AGENTS_DIR not in parent.parents:
            break
        try:
            parent.rmdir()
        except OSError:
            break


def _load_json(path, default):
    try:
        value = json.loads(path.read_text())
    except (OSError, ValueError):
        return default
    return value if isinstance(value, type(default)) else default


def _load_record(path, valid):
    """A state record; {} only when there is none. A damaged one stops the
    command: read as empty, it would lose what the record keeps."""
    try:
        value = json.loads(path.read_text())
    except FileNotFoundError:
        return {}
    except (OSError, ValueError) as exc:
        raise ConfigError(f"cannot read {path} ({exc}); move it aside to start afresh") from None
    if not isinstance(value, dict) or not valid(value):
        raise ConfigError(f"{path} is damaged; move it aside to start afresh")
    return value


def _sync_record_ok(r):
    # An empty or wrong-shaped file map would read as "nothing synced yet".
    files = r.get("files")
    # An account _context() could never give would move ~/.agents aside as
    # another account's.
    return (isinstance(r.get("account"), str) and re.fullmatch(r"[^ ]+ [^ ]+", r["account"])
            and isinstance(r.get("counter"), int)
            and isinstance(r.get("version"), int) and isinstance(files, dict)
            and all(config_path(k) and isinstance(v, list) and len(v) == 2
                    and isinstance(v[0], str) and re.fullmatch(r"[0-9a-f]{64}", v[0])
                    and isinstance(v[1], bool) for k, v in files.items()))


def _load_sync_record():
    """The sync record. Read as a first join, a damaged one would take the
    account's copy over local edits."""
    return _load_record(CONFIG_STATE, _sync_record_ok)


def _load_links():
    """{link: what it displaced}. Read as empty, a damaged one would forget
    the user files the links displaced."""
    return _load_record(LINKS_STATE, lambda r: all(
        _link_entry_ok(k, v) for k, v in r.items()))


def _link_entry_ok(link, moved):
    """A link fleet makes, mapped to the backup or the old agents module's
    sidecar beside it: restoring moves `moved` onto `link`, so anything else
    would move arbitrary files around."""
    if not isinstance(moved, str):
        return False
    link, moved = pathlib.Path(link), pathlib.Path(moved)
    if not (link in AGENTS_LINKS or link.parent == SKILL_LINK_DIR):
        return False
    if moved == _old_backup(link):
        return True
    # Only where _link backs up this very link: a run's folder, then
    # displaced/<the link's path>, with a collision suffix at most.
    if not (moved.is_absolute() and moved.is_relative_to(BACKUP_DIR) and link.is_relative_to(HOME)):
        return False
    parts, rel = moved.relative_to(BACKUP_DIR).parts, link.relative_to(HOME).parts
    return (len(parts) == len(rel) + 2
            and re.fullmatch(r"\d{8}-\d{6}(-\d+)?", parts[0]) is not None
            and parts[1] == "displaced" and parts[2:-1] == rel[:-1]
            and re.fullmatch(re.escape(rel[-1]) + r"(\.\d+)?", parts[-1]) is not None)


def _save_json(path, value):
    path.parent.mkdir(parents=True, exist_ok=True)
    # Owner-only: an applied record can hold an account's secrets.
    fd, temporary = tempfile.mkstemp(prefix=f".{path.name}.", dir=path.parent)
    try:
        with os.fdopen(fd, "w") as handle:
            handle.write(json.dumps(value, indent=1, sort_keys=True) + "\n")
        os.replace(temporary, path)
    finally:
        pathlib.Path(temporary).unlink(missing_ok=True)


def add_notice(text):
    """Something a run without a terminal did that the user should see."""
    if sys.stdin.isatty():
        return
    notices = _load_json(NOTICES, [])
    if text not in notices:
        # A notice that cannot be kept is still on stderr; the run goes on.
        try:
            _save_json(NOTICES, notices + [text])
        except OSError:
            pass


def _report(text):
    eprint(f"fleet: {text}")
    add_notice(text)


def _inside_agents(path):
    """Whether `path` leads into ~/.agents, through a linked parent too."""
    return pathlib.Path(os.path.realpath(path)).is_relative_to(os.path.realpath(AGENTS_DIR))


def _skill_folders(directory):
    """The real, non-dot folders holding a SKILL.md in a harness skill folder.
    A linked harness folder is skipped: it may lead into ~/.agents/skills,
    whose folders would then be moved out from under it."""
    if directory.is_symlink() or _inside_agents(directory):
        return []
    # Only a missing folder holds no skills; an unreadable one fails
    # onboarding, which would otherwise record the account without them.
    try:
        entries = sorted(directory.iterdir())
    except (FileNotFoundError, NotADirectoryError):
        return []
    except OSError as exc:
        _unreadable(exc)
    # The old agents module's .pre-agents.bak sidecars go back by name when
    # the links are refreshed; they are not skills of their own.
    return [e for e in entries if not e.name.startswith(".") and not e.is_symlink()
            and not e.name.endswith(".pre-agents.bak")
            and _is(e, stat.S_ISDIR) and _is(e/"SKILL.md", stat.S_ISREG)
            # A linked SKILL.md is not uploaded; the folder would go without it.
            and not (e/"SKILL.md").is_symlink()]


def _is(path, kind):
    """Path.is_dir and is_file can hide an unreadable folder as "not one",
    which would leave its skill behind; only a missing path is not one."""
    try:
        return kind(path.stat().st_mode)
    except (FileNotFoundError, NotADirectoryError):
        return False
    except OSError as exc:
        _unreadable(exc)


def _same_tree(a, b):
    # os.walk, not rglob: rglob skips a folder it cannot read, and the trees
    # would match without it.
    # A link counts by where it points, so a tree with an extra one differs.
    def tree(root):
        files = {}
        for top, dirs, names in os.walk(root, onerror=_unreadable):
            for name in names + dirs:
                p = pathlib.Path(top)/name
                rel = p.relative_to(root).as_posix()
                if p.is_symlink():
                    files[rel] = ("link", os.readlink(p))
                elif name in names:
                    files[rel] = p.read_bytes() if p.is_file() else ("special",)
        return files
    try:
        return tree(a) == tree(b)
    except OSError as exc:
        _unreadable(exc)


def _has_links(folder):
    for root, dirs, names in os.walk(folder):
        if any(os.path.islink(os.path.join(root, n)) for n in dirs + names):
            return True
    return False


def _move_harness_skills(backup):
    """Move the user's own skill folders out of the harness folders, so
    harnesses don't load them next to ~/.agents/skills; list them. A failed
    move puts the ones already moved back. Returns (folder, saved) pairs, for
    a caller that has to undo the move later."""
    moved = []
    try:
        for directory in HARNESS_SKILL_DIRS:
            for folder in _skill_folders(directory):
                moved.append((folder, backup.move(folder, f"harness-skills/{directory.relative_to(HOME)}/{folder.name}")))
    except BaseException:
        _put_harness_back(moved)
        raise
    if moved:
        _report(f"moved skill folders to {backup.root}: " + ", ".join(str(f) for f, _ in moved))
    return moved


def _put_harness_back(moved):
    for folder, saved in reversed(moved):
        if not os.path.lexists(folder):
            shutil.move(str(saved), str(folder))


def _apply_changes(take, remove, contents, server, backup, then=None, scanned=None):
    """Replaced and deleted local copies, symlinks included, go to the backup.
    If a write fails, or `then` (run once all are written) does, the files
    already written go and the moved ones come back, so ~/.agents stays as it
    was. Returns the paths whose local copy changed since `scanned` was read
    (an edit saved during the sync, which the merge never saw) and those
    deleted since, which have no copy in the backup."""
    moved, written, changed, deleted = [], [], [], []
    try:
        for rel in sorted(remove) + sorted(take):
            target = _safe_target(rel)
            if target.is_symlink() or target.exists():
                saved = backup.move(target, f"agents/{rel}")
                moved.append((target, saved))
                # A symlink or folder put in its place since the scan is a
                # change too; the scan holds regular files only.
                now = _digest(saved) if saved.is_file() and not saved.is_symlink() else None
                if scanned is not None and now != scanned.get(rel):
                    changed.append(rel)
            elif scanned is not None and rel in scanned and rel in take:
                # So is one deleted since: the account's copy would undo that.
                deleted.append(rel)
        for rel in remove:
            _remove_file(rel)
        for rel in sorted(take):
            _write_file(rel, contents[rel], server[rel][1])
            written.append(rel)
        if then:
            then()
    except BaseException:
        for rel in written:
            _remove_file(rel)
        for target, saved in reversed(moved):
            if not os.path.lexists(target):
                target.parent.mkdir(parents=True, exist_ok=True)
                shutil.move(str(saved), str(target))
        raise
    return changed, deleted


def _move_foreign(backup):
    moved = backup.move(AGENTS_DIR, "agents-other-account")
    _report(f"moved another account's ~/.agents to {backup.root}")
    return moved


def _put_foreign_back(moved, backup):
    if moved:
        if AGENTS_DIR.exists() or AGENTS_DIR.is_symlink():
            backup.move(AGENTS_DIR, "agents-incomplete")
        shutil.move(str(moved), str(AGENTS_DIR))
        _report("put the other account's ~/.agents back, since this account's copy "
                "could not be put in place")


def pull(account, settle_old=False):
    """Bring ~/.agents/ in step with the account. Returns ('synced', record,
    conflicts) or ('pending', None, []) when the account was never pushed.
    settle_old: the old agents module's payload here is not the account's, and
    goes once the account's copy is in hand."""
    for _ in range(3):
        counter, version, server, installs, _ = _listing()
        if _context() != account:
            raise ConfigError("the session changed during the sync")
        state = _load_sync_record()
        record = state if state.get("account") == account else None
        backup = Backup()
        # Another account's files: they are not this account's to push. They
        # move aside only once this account's copy is in hand, so a failed
        # fetch leaves the old copy, and its links, working.
        other = bool(state) and record is None
        foreign = other and AGENTS_DIR.exists()
        old = settle_old and os.path.lexists(OLD_AGENTS_CLONE)
        # The old payload is not this account's either, and goes; with it in
        # the way the merge would read the account's files as already here.
        local = {} if foreign or old else scan_local()[0]
        # Installed skills come from their authors' copies, fetched before
        # anything here moves. The old payload's skills folder goes with it.
        writes, drops = _install_plan(installs, fresh=foreign or old)
        try:
            fetched = {name: _fetch_skill(installs[name]) for name in writes}
        except Changed:
            continue
        if _context() != account:
            raise ConfigError("the session changed during the sync")
        if record is None and counter == 0:
            # Before anything moves: the old payload cannot come back once
            # its clone is gone, so a failure here must leave it in place.
            created = not ONBOARDING_MARKER.exists()
            ONBOARDING_MARKER.parent.mkdir(parents=True, exist_ok=True)
            ONBOARDING_MARKER.touch()
            try:
                moved = _settle_pending(old, foreign, backup, install=lambda: _apply_installs(
                    installs, writes, drops, fetched, backup))
                try:
                    # Even with no tree to move, the other account's links go.
                    # With installs, every pass links them: one whose links
                    # failed after the installs were written has nothing left
                    # to write.
                    if other or installs or drops:
                        refresh_links()
                    # Its record goes last: until then a failure puts its
                    # tree and links back, and a retry finishes the job.
                    CONFIG_STATE.unlink(missing_ok=True)
                except BaseException as exc:
                    if other:
                        _put_foreign_back(moved, backup)
                        try:
                            refresh_links()
                        except Exception as again:
                            # Its links stay down until a sync gets through.
                            raise ConfigError(f"{exc}; the other account's links could not be put back "
                                              f"either ({again}), so run fleet sync once that is fixed") from exc
                    raise
            except BaseException:
                # Not pending after all: the record here still stands.
                if created:
                    with contextlib.suppress(OSError):
                        ONBOARDING_MARKER.unlink()
                raise
            return "pending", None, []
        conflicts = []
        if record is None or old:
            # Joining an account that was pushed, or taking it back over the
            # old payload: take its copy wholesale.
            take = [p for p in server if local.get(p) != server[p]]
            remove = [p for p in local if p not in server]
        else:
            base = record.get("files") or {}
            take, remove = [], []
            for rel in set(server) | set(local) | set(base):
                s, l, b = server.get(rel), local.get(rel), base.get(rel)
                if s == b or s == l:
                    continue
                if l != b:
                    conflicts.append(rel)
                (remove if s is None else take).append(rel)
        try:
            contents = fetch_contents(take, counter, server)
        except Changed:
            continue
        # A sign-in during the fetch: these files are the old account's.
        if _context() != account:
            raise ConfigError("the session changed during the sync")
        # The old payload moves aside, and its clone and links go only once
        # the account's copy is written, so a failed write leaves it working.
        displaced = _displace_old_payload(backup) if old else []
        try:
            moved = _move_foreign(backup) if foreign else None
        except BaseException:
            _restore_displaced(displaced, backup)
            raise
        harness = []
        new_record = {"account": account, "counter": counter, "version": version, "files": server}
        def finish():
            # Inside the account files' transaction: a failed install puts
            # them back too. installed.json follows each install on its own.
            _apply_installs(installs, writes, [], fetched, backup)
            if record is None:
                harness.extend(_move_harness_skills(backup))
            # The changes are done only once their record is saved.
            _save_json(CONFIG_STATE, new_record)
        try:
            # Uninstalled skills go first: the account's files may hold one
            # of the same name, which the drop would otherwise clear.
            _apply_installs(installs, [], drops, fetched, backup)
            # Unscanned, nothing here is a change of this account's to keep.
            changed, deleted = _apply_changes(take, remove, contents, server, backup, then=finish,
                                              scanned=None if foreign or old else local)
        except BaseException:
            _put_harness_back(harness)
            # The other account's copy, which its record and links still
            # name, comes back until this account's is fully in place.
            _put_foreign_back(moved, backup)
            _restore_displaced(displaced, backup)
            raise
        conflicts += changed
        if old:
            if displaced:
                _report_displaced(backup)
            # The account's copy is in place: a clone that cannot all go
            # still leaves its links made, and the next sync drops the rest.
            try:
                _drop_old_clone(operator=False, backup=backup)
            except BaseException:
                refresh_links()
                raise
        if conflicts:
            _report(f"changed here and in the account, kept the account's copy (yours are in "
                    f"{backup.root}): " + ", ".join(sorted(set(conflicts))))
        if deleted:
            _report("deleted here during the sync, so the account's copy came back: " + ", ".join(deleted))
        ONBOARDING_MARKER.unlink(missing_ok=True)
        return "synced", new_record, sorted(set(conflicts + deleted))
    raise ConfigError("the account kept changing during the sync; try again")


def _check_json_objects(payloads):
    for rel, data in payloads.items():
        if rel == "mcp.json" or (rel.startswith("settings/") and rel.endswith(".json")):
            try:
                value = json.loads(data)
            except ValueError:
                value = None
            if not isinstance(value, dict):
                raise ConfigError(f"{rel} is not a JSON object; fix it before uploading")
            problem = check_tier_shape(rel, value)
            if problem:
                raise ConfigError(f"{rel}: {problem}; fix it before uploading")


def _read_regular(rel):
    """A file's bytes, refusing one turned into a link (or a FIFO, which
    would block) since it was scanned: its target is not fleet's to send."""
    try:
        fd = os.open(AGENTS_DIR/rel, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
    except OSError as exc:
        if exc.errno == errno.ELOOP:
            raise ConfigError(f"{rel} became a link while syncing; nothing pushed, run fleet sync again")
        raise
    with os.fdopen(fd, "rb") as f:
        if not stat.S_ISREG(os.fstat(f.fileno()).st_mode):
            raise ConfigError(f"{rel} is no longer a regular file; nothing pushed, run fleet sync again")
        return f.read()


def push(record, local, puts, deletes):
    """Upload the given local changes against `record`; the new record."""
    # Each file is read once, so what is checked, sent, and recorded as sent
    # is the same version even while an editor saves over it.
    payloads = {rel: _read_regular(rel) for rel in sorted(puts)}
    _check_json_objects(payloads)
    # Installed skills count too: an owned skills/Foo next to an installed
    # skills/foo uploads, and every later listing then refuses the pair.
    installed = {f"skills/{name}" for name in _load_json(INSTALLED, {})}
    clashes = _collisions(set(record.get("files") or {}) - set(deletes) | set(puts) | installed)
    if clashes:
        raise ConfigError("not pushing paths a case-insensitive disk would merge into one file; "
                          "rename one of each: " + "; ".join(clashes))
    # Two accounts can share a counter, so the push is pinned to the account
    # this machine pulled, not one signed in to since: the auth CLI refuses a
    # login from another origin, and Auth refuses another subject.
    origin, subject = record["account"].split(" ", 1)
    body = {"base": record["counter"], "subject": subject,
            "put": [{"path": rel, "content": base64.b64encode(data).decode(),
                     "executable": local[rel][1]} for rel, data in payloads.items()],
            "delete": sorted(deletes)}
    try:
        value = _request("POST", "/api/fleet/config/push", body, origin=origin)
    except HttpError as exc:
        if exc.status == 409 and str(exc) == "account changed":
            raise ConfigError("the session changed during the sync") from None
        raise
    files = dict(record.get("files") or {})
    for rel, data in payloads.items():
        files[rel] = [hashlib.sha256(data).hexdigest(), local[rel][1]]
    for rel in deletes:
        files.pop(rel, None)
    return {**record, "counter": value["counter"], "version": value["version"], "files": files}


def upload(account, record):
    """Push the local changes; on a stale base pull again and retry."""
    for _ in range(3):
        local, symlinks = scan_local()
        base = record.get("files") or {}
        puts = [p for p in local if local[p] != base.get(p)]
        # A path replaced by a symlink (or under one) is skipped, not deleted.
        deletes = [p for p in base if p not in local
                   and not any(p == s or p.startswith(s + "/") for s in symlinks)]
        if symlinks:
            eprint("fleet: symlinks are not uploaded: " + ", ".join(symlinks))
        if not puts and not deletes:
            return record, 0
        # Keep the server copies this upload overwrites or deletes.
        try:
            replaced = fetch_contents([p for p in puts + deletes if p in base], record["counter"], base)
        except Changed:
            replaced = None
        if replaced is not None:
            backup = Backup()
            for rel, data in replaced.items():
                backup.save(data, f"account/{rel}")
            # A file deleted at the scan but saved again since goes up, not
            # out: scanned again.
            if any(os.path.lexists(AGENTS_DIR/rel) for rel in deletes):
                continue
            try:
                new = push(record, local, puts, deletes)
            except HttpError as exc:
                if exc.status == 429:
                    wait = int(exc.retry_after or 0)
                    raise ConfigError("this account pushed too often; uploads resume in "
                                      f"{max(1, (wait + 59) // 60)} min") from None
                if exc.status != 409:
                    raise ConfigError(f"upload refused: {exc}") from None
            else:
                _save_json(CONFIG_STATE, new)
                print(f"fleet: uploaded {len(puts)} changed, {len(deletes)} deleted")
                return new, len(puts) + len(deletes)
        outcome, record, conflicts = pull(account)
        refresh_links()
        if conflicts:
            raise ConfigError("not uploading over files changed in the account; see above")
    raise ConfigError("the account kept changing during the upload; try again")


# --- links ---------------------------------------------------------------

def _old_backup(target):
    """Where the old agents module set aside what its link replaced."""
    return target.with_name(target.name + ".pre-agents.bak")


def _restore_old_backup(target):
    """Put back what the old agents module set aside for a link fleet drops."""
    old = _old_backup(target)
    if os.path.lexists(old) and not os.path.lexists(target):
        shutil.move(old, target)


def _link(target, source, links, backup):
    """Point `target` at `source`; anything it displaces goes to the backup.
    A sidecar the old agents module left is taken over, so unlinking later
    puts it back."""
    if str(target) not in links and os.path.lexists(_old_backup(target)):
        links[str(target)] = str(_old_backup(target))
    if target.is_symlink() and os.readlink(target) == str(source):
        return
    if target.is_symlink() or target.exists():
        moved = backup.move(target, f"displaced/{target.relative_to(HOME)}")
        links[str(target)] = str(moved)
    target.parent.mkdir(parents=True, exist_ok=True)
    target.symlink_to(source)


def _unlink_restoring(target, links):
    """Drop a link into ~/.agents and put back the file it displaced, also
    when the link itself is already gone."""
    if _points_into(target, AGENTS_DIR):
        target.unlink()
    elif os.path.lexists(target):
        return
    # The mapping goes only once the file is back, so a failed move leaves
    # the next run to find it.
    moved = links.get(str(target))
    if moved and os.path.lexists(moved):
        target.parent.mkdir(parents=True, exist_ok=True)
        shutil.move(moved, target)
        del links[str(target)]
    else:
        links.pop(str(target), None)
        _restore_old_backup(target)


def _skill_link_targets(links):
    """Entries in claude's skill folder plus recorded ones since removed. A
    sidecar the old agents module left stands for its link, deleted or not."""
    found = set(SKILL_LINK_DIR.iterdir()) if SKILL_LINK_DIR.is_dir() else set()
    found = {e.with_name(e.name[:-len(".pre-agents.bak")]) if e.name.endswith(".pre-agents.bak") else e
             for e in found}
    found |= {pathlib.Path(k) for k in links if pathlib.Path(k).parent == SKILL_LINK_DIR}
    return sorted(found)


def _points_into(path, root):
    try:
        # Resolved as the link would be, .. and all, but not followed further.
        return path.is_symlink() and pathlib.Path(
            os.path.normpath(os.path.join(path.parent, os.readlink(path)))).is_relative_to(root)
    except OSError:
        return False


_lock_depth = 0


@contextlib.contextmanager
def _config_locked():
    """One run at a time on ~/.agents, the links and their records: the
    nightly run and a manual sync would each save over what the other did."""
    global _lock_depth
    if _lock_depth == 0:
        CONFIG_LOCK.parent.mkdir(parents=True, exist_ok=True)
        fd = os.open(CONFIG_LOCK, os.O_RDWR | os.O_CREAT, 0o600)
        fcntl.flock(fd, fcntl.LOCK_EX)
    _lock_depth += 1
    try:
        yield
    finally:
        _lock_depth -= 1
        if _lock_depth == 0:
            os.close(fd)


@_config_locked()
def refresh_links():
    """AGENTS.md where each harness reads it, and each skill in claude's
    folder, adding new skills and pruning removed ones."""
    links = _load_links()
    before = dict(links)
    backup = Backup()
    # Saved however far this gets: a retry finds what it already displaced
    # linked and would not record it again.
    try:
        agents_md = AGENTS_DIR/"AGENTS.md"
        if agents_md.is_file():
            for target in AGENTS_LINKS:
                if target != HOME/"AGENTS.md" and not target.parent.is_dir():
                    continue
                # A harness folder that is ~/.agents, or a folder in it, by
                # another name would have a synced file replaced by a link.
                if _inside_agents(target.parent):
                    eprint(f"fleet: {target.parent} is inside {AGENTS_DIR}; not linking AGENTS.md into it")
                    continue
                _link(target, agents_md, links, backup)
        else:
            for target in AGENTS_LINKS:
                _unlink_restoring(target, links)
        skills = AGENTS_DIR/"skills"
        names = {e.name for e in _skill_entries(skills)}
        if SKILL_LINK_DIR.is_symlink():
            # Linking through it would move what it leads to, ~/.agents/skills
            # included, into the backup.
            eprint(f"fleet: {SKILL_LINK_DIR} is a link; not linking skills into it")
        elif _inside_agents(SKILL_LINK_DIR):
            eprint(f"fleet: {SKILL_LINK_DIR} is inside {AGENTS_DIR}; not linking skills into it")
        elif SKILL_LINK_DIR.parent.is_dir():
            for name in sorted(names):
                _link(SKILL_LINK_DIR/name, skills/name, links, backup)
            for entry in _skill_link_targets(links):
                if entry.name not in names:
                    _unlink_restoring(entry, links)
        _drop_old_links()
    finally:
        try:
            _save_json(LINKS_STATE, links)
        except OSError:
            # Unrecorded, what this run displaced could never come back: put
            # it back now.
            for target, moved in links.items():
                target = pathlib.Path(target)
                if before.get(str(target)) != moved and backup.root and pathlib.Path(moved).is_relative_to(backup.root) \
                        and _points_into(target, AGENTS_DIR) and os.path.lexists(moved):
                    target.unlink()
                    shutil.move(moved, target)
            raise
    if backup.root:
        _report(f"moved files the links replaced to {backup.root}")


def _drop_old_links():
    """The old agents module's links go, and what they replaced comes back,
    also when the link was already deleted: fleet is the only one left to
    return it."""
    skills = AGENTS_DIR/"skills"
    for target in OLD_AGENTS_LINKS:
        if _points_into(target, AGENTS_DIR):
            target.unlink()
        _restore_old_backup(target)
    for directory in OLD_SKILL_LINK_DIRS:
        # A folder that is itself a link is shared with something else: its
        # entries aren't this harness's to remove.
        if directory.is_dir() and not directory.is_symlink():
            for entry in list(directory.iterdir()):
                if _points_into(entry, skills):
                    entry.unlink()
                    _restore_old_backup(entry)
                elif entry.name.endswith(".pre-agents.bak"):
                    _restore_old_backup(entry.with_name(entry.name[:-len(".pre-agents.bak")]))


def _skill_entries(skills):
    try:
        return [e for e in sorted(skills.iterdir()) if e.is_dir() and not e.name.startswith(".")]
    except OSError:
        return []


@_config_locked()
def remove_links():
    """Undo refresh_links: drop the links into ~/.agents and put back what
    they displaced."""
    links = _load_links()
    # A linked claude skill folder leads to someone else's: what is in it
    # is not fleet's to drop or fill.
    skills_linked = SKILL_LINK_DIR.is_symlink()
    for path in list(AGENTS_LINKS) + ([] if skills_linked else _skill_link_targets(links)):
        _unlink_restoring(path, links)
    # Also the old agents module's, which a sync may not have taken over yet.
    _drop_old_links()
    # A target the user has since filled keeps its mapping, so the file it
    # replaced is not left stranded in a backup.
    stuck = {t: moved for t, moved in links.items() if os.path.lexists(moved)}
    if stuck:
        _save_json(LINKS_STATE, stuck)
        if skills_linked and any(pathlib.Path(t).parent == SKILL_LINK_DIR for t in stuck):
            raise ConfigError(f"{SKILL_LINK_DIR} is a link, so the skills fleet moved out of it stay "
                              "in the backup; make it a folder again and run the uninstall again")
        target = sorted(stuck)[0]
        raise ConfigError(f"{target} is no longer fleet's link, so the file it replaced stays at "
                          f"{stuck[target]}; move one of them aside and run the uninstall again")
    LINKS_STATE.unlink(missing_ok=True)


def settle_old_agents(operator):
    """Remove the old agents module's clone, once. On a machine of another
    account its links go too and what they displaced comes back; the
    operator's AGENTS.md and skills it copied move to the backup, since other
    tools may have added skills there."""
    if not os.path.lexists(OLD_AGENTS_CLONE):
        return
    if operator:
        _drop_old_clone(operator)
        return
    # A clone that cannot be dropped puts the payload back, so a retry
    # still finds it where the next attempt expects.
    backup = Backup()
    displaced = _displace_old_payload(backup)
    try:
        _drop_old_clone(operator, backup)
    except BaseException:
        _restore_displaced(displaced, backup)
        raise
    if displaced:
        _report_displaced(backup)


def _settle_pending(old, foreign, backup, install):
    """For an account never pushed: the old payload and another account's
    tree both move aside and the account's installed skills go in, or none
    of it happens. Returns where the other tree went."""
    displaced = _displace_old_payload(backup) if old else []
    moved = None
    try:
        if foreign:
            moved = _move_foreign(backup)
        install()
        # A clone that cannot be dropped puts the payload back too, so a
        # retry still finds it where the next attempt expects.
        if old:
            _drop_old_clone(operator=False, backup=backup)
    except BaseException:
        _put_foreign_back(moved, backup)
        _restore_displaced(displaced, backup)
        raise
    if displaced:
        _report_displaced(backup)
    return moved


def _displace_old_payload(backup):
    """Move the operator's AGENTS.md and skills the old module left to the
    backup; the (path, saved) pairs, so a failed sync can put them back."""
    moved = []
    try:
        for path in (AGENTS_DIR/"AGENTS.md", AGENTS_DIR/"skills"):
            if os.path.lexists(path):
                moved.append((path, backup.move(path, f"displaced/{path.relative_to(HOME)}")))
    except BaseException:
        _restore_displaced(moved, backup)
        raise
    return moved


def _restore_displaced(displaced, backup):
    """Put the old payload back after a failed sync, moving aside what the
    sync left in its place (installed skills are not taken back)."""
    for path, saved in reversed(displaced):
        if os.path.lexists(path):
            backup.move(path, f"incomplete/{path.relative_to(HOME)}")
        shutil.move(str(saved), str(path))


def _report_displaced(backup):
    _report(f"moved the operator's AGENTS.md and skills the old agents module left to {backup.root}")


def _drop_old_clone(operator, backup=None):
    if operator:
        if OLD_AGENTS_CLONE.is_dir() and not OLD_AGENTS_CLONE.is_symlink():
            shutil.rmtree(OLD_AGENTS_CLONE)
        else:
            OLD_AGENTS_CLONE.unlink()
        return
    # The clone goes first, by a rename that cannot stop halfway, and comes
    # back if the links cannot go: a clone still here is what a retry finds.
    saved = backup.move(OLD_AGENTS_CLONE, "agents-src")
    undone = []

    def drop(link):
        undone.append((link, os.readlink(link)))
        link.unlink()

    try:
        for target in AGENTS_LINKS + OLD_AGENTS_LINKS:
            if _points_into(target, AGENTS_DIR):
                drop(target)
            _restore_old_backup(target)
        for directory in [SKILL_LINK_DIR, *OLD_SKILL_LINK_DIRS]:
            for entry in (list(directory.iterdir()) if directory.is_dir() else []):
                if _points_into(entry, AGENTS_DIR):
                    drop(entry)
                    _restore_old_backup(entry)
                elif entry.name.endswith(".pre-agents.bak"):
                    # Its link already deleted: the sidecar still comes back.
                    _restore_old_backup(entry.with_name(entry.name[:-len(".pre-agents.bak")]))
    except BaseException:
        # The links already gone come back too, with what they displaced
        # set aside again, so the old payload stays in use.
        for link, source in reversed(undone):
            try:
                if os.path.lexists(link) and not os.path.lexists(_old_backup(link)):
                    os.rename(link, _old_backup(link))
                if not os.path.lexists(link):
                    os.symlink(source, link)
            except OSError:
                pass
        shutil.move(str(saved), str(OLD_AGENTS_CLONE))
        raise


def not_the_operators():
    """Whether this machine, with no session, is known not to be the
    operator's: GitHub answered and lists none of its keys. Asked once."""
    if "value" not in OWNER_CHECK:
        try:
            OWNER_CHECK["value"] = not set(_local_keys()) & set(fetch_owner_keys())
        except Unavailable:
            OWNER_CHECK["value"] = False
    return OWNER_CHECK["value"]


# --- onboarding ----------------------------------------------------------

def onboard(account):
    """Push this machine's agent config as the account's starting copy,
    gathering AGENTS.md and skills from the harness folders first."""
    backup = Backup()
    listed = []
    agents_md = AGENTS_DIR/"AGENTS.md"
    sources = []
    for path in HARNESS_INSTRUCTIONS:
        try:
            if path.is_file() and not _points_into(path, AGENTS_DIR):
                sources.append((path, path.read_bytes()))
        except (FileNotFoundError, NotADirectoryError):
            pass
        except OSError as exc:
            _unreadable(exc)
    # What this run copies into ~/.agents comes out again if staging or the
    # upload fails, so a retry gathers the harness files afresh.
    staged, relinked = [], []
    try:
        if not agents_md.exists() and sources:
            agents_md.parent.mkdir(parents=True, exist_ok=True)
            # The copy keeps the source's permissions: an owner-only CLAUDE.md
            # stays owner-only.
            source, data = sources[0]
            fd = os.open(agents_md, os.O_WRONLY | os.O_CREAT | os.O_EXCL,
                         stat.S_IMODE(source.stat().st_mode) & 0o666)
            staged.append(agents_md)
            with os.fdopen(fd, "wb") as handle:
                handle.write(data)
        if agents_md.is_file():
            listed += [str(path) for path, data in sources if data != agents_md.read_bytes()]
        skills = AGENTS_DIR/"skills"
        for directory in HARNESS_SKILL_DIRS:
            for folder in _skill_folders(directory):
                mine = skills/folder.name
                # lexists: a dangling link there is the user's, not staged.
                if mine.is_symlink() and not _has_links(folder) and pathlib.Path(
                        os.path.realpath(mine)).is_relative_to(os.path.realpath(folder)):
                    # A link to the folder about to move would dangle: it
                    # becomes a copy, and a link again if the upload fails.
                    relinked.append((mine, os.readlink(mine)))
                    mine.unlink()
                    shutil.copytree(folder, mine, symlinks=True)
                elif os.path.lexists(mine):
                    if not _same_tree(folder, mine):
                        listed.append(str(folder))
                elif _has_links(folder):
                    # A link is not uploaded, and a relative one would lead
                    # elsewhere once the folder moves: the whole folder stays
                    # out, kept in the backup the harness folders go to.
                    listed.append(str(folder))
                else:
                    # Listed first: a copy that fails partway comes out too.
                    staged.append(mine)
                    shutil.copytree(folder, mine, symlinks=True)
        if listed:
            _report("these differ from what was uploaded and were left out: " + ", ".join(listed))
        local, symlinks = scan_local()
        if symlinks:
            eprint("fleet: symlinks are not uploaded: " + ", ".join(symlinks))
        record = {"account": account, "counter": 0, "version": 0, "files": {}}
        record = push(record, local, list(local), [])
    except BaseException as exc:
        for path in staged:
            if path.is_dir() and not path.is_symlink():
                shutil.rmtree(path)
            else:
                path.unlink(missing_ok=True)
        for path, target in reversed(relinked):
            if path.is_dir() and not path.is_symlink():
                shutil.rmtree(path)
            path.unlink(missing_ok=True)
            os.symlink(target, path)
        if isinstance(exc, HttpError):
            if exc.status == 409:
                raise ConfigError("another machine set up this account first; run: fleet sync") from None
            raise ConfigError(f"upload refused: {exc}") from None
        raise
    print(f"fleet: uploaded this machine's agent config ({len(local)} files) as the account's copy")
    # Only now: a refused upload leaves the harness skill folders in use. And
    # before the record: a failed move leaves the next sync to join the
    # account, which moves them again. So does a record that cannot be saved,
    # once the folders are back where claude reads them.
    moved = _move_harness_skills(backup)
    try:
        _save_json(CONFIG_STATE, record)
    except BaseException:
        _put_harness_back(moved)
        raise
    ONBOARDING_MARKER.unlink(missing_ok=True)
    refresh_links()


def _offer_onboarding(account):
    if os.environ.get("BATCH") == "1" or not (sys.stdin.isatty() and sys.stdout.isatty()):
        print("fleet: this account has no agent config yet; to upload this machine's, run: fleet onboard")
        return 0
    answer = input("fleet: this account has no agent config yet. Upload this machine's ~/.agents, "
                   "AGENTS.md, and skills as its starting copy? [y/N] ")
    if answer.strip().lower() not in ("y", "yes"):
        print("fleet: not now; run fleet onboard when ready")
        return 0
    onboard(account)
    return 0


@_config_locked()
def config_sync(direct):
    """Pull, and on a direct run upload. 0 done, 1 conflicts or a refused
    upload, 3 no answer from Auth."""
    if not config_sync_enabled():
        return 0
    if AGENTS_DIR.is_symlink():
        eprint(f"fleet: account config: refusing a symlinked {AGENTS_DIR}")
        return 1
    # Anything else in its place would scan as empty: every file deleted.
    if os.path.lexists(AGENTS_DIR) and not AGENTS_DIR.is_dir():
        eprint(f"fleet: account config: {AGENTS_DIR} is not a folder")
        return 1
    state, account = _session()
    try:
        if account is None:
            if state == "out" and os.path.lexists(OLD_AGENTS_CLONE) and not_the_operators():
                settle_old_agents(operator=False)
            return 3
        operator = account.split(" ", 1)[1] == OPERATOR_SUBJECT
        if operator:
            settle_old_agents(operator=True)
    except (Rejected, Unreachable) as exc:
        eprint(f"fleet: account config: {exc}")
        return 3
    except ConfigError as exc:
        eprint(f"fleet: account config: {exc}")
        return 1
    except OSError as exc:
        eprint(f"fleet: account config: settling the old agents module: {exc}")
        return 1
    try:
        # Another account's machine keeps the old payload in use until the
        # account's copy is fetched.
        outcome, record, conflicts = pull(account, settle_old=not operator)
        PULL["outcome"] = outcome
        if outcome == "pending":
            return _offer_onboarding(account)
        refresh_links()
        if direct:
            record, _ = upload(account, record)
    except (Rejected, Unreachable) as exc:
        eprint(f"fleet: account config: {exc}")
        return 3
    except (ConfigError, OSError) as exc:
        eprint(f"fleet: account config: {exc}")
        return 1
    return 1 if conflicts else 0


def config_outdated():
    """Whether a pull would change something (for setup's status); None when
    Auth gave no answer to tell by."""
    if not config_sync_enabled():
        return False
    # A pull refuses these, so it is not current; setup's update says why.
    if AGENTS_DIR.is_symlink() or (os.path.lexists(AGENTS_DIR) and not AGENTS_DIR.is_dir()):
        return True
    account = _context()
    if account is None:
        return None
    try:
        counter, version, _, installs, _ = _listing()
    except (ConfigError, Unavailable) as exc:
        eprint(f"fleet: account config: {exc}")
        return None
    # A damaged record is outdated: the sync that follows reports it.
    try:
        record = _load_sync_record()
    except ConfigError:
        return True
    if record.get("account") != account:
        # Another account's config here is outdated even when this account
        # has none: the pull moves it aside.
        # So is an install the account has since dropped.
        return counter > 0 or bool(record) or bool(installs) or any(_install_plan(installs))
    return record.get("version") != version or any(_install_plan(installs))


def config_status():
    if not config_sync_enabled():
        print("fleet: account config waits until setup swaps out the old agents and harnesses modules")
        return
    account = _context()
    if account is None:
        return
    try:
        counter, version, server, installs, _ = _listing()
        record = _load_sync_record()
        local, symlinks = scan_local()
    except (ConfigError, OSError) as exc:
        print(f"fleet: account config: {exc}")
        return
    if record.get("account") != account:
        print("fleet: account config not set up yet; run: fleet onboard" if counter == 0
              else "fleet: account config not pulled yet; run: fleet sync")
    else:
        base = record.get("files") or {}
        changed = sorted(p for p in set(local) | set(base) if local.get(p) != base.get(p)
                         and not any(p == s or p.startswith(s + "/") for s in symlinks))
        edited = _edited_installs()
        writes, drops = _install_plan(installs)
        current = record.get("version") == version and not drops and set(writes) <= set(edited)
        print("fleet: account config " + ("current" if current else "changed in the account; run: fleet sync"))
        if edited:
            print("fleet: installed skills changed here, which the next sync puts back: " + ", ".join(edited))
        if changed:
            print(f"fleet: {len(changed)} local changes wait for a direct fleet sync: "
                  + ", ".join(changed[:10]) + (" ..." if len(changed) > 10 else ""))
    if symlinks:
        print("fleet: symlinks are not uploaded: " + ", ".join(symlinks))
    for notice in _load_json(NOTICES, []):
        print(f"fleet: since the last status: {notice}")
    NOTICES.unlink(missing_ok=True)


