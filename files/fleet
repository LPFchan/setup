def cmd_skills(args):
    if WINDOWS:
        eprint("fleet: skills are not synced on Windows")
        return 2
    action, rest = (args[0], args[1:]) if args else ("list", [])
    try:
        if action == "list" and not rest:
            listing = _api("GET", "/api/fleet/skills")["skills"]
            installed = {k: v["name"] for k, v in _load_json_quiet(AGENTS_STATE).get("installs", {}).items()}
            for skill in listing:
                mark = "own" if skill.get("own") else (f"installed as {installed[skill['id']]}" if skill["id"] in installed else "")
                print(f"{skill['author']}/{skill['folder']:<24} {skill.get('installs', 0):>4}  {mark}")
                if skill.get("description"):
                    print(f"    {skill['description']}")
            return 0
        subject = _subject()
        if action == "install" and len(rest) in (1, 3) and (len(rest) == 1 or rest[1] == "--as"):
            body = {"skill": rest[0], "subject": subject, **({"as": rest[2]} if len(rest) == 3 else {})}
            print(f"fleet: installed {_api('POST', '/api/fleet/skills/install', body).get('name', rest[0])}")
        elif action == "uninstall" and len(rest) == 1:
            _api("POST", "/api/fleet/skills/uninstall", {"skill": rest[0], "subject": subject})
        elif action == "publish" and len(rest) == 1:
            with _fleet_lock():
                sync_agents(push=True)  # Auth publishes what it holds
            answer = _api("POST", "/api/fleet/skills/publish", {"folder": rest[0], "subject": subject})
            print(f"fleet: published {rest[0]} ({answer['id']})")
            return 0
        elif action == "unpublish" and len(rest) == 1:
            _api("POST", "/api/fleet/skills/unpublish", {"skill": rest[0], "subject": subject})
            return 0
        else:
            eprint(SKILLS_USAGE)
            return 2
    except ApiError as exc:
        eprint(f"fleet: {exc}")
        return 1
    return cmd_sync(pull=True)


SKILLS_USAGE = ("Usage: fleet skills [list] | install <author/folder|id> [--as NAME] | uninstall <name|id>\n"
                "                    | publish <folder> | unpublish <folder|id>")


