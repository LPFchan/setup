def render_harnesses():
    """Every harness file fleet manages, from the manifest and the account tree."""
    common = manifest()
    record = _load_json_quiet(RENDERED)
    servers = tokens = context = None
    try:
        rc, out = _auth("context")
        context = json.loads(out) if rc == 0 else None
        if not isinstance(context, dict) or not context.get("origin"):
            raise McpUnavailable("not signed in")
        context = {"origin": context["origin"], "subject": context.get("subject")}
        servers = wanted_servers(common)
        tokens = resolve_tokens(servers, context)
    except (McpUnavailable, ValueError) as exc:
        eprint(f"fleet: MCP servers not rendered: {exc}")
        servers = None
    keepout = keepout_command()
    steps = []
    if CLAUDE_SETTINGS.parent.is_dir():
        steps.append(lambda: render_claude(common, servers, record.setdefault("claude", {}), keepout))
    if servers is not None:
        retired = retired_env_vars(common)
        steps.append(lambda: write_tokens(tokens, context, retired))
        if CLAUDE_SETTINGS.parent.is_dir():
            steps.append(lambda: render_claude_mcp(common, servers, record))
        if CODEX_DIR.is_dir():
            steps.append(lambda: render_codex_mcp([s for s in servers if "codex" in surfaces(s)]))
            steps.append(lambda: write_dotenv(CODEX_DIR/".env", tokens, retired))
        steps.append(lambda: render_hermes(common, [s for s in servers if "hermes" in surfaces(s)], tokens, record))
    if CODEX_DIR.is_dir() and keepout is not False:
        steps.append(lambda: render_codex_keepout(keepout, record))
    steps.append(lambda: render_t3(common, record))
    ok = servers is not None
    for step in steps:
        try:
            step()
        except (OSError, ValueError) as exc:
            eprint(f"fleet: {exc}")
            ok = False
    save_json(RENDERED, record)
    return ok


# --- harnesses -----------------------------------------------------------

def _heal_path():
    """A timer starts us without the user's PATH; put their bins back first."""
    mine = [str(d) for d in (HOME/".local/bin", HOME/".opencode/bin") if d.is_dir()]
    tools = [str(d) for d in sorted((HOME/".nvm/versions/node").glob("*/bin"), reverse=True)]
    tools += [d for d in ("/opt/homebrew/bin", "/usr/local/bin") if os.path.isdir(d)]
    current = [p for p in os.environ.get("PATH", "").split(os.pathsep) if p and p not in mine]
    os.environ["PATH"] = os.pathsep.join(mine + current + [d for d in tools if d not in current])


def _resolve(spec):
    found = shutil.which(spec["name"])
    if found:
        return found
    for pattern in spec.get("candidates", []):
        for path in sorted(glob.glob(os.path.expanduser(pattern)), reverse=True):
            if os.access(path, os.X_OK):
                return path
    return None


def _version(binary):
    try:
        out = subprocess.run([binary, "--version"], capture_output=True, text=True,
                             stdin=subprocess.DEVNULL, timeout=20)
    except (OSError, subprocess.SubprocessError):
        return None
    lines = (out.stdout or out.stderr).strip().splitlines() if out.returncode == 0 else []
    return lines[0].strip() if lines else None


def _node_bin(binary):
    """The bin/ of the node install npm put this harness under: its own
    updater runs `npm install -g`, which must land in that same install."""
    for parent in pathlib.Path(os.path.realpath(binary)).parents:
        if parent.name == "node_modules" and parent.parent.name == "lib" and (parent.parent.parent/"bin/npm").exists():
            return str(parent.parent.parent/"bin")
    return None


def _harnesses(names):
    specs = {h["name"]: h for h in manifest().get("harnesses", [])}
    unknown = [n for n in names if n not in specs]
    if unknown:
        raise SystemExit(f"fleet: unknown harness: {' '.join(unknown)} (known: {' '.join(specs)})")
    return [specs[n] for n in names] if names else None, specs


def cmd_install(names):
    chosen, specs = _harnesses(names)
    rc = 0
    for spec in chosen or [s for s in specs.values() if s.get("default")]:
        if _resolve(spec) and not spec.get("rerunWhenInstalled"):
            print(f"fleet: {spec['name']} already installed")
            continue
        print(f"fleet: installing {spec['name']}")
        # pipefail: a failed download piped into sh otherwise exits 0
        if subprocess.run(["bash", "-o", "pipefail", "-c", spec["install"]]).returncode:
            eprint(f"fleet: {spec['name']} install failed")
            rc = 1
    return rc


def cmd_update(names):
    chosen, specs = _harnesses(names)
    failed = []
    for spec in chosen or specs.values():
        binary = _resolve(spec)
        if not binary:
            if chosen:
                eprint(f"fleet: {spec['name']} is not installed")
                failed.append(spec["name"])
            continue
        env = dict(os.environ)
        lead = [p for p in (_node_bin(binary), os.path.dirname(binary)) if p]
        env["PATH"] = os.pathsep.join(lead + [env.get("PATH", "")])
        if spec["name"] == "claude":
            env["CLAUDE_CODE_SIMPLE"] = "1"
        argv = (["bash", "-o", "pipefail", "-c", spec["update"]] if spec.get("update")
                else [binary, *spec.get("updateArgs", "update").split()])
        before = _version(binary)
        try:
            ok = subprocess.run(argv, stdin=subprocess.DEVNULL, env=env, timeout=900).returncode == 0
        except subprocess.TimeoutExpired:
            ok = False
        after = _version(binary)
        if not ok:
            failed.append(spec["name"])
        elif before and after and before != after:
            print(f"fleet: {spec['name']} {before} -> {after}")
        else:
            print(f"fleet: {spec['name']} {after or 'updated'} (unchanged)")
    if failed:
        eprint(f"fleet: could not update: {' '.join(failed)}")
    return 1 if failed else 0


