def _manifest_path():
    for candidate in (os.environ.get("FLEET_MANIFEST"), HOME/".config/fleet/manifest.json",
                      HERE/"fleet-manifest.json", HERE.parent/"files/fleet-manifest.json"):
        if candidate and os.path.isfile(candidate):
            return pathlib.Path(candidate)
    return None


def _version_key(path):
    """Sorts v20 after v9: the digit runs compare as numbers."""
    return [int(x) if x.isdigit() else x for x in re.split(r"(\d+)", str(path))]


def _nvm_default():
    """nvm's default node bin/, as a login shell picks it, or None."""
    root = HOME/".nvm"
    dirs = sorted((root/"versions/node").glob("*/bin"), key=_version_key, reverse=True)
    spec = "default"
    # An alias can name another alias: default -> lts/* -> lts/jod -> v22.11.0.
    for _ in range(8):
        try:
            spec = (root/"alias"/spec).read_text().strip()
        except (OSError, ValueError):
            break
    want = spec.removeprefix("v")
    for d in dirs:
        version = d.parent.name.removeprefix("v")
        if spec in ("node", "stable") or version == want or version.startswith(want + "."):
            return d
    return None


def _nvm_toolchains():
    """nvm's node bin/ folders: its default first, so a timer finds the same
    harness copy the user and system-updates run; then the rest, newest
    first."""
    dirs = sorted((HOME/".nvm/versions/node").glob("*/bin"), key=_version_key, reverse=True)
    default = _nvm_default()
    return [default] + [x for x in dirs if x != default] if default else dirs


def manifest():
    if not _MANIFEST:
        path = _manifest_path()
        if path is None:
            raise ConfigError("the harness manifest is missing; run: setup install fleet")
        try:
            data = path.read_bytes()
            _MANIFEST.update(json.loads(data), _digest=hashlib.sha256(data).hexdigest())
        except (OSError, ValueError) as exc:
            raise ConfigError(f"cannot read {path}: {exc}") from None
    return _MANIFEST


def _heal_path():
    """Put the user's own bin directories back on PATH.

    systemd and launchd start fleet with a login-less PATH, where claude,
    codex, npm and ocx are all invisible. The user's own bin directories lead,
    even ahead of a system copy of a harness, and so does nvm's default node,
    as a login shell puts it first; the other node toolchains go on the end,
    there to be found rather than to win.
    """
    mine = [HOME/".local/bin", HOME/".opencode/bin"] + [d for d in [_nvm_default()] if d]
    toolchains = _nvm_toolchains() + [pathlib.Path("/opt/homebrew/bin"), pathlib.Path("/usr/local/bin")]
    current = os.environ.get("PATH", "").split(os.pathsep)
    owned = [str(d) for d in mine if d.is_dir()]
    front = owned + [entry for entry in current if entry not in owned]
    os.environ["PATH"] = os.pathsep.join(
        front + [str(d) for d in toolchains if d.is_dir() and str(d) not in front])


@contextlib.contextmanager
def _consumer_sync_lock():
    """opencodex edits the claude settings and ~/.zshenv under the same lock."""
    CONSUMER_SYNC_LOCK.parent.mkdir(parents=True, exist_ok=True)
    with open(CONSUMER_SYNC_LOCK, "a+") as handle:
        os.chmod(CONSUMER_SYNC_LOCK, 0o600)
        fcntl.flock(handle.fileno(), fcntl.LOCK_EX)
        try:
            yield
        finally:
            fcntl.flock(handle.fileno(), fcntl.LOCK_UN)


def _claude_env(base=None):
    """Claude's minimal mode: MCP and update commands without an OAuth refresh,
    which can erase the login running T3 sessions share."""
    env = dict(os.environ if base is None else base)
    env["CLAUDE_CODE_SIMPLE"] = "1"
    return env


def load_json(path):
    """A JSON object file; a corrupt one is moved aside and read as empty."""
    try:
        text = pathlib.Path(path).read_text()
    except FileNotFoundError:
        return {}
    try:
        value = json.loads(text)
    except ValueError as exc:
        os.replace(path, f"{path}.corrupt")
        eprint(f"  {path} was corrupt ({exc}); moved aside and rebuilding")
        return {}
    return value if isinstance(value, dict) else {}


def save_text_atomic(path, text):
    """Replace the file in one rename, through a symlink to its target."""
    path = os.path.realpath(path)
    directory = os.path.dirname(path)
    pathlib.Path(directory).mkdir(parents=True, exist_ok=True)
    try:
        mode = os.stat(path).st_mode & 0o777
    except FileNotFoundError:
        mode = 0o600
    fd, temporary = tempfile.mkstemp(prefix=".fleet.", dir=directory)
    try:
        with os.fdopen(fd, "w") as handle:
            handle.write(text)
            handle.flush()
            os.fsync(handle.fileno())
        os.chmod(temporary, mode)
        os.replace(temporary, path)
    finally:
        pathlib.Path(temporary).unlink(missing_ok=True)


def save_json_atomic(path, data):
    save_text_atomic(path, json.dumps(data, indent=2) + "\n")


def deep_merge(base, overlay):
    out = dict(base)
    for key, value in overlay.items():
        if isinstance(out.get(key), dict) and isinstance(value, dict):
            out[key] = deep_merge(out[key], value)
        else:
            out[key] = value
    return out


def _leaves(value, path=()):
    """{json [key, ...]: value} for every non-object value under `value`."""
    out = {}
    for key, item in value.items():
        if isinstance(item, dict) and item:
            out.update(_leaves(item, path + (key,)))
        else:
            out[json.dumps(list(path + (key,)))] = item
    return out


# --- harnesses: registry ---

def harness_specs():
    return {spec["name"]: spec for spec in manifest().get("harnesses", [])}


def _expand_candidates(patterns):
    """~ and globs expanded; a glob yields its matches newest version first."""
    out = []
    for pattern in patterns:
        pattern = os.path.expanduser(pattern)
        if any(ch in pattern for ch in "*?["):
            out.extend(sorted(glob.glob(pattern), key=_version_key, reverse=True))
        else:
            out.append(pattern)
    return out


def _node_bin_dirs():
    dirs = []
    nvm = os.environ.get("NVM_BIN")
    if nvm and os.path.isdir(nvm):
        dirs.append(nvm)
    if os.path.isdir("/opt/node/bin"):
        dirs.append("/opt/node/bin")
    dirs += [str(d) for d in _nvm_toolchains()]
    dirs += [str(d) for d in sorted(pathlib.Path("/opt").glob("*/bin"), key=_version_key, reverse=True)]
    return dirs


def _owning_node_bin(binpath):
    """The bin/ of the node install npm put `binpath` under, or None. An npm
    self-update must run that install's npm, or the new version lands in
    another node while the copy in use never moves."""
    for parent in pathlib.Path(os.path.realpath(binpath)).parents:
        if parent.name == "node_modules" and parent.parent.name == "lib":
            candidate = parent.parent.parent/"bin"
            if (candidate/"npm").exists():
                return str(candidate)
    return None


def harness_resolve(name, spec):
    found = shutil.which(name)
    if found:
        return found
    candidates = _expand_candidates(spec.get("candidates", []))
    if spec.get("npm"):
        try:
            prefix = subprocess.run(["npm", "config", "get", "prefix"], capture_output=True,
                                    text=True, timeout=5).stdout.strip()
            if prefix and prefix != "undefined":
                candidates.append(os.path.join(prefix, "bin", name))
        except (OSError, subprocess.SubprocessError):
            pass
        candidates += [os.path.join(d, name) for d in _node_bin_dirs()]
    for candidate in candidates:
        if os.path.isfile(candidate) and os.access(candidate, os.X_OK):
            return candidate
    return None


def _npm_linked(binpath):
    """Whether `binpath` runs a package `npm link`ed from a working copy. The
    chain of links is walked without resolving it, so the node_modules entry
    each step passes through can be checked for being a link itself."""
    path = pathlib.Path(binpath)
    for _ in range(40):
        parts = path.parts
        if "node_modules" in parts:
            i = len(parts) - 1 - parts[::-1].index("node_modules")
            rest = parts[i + 1:]
            width = 2 if rest and rest[0].startswith("@") and len(rest) > 1 else 1
            if rest and pathlib.Path(*parts[:i + 1 + width]).is_symlink():
                return True
        if not path.is_symlink():
            return False
        path = path.parent/os.readlink(path)
    return False


def harness_version(binpath):
    """The harness's own `--version`, first line, or None. An updater that
    exits 0 may still have done nothing; reading the version on both sides
    makes that visible."""
    try:
        result = subprocess.run([binpath, "--version"], capture_output=True, text=True,
                                stdin=subprocess.DEVNULL, timeout=20)
    except (OSError, subprocess.SubprocessError):
        return None
    lines = (result.stdout or result.stderr or "").strip().splitlines()
    return lines[0].strip() if result.returncode == 0 and lines else None


def _harness_env(name, binpath):
    env = dict(os.environ)
    lead = [os.path.dirname(binpath)]
    owner = _owning_node_bin(binpath)
    if owner and owner not in lead:
        lead.insert(0, owner)
    env["PATH"] = os.pathsep.join(lead + [env.get("PATH", "")])
    return _claude_env(env) if name == "claude" else env


def cmd_install(names):
    specs, retired = harness_specs(), set(manifest().get("retiredHarnesses") or [])
    if not names:
        eprint("usage: fleet install <harness>...  (" + ", ".join(specs) + ")")
        return 2
    needs_node = [n for n in names if specs.get(n, {}).get("needsNode")]
    if needs_node and not shutil.which("node"):
        eprint(f"fleet: node is required for {'/'.join(needs_node)}; install it through nvm, then re-run")
        return 1
    rc, installed = 0, False
    for name in names:
        spec = specs.get(name)
        if name in retired:
            eprint(f"fleet: {name} is retired; fleet no longer installs it")
            rc = 1
            continue
        if not spec:
            eprint(f"fleet: unknown harness {name}")
            rc = 1
            continue
        command = spec.get("install", "").strip()
        if not command:
            print(f"fleet: {name} has no installer")
            continue
        # A rerunnable installer repairs a partial install itself (t3: the CLI
        # is there but its background service is not).
        if harness_resolve(name, spec) and not spec.get("rerunWhenInstalled"):
            print(f"fleet: {name} is already installed")
            continue
        print(f"fleet: installing {name}")
        # Installers are `curl ... | sh` pipelines: without pipefail a failed
        # download feeds sh nothing and reads as success.
        if subprocess.run(["bash", "-o", "pipefail", "-c", command]).returncode != 0:
            eprint(f"fleet: {name}: install failed")
            rc = 1
        else:
            installed = True
    if installed and config_sync_enabled():
        config_sync(direct=False)
        rc = harness_render(force=True) or rc
    return rc


def harness_update():
    """Run each installed harness's own updater; 1 when one failed."""
    present, failed, unchanged = 0, [], []
    for name, spec in harness_specs().items():
        binpath = harness_resolve(name, spec)
        if not binpath:
            continue
        present += 1
        if spec.get("npm") and _npm_linked(binpath):
            print(f"fleet: {name} is npm-linked to a working copy; not updating it")
            continue
        if spec.get("update"):
            argv = ["bash", "-o", "pipefail", "-c", spec["update"]]
        else:
            argv = [binpath] + spec.get("updateArgs", "update").split()
        print(f"fleet: updating {name} ({binpath})")
        before = harness_version(binpath)
        try:
            result = subprocess.run(argv, stdin=subprocess.DEVNULL, env=_harness_env(name, binpath),
                                    timeout=int(os.environ.get("SETUP_HARNESS_TIMEOUT", "900")))
        except (OSError, subprocess.SubprocessError):
            failed.append(name)
            continue
        if result.returncode != 0:
            failed.append(name)
            continue
        after = harness_version(binpath)
        if before and after and before != after:
            print(f"  {before} -> {after}")
        elif before and after:
            unchanged.append(name)
    if present and unchanged:
        print("fleet: already current, or the updater did nothing: " + " ".join(unchanged))
    if failed:
        _report("could not update " + ", ".join(failed))
    return 1 if failed else 0


# --- harnesses: tiers ---

def mcp_env_var(server):
    """The env var holding a server's token: {NAME}_MCP_TOKEN unless named."""
    return server.get("envVar") or re.sub(r"[^A-Za-z0-9]+", "_", server["name"]).upper() + "_MCP_TOKEN"


def mcp_surfaces(server):
    return server.get("surfaces") or list(SURFACES)


def _account_server(entry, subject):
    """An mcp.json entry checked and normalized; ValueError says why not."""
    if not isinstance(entry, dict):
        raise ValueError("not an object")
    name, url, auth = entry.get("name"), entry.get("url"), entry.get("auth", "none")
    if not isinstance(name, str) or not MCP_NAME.match(name):
        raise ValueError(f"bad name {name!r}")
    if not isinstance(url, str) or not re.match(r"^https?://[^\s]+$", url):
        raise ValueError(f"{name}: url must be http(s)")
    if auth not in ("none", "bearer", "x-api-key"):
        raise ValueError(f"{name}: auth must be none, bearer or x-api-key")
    server = {"name": name, "url": url, "auth": auth}
    surfaces = entry.get("surfaces")
    if surfaces is not None:
        if not isinstance(surfaces, list) or not surfaces or any(s not in SURFACES for s in surfaces):
            raise ValueError(f"{name}: surfaces must name claude, codex or hermes")
        server["surfaces"] = surfaces
    if auth == "none":
        return server
    source = entry.get("credentialSource")
    if source == "env":
        if not isinstance(entry.get("env"), str) or not ENV_NAME.match(entry["env"]):
            raise ValueError(f"{name}: credentialSource env needs an env variable name")
        server.update(credentialSource="env", envVar=entry["env"])
    elif source == "passage":
        # The passage vault is the operator's own.
        if subject != OPERATOR_SUBJECT:
            raise ValueError(f"{name}: credentialSource passage is for the operator's account")
        for key in ("envVar", "vaultItem"):
            if key in entry:
                if not isinstance(entry[key], str) or not ENV_NAME.match(entry[key]):
                    raise ValueError(f"{name}: bad {key}")
                server[key] = entry[key]
        server["credentialSource"] = "passage"
    else:
        raise ValueError(f"{name}: credentialSource must be env or passage")
    return server


def _tier_file(rel, warnings):
    path = AGENTS_DIR/rel
    if not path.is_file() or path.is_symlink():
        return {}
    try:
        value = json.loads(path.read_text())
    except (OSError, ValueError) as exc:
        warnings.append(f"{rel}: {exc}")
        return {}
    if not isinstance(value, dict):
        warnings.append(f"{rel}: not a JSON object")
        return {}
    return value


def empty_tier():
    return {"claude": {}, "allow": [], "t3": [], "keepout": False, "mcp": []}


def read_tier(subject, warnings):
    """The account's tier from ~/.agents; malformed parts are skipped."""
    tier = empty_tier()
    claude = _tier_file("settings/claude.json", warnings)
    if isinstance(claude.get("json"), dict):
        tier["claude"] = claude["json"]
    elif "json" in claude:
        warnings.append("settings/claude.json: json is not an object")
    allow = claude.get("permissionsAllowAdd", [])
    if isinstance(allow, list) and all(isinstance(a, str) for a in allow):
        tier["allow"] = allow
    else:
        warnings.append("settings/claude.json: permissionsAllowAdd is not a list of strings")
    models = _tier_file("settings/t3.json", warnings).get("claudeCustomModels", [])
    if isinstance(models, list):
        for row in models:
            if isinstance(row, dict) and isinstance(row.get("slug"), str) and row["slug"]:
                tier["t3"].append(row)
            else:
                warnings.append(f"settings/t3.json: skipped model {row!r}")
    keepout = _tier_file("settings/keepout.json", warnings).get("enabled", False)
    tier["keepout"] = keepout is True
    entries = _tier_file("mcp.json", warnings).get("mcpServers", [])
    if not isinstance(entries, list):
        warnings.append("mcp.json: mcpServers is not a list")
        entries = []
    for entry in entries:
        try:
            tier["mcp"].append(_account_server(entry, subject))
        except ValueError as exc:
            warnings.append(f"mcp.json: skipped {exc}")
    return tier


def check_tier_shape(rel, value):
    """Why `rel` cannot be uploaded as `value`, or None."""
    if rel == "mcp.json" and not isinstance(value.get("mcpServers", []), list):
        return "mcpServers must be a list"
    if rel == "settings/claude.json":
        if not isinstance(value.get("json", {}), dict):
            return "json must be an object"
        if not isinstance(value.get("permissionsAllowAdd", []), list):
            return "permissionsAllowAdd must be a list"
    if rel == "settings/t3.json" and not isinstance(value.get("claudeCustomModels", []), list):
        return "claudeCustomModels must be a list"
    if rel == "settings/keepout.json" and not isinstance(value.get("enabled", False), bool):
        return "enabled must be true or false"
    return None


def hub_servers():
    """The lost.plus MCPs the account is admitted to, from the hub."""
    rows = _request("GET", "/api/services", expect=list)
    if not all(isinstance(row, dict) and all(isinstance(row.get(k), str)
                                             for k in ("key", "mcp_url", "token_key"))
               for row in rows):
        raise ConfigError("Auth returned an invalid service list")
    servers = []
    for row in rows:
        if not row["mcp_url"]:
            continue
        key = row["key"]
        name = key[:-len(HUB_SUFFIX)] if key.endswith(HUB_SUFFIX) else key
        # The same names an account may use: a harness config can hold them as is.
        if not MCP_NAME.match(name):
            _report(f"skipped the hub service {key!r}: not a usable MCP name")
            continue
        server = {"name": name, "url": row["mcp_url"], "auth": "none"}
        if row["token_key"]:
            server.update(auth="bearer", credentialSource="common-auth", scope=row["token_key"])
        servers.append(server)
    return servers


def local_plugin_servers():
    """Codex's bundled plugin MCPs on a Mac, offered to claude as stdio."""
    if sys.platform != "darwin":
        return []
    servers = []
    for spec in manifest().get("localPluginMcpServers", []):
        root = CODEX_DIR/"plugins/cache/openai-bundled"/spec["plugin"]
        versions = [p for p in root.glob("*") if p.is_dir() and re.fullmatch(r"\d+(?:\.\d+)*", p.name)]
        if not versions:
            continue
        latest = max(versions, key=lambda p: tuple(int(n) for n in p.name.split(".")))
        try:
            entry = json.loads((latest/".mcp.json").read_text())["mcpServers"][spec["server"]]
            command, args, env = entry["command"], entry.get("args", []), entry.get("env", {})
            env = {**env, **spec.get("env", {})}
            if (not isinstance(command, str) or not os.path.isabs(command)
                    or not os.access(command, os.X_OK)
                    or not isinstance(args, list) or not all(isinstance(a, str) for a in args)
                    or not all(isinstance(k, str) and isinstance(v, str) for k, v in env.items())
                    or entry.get("enabled") is False or entry.get("env_vars")
                    or any("${" in v for v in [command, *args, *env.values()])):
                raise ValueError("unsupported plugin launch configuration")
        except (OSError, ValueError, KeyError, TypeError, AttributeError) as exc:
            eprint(f"  {spec['name']}: cannot import {latest/'.mcp.json'}: {exc}")
            continue
        servers.append({"name": spec["name"], "auth": "none", "surfaces": ["claude"],
                        "stdio": {"type": "stdio", "command": command, "args": args, "env": env}})
    return servers


# --- harnesses: credentials ---

def common_auth_token(scope, context):
    rc, out = _auth("token", scope, "--expect-context",
                    json.dumps(context, sort_keys=True, separators=(",", ":")), timeout=60)
    if rc == 5:
        raise Changed()
    token = out.strip()
    if rc or not token:
        raise TokenError(f"no {scope} credential from Common Auth", authoritative=rc in (3, 4))
    return token


class TokenError(Exception):
    def __init__(self, message, authoritative=False):
        super().__init__(message)
        self.authoritative = authoritative


def _vault_get(token, item):
    body = {"jsonrpc": "2.0", "id": 1, "method": "tools/call",
            "params": {"name": "get_secret", "arguments": {"folder": VAULT_FOLDER, "item_name": item}}}
    request = urllib.request.Request(VAULT_URL, data=json.dumps(body).encode(), method="POST", headers={
        "Authorization": "Bearer " + token, "Content-Type": "application/json",
        "Accept": "application/json, text/event-stream", "User-Agent": "fleet/1.0"})
    try:
        with urllib.request.urlopen(request, timeout=10) as response:
            result = json.loads(response.read()).get("result", {})
    except (OSError, ValueError, AttributeError) as exc:
        raise TokenError(f"passage unreachable: {exc}") from None
    content = result.get("content") or [{}]
    text = (content[0].get("text") or "").strip()
    if result.get("isError") or not text:
        raise TokenError(f"no passage item mcp/{item}")
    return text


def mcp_token_value(raw):
    """The bare token from a vault item that may record how to send it,
    such as '<url> | Authorization: Bearer <token>'."""
    value = (raw or "").strip().split("|")[-1].strip()
    if not value.lower().startswith(("http://", "https://")):
        match = re.match(r"^([A-Za-z][A-Za-z0-9-]*)\s*:\s*(.+)$", value, re.S)
        if match:
            value = match.group(2).strip()
    if value.lower().startswith("bearer "):
        value = value[len("bearer "):].strip()
    return value


def _existing_block(text):
    match = re.search(re.escape(TOKENS_BEGIN) + r"(.*?)" + re.escape(TOKENS_END), text, re.S)
    return match.group(1) if match else ""


def managed_exports():
    """The managed token block of ~/.zshenv, read the way zsh would: a quoted
    value may run over lines, and '#' starts a comment only at a line's head."""
    try:
        text = ZSHENV.read_text()
    except OSError:
        return {}
    found, pending = {}, ""
    for line in _existing_block(text).splitlines(keepends=True):
        if not pending and line.lstrip().startswith("#"):
            continue
        pending += line
        try:
            words = shlex.split(pending)
        except ValueError:
            continue
        pending = ""
        for word in words:
            name, eq, value = word.partition("=")
            if eq and ENV_NAME.match(name):
                found[name] = value
    return found


def _block_context():
    try:
        text = ZSHENV.read_text()
    except OSError:
        return None
    match = re.search(r"^# common-auth-context (\{.*\})$", _existing_block(text), re.M)
    try:
        value = json.loads(match.group(1)) if match else None
    except ValueError:
        return None
    return {"origin": value.get("origin"), "subject": value.get("subject")} if isinstance(value, dict) else None


def resolve_tokens(servers, context, warnings):
    """(exports {VAR: value}, names to drop, servers left out for want of a
    token, servers whose lookup failed with nothing to fall back on: the
    render fails, so the next sync looks again). A failed lookup keeps the value already in the block unless Auth
    said the credential is gone; a Passage item falls back further to the
    environment, which holds it before the first render writes the block."""
    existing = managed_exports()
    drop = set()
    if _block_context() != context:
        # Another account: nothing Common Auth gave the old one carries over.
        drop.update(mcp_env_var(s) for s in servers if s.get("credentialSource") == "common-auth")
        drop.add("PASSAGE_MCP_TOKEN")
        for name in drop:
            existing.pop(name, None)
    tokens, exports, skipped, missing = {}, {}, set(), set()

    def common(scope):
        if scope not in tokens:
            tokens[scope] = common_auth_token(scope, context)
        return tokens[scope]

    for server in servers:
        if server["auth"] == "none":
            continue
        var, source, value = mcp_env_var(server), server.get("credentialSource"), None
        try:
            if source == "common-auth":
                value = common(server["scope"])
            elif source == "passage":
                value = _vault_get(common("passage"), server.get("vaultItem") or var)
            else:
                value = os.environ.get(var) or existing.get(var)
                if not value:
                    warnings.append(f"{server['name']}: {var} is not set; server skipped")
                    skipped.add(server["name"])
                    continue
        except TokenError as exc:
            if exc.authoritative:
                drop.add(var)
            value = None if exc.authoritative else existing.get(var) or (
                os.environ.get(var) if source == "passage" else None)
            eprint(f"  {var}: {exc}; " + ("keeping the current value" if value else "no value"))
            if not value and not exc.authoritative:
                missing.add(server["name"])
        value = mcp_token_value(value)
        if value:
            exports[var] = value
            drop.discard(var)
    return exports, drop, skipped, missing


def _mirror_zshenv(exports, drop, context, retired):
    text = ZSHENV.read_text() if ZSHENV.exists() else ""
    kept = {}
    for line in _existing_block(text).splitlines():
        match = re.match(r"^export\s+([A-Za-z_][A-Za-z0-9_]*)=", line)
        if match:
            kept[match.group(1)] = line
    lines = [f"export {k}={shlex.quote(v)}" for k, v in exports.items()]
    lines += [line for name, line in kept.items()
              if name not in exports and name not in drop and name not in retired]
    context_line = "# common-auth-context " + json.dumps(context, sort_keys=True, separators=(",", ":"))
    block = "\n".join([TOKENS_BEGIN, context_line, *lines, TOKENS_END]) + "\n"
    if TOKENS_BEGIN in text and TOKENS_END in text:
        new = re.sub(re.escape(TOKENS_BEGIN) + r".*?" + re.escape(TOKENS_END) + r"\n?",
                     lambda _: block, text, flags=re.S)
    else:
        new = text.rstrip("\n") + ("\n\n" if text.strip() else "") + block
    for name in retired:
        new = re.sub(r"^export\s+%s=.*\n?" % re.escape(name), "", new, flags=re.M)
    if new != text:
        # Atomic: claude's headersHelper reads this file at any moment.
        save_text_atomic(ZSHENV, new)
        print(f"  wrote {len(lines)} token(s) to {ZSHENV}")


def _remove_zshenv_block():
    text = ZSHENV.read_text() if ZSHENV.exists() else ""
    new = re.sub(r"\n*" + re.escape(TOKENS_BEGIN) + r".*?" + re.escape(TOKENS_END) + r"\n?",
                 "\n", text, flags=re.S)
    if new != text:
        save_text_atomic(ZSHENV, new.lstrip("\n") if new.strip() else "")
        print(f"  removed fleet's tokens from {ZSHENV}")


def _dotenv_value(value):
    return value if re.fullmatch(r"[A-Za-z0-9_./:=+@,-]+", value) else "'" + value.replace("'", "'\\''") + "'"


def _mirror_dotenv(path, exports, retired):
    """The same tokens as a NAME=value block, for a harness that reads a .env
    rather than the shell: codex and the hermes gateway, started by services
    that never read ~/.zshenv."""
    original = path.read_text() if path.exists() else ""
    body = [f"{k}={_dotenv_value(v)}" for k, v in exports.items()]
    block = "\n".join([TOKENS_BEGIN, *body, TOKENS_END]) + "\n"
    if TOKENS_BEGIN in original and TOKENS_END in original:
        text = re.sub(re.escape(TOKENS_BEGIN) + r".*?" + re.escape(TOKENS_END) + r"\n?",
                      lambda _: block, original, flags=re.S)
    else:
        text = original.rstrip("\n") + ("\n\n" if original.strip() else "") + block
    # The block is rewritten from exports; outside it only what setup's old
    # modules wrote comes off, never a line the user wrote for a dropped name.
    for name in set(retired) - set(exports):
        text = re.sub(r"^%s=.*\n?" % re.escape(name), "", text, flags=re.M)
    if text == original:
        return False
    path.parent.mkdir(parents=True, exist_ok=True)
    save_text_atomic(path, text)
    os.chmod(path, 0o600)
    return True


def cmd_mcp_headers(args):
    """claude's headersHelper: one server's auth header as JSON."""
    if len(args) != 2 or args[0] not in ("bearer", "x-api-key"):
        eprint("usage: fleet mcp-headers bearer|x-api-key ENV_VAR")
        return 2
    auth, var = args
    token = managed_exports().get(var)
    if not token:
        eprint(f"fleet: no {var} in the managed token block of {ZSHENV}; run: fleet sync")
        return 1
    print(json.dumps({"Authorization": "Bearer " + token} if auth == "bearer" else {"X-API-Key": token}))
    return 0


# --- harnesses: renderers ---

_MISSING = object()


def _keepout_command():
    command = manifest().get("keepout", {}).get("command")
    if not isinstance(command, str) or KEEPOUT_MARKER not in command:
        raise ConfigError(f"the manifest's keepout.command must contain {KEEPOUT_MARKER}")
    return command


def _is_keepout_hook(handler):
    return isinstance(handler, dict) and KEEPOUT_MARKER in str(handler.get("command", ""))


def _merge_keepout_hooks(settings, command):
    """Reconcile only our command, even in a group shared with the user's
    hooks; None removes it."""
    hooks = settings.get("hooks") if isinstance(settings.get("hooks"), dict) else {}
    out = []
    for group in hooks.get("UserPromptSubmit") or []:
        handlers = group.get("hooks", []) if isinstance(group, dict) else []
        kept = [h for h in handlers if not _is_keepout_hook(h)]
        if kept == handlers:
            out.append(group)
        elif kept:
            out.append({**group, "hooks": kept})
    if command:
        # Synchronous: a background hook cannot reject a prompt.
        out.append({"hooks": [{"type": "command", "command": command}]})
    if out:
        settings.setdefault("hooks", {})["UserPromptSubmit"] = out
    elif "UserPromptSubmit" in hooks:
        del hooks["UserPromptSubmit"]
        if not hooks:
            settings.pop("hooks", None)


def _get_path(value, path):
    for key in path:
        if not isinstance(value, dict) or key not in value:
            return _MISSING
        value = value[key]
    return value


def _drop_path(value, path):
    """Delete the leaf at `path`, then any parent it leaves empty."""
    parents = []
    for key in path[:-1]:
        parents.append((value, key))
        value = value[key]
    del value[path[-1]]
    for parent, key in reversed(parents):
        if parent[key] != {}:
            break
        del parent[key]


def render_claude(desired, allow, previous, command):
    """~/.claude/settings.json: the tiers deep-merged in, the allow list
    union-merged, the keepout hook reconciled. What the record says fleet
    wrote and the tiers no longer set comes off while it holds that value."""
    current = load_json(CLAUDE_SETTINGS)
    before = json.dumps(current, sort_keys=True)
    wanted = _leaves(desired)
    for key, value in (previous.get("claude") or {}).items():
        path = json.loads(key)
        if key not in wanted and _get_path(current, path) == value:
            _drop_path(current, path)
    merged = deep_merge(current, desired)
    if not isinstance(merged.get("permissions", {}), dict):
        merged["permissions"] = {}
    permissions = merged.get("permissions", {})
    existing = permissions.get("allow", [])
    existing = existing if isinstance(existing, list) else []
    # A grant leaves with its server: the whole mcp__<name>__ namespace, since
    # a connector granted per tool leaves a row per tool.
    retired = tuple(f"mcp__{n}__" for n in (manifest().get("retiredMcpServers") or [])
                    + (manifest().get("retiredMcpGrants") or []))
    gone = set(previous.get("allow") or []) - set(allow)
    kept = [e for e in existing
            if e not in gone and not (retired and isinstance(e, str) and e.startswith(retired))]
    kept += [e for e in allow if e not in kept]
    if kept or "allow" in permissions:
        merged.setdefault("permissions", {})["allow"] = kept
    if merged.get("permissions") == {}:
        merged.pop("permissions")
    _merge_keepout_hooks(merged, command)
    if json.dumps(merged, sort_keys=True) != before:
        save_json_atomic(CLAUDE_SETTINGS, merged)
        print(f"  wrote {CLAUDE_SETTINGS}")
    return wanted


def _claude_mcp_entry(server):
    """The user-scope ~/.claude.json entry. A token server gets a
    headersHelper, not a ${VAR} header: claude expands ${VAR} from its own
    environment, and a claude a service or GUI app started never read
    .zshenv. The helper reads the token block at each connect."""
    if "stdio" in server:
        return dict(server["stdio"])
    entry = {"type": "http", "url": server["url"]}
    if server["auth"] != "none":
        entry["headersHelper"] = (f"{shlex.quote(_self_path())} mcp-headers "
                                  f"{server['auth']} {mcp_env_var(server)}")
    return entry


def _self_path():
    return os.path.abspath(sys.argv[0]) if sys.argv and sys.argv[0] else str(HOME/".local/bin/fleet")


def _claude_mcp_scope(claude, name):
    """The scope claude holds the server at ("" when it does not say), or
    None when it is not registered. `get` names one server, where a search of
    `list` matched prefixes of unrelated connectors."""
    result = subprocess.run([claude, "mcp", "get", name], capture_output=True, text=True,
                            env=_claude_env())
    if result.returncode != 0 or "No MCP server named" in (result.stdout + result.stderr):
        return None
    for line in result.stdout.splitlines():
        if line.strip().startswith("Scope:"):
            return (line.strip()[6:].strip().split() or [""])[0].lower()
    return ""


def _claude_json():
    return pathlib.Path(os.environ.get("CLAUDE_CONFIG_DIR") or HOME)/".claude.json"


def _claude_user_entry(name):
    """The stored user-scope entry, from the file: `claude mcp get` does not
    print a headersHelper."""
    try:
        return (json.loads(_claude_json().read_text()).get("mcpServers") or {}).get(name)
    except (OSError, ValueError, AttributeError):
        return None


def _claude_json_remove(name):
    """Without the claude CLI, drop a user-scope entry from the file itself:
    its headersHelper would call a fleet being uninstalled."""
    try:
        data = json.loads(_claude_json().read_text())
        del data["mcpServers"][name]
        save_json_atomic(_claude_json(), data)
    except (OSError, ValueError, TypeError, KeyError) as exc:
        eprint(f"fleet: could not remove MCP server {name} from {_claude_json()}: {exc}")
        return False
    return True


def _rendered_on(record, surface):
    """Whether fleet put this recorded server on `surface`. Records from
    before fleet kept track count as on every surface."""
    return isinstance(record, dict) and surface in record.get("rendered", [surface])


def render_claude_mcp(claude, servers, previous, retired):
    """(ok, kept, found): kept holds the previous records of servers claude
    would not remove, so the applied record keeps owning them and the next run
    retries; found names the user's own entries that already matched ours,
    which stay theirs. Without claude (only when taking settings back) the
    file is edited."""
    ok, kept, found = True, {}, set()
    for name in sorted(retired):
        if _claude_mcp_scope(claude, name) is not None:
            print(f"  unregistering retired MCP server {name}")
            # No -s: the CLI then removes it from whichever scope holds it.
            ok = _claude_remove([claude, "mcp", "remove", name]) and ok
    for name, record in (previous.get("mcp") or {}).items():
        if name in servers or name in retired or "claude" in (record.get("users") or []):
            continue
        entry = _claude_user_entry(name)
        if isinstance(entry, dict) and ((record.get("url") and entry.get("url") == record["url"])
                                        or (record.get("claude") and entry == record["claude"])):
            print(f"  unregistering MCP server {name}")
            if not (_claude_remove([claude, "mcp", "remove", name, "-s", "user"]) if claude
                    else _claude_json_remove(name)):
                ok, kept[name] = False, record
    for server in servers.values():
        want = _claude_mcp_entry(server)
        argv = [claude, "mcp", "add-json", "--scope", "user", server["name"], json.dumps(want)]
        scope = _claude_mcp_scope(claude, server["name"])
        if scope is None:
            ok = _claude_add(argv) and ok
        elif scope not in ("", "user"):
            # A local or project registration is the user's and shadows ours.
            print(f"  {server['name']} is registered at {scope} scope; leaving it alone")
        elif "claude" in (((previous.get("mcp") or {}).get(server["name"]) or {}).get("users") or []):
            # The user's own entry, which matched ours once, stays theirs
            # when ours changes. Once they delete it, the one fleet adds back
            # is fleet's.
            found.add(server["name"])
        elif _claude_user_entry(server["name"]) != want:
            print(f"  re-enrolling {server['name']}")
            if _claude_remove([claude, "mcp", "remove", server["name"], "-s", "user"]):
                ok = _claude_add(argv) and ok
            else:
                ok = False
        elif not _rendered_on((previous.get("mcp") or {}).get(server["name"]), "claude"):
            found.add(server["name"])
    return ok, kept, found


def _claude_remove(argv):
    """Whether claude dropped the server; a failure is retried next run."""
    result = subprocess.run(argv, capture_output=True, text=True, env=_claude_env())
    if result.returncode != 0:
        eprint(f"fleet: claude did not remove MCP server {argv[3]}: "
               f"{(result.stderr or result.stdout).strip() or f'exit {result.returncode}'}")
    return result.returncode == 0


def _claude_add(argv):
    """Whether claude took the server; a failure renders again next run."""
    result = subprocess.run(argv, capture_output=True, text=True, env=_claude_env())
    if result.returncode != 0:
        eprint(f"fleet: claude did not add MCP server {argv[5]}: "
               f"{(result.stderr or result.stdout).strip() or f'exit {result.returncode}'}")
    return result.returncode == 0


def _codex_mcp_block(server):
    lines = [f"[mcp_servers.{server['name']}]", f"url = {json.dumps(server['url'])}"]
    if server["auth"] == "bearer":
        lines.append(f"bearer_token_env_var = \"{mcp_env_var(server)}\"")
    elif server["auth"] == "x-api-key":
        lines.append(f"env_http_headers = {{ \"X-API-Key\" = \"{mcp_env_var(server)}\" }}")
    return "\n".join(lines) + "\n"


def _toml(text):
    """(parsed, error); (None, None) where Python has no TOML parser."""
    try:
        import tomllib
    except ImportError:
        return None, None
    try:
        return tomllib.loads(text), None
    except Exception as exc:  # tomllib raises its own TOMLDecodeError
        return None, str(exc)


def _codex_sections(text):
    """[(name, text)] of each top-level [mcp_servers.<name>] table."""
    out = []
    for match in re.finditer(r"^\[mcp_servers\.([^.\]]+)\]\s*$", text, re.M):
        following = re.search(r"^\[", text[match.end():], re.M)
        end = match.end() + (following.start() if following else len(text) - match.end())
        out.append((match.group(1).strip("\"'"), text[match.start():end]))
    return out


def render_codex_mcp(servers, previous, retired):
    """Our servers in one marked region of config.toml, replaced whole. A
    server the user declares outside it is theirs and is never emitted (a
    second table would stop codex from starting); the result must parse
    before it is written. Returns False when the file was left alone."""
    original = CODEX_CONFIG.read_text() if CODEX_CONFIG.exists() else ""
    if original.strip() and _toml(original)[1]:
        eprint(f"  {CODEX_CONFIG} does not parse; refusing to edit it: {_toml(original)[1]}")
        return False
    region = re.search(re.escape(CODEX_MCP_BEGIN) + r".*?" + re.escape(CODEX_MCP_END) + r"\n?",
                       original, re.S)
    text = original[:region.start()] + original[region.end():] if region else original
    # Reclaim blocks an older release appended outside the region: a body
    # identical to one of ours, or a retired name. A block carrying
    # [.tools.*] rules was never ours.
    ours = {_codex_mcp_block(s).strip().split("\n", 1)[1] for s in servers}
    for name, body in _codex_sections(text):
        table = ((_toml(text)[0] or {}).get("mcp_servers") or {}).get(name)
        if isinstance(table, dict) and any(isinstance(v, dict) for v in table.values()):
            continue
        rest = body.strip().split("\n", 1)
        if name in retired or (len(rest) == 2 and rest[1] in ours):
            text = text.replace(body, "", 1)
    # Declared means given settings of its own, not only [.tools.*] rules
    # hanging off the name, which still need our url.
    declared = {name for name, table in ((_toml(text)[0] or {}).get("mcp_servers") or {}).items()
                if not isinstance(table, dict) or any(not isinstance(v, dict) for v in table.values())}
    emit = [s for s in servers if s["name"] not in declared]
    for server in servers:
        if server["name"] in declared:
            print(f"  {server['name']} is configured in {CODEX_CONFIG.name} already; leaving it alone")
    body = "\n".join(_codex_mcp_block(s) for s in emit)
    region = f"{CODEX_MCP_BEGIN}\n{body}{CODEX_MCP_END}\n" if emit else ""
    candidate = text.rstrip("\n")
    candidate = candidate + "\n\n" + region if region else candidate + "\n"
    if candidate.strip() == "":
        candidate = ""
    if _toml(candidate)[1]:
        eprint(f"  refusing to write {CODEX_CONFIG}: the result would not parse: {_toml(candidate)[1]}")
        return False
    if candidate != original:
        save_text_atomic(CODEX_CONFIG, candidate)
        print(f"  wrote {CODEX_CONFIG} ({len(emit)} codex MCP server(s))")
    return True


def render_codex_keepout(command):
    current = load_json(CODEX_HOOKS)
    before = json.dumps(current, sort_keys=True)
    _merge_keepout_hooks(current, command)
    if json.dumps(current, sort_keys=True) != before:
        save_json_atomic(CODEX_HOOKS, current)
        print(f"  wrote {CODEX_HOOKS}")
    return _trust_codex_keepout(command) if command else True


def _trust_codex_keepout(command):
    """Trust our keepout hook the way /hooks does, through codex app-server.
    Codex skips a hook whose hash it has not trusted, so a changed command
    would silently turn the gate off. Only this exact command, in its own
    hooks.json, is trusted; other hooks stay for the user to review."""
    codex = harness_resolve("codex", harness_specs().get("codex", {}))
    if not codex:
        return True
    ids = iter(range(1, 100))

    def call(rid, method, params):
        proc.stdin.write(json.dumps({"jsonrpc": "2.0", "id": rid, "method": method, "params": params}) + "\n")
        proc.stdin.flush()
        for line in proc.stdout:
            message = json.loads(line)
            if message.get("id") == rid:
                if "error" in message:
                    raise RuntimeError(f"{method}: {message['error'].get('message', message['error'])}")
                return message["result"]
        raise RuntimeError("codex app-server exited during " + method)

    def ours():
        listed = call(next(ids), "hooks/list", {"cwds": [str(HOME)]})
        return [h for entry in listed.get("data", []) for h in entry.get("hooks", [])
                if h.get("command") == command and h.get("sourcePath") == str(CODEX_HOOKS)]

    try:
        proc = subprocess.Popen([codex, "app-server"], stdin=subprocess.PIPE, stdout=subprocess.PIPE,
                                stderr=subprocess.DEVNULL, text=True)
    except OSError as exc:
        eprint(f"  cannot trust the codex keepout hook: {exc}; trust it via /hooks")
        return False
    timer = threading.Timer(CODEX_TRUST_TIMEOUT, proc.kill)
    timer.start()
    try:
        call(next(ids), "initialize", {"clientInfo": {"name": "fleet", "version": "1"}})
        proc.stdin.write(json.dumps({"jsonrpc": "2.0", "method": "initialized"}) + "\n")
        hooks = ours()
        pending = {h["key"]: {"trusted_hash": h["currentHash"]} for h in hooks
                   if h.get("trustStatus") in ("untrusted", "modified")}
        if pending:
            call(next(ids), "config/batchWrite", {
                "edits": [{"keyPath": "hooks.state", "value": pending, "mergeStrategy": "upsert"}],
                "reloadUserConfig": True})
            hooks = ours()
        if not hooks or any(h.get("trustStatus") != "trusted" for h in hooks):
            raise RuntimeError(f"keepout hook is {[h.get('trustStatus') for h in hooks] or 'not listed'}")
        if pending:
            print("  trusted the keepout hook in codex")
        return True
    except (OSError, ValueError, RuntimeError) as exc:
        eprint(f"  cannot trust the codex keepout hook: {exc}; trust it via /hooks")
        return False
    finally:
        timer.cancel()
        proc.kill()
        proc.wait()


def _effort_descriptors():
    """Model slug -> a t3 'effort' option descriptor, from the opencodex
    proxy's catalog: t3 shows a reasoning selector only for a custom model
    that declares one, and the levels are the provider's to publish."""
    try:
        url = subprocess.run([sys.executable, str(OPENCODEX), "__proxy-url"], capture_output=True,
                             text=True, timeout=30).stdout.strip()
        with urllib.request.urlopen(url + "/v1/models", timeout=T3_CATALOG_TIMEOUT) as response:
            payload = json.load(response)
    except (OSError, ValueError, subprocess.SubprocessError):
        return {}
    out = {}
    for row in (payload.get("data") or []) if isinstance(payload, dict) else []:
        if not isinstance(row, dict) or not isinstance(row.get("id"), str):
            continue
        options = []
        for level in row.get("reasoning_efforts") or []:
            if not isinstance(level, dict) or not isinstance(level.get("value"), str):
                continue
            label = level.get("label") if isinstance(level.get("label"), str) and level["label"] else level["value"]
            # The column is already called Reasoning.
            option = {"id": level["value"], "label": label.removesuffix(" Effort")}
            if level.get("default") is True:
                option["isDefault"] = True
            options.append(option)
        if options:
            out[row["id"]] = {"id": "effort", "label": "Reasoning", "type": "select", "options": options}
    return out


def render_t3(models, previous):
    """T3's claude custom models: ours appended or refreshed by slug, the
    user's left alone. Returns the record: slug -> row as written, marked
    user when the row was there before fleet."""
    current = load_json(T3_SETTINGS)
    before = json.dumps(current, sort_keys=True)
    instances = current.setdefault("providerInstances", {})
    claude = instances.setdefault("claudeAgent", {"driver": "claudeAgent", "enabled": True, "config": {}})
    config = claude.setdefault("config", {})
    if config.get("binaryPath") in {str(p) for p in RETIRED_CLAUDE_LAUNCHERS}:
        config["binaryPath"] = "claude"
    descriptors = _effort_descriptors() if models and os.access(OPENCODEX, os.X_OK) else {}
    wanted = {}
    for model in models:
        entry = dict(model)
        # A model the proxy routes before it lists borrows a sibling's ladder.
        sibling = entry.pop("effortsFrom", None)
        descriptor = descriptors.get(entry["slug"]) or descriptors.get(sibling)
        if descriptor:
            entry["capabilities"] = {"optionDescriptors": [descriptor]}
        wanted[entry["slug"]] = entry
    record = {slug: {k: v for k, v in e.items() if k != "capabilities"} for slug, e in wanted.items()}
    recorded = previous.get("t3") or {}
    retired = set(manifest().get("retiredClaudeCustomModels") or [])
    out = []
    for row in config.get("customModels") or []:
        slug = row.get("slug") if isinstance(row, dict) else row
        if slug in retired:
            continue
        if slug in wanted:
            merged = dict(row) if isinstance(row, dict) else {"slug": slug}
            merged.update(wanted.pop(slug))
            out.append(merged)
            # A row fleet did not add is the user's: refreshed while fleet
            # ships its slug, but never removed.
            mine = recorded.get(slug) if isinstance(recorded.get(slug), dict) else None
            if mine is None or mine.get("user"):
                record[slug] = {**record[slug], "user": True}
        elif not (slug in recorded and isinstance(row, dict)
                  and {k: v for k, v in row.items() if k != "capabilities"} == recorded[slug]):
            out.append(row)
    out += wanted.values()
    config["customModels"] = out
    if json.dumps(current, sort_keys=True) != before:
        save_json_atomic(T3_SETTINGS, current)
        print(f"  wrote {T3_SETTINGS} ({len(out)} claude custom models)")
    # Only once settings stop naming a retired launcher can it go.
    if config.get("binaryPath", "claude") == "claude":
        for path in RETIRED_CLAUDE_LAUNCHERS:
            path.unlink(missing_ok=True)
    return record


def _hermes_entry(server):
    var = mcp_env_var(server)
    lines = [f"  {server['name']}:", "    type: remote", f"    url: {server['url']}", "    oauth: false"]
    if server["auth"] == "bearer":
        lines += ["    headers:", f"      Authorization: Bearer ${{{var}}}"]
    elif server["auth"] == "x-api-key":
        lines += ["    headers:", f"      X-API-Key: ${{{var}}}"]
    return lines


def _yaml_block(lines, key):
    """(start, end) of a top-level `key:` block, end exclusive, or (None, None).
    A key written on one line ({...} or [...]) is not edited: a second block
    after it would replace it in the loader."""
    for i, line in enumerate(lines):
        if re.match(rf"^{key}:\s*[^\s#]", line):
            raise ConfigError(f"{HERMES_CONFIG}: {key} is written on one line; "
                              f"write it as an indented block for fleet to edit it")
        if re.match(rf"^{key}:\s*(#.*)?$", line):
            j = i + 1
            while j < len(lines) and (lines[j].strip() == "" or lines[j][0] in " \t" or lines[j].startswith("#")):
                j += 1
            return i, j
    return None, None


def _hermes_entries(lines, start, end):
    """[(name, first, stop)] of each entry in the mcp_servers block."""
    heads = [k for k in range(start + 1, end) if re.match(r"^  [^\s#][^:]*:\s*$", lines[k])]
    out = []
    for n, k in enumerate(heads):
        stop = heads[n + 1] if n + 1 < len(heads) else end
        while stop > k + 1 and lines[stop - 1].strip() == "":
            stop -= 1
        out.append((lines[k].strip()[:-1], k, stop))
    return out


def _hermes_skills(lines):
    """Add ~/.agents/skills to skills.external_dirs, where hermes looks for
    skills beyond its bundled ones. True when fleet added it."""
    start, end = _yaml_block(lines, "skills")
    if start is None:
        if lines and lines[-1].strip():
            lines.append("")
        lines += ["skills:", "  external_dirs:", "  - ~/.agents/skills"]
        return True
    for k in range(start + 1, end):
        match = re.match(r"^  external_dirs:\s*(\[\s*\])?\s*$", lines[k])
        if not match:
            continue
        if match.group(1):
            lines[k] = "  external_dirs:"
        j = k + 1
        items = []
        while j < end and re.match(r"^\s*- ", lines[j]):
            items.append(lines[j].split("- ", 1)[1].strip().strip("\"'"))
            j += 1
        if {"~/.agents/skills", str(AGENTS_DIR/"skills")} & set(items):
            return False
        indent = re.match(r"^(\s*)- ", lines[k + 1]).group(1) if items else "  "
        lines.insert(j, f"{indent}- ~/.agents/skills")
        return True
    if any(re.match(r"^  external_dirs:", lines[k]) for k in range(start + 1, end)):
        eprint(f"  {HERMES_CONFIG}: skills.external_dirs has a shape fleet does not edit; "
               "add ~/.agents/skills to it by hand")
        return False
    lines[start + 1:start + 1] = ["  external_dirs:", "  - ~/.agents/skills"]
    return True


def _hermes_unskills(lines):
    """Take back the skills folder fleet added, and the keys left empty."""
    start, end = _yaml_block(lines, "skills")
    if start is None:
        return
    for k in range(start + 1, end):
        if re.match(r"^\s*- ['\"]?~/\.agents/skills['\"]?\s*$", lines[k]):
            del lines[k]
            break
    start, end = _yaml_block(lines, "skills")
    for k in range(start + 1, end):
        if re.match(r"^  external_dirs:\s*$", lines[k]) and not (k + 1 < end and re.match(r"^\s*- ", lines[k + 1])):
            del lines[k]
            break
    start, end = _yaml_block(lines, "skills")
    if not any(line.strip() for line in lines[start + 1:end]):
        del lines[start:end]


def render_hermes(servers, previous, retired, clear=False):
    """hermes's config.yaml: our MCP entries and the skills folder. Returns
    whether the file changed, whether the skills folder is fleet's, and the
    user's own entries that already matched ours, which stay theirs."""
    original = HERMES_CONFIG.read_text()
    lines = original.split("\n")
    start, end = _yaml_block(lines, "mcp_servers")
    if start is None:
        if lines and lines[-1].strip():
            lines.append("")
        lines.append("mcp_servers:")
        start, end = len(lines) - 1, len(lines)
    wanted = {s["name"]: _hermes_entry(s) for s in servers}
    urls = {s["name"]: f"    url: {s['url']}" for s in servers}
    recorded = previous.get("mcp") or {}
    seen, found = set(), set()
    # Bottom-up, so earlier spans keep their indexes through edits.
    for name, k, stop in reversed(_hermes_entries(lines, start, end)):
        body = lines[k:stop]
        if name in retired:
            print(f"  hermes: removing retired MCP server {name}")
            del lines[k:stop]
        elif name in wanted:
            seen.add(name)
            if "hermes" in (recorded.get(name, {}).get("users") or []):
                found.add(name)
                continue
            if body == wanted[name]:
                if not _rendered_on(recorded.get(name), "hermes"):
                    found.add(name)
                continue
            # Fleet's entry still names the URL fleet last wrote, when the
            # account has moved the server since.
            old = recorded.get(name, {}).get("url")
            if urls[name] not in body and not (old and _rendered_on(recorded[name], "hermes")
                                               and f"    url: {old}" in body):
                print(f"  hermes: {name} points somewhere else; leaving it alone")
                continue
            lines[k:stop] = wanted[name]
        elif (recorded.get(name, {}).get("url") and "hermes" not in (recorded[name].get("users") or [])
              and f"    url: {recorded[name]['url']}" in body):
            print(f"  hermes: removing MCP server {name}")
            del lines[k:stop]
    start, end = _yaml_block(lines, "mcp_servers")
    at = end
    while at > start + 1 and not lines[at - 1].strip():
        at -= 1
    lines[at:at] = [line for s in servers if s["name"] not in seen for line in wanted[s["name"]]]
    skills = bool(previous.get("hermesSkills"))
    if clear:
        if skills:
            _hermes_unskills(lines)
        skills = False
    else:
        skills = _hermes_skills(lines) or skills
    text = "\n".join(lines)
    if text == original:
        return False, skills, found
    save_text_atomic(HERMES_CONFIG, text)
    print(f"  wrote {HERMES_CONFIG} ({len(servers)} hermes MCP server(s))")
    return True, skills, found


