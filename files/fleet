def harnesses_present(clear=False):
    """Which harnesses get settings: {name: present}. claude's value is its
    binary, for the MCP commands. Taking settings back, a harness the
    manifest does not list is looked for on PATH."""
    specs = harness_specs()

    def found(name):
        if name in specs:
            return harness_resolve(name, specs[name])
        return shutil.which(name) if clear else None
    return {"claude": found("claude"), "codex": bool(found("codex") or CODEX_DIR.is_dir()),
            "t3": bool(found("t3") or T3_SETTINGS.parent.is_dir()),
            "hermes": HERMES_CONFIG.is_file(), "kimi": KIMI_CONFIG.is_file()}


def _retired_env_vars():
    return ({re.sub(r"[^A-Za-z0-9]+", "_", n).upper() + "_MCP_TOKEN"
             for n in manifest().get("retiredMcpServers") or []}
            | set(manifest().get("retiredEnvVars") or []))


def _t3_models(tier, opencodex):
    models = {}
    for row in (manifest().get("opencodex", {}).get("t3", {}).get("claudeCustomModels", [])
                if opencodex else []):
