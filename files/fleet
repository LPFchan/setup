class ConfigError(Exception):
    """The config sync could not finish; nothing past the failure was written."""


class Changed(Exception):
    """The account changed while it was read; the pull starts over."""


def config_sync_enabled():
    try:
        rows = SETUP_STATE.read_text().splitlines()
    except OSError:
        return True
    return not any(row.split("\t", 1)[0] in PREDECESSOR_MODULES for row in rows)


def config_path(rel):
    """Whether `rel` is a path Auth stores, as it checks them."""
    if len(rel.encode()) > MAX_PATH_BYTES or re.search(r"[\x00-\x1f\x7f\\]", rel):
        return False
    segments = rel.split("/")
    for segment in segments:
        if segment in ("", ".", "..") or len(segment.encode()) > MAX_SEGMENT_BYTES:
            return False
        if segment.casefold() in SKIPPED_NAMES:
            return False
    if len(segments) == 1:
        return rel in ("AGENTS.md", "mcp.json")
    return segments[0] in ("skills", "settings")


def _digest(path):
    data = path.read_bytes()
    return [hashlib.sha256(data).hexdigest(), bool(path.stat().st_mode & 0o100)]


def _unreadable(exc):
    raise ConfigError(f"cannot read {exc.filename}: {exc.strerror}")


def scan_local():
    """({path: [sha256, executable]}, symlinks skipped) under ~/.agents/."""
    files, symlinks = {}, []

    def add(path, rel):
        if path.is_symlink():
            symlinks.append(rel)
        elif path.is_file() and config_path(rel):
            files[rel] = _digest(path)

    for name in ("AGENTS.md", "mcp.json"):
        add(AGENTS_DIR/name, name)
    for top in ("skills", "settings"):
        root = AGENTS_DIR/top
        if root.is_symlink():
            symlinks.append(top)
            continue
        if not os.path.lexists(root):
            continue
        # An unreadable folder fails the scan: skipped, its files would read
        # as deleted and the deletions would reach every machine.
        for folder, dirs, names in os.walk(root, onerror=_unreadable):
            base = pathlib.Path(folder)
            for name in list(dirs):
                if name.casefold() in SKIPPED_NAMES:
                    dirs.remove(name)
                elif (base/name).is_symlink():
                    dirs.remove(name)
                    symlinks.append((base/name).relative_to(AGENTS_DIR).as_posix())
            for name in names:
                if name.casefold() not in SKIPPED_NAMES:
                    add(base/name, (base/name).relative_to(AGENTS_DIR).as_posix())
    return files, sorted(symlinks)


def _safe_target(rel):
    """Where `rel` lands, refusing a path that leaves ~/.agents/ or passes
    through a symlink."""
    if not config_path(rel):
        raise ConfigError(f"Auth served a path outside ~/.agents/: {rel!r}")
    target = AGENTS_DIR/rel
    # The parents up to and including ~/.agents itself.
    for parent in list(target.parents)[:len(rel.split("/"))]:
        if parent.is_symlink():
            raise ConfigError(f"refusing to write through a symlink: {parent}")
    return target


def _request(method, path, body=None, expect=dict, origin=None):
    """The parsed answer of a session-authenticated request. Raises Rejected
    for a refused session, ConfigError for anything else. With `origin`, a
    login that moved to another Auth origin raises ConfigError."""
    args = ["request", method, path] + (["-"] if body is not None else [])
    stdin = json.dumps(body) if body is not None else None
    for attempt in range(3):
        rc, out = _auth(*args, stdin=stdin, timeout=300, origin=origin)
        if rc == 4:
            _set_login_marker(True)
            raise Rejected()
        if rc == 5 and origin:
            raise ConfigError("the session changed during the sync")
        try:
            value = json.loads(out) if out.strip() else None
        except ValueError:
            value = None
        if rc == 0 and isinstance(value, expect):
            return value
        if rc == 6 and isinstance(value, dict):
            if value.get("status") == 503 and attempt < 2:
                time.sleep(1 + attempt)
                continue
            raise HttpError(value)
        raise Unreachable("Auth is unreachable")
    raise Unreachable("Auth is unreachable")


class Unreachable(ConfigError):
    pass


class Rejected(ConfigError):
    def __init__(self):
        super().__init__("no session; run: auth login")


class HttpError(ConfigError):
    def __init__(self, value):
        self.status = value.get("status")
        self.retry_after = value.get("retry_after")
        super().__init__(str(value.get("error") or f"Auth answered {self.status}"))


def _listing():
    value = _request("GET", "/api/fleet/config")
    files = {}
    for entry in value.get("files") or []:
        rel = entry.get("path") if isinstance(entry, dict) else None
        if not isinstance(rel, str) or not config_path(rel):
            raise ConfigError(f"Auth listed a path outside ~/.agents/: {rel!r}")
        files[rel] = [entry.get("sha256"), bool(entry.get("executable"))]
    clashes = _collisions(files)
    if clashes:
        raise ConfigError("the account has paths that a case-insensitive disk would merge into "
                          "one file: " + "; ".join(clashes))
    counter, version = value.get("counter"), value.get("version")
    if not isinstance(counter, int) or not isinstance(version, int):
        raise ConfigError("Auth answered without a counter")
    return counter, version, files


def _collisions(paths):
    """Groups of spellings that are one file or folder on macOS's default
    disk: they differ only in letter case or Unicode normalization. Folders
    count too, since skills/Foo/a and skills/foo/b would share one."""
    groups = {}
    for rel in paths:
        parts = rel.split("/")
        for end in range(1, len(parts) + 1):
            prefix = "/".join(parts[:end])
            groups.setdefault(unicodedata.normalize("NFC", prefix).casefold(), set()).add(prefix)
    return sorted(", ".join(sorted(g)) for g in groups.values() if len(g) > 1)


def fetch_contents(paths, counter, server):
    """{path: bytes} for `paths`, all from the snapshot at `counter`."""
    contents, pending = {}, sorted(paths)
    while pending:
        value = _request("POST", "/api/fleet/config/fetch", {"paths": pending})
        if value.get("counter") != counter or value.get("missing"):
            raise Changed()
        for entry in value.get("files") or []:
            rel = entry.get("path")
            try:
                data = base64.b64decode(entry.get("content") or "", validate=True)
            except (ValueError, TypeError):
                raise ConfigError(f"Auth sent unreadable content for {rel!r}") from None
            if rel not in server or hashlib.sha256(data).hexdigest() != server[rel][0]:
                raise Changed()
            contents[rel] = data
        remaining = value.get("remaining") or []
        if len(remaining) >= len(pending):
            raise ConfigError("Auth returned no files for a fetch")
        pending = remaining
    return contents


class Backup:
    """One run's backup folder, made on first use."""

    def __init__(self):
        self.root = None

    def _dir(self):
        if self.root is None:
            stamp = datetime.datetime.now().strftime("%Y%m%d-%H%M%S")
            root = BACKUP_DIR/stamp
            n = 1
            while root.exists():
                n += 1
                root = BACKUP_DIR/f"{stamp}-{n}"
            # Server copies can hold credentials: owner-only.
            BACKUP_DIR.mkdir(parents=True, exist_ok=True)
            BACKUP_DIR.chmod(0o700)
            root.mkdir(mode=0o700)
            self.root = root
        return self.root

    def move(self, path, label):
        """Move `path` (file, folder, or link) under `label` in the backup."""
        destination = self._dir()/label
        # A folder replaced by a file can back up a descendant first; give the
        # folder its own name rather than moving it inside that copy.
        n = 1
        while os.path.lexists(destination):
            n += 1
            destination = self._dir()/f"{label}.{n}"
        destination.parent.mkdir(parents=True, exist_ok=True)
        # A rename or nothing: shutil.move's copy-then-delete can fail halfway
        # (a folder it may not empty), leaving the original gutted.
        try:
            os.rename(path, destination)
        except OSError as exc:
            if exc.errno != errno.EXDEV:
                raise
            shutil.move(str(path), str(destination))
        return destination

    def save(self, data, label):
        destination = self._dir()/label
        destination.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
        fd = os.open(destination, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
        with os.fdopen(fd, "wb") as handle:
            handle.write(data)


def _write_file(rel, data, executable):
    target = _safe_target(rel)
    target.parent.mkdir(parents=True, exist_ok=True)
    fd, temporary = tempfile.mkstemp(prefix=f".{target.name}.", dir=target.parent)
    try:
        with os.fdopen(fd, "wb") as handle:
            handle.write(data)
        # Account files can hold credentials: readable by the owner only.
        os.chmod(temporary, 0o700 if executable else 0o600)
        os.replace(temporary, target)
    except BaseException:
        pathlib.Path(temporary).unlink(missing_ok=True)
        raise


def _remove_file(rel):
    target = _safe_target(rel)
    target.unlink(missing_ok=True)
    for parent in target.parents:
        if parent == AGENTS_DIR or AGENTS_DIR not in parent.parents:
            break
        try:
            parent.rmdir()
        except OSError:
            break


def _load_json(path, default):
    try:
        value = json.loads(path.read_text())
    except (OSError, ValueError):
        return default
    return value if isinstance(value, type(default)) else default


def _save_json(path, value):
    path.parent.mkdir(parents=True, exist_ok=True)
    temporary = path.with_name(f".{path.name}.{os.getpid()}")
    temporary.write_text(json.dumps(value, indent=1, sort_keys=True) + "\n")
    os.replace(temporary, path)


def add_notice(text):
    """Something a run without a terminal did that the user should see."""
    if sys.stdin.isatty():
        return
    notices = _load_json(NOTICES, [])
    if text not in notices:
        # A notice that cannot be kept is still on stderr; the run goes on.
        try:
            _save_json(NOTICES, notices + [text])
        except OSError:
            pass


def _report(text):
    eprint(f"fleet: {text}")
    add_notice(text)


def _skill_folders(directory):
    """The real, non-dot folders holding a SKILL.md in a harness skill folder."""
    try:
        entries = sorted(directory.iterdir())
    except OSError:
        return []
    # The old agents module's .pre-agents.bak sidecars go back by name when
    # the links are refreshed; they are not skills of their own.
    return [e for e in entries if not e.name.startswith(".") and not e.is_symlink()
            and not e.name.endswith(".pre-agents.bak")
            and e.is_dir() and (e/"SKILL.md").is_file()]


def _same_tree(a, b):
    def tree(root):
        return {p.relative_to(root).as_posix(): p.read_bytes()
                for p in root.rglob("*") if p.is_file() and not p.is_symlink()}
    try:
        return tree(a) == tree(b)
    except OSError:
        return False


def _move_harness_skills(backup):
    """Move the user's own skill folders out of the harness folders, so
    harnesses don't load them next to ~/.agents/skills; list them. A failed
    move puts the ones already moved back. Returns (folder, saved) pairs, for
    a caller that has to undo the move later."""
    moved = []
    try:
        for directory in HARNESS_SKILL_DIRS:
            for folder in _skill_folders(directory):
                moved.append((folder, backup.move(folder, f"harness-skills/{directory.relative_to(HOME)}/{folder.name}")))
    except BaseException:
        for folder, saved in reversed(moved):
            if not os.path.lexists(folder):
                shutil.move(str(saved), str(folder))
        raise
    if moved:
        _report(f"moved skill folders to {backup.root}: " + ", ".join(str(f) for f, _ in moved))
    return moved


def _apply_changes(take, remove, contents, server, backup, then=None):
    """Replaced and deleted local copies, symlinks included, go to the backup.
    If a write fails, or `then` (run once all are written) does, the files
    already written go and the moved ones come back, so ~/.agents stays as it
    was."""
    moved, written = [], []
    try:
        for rel in sorted(remove) + sorted(take):
            target = _safe_target(rel)
            if target.is_symlink() or target.exists():
                moved.append((target, backup.move(target, f"agents/{rel}")))
        for rel in remove:
            _remove_file(rel)
        for rel in sorted(take):
            _write_file(rel, contents[rel], server[rel][1])
            written.append(rel)
        if then:
            then()
    except BaseException:
        for rel in written:
            _remove_file(rel)
        for target, saved in reversed(moved):
            if not os.path.lexists(target):
                target.parent.mkdir(parents=True, exist_ok=True)
                shutil.move(str(saved), str(target))
        raise


def _move_foreign(backup):
    moved = backup.move(AGENTS_DIR, "agents-other-account")
    _report(f"moved another account's ~/.agents to {backup.root}")
    return moved


def pull(account, settle_old=False):
    """Bring ~/.agents/ in step with the account. Returns ('synced', record,
    conflicts) or ('pending', None, []) when the account was never pushed.
    settle_old: the old agents module's payload here is not the account's, and
    goes once the account's copy is in hand."""
    for _ in range(3):
        counter, version, server = _listing()
        if _context() != account:
            raise ConfigError("the session changed during the sync")
        state = _load_json(CONFIG_STATE, {})
        record = state if state.get("account") == account else None
        backup = Backup()
        # Another account's files: they are not this account's to push. They
        # move aside only once this account's copy is in hand, so a failed
        # fetch leaves the old copy, and its links, working.
        other = bool(state) and record is None
        foreign = other and AGENTS_DIR.exists()
        old = settle_old and os.path.lexists(OLD_AGENTS_CLONE)
        # The old payload is not this account's either, and goes; with it in
        # the way the merge would read the account's files as already here.
        local = {} if foreign or old else scan_local()[0]
        if record is None and counter == 0:
            if old or foreign:
                _settle_pending(old, foreign, backup)
            if other:
                # Even with no tree to move, the other account's links go. Its
                # record stays until they have, so a retry finishes the job.
                refresh_links()
                CONFIG_STATE.unlink(missing_ok=True)
            ONBOARDING_MARKER.parent.mkdir(parents=True, exist_ok=True)
            ONBOARDING_MARKER.touch()
            return "pending", None, []
        conflicts = []
        if record is None or old:
            # Joining an account that was pushed, or taking it back over the
            # old payload: take its copy wholesale.
            take = [p for p in server if local.get(p) != server[p]]
            remove = [p for p in local if p not in server]
        else:
            base = record.get("files") or {}
            take, remove = [], []
            for rel in set(server) | set(local) | set(base):
                s, l, b = server.get(rel), local.get(rel), base.get(rel)
                if s == b or s == l:
                    continue
                if l != b:
                    conflicts.append(rel)
                (remove if s is None else take).append(rel)
        try:
            contents = fetch_contents(take, counter, server)
        except Changed:
            continue
        # A sign-in during the fetch: these files are the old account's.
        if _context() != account:
            raise ConfigError("the session changed during the sync")
        # The old payload moves aside, and its clone and links go only once
        # the account's copy is written, so a failed write leaves it working.
        displaced = _displace_old_payload(backup) if old else []
        try:
            moved = _move_foreign(backup) if foreign else None
        except BaseException:
            _restore_displaced(displaced, backup)
            raise
        harness = []
        new_record = {"account": account, "counter": counter, "version": version, "files": server}
        def finish():
            if record is None:
                harness.extend(_move_harness_skills(backup))
            # The changes are done only once their record is saved.
            _save_json(CONFIG_STATE, new_record)
        try:
            _apply_changes(take, remove, contents, server, backup, then=finish)
        except BaseException:
            for folder, saved in reversed(harness):
                if not os.path.lexists(folder):
                    shutil.move(str(saved), str(folder))
            # The other account's copy, which its record and links still
            # name, comes back until this account's is fully in place.
            if moved:
                if AGENTS_DIR.exists() or AGENTS_DIR.is_symlink():
                    backup.move(AGENTS_DIR, "agents-incomplete")
                shutil.move(str(moved), str(AGENTS_DIR))
                _report("put the other account's ~/.agents back, since this account's copy "
                        "could not be put in place")
            _restore_displaced(displaced, backup)
            raise
        if old:
            if displaced:
                _report_displaced(backup)
            # The account's copy is in place: a clone that cannot all go
            # still leaves its links made, and the next sync drops the rest.
            try:
                _drop_old_clone(operator=False, backup=backup)
            except BaseException:
                refresh_links()
                raise
        if conflicts:
            _report(f"changed here and in the account, kept the account's copy (yours are in "
                    f"{backup.root}): " + ", ".join(sorted(conflicts)))
        ONBOARDING_MARKER.unlink(missing_ok=True)
        return "synced", new_record, sorted(conflicts)
    raise ConfigError("the account kept changing during the sync; try again")


def _check_json_objects(payloads):
    for rel, data in payloads.items():
        if rel == "mcp.json" or (rel.startswith("settings/") and rel.endswith(".json")):
            try:
                value = json.loads(data)
            except ValueError:
                value = None
            if not isinstance(value, dict):
                raise ConfigError(f"{rel} is not a JSON object; fix it before uploading")
            problem = check_tier_shape(rel, value)
            if problem:
                raise ConfigError(f"{rel}: {problem}; fix it before uploading")


def push(record, local, puts, deletes):
    """Upload the given local changes against `record`; the new record."""
    # Each file is read once, so what is checked, sent, and recorded as sent
    # is the same version even while an editor saves over it.
    payloads = {rel: (AGENTS_DIR/rel).read_bytes() for rel in sorted(puts)}
    _check_json_objects(payloads)
    clashes = _collisions(set(record.get("files") or {}) - set(deletes) | set(puts))
    if clashes:
        raise ConfigError("not pushing paths a case-insensitive disk would merge into one file; "
                          "rename one of each: " + "; ".join(clashes))
    # Two accounts can share a counter, so the push is pinned to the account
    # this machine pulled, not one signed in to since: the auth CLI refuses a
    # login from another origin, and Auth refuses another subject.
    origin, subject = record["account"].split(" ", 1)
    body = {"base": record["counter"], "subject": subject,
            "put": [{"path": rel, "content": base64.b64encode(data).decode(),
                     "executable": local[rel][1]} for rel, data in payloads.items()],
            "delete": sorted(deletes)}
    try:
        value = _request("POST", "/api/fleet/config/push", body, origin=origin)
    except HttpError as exc:
        if exc.status == 409 and str(exc) == "account changed":
            raise ConfigError("the session changed during the sync") from None
        raise
    files = dict(record.get("files") or {})
    for rel, data in payloads.items():
        files[rel] = [hashlib.sha256(data).hexdigest(), local[rel][1]]
    for rel in deletes:
        files.pop(rel, None)
    return {**record, "counter": value["counter"], "version": value["version"], "files": files}


def upload(account, record):
    """Push the local changes; on a stale base pull again and retry."""
    for _ in range(3):
        local, symlinks = scan_local()
        base = record.get("files") or {}
        puts = [p for p in local if local[p] != base.get(p)]
        # A path replaced by a symlink (or under one) is skipped, not deleted.
        deletes = [p for p in base if p not in local
                   and not any(p == s or p.startswith(s + "/") for s in symlinks)]
        if symlinks:
            eprint("fleet: symlinks are not uploaded: " + ", ".join(symlinks))
        if not puts and not deletes:
            return record, 0
        # Keep the server copies this upload overwrites or deletes.
        try:
            replaced = fetch_contents([p for p in puts + deletes if p in base], record["counter"], base)
        except Changed:
            replaced = None
        if replaced is not None:
            backup = Backup()
            for rel, data in replaced.items():
                backup.save(data, f"account/{rel}")
            try:
                new = push(record, local, puts, deletes)
            except HttpError as exc:
                if exc.status == 429:
                    wait = int(exc.retry_after or 0)
                    raise ConfigError("this account pushed too often; uploads resume in "
                                      f"{max(1, (wait + 59) // 60)} min") from None
                if exc.status != 409:
                    raise ConfigError(f"upload refused: {exc}") from None
            else:
                _save_json(CONFIG_STATE, new)
                print(f"fleet: uploaded {len(puts)} changed, {len(deletes)} deleted")
                return new, len(puts) + len(deletes)
        outcome, record, conflicts = pull(account)
        refresh_links()
        if conflicts:
            raise ConfigError("not uploading over files changed in the account; see above")
    raise ConfigError("the account kept changing during the upload; try again")


# --- links ---------------------------------------------------------------

def _old_backup(target):
    """Where the old agents module set aside what its link replaced."""
    return target.with_name(target.name + ".pre-agents.bak")


def _restore_old_backup(target):
    """Put back what the old agents module set aside for a link fleet drops."""
    old = _old_backup(target)
    if os.path.lexists(old) and not os.path.lexists(target):
        shutil.move(old, target)


def _link(target, source, links, backup):
    """Point `target` at `source`; anything it displaces goes to the backup.
    A sidecar the old agents module left is taken over, so unlinking later
    puts it back."""
    if str(target) not in links and os.path.lexists(_old_backup(target)):
        links[str(target)] = str(_old_backup(target))
    if target.is_symlink() and os.readlink(target) == str(source):
        return
    if target.is_symlink() or target.exists():
        moved = backup.move(target, f"displaced/{target.relative_to(HOME)}")
        links[str(target)] = str(moved)
    target.parent.mkdir(parents=True, exist_ok=True)
    target.symlink_to(source)


def _unlink_restoring(target, links):
    """Drop a link into ~/.agents and put back the file it displaced, also
    when the link itself is already gone."""
    if _points_into(target, AGENTS_DIR):
        target.unlink()
    elif os.path.lexists(target):
        return
    # The mapping goes only once the file is back, so a failed move leaves
    # the next run to find it.
    moved = links.get(str(target))
    if moved and os.path.lexists(moved):
        target.parent.mkdir(parents=True, exist_ok=True)
        shutil.move(moved, target)
        del links[str(target)]
    else:
        links.pop(str(target), None)
        _restore_old_backup(target)


def _skill_link_targets(links):
    """Entries in claude's skill folder plus recorded ones since removed. A
    sidecar the old agents module left stands for its link, deleted or not."""
    found = set(SKILL_LINK_DIR.iterdir()) if SKILL_LINK_DIR.is_dir() else set()
    found = {e.with_name(e.name[:-len(".pre-agents.bak")]) if e.name.endswith(".pre-agents.bak") else e
             for e in found}
    found |= {pathlib.Path(k) for k in links if pathlib.Path(k).parent == SKILL_LINK_DIR}
    return sorted(found)


def _points_into(path, root):
    try:
        return path.is_symlink() and pathlib.Path(os.readlink(path)).is_relative_to(root)
    except OSError:
        return False


_lock_depth = 0


@contextlib.contextmanager
def _config_locked():
    """One run at a time on ~/.agents, the links and their records: the
    nightly run and a manual sync would each save over what the other did."""
    global _lock_depth
    if _lock_depth == 0:
        CONFIG_LOCK.parent.mkdir(parents=True, exist_ok=True)
        fd = os.open(CONFIG_LOCK, os.O_RDWR | os.O_CREAT, 0o600)
        fcntl.flock(fd, fcntl.LOCK_EX)
    _lock_depth += 1
    try:
        yield
    finally:
        _lock_depth -= 1
        if _lock_depth == 0:
            os.close(fd)


@_config_locked()
def refresh_links():
    """AGENTS.md where each harness reads it, and each skill in claude's
    folder, adding new skills and pruning removed ones."""
    links = _load_json(LINKS_STATE, {})
    before = dict(links)
    backup = Backup()
    # Saved however far this gets: a retry finds what it already displaced
    # linked and would not record it again.
    try:
        agents_md = AGENTS_DIR/"AGENTS.md"
        if agents_md.is_file():
            for target in AGENTS_LINKS:
                if target == HOME/"AGENTS.md" or target.parent.is_dir():
                    _link(target, agents_md, links, backup)
        else:
            for target in AGENTS_LINKS:
                _unlink_restoring(target, links)
        skills = AGENTS_DIR/"skills"
        names = {e.name for e in _skill_entries(skills)}
        if SKILL_LINK_DIR.parent.is_dir():
            for name in sorted(names):
                _link(SKILL_LINK_DIR/name, skills/name, links, backup)
            for entry in _skill_link_targets(links):
                if entry.name not in names:
                    _unlink_restoring(entry, links)
        _drop_old_links()
    finally:
        try:
            _save_json(LINKS_STATE, links)
        except OSError:
            # Unrecorded, what this run displaced could never come back: put
            # it back now.
            for target, moved in links.items():
                target = pathlib.Path(target)
                if before.get(str(target)) != moved and backup.root and pathlib.Path(moved).is_relative_to(backup.root) \
                        and _points_into(target, AGENTS_DIR) and os.path.lexists(moved):
                    target.unlink()
                    shutil.move(moved, target)
            raise
    if backup.root:
        _report(f"moved files the links replaced to {backup.root}")


def _drop_old_links():
    """The old agents module's links go, and what they replaced comes back,
    also when the link was already deleted: fleet is the only one left to
    return it."""
    skills = AGENTS_DIR/"skills"
    for target in OLD_AGENTS_LINKS:
        if _points_into(target, AGENTS_DIR):
            target.unlink()
        _restore_old_backup(target)
    for directory in OLD_SKILL_LINK_DIRS:
        if directory.is_dir():
            for entry in list(directory.iterdir()):
                if _points_into(entry, skills):
                    entry.unlink()
                    _restore_old_backup(entry)
                elif entry.name.endswith(".pre-agents.bak"):
                    _restore_old_backup(entry.with_name(entry.name[:-len(".pre-agents.bak")]))


def _skill_entries(skills):
    try:
        return [e for e in sorted(skills.iterdir()) if e.is_dir() and not e.name.startswith(".")]
    except OSError:
        return []


@_config_locked()
def remove_links():
    """Undo refresh_links: drop the links into ~/.agents and put back what
    they displaced."""
    links = _load_json(LINKS_STATE, {})
    for path in list(AGENTS_LINKS) + _skill_link_targets(links):
        _unlink_restoring(path, links)
    # Also the old agents module's, which a sync may not have taken over yet.
    _drop_old_links()
    LINKS_STATE.unlink(missing_ok=True)


def settle_old_agents(operator):
    """Remove the old agents module's clone, once. On a machine of another
    account its links go too and what they displaced comes back; the
    operator's AGENTS.md and skills it copied move to the backup, since other
    tools may have added skills there."""
    if not os.path.lexists(OLD_AGENTS_CLONE):
        return
    if operator:
        _drop_old_clone(operator)
        return
    # A clone that cannot be dropped puts the payload back, so a retry
    # still finds it where the next attempt expects.
    backup = Backup()
    displaced = _displace_old_payload(backup)
    try:
        _drop_old_clone(operator, backup)
    except BaseException:
        _restore_displaced(displaced, backup)
        raise
    if displaced:
        _report_displaced(backup)


def _settle_pending(old, foreign, backup):
    """For an account never pushed: the old payload and another account's
    tree both move aside, or neither does."""
    displaced = _displace_old_payload(backup) if old else []
    moved = None
    try:
        if foreign:
            moved = _move_foreign(backup)
        if old:
            _drop_old_clone(operator=False, backup=backup)
    except BaseException:
        if moved:
            shutil.move(str(moved), str(AGENTS_DIR))
        _restore_displaced(displaced, backup)
        raise
    if displaced:
        _report_displaced(backup)


def _displace_old_payload(backup):
    """Move the operator's AGENTS.md and skills the old module left to the
    backup; the (path, saved) pairs, so a failed sync can put them back."""
    moved = []
    try:
        for path in (AGENTS_DIR/"AGENTS.md", AGENTS_DIR/"skills"):
            if os.path.lexists(path):
                moved.append((path, backup.move(path, f"displaced/{path.relative_to(HOME)}")))
    except BaseException:
        _restore_displaced(moved, backup)
        raise
    return moved


def _restore_displaced(displaced, backup):
    """Put the old payload back after a failed sync, moving aside what the
    sync left in its place."""
    for path, saved in reversed(displaced):
        if os.path.lexists(path):
            backup.move(path, f"incomplete/{path.relative_to(HOME)}")
        shutil.move(str(saved), str(path))


def _report_displaced(backup):
    _report(f"moved the operator's AGENTS.md and skills the old agents module left to {backup.root}")


def _drop_old_clone(operator, backup=None):
    if operator:
        if OLD_AGENTS_CLONE.is_dir() and not OLD_AGENTS_CLONE.is_symlink():
            shutil.rmtree(OLD_AGENTS_CLONE)
        else:
            OLD_AGENTS_CLONE.unlink()
        return
    # The clone goes first, by a rename that cannot stop halfway, and comes
    # back if the links cannot go: a clone still here is what a retry finds.
    saved = backup.move(OLD_AGENTS_CLONE, "agents-src")
    try:
        for target in AGENTS_LINKS + OLD_AGENTS_LINKS:
            if _points_into(target, AGENTS_DIR):
                target.unlink()
            _restore_old_backup(target)
        for directory in [SKILL_LINK_DIR, *OLD_SKILL_LINK_DIRS]:
            for entry in (list(directory.iterdir()) if directory.is_dir() else []):
                if _points_into(entry, AGENTS_DIR):
                    entry.unlink()
                    _restore_old_backup(entry)
                elif entry.name.endswith(".pre-agents.bak"):
                    # Its link already deleted: the sidecar still comes back.
                    _restore_old_backup(entry.with_name(entry.name[:-len(".pre-agents.bak")]))
    except BaseException:
        shutil.move(str(saved), str(OLD_AGENTS_CLONE))
        raise


def not_the_operators():
    """Whether this machine, with no session, is known not to be the
    operator's: GitHub answered and lists none of its keys. Asked once."""
    if "value" not in OWNER_CHECK:
        try:
            OWNER_CHECK["value"] = not set(_local_keys()) & set(fetch_owner_keys())
        except Unavailable:
            OWNER_CHECK["value"] = False
    return OWNER_CHECK["value"]


# --- onboarding ----------------------------------------------------------

def onboard(account):
    """Push this machine's agent config as the account's starting copy,
    gathering AGENTS.md and skills from the harness folders first."""
    backup = Backup()
    listed = []
    agents_md = AGENTS_DIR/"AGENTS.md"
    sources = []
    for path in HARNESS_INSTRUCTIONS:
        try:
            if path.is_file() and not _points_into(path, AGENTS_DIR):
                sources.append((path, path.read_bytes()))
        except OSError:
            pass
    # What this run copies into ~/.agents comes out again if staging or the
    # upload fails, so a retry gathers the harness files afresh.
    staged = []
    try:
        if not agents_md.exists() and sources:
            agents_md.parent.mkdir(parents=True, exist_ok=True)
            # The copy keeps the source's permissions: an owner-only CLAUDE.md
            # stays owner-only.
            source, data = sources[0]
            fd = os.open(agents_md, os.O_WRONLY | os.O_CREAT | os.O_EXCL,
                         stat.S_IMODE(source.stat().st_mode) & 0o666)
            staged.append(agents_md)
            with os.fdopen(fd, "wb") as handle:
                handle.write(data)
        if agents_md.is_file():
            listed += [str(path) for path, data in sources if data != agents_md.read_bytes()]
        skills = AGENTS_DIR/"skills"
        for directory in HARNESS_SKILL_DIRS:
            for folder in _skill_folders(directory):
                mine = skills/folder.name
                # lexists: a dangling link there is the user's, not staged.
                if os.path.lexists(mine):
                    if not _same_tree(folder, mine):
                        listed.append(str(folder))
                else:
                    # Listed first: a copy that fails partway comes out too.
                    staged.append(mine)
                    shutil.copytree(folder, mine, symlinks=True)
        if listed:
            _report("these differ from what was uploaded and were left out: " + ", ".join(listed))
        local, symlinks = scan_local()
        if symlinks:
            eprint("fleet: symlinks are not uploaded: " + ", ".join(symlinks))
        record = {"account": account, "counter": 0, "version": 0, "files": {}}
        record = push(record, local, list(local), [])
    except BaseException as exc:
        for path in staged:
            if path.is_dir() and not path.is_symlink():
                shutil.rmtree(path)
            else:
                path.unlink(missing_ok=True)
        if isinstance(exc, HttpError):
            if exc.status == 409:
                raise ConfigError("another machine set up this account first; run: fleet sync") from None
            raise ConfigError(f"upload refused: {exc}") from None
        raise
    print(f"fleet: uploaded this machine's agent config ({len(local)} files) as the account's copy")
    # Only now: a refused upload leaves the harness skill folders in use. And
    # before the record: a failed move leaves the next sync to join the
    # account, which moves them again.
    _move_harness_skills(backup)
    _save_json(CONFIG_STATE, record)
    ONBOARDING_MARKER.unlink(missing_ok=True)
    refresh_links()


def _offer_onboarding(account):
    if os.environ.get("BATCH") == "1" or not (sys.stdin.isatty() and sys.stdout.isatty()):
        print("fleet: this account has no agent config yet; to upload this machine's, run: fleet onboard")
        return 0
    answer = input("fleet: this account has no agent config yet. Upload this machine's ~/.agents, "
                   "AGENTS.md, and skills as its starting copy? [y/N] ")
    if answer.strip().lower() not in ("y", "yes"):
        print("fleet: not now; run fleet onboard when ready")
        return 0
    onboard(account)
    return 0


@_config_locked()
def config_sync(direct):
    """Pull, and on a direct run upload. 0 done, 1 conflicts or a refused
    upload, 3 no answer from Auth."""
    if not config_sync_enabled():
        return 0
    if AGENTS_DIR.is_symlink():
        eprint(f"fleet: account config: refusing a symlinked {AGENTS_DIR}")
        return 1
    state, account = _session()
    try:
        if account is None:
            if state == "out" and os.path.lexists(OLD_AGENTS_CLONE) and not_the_operators():
                settle_old_agents(operator=False)
            return 3
        operator = account.split(" ", 1)[1] == OPERATOR_SUBJECT
        if operator:
            settle_old_agents(operator=True)
    except (Rejected, Unreachable) as exc:
        eprint(f"fleet: account config: {exc}")
        return 3
    except ConfigError as exc:
        eprint(f"fleet: account config: {exc}")
        return 1
    except OSError as exc:
        eprint(f"fleet: account config: settling the old agents module: {exc}")
        return 1
    try:
        # Another account's machine keeps the old payload in use until the
        # account's copy is fetched.
        outcome, record, conflicts = pull(account, settle_old=not operator)
        PULL["outcome"] = outcome
        if outcome == "pending":
            return _offer_onboarding(account)
        refresh_links()
        if direct:
            record, _ = upload(account, record)
    except (Rejected, Unreachable) as exc:
        eprint(f"fleet: account config: {exc}")
        return 3
    except (ConfigError, OSError) as exc:
        eprint(f"fleet: account config: {exc}")
        return 1
    return 1 if conflicts else 0


def config_outdated():
    """Whether a pull would change something (for setup's status)."""
    if not config_sync_enabled():
        return False
    account = _context()
    if account is None:
        return False
    try:
        counter, version, _ = _listing()
    except ConfigError:
        return False
    record = _load_json(CONFIG_STATE, {})
    if record.get("account") != account:
        # Another account's config here is outdated even when this account
        # has none: the pull moves it aside.
        return counter > 0 or bool(record)
    return record.get("version") != version


def config_status():
    if not config_sync_enabled():
        print("fleet: account config waits until setup swaps out the old agents and harnesses modules")
        return
    account = _context()
    if account is None:
        return
    try:
        counter, version, server = _listing()
    except ConfigError as exc:
        print(f"fleet: account config: {exc}")
        return
    record = _load_json(CONFIG_STATE, {})
    local, symlinks = scan_local()
    if record.get("account") != account:
        print("fleet: account config not set up yet; run: fleet onboard" if counter == 0
              else "fleet: account config not pulled yet; run: fleet sync")
    else:
        base = record.get("files") or {}
        changed = sorted(p for p in set(local) | set(base) if local.get(p) != base.get(p)
                         and not any(p == s or p.startswith(s + "/") for s in symlinks))
        print("fleet: account config " + ("current" if record.get("version") == version
                                          else "changed in the account; run: fleet sync"))
        if changed:
            print(f"fleet: {len(changed)} local changes wait for a direct fleet sync: "
                  + ", ".join(changed[:10]) + (" ..." if len(changed) > 10 else ""))
    if symlinks:
        print("fleet: symlinks are not uploaded: " + ", ".join(symlinks))
    for notice in _load_json(NOTICES, []):
        print(f"fleet: since the last status: {notice}")
    NOTICES.unlink(missing_ok=True)


