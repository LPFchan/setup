#!/usr/bin/env python3
# setup-module: auth
# setup-source: files/auth
"""auth — one Common Auth login and credential store for setup modules."""

from __future__ import annotations

import contextlib
import fcntl
import json
import os
import pathlib
import socket
import subprocess
import sys
import tempfile
import time
import urllib.error
import urllib.parse
import urllib.request
import webbrowser

ORIGIN = os.environ.get("LOST_AUTH_ORIGIN", "https://auth.lost.plus").rstrip("/")
STORE = pathlib.Path(os.path.expanduser(os.environ.get(
    "LOST_AUTH_STORE", "~/.local/share/lost-plus/auth.json"
)))
LOCK = STORE.with_name(STORE.name + ".lock")
DEVICE_NAME = socket.gethostname()
SSH_KEY = pathlib.Path(os.path.expanduser(os.environ.get("LOST_AUTH_SSH_KEY", "~/.ssh/id_ed25519")))
TAILSCALE_APP = "/Applications/Tailscale.app/Contents/MacOS/Tailscale"


class AuthError(RuntimeError):
    def __init__(self, message, status=None, transient=False, exit_code=1, retry_after=None):
        super().__init__(message)
        self.status = status
        self.transient = transient
        self.exit_code = exit_code
        self.retry_after = retry_after


def _request(path, *, form=None, json_body=None, token=None, session=None, method=None, timeout=15):
    data = None
    headers = {"Accept": "application/json", "User-Agent": "setup-auth/1.0"}
    if session:
        headers["X-Setup-Session"] = session
    if form is not None:
        data = urllib.parse.urlencode(form).encode()
        headers["Content-Type"] = "application/x-www-form-urlencoded"
        headers["Origin"] = ORIGIN
    if json_body is not None:
        data = json.dumps(json_body).encode()
        headers["Content-Type"] = "application/json"
        headers["Origin"] = ORIGIN
    if token:
        headers["Authorization"] = f"Bearer {token}"
    request = urllib.request.Request(ORIGIN + path, data=data, headers=headers, method=method)
    try:
        with urllib.request.urlopen(request, timeout=timeout) as response:
            return json.loads(response.read())
    except urllib.error.HTTPError as exc:
        try:
            detail = json.loads(exc.read()).get("error")
        except Exception:
            detail = None
        try:
            retry_after = int(exc.headers.get("Retry-After", ""))
        except (TypeError, ValueError):
            retry_after = None
        raise AuthError(
            detail or f"Auth returned HTTP {exc.code}",
            exc.code,
            transient=exc.code >= 500,
            retry_after=retry_after,
        ) from exc
    except json.JSONDecodeError as exc:
        raise AuthError(f"Auth returned invalid JSON: {exc}") from exc
    except OSError as exc:
        raise AuthError(f"cannot reach {ORIGIN}: {exc}", transient=True) from exc


def _output(command):
    try:
        result = subprocess.run(command, capture_output=True, text=True, timeout=10)
    except (OSError, ValueError, subprocess.SubprocessError):
        return None
    return result.stdout.strip() if result.returncode == 0 else None


def _machine_key():
    """The machine's public key, generated the first time it is needed. Any
    failure reports no key rather than failing the login or refresh."""
    try:
        return _read_machine_key()
    except (OSError, ValueError):
        return ""


def _read_machine_key():
    public = SSH_KEY.with_name(SSH_KEY.name + ".pub")
    if not SSH_KEY.exists():
        SSH_KEY.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
        if _output(["ssh-keygen", "-q", "-t", "ed25519", "-N", "", "-f", str(SSH_KEY)]) is None:
            return ""
    if not public.exists():
        # Only the private half is left: derive the public one from it. A
        # passphrase-protected key fails here rather than prompting.
        derived = _output(["ssh-keygen", "-y", "-P", "", "-f", str(SSH_KEY)])
        if not derived:
            return ""
        try:
            public.write_text(derived + "\n")
        except OSError:
            return " ".join(derived.split()[:2])
    try:
        return " ".join(public.read_text().split()[:2])
    except OSError:
        return ""


def _short_hostname():
    # On macOS `hostname -s` follows the router's DNS, so ask the system.
    if sys.platform == "darwin":
        name = _output(["scutil", "--get", "HostName"]) or _output(["scutil", "--get", "LocalHostName"])
        if name:
            return name.split(".")[0]
    return socket.gethostname().split(".")[0]


def _tailnet_name():
    # App Store installs leave the Tailscale CLI off PATH.
    for binary in ("tailscale", TAILSCALE_APP):
        raw = _output([binary, "status", "--json"])
        if not raw:
            continue
        try:
            name = (json.loads(raw).get("Self") or {}).get("DNSName") or ""
        except (json.JSONDecodeError, AttributeError):
            continue
        if name:
            return name.rstrip(".")
    return ""


def _machine_report():
    """What this machine tells Auth about itself at login and on refresh, for
    the Fleet tab (DEC-20261015-001). A field that cannot be read is left
    empty; Auth drops anything that fails its own checks."""
    return {
        "key": _machine_key(),
        "hostname": _short_hostname(),
        "tailnet": _tailnet_name(),
        "user": os.environ.get("USER", ""),
        "needs_term": _output(["infocmp", "tmux-256color"]) is None,
    }


def _load():
    try:
        data = json.loads(STORE.read_text())
    except FileNotFoundError:
        return None
    except (OSError, json.JSONDecodeError) as exc:
        raise AuthError(f"cannot read {STORE}: {exc}") from exc
    if not isinstance(data, dict) or data.get("version") not in (1, 2):
        raise AuthError(f"unsupported credential store at {STORE}")
    if data.get("mode") not in ("global", "per-service") or not isinstance(data.get("tokens"), dict):
        raise AuthError(f"invalid credential store at {STORE}")
    return data


def _validate_bundle(bundle):
    subject = bundle.get("subject")
    mode = bundle.get("mode")
    tokens = bundle.get("tokens")
    active_scopes = bundle.get("active_scopes")
    unavailable_scopes = bundle.get("unavailable_scopes", [])
    if not isinstance(subject, str) or not subject:
        raise AuthError("Auth returned an invalid account identity")
    if mode not in ("global", "per-service"):
        raise AuthError("Auth returned an invalid credential mode")
    if not isinstance(tokens, dict) or not all(
        isinstance(scope, str) and isinstance(secret, str) and secret
        for scope, secret in tokens.items()
    ):
        raise AuthError("Auth returned an invalid credential bundle")
    if not isinstance(active_scopes, list) or not all(
        isinstance(scope, str) and scope for scope in active_scopes
    ):
        raise AuthError("Auth returned an invalid active-scope list")
    if not isinstance(unavailable_scopes, list) or not all(
        isinstance(scope, str) and scope for scope in unavailable_scopes
    ):
        raise AuthError("Auth returned an invalid unavailable-scope list")
    if len(active_scopes) != len(set(active_scopes)) or len(unavailable_scopes) != len(set(unavailable_scopes)):
        raise AuthError("Auth returned duplicate credential scopes")
    if not set(tokens).issubset(active_scopes):
        raise AuthError("Auth returned a credential outside its active scopes")
    if not set(unavailable_scopes).issubset(active_scopes):
        raise AuthError("Auth returned an unavailable credential outside its active scopes")
    return subject, mode, tokens, active_scopes, unavailable_scopes


def _updated_store(current, bundle, session=None):
    subject, mode, tokens, active_scopes, unavailable_scopes = _validate_bundle(bundle)
    same_account = (
        isinstance(current, dict)
        and current.get("version") == 2
        and current.get("origin") == ORIGIN
        and current.get("account_sub") == subject
    )
    previous = current.get("tokens", {}) if same_account else {}
    merged = {
        scope: previous[scope]
        for scope in active_scopes
        if scope in unavailable_scopes and isinstance(previous.get(scope), str)
    }
    merged.update(tokens)
    renewing = session is None
    if renewing:
        session = current.get("session") if isinstance(current, dict) else None
    if not isinstance(session, dict):
        raise AuthError("Auth did not return a renewable device session")
    session = dict(session)
    refresh_token = session.get("refresh_token")
    if not isinstance(refresh_token, str) or not refresh_token:
        raise AuthError("Auth returned an invalid device session")
    renewed_expiry = bundle.get("session_expires_at")
    if renewed_expiry is not None:
        if isinstance(renewed_expiry, bool) or not isinstance(renewed_expiry, int):
            raise AuthError("Auth returned an invalid device-session expiry")
        session["expires_at"] = renewed_expiry
    expiry = session.get("expires_at")
    if isinstance(expiry, bool) or not isinstance(expiry, int) or expiry <= 0:
        raise AuthError("Auth returned an invalid device-session expiry")
    if renewing and renewed_expiry is None:
        raise AuthError("Auth did not renew the device-session expiry")
    return {
        "version": 2,
        "origin": ORIGIN,
        "account_sub": subject,
        "session": session,
        "session_state": "active",
        "mode": mode,
        "tokens": merged,
        "active_scopes": active_scopes,
        "unavailable_scopes": unavailable_scopes,
        "updated_at": int(time.time()),
    }


def _invalidate(data):
    invalid = dict(data)
    invalid["session_state"] = "invalid"
    invalid["tokens"] = {}
    invalid["active_scopes"] = []
    invalid["unavailable_scopes"] = []
    invalid["invalidated_at"] = int(time.time())
    _save(invalid)


def _refresh(data):
    if data.get("version") != 2:
        raise AuthError("saved login cannot refresh; run: auth login")
    saved_origin = data.get("origin")
    if saved_origin != ORIGIN:
        raise AuthError(
            f"saved login belongs to {saved_origin or 'an unknown Auth origin'}; "
            "restore LOST_AUTH_ORIGIN or run: auth login"
        )
    if data.get("session_state") == "invalid":
        raise AuthError(
            "setup session is invalid, expired, or revoked; run: auth login",
            401,
            exit_code=4,
        )
    session = data.get("session")
    if not isinstance(session, dict):
        raise AuthError("saved device session is invalid; run: auth login")
    refresh_token = session.get("refresh_token")
    if not isinstance(refresh_token, str) or not refresh_token:
        raise AuthError("saved device session is invalid; run: auth login")
    expires_at = session.get("expires_at")
    if isinstance(expires_at, bool) or not isinstance(expires_at, int):
        raise AuthError("saved device session has no valid expiry; run: auth login")
    if expires_at <= int(time.time()):
        _invalidate(data)
        raise AuthError(
            "setup session has expired; run: auth login", 401, exit_code=4
        )
    try:
        bundle = _request(
            "/api/device/session/token",
            json_body={
                "refresh_token": refresh_token,
                "device_name": DEVICE_NAME,
                "machine": _machine_report(),
            },
        )
    except AuthError as exc:
        if exc.status in (401, 403):
            _invalidate(data)
            raise AuthError(str(exc), exc.status, exit_code=4) from exc
        raise
    updated = _updated_store(data, bundle)
    if data.get("account_sub") != updated.get("account_sub"):
        raise AuthError("Auth returned a different account for this setup session")
    _save(updated)
    return updated


def _save(data):
    STORE.parent.mkdir(parents=True, exist_ok=True)
    fd, temporary = tempfile.mkstemp(prefix=".auth.", dir=STORE.parent)
    try:
        with os.fdopen(fd, "w") as handle:
            json.dump(data, handle, indent=2)
            handle.write("\n")
            handle.flush()
            os.fsync(handle.fileno())
        os.chmod(temporary, 0o600)
        os.replace(temporary, STORE)
    finally:
        try:
            os.unlink(temporary)
        except FileNotFoundError:
            pass


@contextlib.contextmanager
def _store_lock():
    LOCK.parent.mkdir(parents=True, exist_ok=True)
    fd = os.open(LOCK, os.O_CREAT | os.O_RDWR, 0o600)
    os.chmod(LOCK, 0o600)
    with os.fdopen(fd, "r+") as handle:
        fcntl.flock(handle, fcntl.LOCK_EX)
        yield


def _open_browser(uri):
    if webbrowser.open(uri):
        return
    for command in (("xdg-open", uri), ("open", uri)):
        try:
            if subprocess.run(command, stdout=subprocess.DEVNULL,
                              stderr=subprocess.DEVNULL).returncode == 0:
                return
        except FileNotFoundError:
            pass


def _previous_session():
    """The session this CLI held before, which Auth ends once the new login
    is approved, so the old key leaves the fleet."""
    try:
        data = _load()
    except AuthError:
        return ""
    if not isinstance(data, dict) or data.get("origin") != ORIGIN:
        return ""
    session = data.get("session")
    token = session.get("refresh_token") if isinstance(session, dict) else None
    return token if isinstance(token, str) else ""


def cmd_login():
    device = _request(
        "/api/device",
        form={
            "client": "setup-auth",
            "device_name": DEVICE_NAME,
            "machine": json.dumps(_machine_report(), separators=(",", ":")),
        },
    )
    device_code = device.get("device_code")
    user_code = device.get("user_code")
    uri = device.get("verification_uri_complete") or device.get("verification_uri")
    if not all(isinstance(value, str) and value for value in (device_code, user_code, uri)):
        raise AuthError("Auth returned an invalid device authorization response")
    print("Waiting for approval… Open :")
    print(uri)
    _open_browser(uri)
    previous = _previous_session()
    deadline = time.monotonic() + int(device.get("expires_in", 600))
    interval = max(int(device.get("interval", 5)), 1)
    bundle = None
    while time.monotonic() < deadline:
        time.sleep(interval)
        try:
            response = _request(
                "/api/device/token",
                form={"device_code": device_code, "previous_session": previous},
            )
        except AuthError as exc:
            if str(exc) == "authorization_pending":
                continue
            if str(exc) == "slow_down":
                interval += 5
                continue
            raise
        if response.get("mode") in ("global", "per-service"):
            bundle = response
            break
    if bundle is None:
        raise AuthError("authorization expired before it was approved")
    session = bundle.get("session")
    with _store_lock():
        saved = _updated_store(_load(), bundle, session)
        _save(saved)
    print(f"Saved renewable {saved['mode']} credentials to {STORE}")


def _refresh_or_cached(data):
    try:
        return _refresh(data), None
    except AuthError as exc:
        if not exc.transient:
            raise
        return data, exc


def cmd_token(scope, expected_context=None):
    with _store_lock():
        data = _load()
        if data is None:
            raise AuthError("not logged in; run: auth login")
        if expected_context is not None:
            actual_context = {
                "origin": data.get("origin"),
                "subject": data.get("account_sub"),
            }
            if actual_context != expected_context:
                raise AuthError("setup login changed during credential sync", exit_code=5)
        if data.get("version") == 1:
            print("auth: saved login cannot refresh; run: auth login", file=sys.stderr)
            refreshed = data
        else:
            refreshed, refresh_error = _refresh_or_cached(data)
            if refresh_error is not None:
                print(f"auth: refresh unavailable; using cached credential: {refresh_error}", file=sys.stderr)
        key = "*" if refreshed["mode"] == "global" else scope
        token = refreshed["tokens"].get(key)
    if not isinstance(token, str) or not token:
        if key in refreshed.get("unavailable_scopes", []):
            raise AuthError(
                f"active credential for {scope} cannot currently be retrieved from Auth"
            )
        raise AuthError(
            f"no active credential for {scope}",
            exit_code=3 if refreshed.get("version") == 2 else 1,
        )
    print(token)


def cmd_token_cached(scope):
    """The saved token, with no network and no lock wait (saves are atomic
    renames): for hot paths like the keepout hook. The nightly harnesses
    refresh keeps it current."""
    data = _load()
    if data is None:
        raise AuthError("not logged in; run: auth login")
    if data.get("origin") != ORIGIN:
        raise AuthError("saved login belongs to another Auth origin; restore LOST_AUTH_ORIGIN or run: auth login")
    expires_at = (data.get("session") or {}).get("expires_at")
    expired = isinstance(expires_at, int) and not isinstance(expires_at, bool) and expires_at <= time.time()
    if data.get("session_state") == "invalid" or expired:
        raise AuthError("setup session is invalid, expired, or revoked; run: auth login", 401, exit_code=4)
    token = data["tokens"].get("*" if data["mode"] == "global" else scope)
    if not isinstance(token, str) or not token:
        raise AuthError(f"no active credential for {scope}", exit_code=3)
    print(token)


def cmd_refresh():
    with _store_lock():
        data = _load()
        if data is None:
            raise AuthError("not logged in; run: auth login")
        refreshed = _refresh(data)
    scopes = ", ".join(refreshed["active_scopes"]) or "no active bearer tokens"
    print(f"auth: refreshed ({refreshed['mode']}; {scopes})")


def cmd_context():
    """Expose the non-secret account binding for credential consumers."""
    with _store_lock():
        data = _load()
    # Exit 4 is a definite answer that there is no usable login; fleet acts
    # on it, so a store that cannot be read stays exit 1.
    if data is None or data.get("version") != 2:
        raise AuthError("no renewable setup login; run: auth login", exit_code=4)
    # A login from another Auth origin says nothing about this one.
    if data.get("origin") != ORIGIN:
        raise AuthError(
            f"saved login belongs to {data.get('origin') or 'an unknown Auth origin'}; "
            "restore LOST_AUTH_ORIGIN or run: auth login"
        )
    # An invalidated or expired session no longer speaks for its account.
    session = data.get("session")
    expires_at = session.get("expires_at") if isinstance(session, dict) else None
    expired = (isinstance(expires_at, int) and not isinstance(expires_at, bool)
               and expires_at <= int(time.time()))
    if data.get("session_state") == "invalid" or expired:
        raise AuthError(
            "setup session is invalid, expired, or revoked; run: auth login",
            401,
            exit_code=4,
        )
    origin = data.get("origin")
    subject = data.get("account_sub")
    if not isinstance(origin, str) or not origin or not isinstance(subject, str) or not subject:
        raise AuthError("saved setup login has no valid account binding; run: auth login")
    print(json.dumps({"origin": origin, "subject": subject}, separators=(",", ":")))


# Account config pushes carry up to ~20 MB, which the default would cut off.
REQUEST_TIMEOUT = 120


def cmd_request(method, path, body=None):
    """A request to Auth made with this machine's setup session rather than a
    bearer token, so revoking the machine ends it (the Fleet endpoints).

    A body of "-" is read from stdin, since a config push is too large for an
    argument. When Auth answers with an error, its status, message, and
    Retry-After go to stdout as JSON with exit code 6, so a caller can tell a
    stale push (409) or a rate limit (429) from an outage."""
    if method not in ("GET", "POST", "PUT", "PATCH", "DELETE"):
        raise AuthError(f"unsupported method {method}", exit_code=2)
    if not path.startswith("/api/"):
        raise AuthError("request path must start with /api/", exit_code=2)
    json_body = None
    if body is not None:
        try:
            json_body = json.loads(sys.stdin.read() if body == "-" else body)
        except json.JSONDecodeError as exc:
            raise AuthError(f"invalid JSON body: {exc}", exit_code=2) from exc
    # The store lock covers reading the session, not the request: a large push
    # must not hold up every other auth call (the keepout hook among them).
    with _store_lock():
        token = _request_session()
    try:
        response = _request(path, json_body=json_body, session=token, method=method,
                            timeout=REQUEST_TIMEOUT)
    except AuthError as exc:
        if exc.status == 401:
            with _store_lock():
                data = _load()
                # Another login may have replaced the session meanwhile.
                if isinstance(data, dict) and (data.get("session") or {}).get("refresh_token") == token:
                    _invalidate(data)
            raise AuthError(str(exc), exc.status, exit_code=4) from exc
        if exc.status is not None:
            print(json.dumps({"status": exc.status, "error": str(exc), "retry_after": exc.retry_after},
                             separators=(",", ":")))
            raise AuthError(str(exc), exc.status, exit_code=6) from exc
        raise
    print(json.dumps(response, separators=(",", ":")))


def _request_session():
    data = _load()
    if data is None or data.get("version") != 2:
        raise AuthError("no renewable setup login; run: auth login", exit_code=4)
    if data.get("origin") != ORIGIN:
        raise AuthError("saved login belongs to another Auth origin; restore LOST_AUTH_ORIGIN or run: auth login")
    session = data.get("session")
    if not isinstance(session, dict):
        session = {}
    expires_at = session.get("expires_at")
    expired = isinstance(expires_at, int) and not isinstance(expires_at, bool) and expires_at <= time.time()
    token = session.get("refresh_token")
    if data.get("session_state") == "invalid" or expired or not isinstance(token, str) or not token:
        raise AuthError("setup session is invalid, expired, or revoked; run: auth login", 401, exit_code=4)
    return token


def cmd_status():
    with _store_lock():
        data = _load()
        if data is None:
            print("auth: logged out")
            return 1
        if data.get("version") == 1:
            print("auth: login needs renewal; run: auth login")
            return 1
        try:
            data = _refresh(data)
            freshness = "current"
        except AuthError as exc:
            if not exc.transient:
                state = "logged out" if exc.status in (401, 403) else "refresh failed"
                print(f"auth: {state} ({exc})")
                return 1
            freshness = f"cached; refresh unavailable: {exc}"
    scopes = "all services" if data["mode"] == "global" and "*" in data["tokens"] else ", ".join(sorted(data["tokens"])) or "no bearer tokens"
    print(f"auth: logged in ({data['mode']}; {scopes}; {freshness})")
    return 0


USAGE = (
    "Usage: auth login | auth refresh | auth token [--cached] <service> | auth status | auth context\n"
    "       auth request <METHOD> </api/path> [json-body | -]"
)


def main():
    args = sys.argv[1:]
    if args == ["login"]:
        cmd_login()
        return 0
    if len(args) == 2 and args[0] == "token":
        cmd_token(args[1])
        return 0
    if len(args) == 3 and args[:2] == ["token", "--cached"]:
        cmd_token_cached(args[2])
        return 0
    if len(args) == 4 and args[0] == "token" and args[2] == "--expect-context":
        try:
            expected_context = json.loads(args[3])
        except json.JSONDecodeError as exc:
            raise AuthError(f"invalid expected Auth context: {exc}") from exc
        if (
            not isinstance(expected_context, dict)
            or set(expected_context) != {"origin", "subject"}
            or not all(isinstance(value, str) and value for value in expected_context.values())
        ):
            raise AuthError("invalid expected Auth context")
        cmd_token(args[1], expected_context)
        return 0
    if args == ["refresh"]:
        cmd_refresh()
        return 0
    if args == ["context"]:
        cmd_context()
        return 0
    if args == ["status"]:
        return cmd_status()
    if len(args) in (3, 4) and args[0] == "request":
        cmd_request(args[1].upper(), args[2], args[3] if len(args) == 4 else None)
        return 0
    if args in (["help"], ["--help"], ["-h"]):
        print(USAGE)
        return 0
    print(USAGE, file=sys.stderr)
    return 2


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except AuthError as exc:
        print(f"auth: {exc}", file=sys.stderr)
        raise SystemExit(exc.exit_code)
