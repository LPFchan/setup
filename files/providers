def _load_servers():
    """Load OpenAI-compatible providers from the canonical provider registry."""
    try:
        registry = _validate_registry(load_json(REGISTRY_PATH))
    except (OSError, json.JSONDecodeError, ValueError) as exc:
        print(f"Cannot read provider registry {REGISTRY_PATH}: {exc}", file=sys.stderr)
        return None
    servers = _servers_from_registry(registry)
    return servers or None


def _servers_from_registry(registry):
    """Extract OpenAI-compatible api-key servers from a validated registry.

    Split out so the fixture registry can be consulted without touching
    the real one (REGISTRY_PATH is env-overridable, so _load_servers can
    only ever see one registry per process).
    """
    providers = registry.get("providers")
    servers = {}
    for name, provider in providers.items():
        if not isinstance(provider, dict):
            continue
        auth = provider.get("auth", {})
        if provider.get("provider_type") != "OpenAICompatible":
            continue
        if not isinstance(auth, dict) or auth.get("type") != "api-key":
            continue
        base_url = provider.get("base_url")
        auth_key = auth.get("key")
        if not all(isinstance(value, str) and value for value in (name, base_url, auth_key)):
            continue
        servers[name] = {
            "baseURL": base_url,
            "api_format": provider.get("api_format", "openai"),
            "npm": provider.get("npm", "@ai-sdk/openai-compatible"),
            "auth": {"type": "auth_json", "provider": auth_key},
            "registry_enabled": provider.get("enabled") is True,
            "models": provider.get("models", []),
        }
    return servers


def _load_provider_state():
    if not os.path.exists(STATE_PATH):
        migrated = _migrate_refresh_models_provider_state()
        if migrated is not None:
            _cleanup_legacy_provider_state()
            return migrated
        if os.path.exists(LEGACY_STATE_PATH):
            return migrated
        return _migrate_legacy_provider_state()
    try:
        data = load_json(STATE_PATH)
    except (OSError, json.JSONDecodeError) as exc:
        print(f"Cannot read provider state {STATE_PATH}; all providers are disabled: {exc}", file=sys.stderr)
        return None
    if not _valid_provider_state(data):
        print(f"Invalid provider state {STATE_PATH}; all providers are disabled", file=sys.stderr)
        return None
    _cleanup_legacy_provider_state()
    return data


def _valid_provider_state(data):
    if (
        not isinstance(data, dict)
        or data.get("version") != PROVIDER_STATE_VERSION
        or not isinstance(data.get("providers"), dict)
    ):
        return False
    return all(
        isinstance(name, str)
        and NAME_RE.fullmatch(name)
        and isinstance(entry, dict)
        and set(entry) == {"enabled"}
        and isinstance(entry["enabled"], bool)
        for name, entry in data["providers"].items()
    )


def _cleanup_legacy_provider_state():
    for path in (LEGACY_STATE_PATH, LEGACY_CONFIG_PATH):
        if os.path.exists(path):
            os.remove(path)
            print(f"Removed obsolete provider state {path}")


def _migrate_refresh_models_provider_state():
    """Move refresh-models' old state into the neutral provider namespace."""
    if not os.path.exists(LEGACY_STATE_PATH):
        return None
    try:
        data = load_json(LEGACY_STATE_PATH)
    except (OSError, json.JSONDecodeError) as exc:
        print(
            f"Cannot migrate provider state {LEGACY_STATE_PATH}; all providers are disabled: {exc}",
            file=sys.stderr,
        )
        return None
    providers = data.get("providers") if isinstance(data, dict) else None
    if not isinstance(providers, dict):
        print(
            f"Cannot migrate provider state {LEGACY_STATE_PATH}; all providers are disabled",
            file=sys.stderr,
        )
        return None
    migrated = {
        "version": PROVIDER_STATE_VERSION,
        "providers": {
            name: {"enabled": entry["enabled"]}
            for name, entry in providers.items()
            if isinstance(name, str)
            and NAME_RE.fullmatch(name)
            and isinstance(entry, dict)
            and isinstance(entry.get("enabled"), bool)
        },
    }
    if len(migrated["providers"]) != len(providers):
        print(
            f"Cannot migrate invalid provider state {LEGACY_STATE_PATH}; all providers are disabled",
            file=sys.stderr,
        )
        return None
    save_json_atomic(STATE_PATH, migrated)
    os.remove(LEGACY_STATE_PATH)
    print(f"Migrated provider state to {STATE_PATH} and removed {LEGACY_STATE_PATH}")
    return migrated


def _migrate_legacy_provider_state():
    if not os.path.exists(LEGACY_CONFIG_PATH):
        return {"version": PROVIDER_STATE_VERSION, "providers": {}}
    try:
        data = load_json(LEGACY_CONFIG_PATH)
    except (OSError, json.JSONDecodeError) as exc:
        print(
            f"Cannot migrate obsolete provider registry {LEGACY_CONFIG_PATH}; all providers are disabled: {exc}",
            file=sys.stderr,
        )
        return None
    legacy_servers = data.get("servers", {}) if isinstance(data, dict) else None
    if not isinstance(legacy_servers, dict):
        print(
            f"Cannot migrate obsolete provider registry {LEGACY_CONFIG_PATH}; all providers are disabled",
            file=sys.stderr,
        )
        return None
    shared_servers = _load_servers()
    if shared_servers is None:
        return None
    local_only = sorted(set(legacy_servers) - set(shared_servers))
    if local_only:
        print(
            f"Dropping obsolete local-only provider definitions: {', '.join(local_only)}",
            file=sys.stderr,
        )
    providers = {}
    for name, cfg in legacy_servers.items():
        if name in shared_servers and isinstance(cfg, dict) and isinstance(cfg.get("enabled"), bool):
            providers[name] = {"enabled": cfg["enabled"]}
    migrated = {"version": PROVIDER_STATE_VERSION, "providers": providers}
    save_json_atomic(STATE_PATH, migrated)
    os.remove(LEGACY_CONFIG_PATH)
    print(f"Migrated provider state to {STATE_PATH} and removed {LEGACY_CONFIG_PATH}")
    return migrated


def _auth_provider(name, cfg):
    auth = cfg.get("auth", {})
    return auth.get("provider", name) if isinstance(auth, dict) else name


def _provider_enabled(name, cfg):
    provider_state = _load_provider_state()
    if provider_state is None:
        return False
    state = provider_state.get("providers", {}).get(name, {})
    if isinstance(state, dict) and "enabled" in state:
        return state["enabled"] is True
    return cfg.get("registry_enabled") is True and bool(_get_key(_auth_provider(name, cfg)))


def _sync_opencode_provider_statuses(servers):
    """Mirror managed provider status without changing unrelated providers."""
    opencode = load_json_or_quarantine(OPENCODE_PATH)
    configured_disabled = opencode.get("disabled_providers", [])
    if not isinstance(configured_disabled, list):
        configured_disabled = []
    managed = set(servers)
    disabled = [name for name in configured_disabled if name not in managed]
    disabled.extend(
        name for name, cfg in servers.items() if not _provider_enabled(name, cfg)
    )
    if disabled:
        opencode["disabled_providers"] = disabled
    else:
        opencode.pop("disabled_providers", None)
    save_json_atomic(OPENCODE_PATH, opencode)


def _sync_opencodex_provider_statuses():
    """Mirror provider status into OpenCodex and the Codex model catalog."""
    if not (os.path.isfile(OPENCODEX_BIN) and os.access(OPENCODEX_BIN, os.X_OK)):
        return
    if subprocess.run([OPENCODEX_BIN, "__apply"]).returncode:
        print("  OpenCodex config unchanged; run: setup update opencodex", file=sys.stderr)
        return
    ocx = shutil.which("ocx")
    if ocx is None:
        return
    if subprocess.run([ocx, "sync"]).returncode:
        print("  Codex model catalog unchanged; run: ocx sync", file=sys.stderr)


def _set_provider_enabled(provider, enabled):
    servers = _load_servers()
    if servers is None:
        return False
    if provider not in servers:
        print(f"Unknown provider: {provider}", file=sys.stderr)
        print(f"Known: {', '.join(servers.keys())}", file=sys.stderr)
        return False
    auth_provider = _auth_provider(provider, servers[provider])
    if enabled and not _get_key(auth_provider):
        print(
            f"Cannot enable {provider}: no API key. "
            f"Run: providers auth {provider} <key>",
            file=sys.stderr,
        )
        return False
    state = _load_provider_state()
    if state is None:
        return False
    state.setdefault("providers", {}).setdefault(provider, {})["enabled"] = enabled
    save_json_atomic(STATE_PATH, state)
    _sync_opencode_provider_statuses(servers)
    _sync_opencodex_provider_statuses()
    print(f"{provider}: {'enabled' if enabled else 'disabled'}")
    return True


def _set_key(provider, key):
    """Enroll a key: write to vault (canonical), refresh cache, then mirrors."""
    cache_set(provider, key)
    if vault_available():
        try:
            items = {item["name"] for item in vault_list_items()}
            env_name = _env_name(provider)
            if env_name not in items:
                vault_add(env_name, key)
            else:
                vault_call_edit(env_name, key)
        except VaultError as exc:
            print(f"  vault write failed ({exc}); key cached locally", file=sys.stderr)
    _sync_mirrors()
    print(f"Saved {_env_name(provider)} to vault (llm/) and mirrors")


def vault_call_edit(item_name, value):
    _vault_call("edit_secret", {"folder": VAULT_FOLDER, "item_name": item_name, "value": value})


def cmd_auth():
    """Interactive or direct API key onboarding.

    providers auth                     → interactive prompt for all missing keys
    providers auth <provider> <key>    → write key directly (agent-friendly)
    """
    _sync_cache_from_vault(_load_servers() or {})

    servers = _load_servers()
    if servers is None:
        sys.exit(1)

    if len(sys.argv) >= 4:
        provider = sys.argv[2]
        key = sys.argv[3]
        if provider not in servers:
            print(f"Unknown provider: {provider}", file=sys.stderr)
            print(f"Known: {', '.join(servers.keys())}", file=sys.stderr)
            sys.exit(1)
        _set_key(_auth_provider(provider, servers[provider]), key)
        if not _set_provider_enabled(provider, True):
            sys.exit(1)
        return

    cache = _load_cache()
    missing = [s for s, cfg in servers.items() if not cache_get(_auth_provider(s, cfg))]
    configured = [s for s, cfg in servers.items() if cache_get(_auth_provider(s, cfg))]

    if configured:
        print("Configured:")
        for s in configured:
            print(f"  {s}: ✓")
        print()

    if not missing:
        _sync_opencode_provider_statuses(servers)
        print("All provider API keys are already stored in the vault.")
        return

    print("Providers available to enable:")
    for s in missing:
        url = PROVIDER_URLS.get(s, "")
        print(f"  {s}" + (f"  — {url}" if url else ""))
    print()

    enabled = []
    for s in missing:
        url = PROVIDER_URLS.get(s, "")
        prompt = f"  {s} API key" + (f" ({url})" if url else "") + ": "
        try:
            key = getpass.getpass(prompt)
        except (EOFError, KeyboardInterrupt):
            print()
            break
        if key.strip():
            cache_set(_auth_provider(s, servers[s]), key.strip())
            enabled.append(s)

    if enabled:
        _sync_mirrors()
        state = _load_provider_state()
        if state is None:
            print("Provider state is invalid; keys were saved but enablement was not changed.", file=sys.stderr)
            return
        for name in enabled:
            state.setdefault("providers", {}).setdefault(name, {})["enabled"] = True
        save_json_atomic(STATE_PATH, state)
        _sync_opencode_provider_statuses(servers)
        print(f"\nSaved to vault (llm/) and mirrors")
    else:
        print("\nNo keys entered.")


def cmd_ls():
    servers = _load_servers()
    if servers is None:
        sys.exit(1)
    cache = _load_cache()
    print(f"providers configured: {len(servers)}")
    for name, provider in servers.items():
        auth_provider = _auth_provider(name, provider)
        state = "enabled" if _provider_enabled(name, provider) else "disabled"
        key_status = "key: ✓" if _get_key(auth_provider) else "key: ✗"
        print(f"  {name}: {state}  {provider.get('baseURL')}  {key_status}")


def cmd_timer_enable():
    _sync_cache_from_vault(_load_servers() or {})

    script_path = os.path.abspath(sys.argv[0])
    cfg_dir = os.path.dirname(STATE_PATH)
    pathlib.Path(cfg_dir).mkdir(parents=True, exist_ok=True)

    if _is_macos():
        pathlib.Path(LAUNCHD_DIR).mkdir(parents=True, exist_ok=True)
        plist_path = os.path.join(LAUNCHD_DIR, f"{PLIST_NAME}.plist")
        plist = f"""<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>{PLIST_NAME}</string>
    <key>ProgramArguments</key>
    <array>
        <string>{script_path}</string>
    </array>
    <key>StartCalendarInterval</key>
    <dict>
        <key>Minute</key><integer>0</integer>
    </dict>
    <key>StandardOutPath</key>
    <string>/tmp/providers.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/providers.log</string>
</dict>
</plist>"""
        with open(plist_path, "w") as f:
            f.write(plist)
        _uid = os.getuid()
        subprocess.run(["launchctl", "bootout", f"gui/{_uid}/{PLIST_NAME}"],
                       capture_output=True)
        r = subprocess.run(["launchctl", "bootstrap", f"gui/{_uid}", plist_path],
                           capture_output=True)
        if r.returncode == 0:
            print("providers launchd agent enabled (hourly)")
        else:
            if r.returncode == 125:
                print("no GUI session — log in on the Mac's screen first", file=sys.stderr)
            else:
                print(f"providers installed but launchd enable failed (rc={r.returncode})", file=sys.stderr)
            if r.stderr:
                print(r.stderr.decode().rstrip(), file=sys.stderr)
    else:
        pathlib.Path(SERVICE_DIR).mkdir(parents=True, exist_ok=True)
        with open(os.path.join(SERVICE_DIR, "providers.service"), "w") as f:
            f.write(SERVICE_UNIT % script_path)
        with open(os.path.join(SERVICE_DIR, "providers.timer"), "w") as f:
            f.write(TIMER_UNIT)
        subprocess.run(["systemctl", "--user", "daemon-reload"], check=True)
        subprocess.run(
