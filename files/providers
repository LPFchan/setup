def _parse_capability_command(args):
    if not args or args[0] not in ("show", "refresh"):
        raise ValueError("Usage: providers capabilities <show|refresh> [--provider NAME] [--model ID] --json")
    command = args[0]
    provider = None
    model = None
    json_requested = False
    index = 1
    while index < len(args):
        argument = args[index]
        if argument == "--json":
            if json_requested:
                raise ValueError("--json may be supplied only once")
            json_requested = True
        elif argument in ("--provider", "--model"):
            if index + 1 >= len(args) or args[index + 1].startswith("-"):
                raise ValueError(f"{argument} requires a value")
            value = args[index + 1]
            if argument == "--provider":
                if provider is not None:
                    raise ValueError("--provider may be supplied only once")
                provider = value
            else:
                if model is not None:
                    raise ValueError("--model may be supplied only once")
                model = value
            index += 1
        else:
            raise ValueError(f"unknown capabilities option: {argument}")
        index += 1
    if not json_requested:
        raise ValueError("capabilities commands require --json")
    if provider == "" or model == "":
        raise ValueError("capability filters cannot be empty")
    return command, provider, model


def _capability_view(cache, provider=None, model=None):
    providers = cache.get("providers", {}) if isinstance(cache, dict) else {}
    if not isinstance(providers, dict):
        raise ValueError("invalid capability cache providers")
    if provider is not None:
        if provider not in providers:
            raise LookupError(f"no capability snapshot for provider: {provider}")
        selected = {provider: providers[provider]}
    else:
        selected = dict(providers)
    if model is not None:
        matches = []
        for name, snapshot in selected.items():
            models = snapshot.get("models", {}) if isinstance(snapshot, dict) else {}
            if isinstance(models, dict) and model in models:
                matches.append((name, snapshot))
        if len(matches) != 1:
            if not matches:
                raise LookupError(f"no capability record for model: {model}")
            raise LookupError(f"model ID is ambiguous; pass --provider: {model}")
        name, snapshot = matches[0]
        snapshot = dict(snapshot)
        snapshot["models"] = {model: snapshot["models"][model]}
        selected = {name: snapshot}
    return {"version": CAPABILITIES_VERSION, "providers": selected}


def cmd_capabilities(args):
    command, provider, model = _parse_capability_command(args)
    if command == "refresh":
        servers = _load_servers()
        if servers is None:
            raise ValueError("cannot read provider registry")
        refreshed = 0
        # Provider refresh helpers are also used by the human-oriented command
        # path. Keep their incidental status output off this machine interface.
        with contextlib.redirect_stdout(sys.stderr):
            if provider is not None:
                if provider not in servers:
                    raise LookupError(f"unknown provider: {provider}")
                if not _provider_enabled(provider, servers[provider]):
                    raise LookupError(f"provider is disabled: {provider}")
                targets = [provider]
            else:
                targets = [
                    name for name, cfg in servers.items()
                    if _provider_enabled(name, cfg)
                ]
            for name in targets:
                result = refresh_server(name, servers[name])
                if isinstance(result, dict) and result:
                    refreshed += 1
        if provider is not None and refreshed == 0:
            raise RuntimeError(f"provider refresh failed or returned no models: {provider}")
    cache = _load_capabilities()
    view = _capability_view(cache, provider, model)
    print(json.dumps(view, indent=2, sort_keys=True, ensure_ascii=False))


def _conforming_item_name(name):
    """C1 convention: {PROVIDER}_API_KEY, where PROVIDER is a lowercase
    alphanumeric/hyphen provider name uppercased with '-' -> '_' (so the item
    is uppercase letters/digits/underscores, ending in _API_KEY)."""
    if not name.endswith("_API_KEY"):
        return False
    stem = name[: -len("_API_KEY")]
    return bool(re.fullmatch(r"[A-Z][A-Z0-9]*(?:_[A-Z0-9]+)*", stem))


def cmd_audit():
    """List vault llm items and flag names that violate C1."""
    if not vault_available():
        print("vault token unset; cannot audit", file=sys.stderr)
        sys.exit(1)
    try:
        items = vault_list_items()
    except VaultError as exc:
        print(f"vault unreachable: {exc}", file=sys.stderr)
        sys.exit(1)
    if not items:
        print("vault llm/ folder is empty")
        return
    print(f"vault llm/ ({len(items)} items):")
    for item in items:
        name = item["name"]
        flag = "" if _conforming_item_name(name) else "  <- non-conforming"
        print(f"  {name}{flag}")


def cmd_rename():
    """Enforce C1 on vault llm items. Default dry-run; --apply performs renames.

    Only non-deleted, non-OAuth, non-conforming items are renamed. OAuth items
    (*_OAUTH_TOKEN / *_REFRESH_TOKEN) are out of scope and never touched.
    """
    dry_run = "--apply" not in sys.argv
    if not vault_available():
        print("vault token unset; cannot rename", file=sys.stderr)
        sys.exit(1)
    try:
        items = vault_list_items()
    except VaultError as exc:
        print(f"vault unreachable: {exc}", file=sys.stderr)
        sys.exit(1)
    plan = []
    for item in items:
        name = item["name"]
        if item.get("deleted"):
            continue
        if _conforming_item_name(name):
            continue
        if name.endswith(("_OAUTH_TOKEN", "_REFRESH_TOKEN")):
            continue
        # map to a proper provider name: lowercase alnum/hyphen, then to env form
        provider = re.sub(r"[^a-z0-9-]", "-", name.lower())
        provider = re.sub(r"-+", "-", provider).strip("-")
        env = provider.replace("-", "_").upper()
        if not env.endswith("_API_KEY"):
            env += "_API_KEY"
        plan.append((item, name, env))
    if not plan:
        print("vault llm/ items all conform to C1")
        return
    print("C1 renames planned:")
    for item, old, new in plan:
        print(f"  {old} -> {new}")
    if dry_run:
        print("\n(dry run — pass --apply to perform)")
        return
    for item, old, new in plan:
        vault_rename(old, new, item.get("item_id"))
        print(f"  renamed {old} -> {new}")


def main():
    args = sys.argv[1:]

    if args and args[0] == "__validate":
        try:
            _validate_registry(load_json(args[1]))
        except (IndexError, OSError, json.JSONDecodeError, ValueError) as exc:
            print(f"providers: {exc}", file=sys.stderr)
            sys.exit(1)
        return

    if args and args[0] == "__migrate-state":
        if _load_provider_state() is None:
            sys.exit(1)
        return

    if not args:
        _source_zsenv()
        _sync_zsenv_to_cache()
        _sync_mirrors()
        servers = _load_servers()
        if servers is None:
            sys.exit(1)
        _sync_cache_from_vault(servers)
        _sync_mirrors()
        _sync_opencode_provider_statuses(servers)
        refreshed = {}
        for name, srv_cfg in servers.items():
            if not _provider_enabled(name, srv_cfg):
                continue
            models = refresh_server(name, srv_cfg)
            if isinstance(models, dict):
                refreshed[name] = models
        _sync_hermes_mirror(servers, refreshed)
        _sync_pi_models_mirror(servers, refreshed)
        return

    cmd = args[0]

    if cmd == "--list":
        servers = _load_servers()
        if servers is None:
            sys.exit(1)
        for name in servers:
            print(name)
        return

    if cmd == "add":
        if len(args) not in (1, 4, 5):
            print("Usage: providers add [<provider> <base-url> <key> [model]]", file=sys.stderr)
            sys.exit(1)
        try:
            _add_provider(*args[1:])
        except (OSError, json.JSONDecodeError, ValueError) as exc:
            print(f"providers: {exc}", file=sys.stderr)
            sys.exit(1)
        return

    if cmd in ("enable", "disable"):
        if len(args) != 2:
            print(f"Usage: providers {cmd} <provider>", file=sys.stderr)
            sys.exit(1)
        if not _set_provider_enabled(args[1], cmd == "enable"):
            sys.exit(1)
        return

    if cmd == "timer":
        if len(args) != 2 or args[1] not in ("enable", "disable", "status"):
            print("Usage: providers timer <enable|disable|status>", file=sys.stderr)
            sys.exit(1)
        {"enable": cmd_timer_enable, "disable": cmd_timer_disable, "status": cmd_timer_status}[args[1]]()
        return

    if cmd == "auth":
        cmd_auth()
        return

    if cmd == "ls":
        cmd_ls()
        return

    if cmd == "sync":
        cmd_sync()
        return

    if cmd == "capabilities":
        try:
            cmd_capabilities(args[1:])
        except (OSError, json.JSONDecodeError, ValueError, LookupError, RuntimeError) as exc:
            print(f"providers capabilities: {exc}", file=sys.stderr)
            sys.exit(1)
        return

    if cmd == "audit":
        cmd_audit()
        return

    if cmd == "rename":
        cmd_rename()
        return

    if cmd in ("--help", "-h", "help"):
        print("providers — vault-owned provider API keys and model refresh")
        print()
        print("Usage:")
        print("  providers                  Refresh all enabled providers")
        print("  providers <provider>       Refresh a single enabled provider")
        print("  providers --list           List configured provider names")
        print("  providers auth             Interactive API key enrollment")
        print("  providers auth <p> <k>     Write key directly (agent-friendly)")
        print("  providers ls               List providers and key status")
        print("  providers add                   Add a provider interactively")
        print("  providers add <p> <url> <key> [model]")
        print("                                  Add directly; model is required without /models")
        print("  providers enable <p>       Enable a provider that has an API key")
        print("  providers disable <p>      Disable a provider without deleting its key")
        print("  providers timer enable     Install systemd/launchd timer (hourly)")
        print("  providers timer disable    Remove timer")
        print("  providers timer status     Show timer state and next run")
        print("  providers sync             vault -> cache -> auth.json -> .zshenv")
        print("  providers capabilities show [--provider P] [--model M] --json")
        print("  providers capabilities refresh [--provider P] [--model M] --json")
        print("  providers audit            List vault llm items, flag non-conforming")
        print("  providers rename [--apply] Enforce C1 naming on vault items")
        print("  providers --help           Show this message")
        return

    servers = _load_servers()
    if servers is None:
        sys.exit(1)
