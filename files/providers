def _conforming_item_name(name):
    """C1 convention: {PROVIDER}_API_KEY, where PROVIDER is a lowercase
    alphanumeric/hyphen provider name uppercased with '-' -> '_' (so the item
    is uppercase letters/digits/underscores, ending in _API_KEY)."""
    if not name.endswith("_API_KEY"):
        return False
    stem = name[: -len("_API_KEY")]
    return bool(re.fullmatch(r"[A-Z][A-Z0-9]*(?:_[A-Z0-9]+)*", stem))


def cmd_audit():
    """List vault llm items and flag names that violate C1."""
    if not vault_available():
        print("vault token unset; cannot audit", file=sys.stderr)
        sys.exit(1)
    try:
        items = vault_list_items()
    except VaultError as exc:
        print(f"vault unreachable: {exc}", file=sys.stderr)
        sys.exit(1)
    if not items:
        print("vault llm/ folder is empty")
        return
    print(f"vault llm/ ({len(items)} items):")
    for item in items:
        name = item["name"]
        flag = "" if _conforming_item_name(name) else "  <- non-conforming"
        print(f"  {name}{flag}")


def cmd_rename():
    """Enforce C1 on vault llm items. Default dry-run; --apply performs renames.

    Only non-deleted, non-OAuth, non-conforming items are renamed. OAuth items
    (*_OAUTH_TOKEN / *_REFRESH_TOKEN) are out of scope and never touched.
    """
    dry_run = "--apply" not in sys.argv
    if not vault_available():
        print("vault token unset; cannot rename", file=sys.stderr)
        sys.exit(1)
    try:
        items = vault_list_items()
    except VaultError as exc:
        print(f"vault unreachable: {exc}", file=sys.stderr)
        sys.exit(1)
    plan = []
    for item in items:
        name = item["name"]
        if item.get("deleted"):
            continue
        if _conforming_item_name(name):
            continue
        if name.endswith(("_OAUTH_TOKEN", "_REFRESH_TOKEN")):
            continue
        # map to a proper provider name: lowercase alnum/hyphen, then to env form
        provider = re.sub(r"[^a-z0-9-]", "-", name.lower())
        provider = re.sub(r"-+", "-", provider).strip("-")
        env = provider.replace("-", "_").upper()
        if not env.endswith("_API_KEY"):
            env += "_API_KEY"
        plan.append((item, name, env))
    if not plan:
        print("vault llm/ items all conform to C1")
        return
    print("C1 renames planned:")
    for item, old, new in plan:
        print(f"  {old} -> {new}")
    if dry_run:
        print("\n(dry run — pass --apply to perform)")
        return
    for item, old, new in plan:
        vault_rename(old, new, item.get("item_id"))
        print(f"  renamed {old} -> {new}")


def main():
    args = sys.argv[1:]

    if args and args[0] == "__validate":
        try:
            _validate_registry(load_json(args[1]))
        except (IndexError, OSError, json.JSONDecodeError, ValueError) as exc:
            print(f"providers: {exc}", file=sys.stderr)
            sys.exit(1)
        return

    if args and args[0] == "__migrate-state":
        if _load_provider_state() is None:
            sys.exit(1)
        return

    if not args:
        _source_zsenv()
        _sync_zsenv_to_cache()
        _sync_mirrors()
        servers = _load_servers()
        if servers is None:
            sys.exit(1)
        _sync_cache_from_vault(servers)
        _sync_mirrors()
        _sync_opencode_provider_statuses(servers)
        refreshed = {}
        for name, srv_cfg in servers.items():
            if not _provider_enabled(name, srv_cfg):
                continue
            models = refresh_server(name, srv_cfg)
            if isinstance(models, dict):
                refreshed[name] = models
        _sync_hermes_mirror(servers, refreshed)
        return

    cmd = args[0]

    if cmd == "--list":
        servers = _load_servers()
        if servers is None:
            sys.exit(1)
        for name in servers:
            print(name)
        return

    if cmd == "add":
        if len(args) not in (1, 4):
            print("Usage: providers add [<provider> <base-url> <key>]", file=sys.stderr)
            sys.exit(1)
        try:
            _add_provider(*args[1:])
        except (OSError, json.JSONDecodeError, ValueError) as exc:
            print(f"providers: {exc}", file=sys.stderr)
            sys.exit(1)
        return

    if cmd in ("enable", "disable"):
        if len(args) != 2:
            print(f"Usage: providers {cmd} <provider>", file=sys.stderr)
            sys.exit(1)
        if not _set_provider_enabled(args[1], cmd == "enable"):
            sys.exit(1)
        return

    if cmd == "timer":
        if len(args) != 2 or args[1] not in ("enable", "disable", "status"):
            print("Usage: providers timer <enable|disable|status>", file=sys.stderr)
            sys.exit(1)
        {"enable": cmd_timer_enable, "disable": cmd_timer_disable, "status": cmd_timer_status}[args[1]]()
        return

    if cmd == "auth":
        cmd_auth()
        return

    if cmd == "ls":
        cmd_ls()
        return

    if cmd == "sync":
        cmd_sync()
        return

    if cmd == "audit":
        cmd_audit()
        return

    if cmd == "rename":
        cmd_rename()
        return

    if cmd in ("--help", "-h", "help"):
        print("providers — vault-owned provider API keys and model refresh")
        print()
        print("Usage:")
        print("  providers                  Refresh all enabled providers")
        print("  providers <provider>       Refresh a single enabled provider")
        print("  providers --list           List configured provider names")
        print("  providers auth             Interactive API key enrollment")
        print("  providers auth <p> <k>     Write key directly (agent-friendly)")
        print("  providers ls               List providers and key status")
        print("  providers add                   Add a provider interactively")
        print("  providers add <p> <url> <key>   Add directly (agent-friendly)")
        print("  providers enable <p>       Enable a provider that has an API key")
        print("  providers disable <p>      Disable a provider without deleting its key")
        print("  providers timer enable     Install systemd/launchd timer (hourly)")
        print("  providers timer disable    Remove timer")
        print("  providers timer status     Show timer state and next run")
        print("  providers sync             vault -> cache -> auth.json -> .zshenv")
        print("  providers audit            List vault llm items, flag non-conforming")
        print("  providers rename [--apply] Enforce C1 naming on vault items")
        print("  providers --help           Show this message")
        return

    servers = _load_servers()
    if servers is None:
        sys.exit(1)
    if cmd in servers:
        if not _provider_enabled(cmd, servers[cmd]):
            print(
                f"{cmd} is disabled. Run: providers enable {cmd}",
                file=sys.stderr,
            )
            sys.exit(1)
        _sync_opencode_provider_statuses(servers)
        models = refresh_server(cmd, servers[cmd])
        if isinstance(models, dict):
            _sync_hermes_mirror(servers, {cmd: models})
        return

    print(f"Unknown: {cmd}", file=sys.stderr)
    print(f"Usage: providers [add|enable|disable|timer|auth|ls|sync|audit|rename|--list|<provider>]", file=sys.stderr)
    sys.exit(1)


if __name__ == "__main__":
    main()
