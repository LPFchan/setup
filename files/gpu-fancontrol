#!/usr/bin/env python3
# setup-module: gpu-fancontrol
# setup-source: files/gpu-fancontrol
"""GPU-based PWM fan controller for ASUS ROG STRIX X570-F + dual RTX 3090.

Ramp rates: both directions are smoothed at RAMP_UP/DOWN_PER_CYCLE degrees
per loop. A HYSTERESIS deadband prevents jitter on tiny fluctuations.
"""

import os
import signal
import subprocess
import sys
import time

TEMP_CURVE = [
    (35,  26),
    (50,  51),
    (60,  89),
    (70, 115),
    (78, 166),
    (83, 166),
]

PWM_CHANNELS = [3]
PWM_MIN = 13
PWM_MAX = 166
INTERVAL = 1
RAMP_UP_PER_CYCLE   = 0.5
RAMP_DOWN_PER_CYCLE = 1.0
HYSTERESIS = 10.0
PWM_STEP = 3

MODE_MANUAL = 1
MODE_AUTO   = 5


def find_hwmon(chip_name):
    base = "/sys/class/hwmon"
    for entry in sorted(os.listdir(base)):
        path = os.path.join(base, entry)
        try:
            with open(os.path.join(path, "name")) as f:
                if f.read().strip() == chip_name:
                    return path
        except OSError:
            continue
    raise RuntimeError("hwmon '{}' not found -- is nct6775 loaded?".format(chip_name))


def get_gpu_temps():
    result = subprocess.run(
        ["nvidia-smi", "--query-gpu=temperature.gpu", "--format=csv,noheader,nounits"],
        capture_output=True, text=True, timeout=5,
    )
    return [int(t.strip()) for t in result.stdout.strip().splitlines() if t.strip()]


def interpolate(temp):
    if temp <= TEMP_CURVE[0][0]:
        return TEMP_CURVE[0][1]
    if temp >= TEMP_CURVE[-1][0]:
        return TEMP_CURVE[-1][1]
    for i in range(len(TEMP_CURVE) - 1):
        t0, p0 = TEMP_CURVE[i]
        t1, p1 = TEMP_CURVE[i + 1]
        if t0 <= temp <= t1:
            ratio = (temp - t0) / (t1 - t0)
            return round(p0 + ratio * (p1 - p0))
    return TEMP_CURVE[-1][1]


def write_pwm(hwmon, channel, value):
    with open(os.path.join(hwmon, "pwm{}".format(channel)), "w") as f:
        f.write(str(value))


def set_mode(hwmon, channel, mode):
    path = os.path.join(hwmon, "pwm{}_enable".format(channel))
    if os.path.exists(path):
        with open(path, "w") as f:
            f.write(str(mode))


def restore_auto(hwmon, sig=None, frame=None):
    print("\nRestoring fans to motherboard auto control...", flush=True)
    for ch in PWM_CHANNELS:
        try:
            set_mode(hwmon, ch, MODE_AUTO)
        except OSError as e:
            print("  pwm{}: {}".format(ch, e), file=sys.stderr)
    if sig is not None:
        sys.exit(0)


def main():
    hwmon = None
    for chip in ("nct6798", "nct6775", "nct6687", "it8792", "it8689"):
        try:
            hwmon = find_hwmon(chip)
            print("hwmon chip {} at {}".format(chip, hwmon), flush=True)
            break
        except RuntimeError:
            continue
    if hwmon is None:
        raise RuntimeError("no supported hwmon chip found (tried: nct6798, nct6775, nct6687, it8792, it8689)")
    for ch in PWM_CHANNELS:
        set_mode(hwmon, ch, MODE_MANUAL)
    signal.signal(signal.SIGTERM, lambda s, f: restore_auto(hwmon, s, f))
    signal.signal(signal.SIGINT,  lambda s, f: restore_auto(hwmon, s, f))
    print("Fan control active. Ramp: {:.1f}C/cycle up / {:.1f}C/cycle down ({:.0f}s/10C). Hysteresis: {:.0f}C. PWM step: {}/cycle ({:.0f}%/cycle). Range: {}%-{}%.".format(
        RAMP_UP_PER_CYCLE, RAMP_DOWN_PER_CYCLE,
        10 / RAMP_UP_PER_CYCLE * INTERVAL, HYSTERESIS,
        PWM_STEP, PWM_STEP / 255 * 100,
        round(PWM_MIN / 255 * 100), round(PWM_MAX / 255 * 100)), flush=True)
    effective_temp = None
    current_pwm = None
    while True:
        try:
            temps = get_gpu_temps()
            if not temps:
                raise RuntimeError("nvidia-smi returned no temperatures")
            actual_max = float(max(temps))
            if effective_temp is None:
                effective_temp = actual_max
                current_pwm = interpolate(round(effective_temp))
            diff = actual_max - effective_temp
            if abs(diff) < HYSTERESIS:
                pass
            elif diff > 0:
                effective_temp = min(actual_max, effective_temp + RAMP_UP_PER_CYCLE)
            else:
                effective_temp = max(actual_max, effective_temp - RAMP_DOWN_PER_CYCLE)
            target_pwm = min(PWM_MAX, max(PWM_MIN, interpolate(round(effective_temp))))
            if current_pwm is None:
                current_pwm = target_pwm
            elif target_pwm > current_pwm:
                current_pwm = min(target_pwm, current_pwm + PWM_STEP)
            elif target_pwm < current_pwm:
                current_pwm = max(target_pwm, current_pwm - PWM_STEP)
            for ch in PWM_CHANNELS:
                write_pwm(hwmon, ch, current_pwm)
            gpu_str = "  ".join("GPU{}={}C".format(i, t) for i, t in enumerate(temps))
            direction = "^" if actual_max > effective_temp else "v" if actual_max < effective_temp else "="
            print("{:<30}  eff={:.1f}C{}  pwm={} ({:.0f}%)  target={} ({:.0f}%)".format(
                gpu_str, effective_temp, direction, current_pwm,
                current_pwm / 255 * 100, target_pwm, target_pwm / 255 * 100), flush=True)
        except Exception as e:
            print("Error: {} -- fans set to max ({})".format(e, PWM_MAX), file=sys.stderr, flush=True)
            effective_temp = None
            for ch in PWM_CHANNELS:
                try:
                    write_pwm(hwmon, ch, PWM_MAX)
                except OSError:
                    pass
        time.sleep(INTERVAL)


UNIT_NAME = "gpu-fancontrol.service"
UNIT_PATH = "/etc/systemd/system/" + UNIT_NAME
BIN_LINK = "/usr/local/bin/gpu-fancontrol"

UNIT = """[Unit]
Description=GPU-based chassis fan controller
After=network.target nvidia-persistenced.service
Wants=nvidia-persistenced.service

[Service]
Type=simple
ExecStart={exec_path}
Restart=on-failure
RestartSec=10
User=root

[Install]
WantedBy=multi-user.target
"""


def _require_root(action):
    if os.geteuid() != 0:
        sys.exit(
            "gpu-fancontrol: %s requires root — try sudo gpu-fancontrol %s"
            % (action, action)
        )


def cmd_enable():
    """Install the unit and start it. The unit runs the managed copy in the
    operator's ~/.local/bin through a stable /usr/local/bin symlink, so a
    `setup update` refreshes the daemon without rewriting the unit."""
    _require_root("enable")
    source = os.path.realpath(__file__)
    if source != BIN_LINK:
        if os.path.islink(BIN_LINK) or os.path.exists(BIN_LINK):
            os.remove(BIN_LINK)
        os.symlink(source, BIN_LINK)
    with open(UNIT_PATH, "w") as unit:
        unit.write(UNIT.format(exec_path=BIN_LINK))
    subprocess.run(["systemctl", "daemon-reload"], check=True)
    subprocess.run(["systemctl", "enable", "--now", UNIT_NAME], check=True)
    print("gpu-fancontrol: enabled")


def cmd_disable():
    _require_root("disable")
    subprocess.run(["systemctl", "disable", "--now", UNIT_NAME], check=False)
    for path in (UNIT_PATH, BIN_LINK):
        try:
            os.remove(path)
        except FileNotFoundError:
            pass
    subprocess.run(["systemctl", "daemon-reload"], check=False)
    # Removing the unit file while it has a runtime state leaves systemd
    # reporting "failed"; clear it so status reads inactive.
    subprocess.run(["systemctl", "reset-failed", UNIT_NAME], check=False,
                   capture_output=True)
    print("gpu-fancontrol: disabled")


def cmd_status():
    result = subprocess.run(
        ["systemctl", "is-active", UNIT_NAME], capture_output=True, text=True
    )
    print("gpu-fancontrol: %s" % (result.stdout.strip() or "not-installed"))


USAGE = """gpu-fancontrol — GPU-based PWM fan controller

  Reads GPU temperatures via nvidia-smi and adjusts chassis fan
  PWM via a Super I/O hwmon chip (nct6798, nct6775, etc.).

Usage:  gpu-fancontrol            run in the foreground
        gpu-fancontrol enable     install the systemd unit and start (root)
        gpu-fancontrol disable    stop and remove the unit (root)
        gpu-fancontrol status     show the unit state
        gpu-fancontrol help"""


if __name__ == "__main__":
    command = sys.argv[1] if len(sys.argv) > 1 else ""
    if command in ("help", "--help", "-h"):
        print(USAGE)
        sys.exit(0)
    if command == "enable":
        cmd_enable()
    elif command == "disable":
        cmd_disable()
    elif command == "status":
        cmd_status()
    elif command:
        sys.exit("gpu-fancontrol: unknown command %r — try 'help'" % command)
    else:
        main()
