#!/usr/bin/env python3
# setup-module: passage
# setup-source: files/passage
"""passage — read secrets from the passage MCP from a shell.

The bearer comes from the shared auth module (`auth token passage`), so no
extra secret sits on disk. Values are printed only by `get`; `run` places
them in a child process's environment and never echoes them.

Commands:
  get <folder> <item>            Print the secret value (for command substitution)
  list <folder>                  List item names in a folder
  run [--env NAME=folder/item]... -- <command...>
                                 Resolve each mapping into the child environment
                                 (an existing NAME wins), then exec the command
  help                           Show usage
"""

from __future__ import annotations

import json
import os
import subprocess
import sys
import urllib.error
import urllib.request

VAULT_URL = os.environ.get("PASSAGE_MCP_URL", "https://passage.lost.plus/mcp")
AUTH_BIN = os.environ.get("AUTH_BIN", os.path.expanduser("~/.local/bin/auth"))
USAGE = (
    "Usage: passage get <folder> <item> | passage list <folder>"
    " | passage run [--env NAME=folder/item]... -- <command...>"
)


class PassageError(RuntimeError):
    pass


def _bearer():
    """Resolve the passage bearer through the auth module's current login."""
    if not os.access(AUTH_BIN, os.X_OK):
        raise PassageError(f"auth module not installed at {AUTH_BIN}; run: setup install auth")
    try:
        result = subprocess.run(
            [AUTH_BIN, "token", "passage"], capture_output=True, text=True, timeout=45
        )
    except subprocess.TimeoutExpired as exc:
        raise PassageError("auth token passage timed out") from exc
    token = result.stdout.strip()
    if result.returncode or not token:
        detail = result.stderr.strip().splitlines() or ["credential unavailable"]
        raise PassageError(detail[-1])
    return token


def _vault_call(tool, arguments, token):
    """Call one passage MCP tool over direct HTTP and return its text payload."""
    body = {
        "jsonrpc": "2.0",
        "id": 1,
        "method": "tools/call",
        "params": {"name": tool, "arguments": arguments},
    }
    request = urllib.request.Request(
        VAULT_URL,
        data=json.dumps(body).encode(),
        headers={
            "Authorization": f"Bearer {token}",
            "Content-Type": "application/json",
            "Accept": "application/json, text/event-stream",
            # The vault proxy 403s Python's default UA (like Cloudflare edges).
            "User-Agent": "passage/1.0",
        },
        method="POST",
    )
    try:
        with urllib.request.urlopen(request, timeout=15) as response:
            payload = json.loads(response.read())
    except urllib.error.HTTPError as exc:
        raise PassageError(f"passage unreachable: HTTP {exc.code}") from exc
    except (OSError, urllib.error.URLError, json.JSONDecodeError) as exc:
        raise PassageError(f"passage unreachable: {exc}") from exc
    result = payload.get("result") if isinstance(payload, dict) else None
    if not isinstance(result, dict):
        detail = payload.get("error", {}).get("message") if isinstance(payload, dict) else None
        raise PassageError(detail or f"{tool}: unexpected response")
    text = "".join(
        content.get("text", "")
        for content in result.get("content", [])
        if isinstance(content, dict) and content.get("type") == "text"
    )
    if result.get("isError"):
        raise PassageError(text.replace(f"Error executing tool {tool}: ", "", 1) or f"{tool} failed")
    structured = result.get("structuredContent")
    if isinstance(structured, dict) and isinstance(structured.get("result"), str):
        return structured["result"]
    return text


def get_secret(folder, item, token):
    return _vault_call("get_secret", {"folder": folder, "item_name": item}, token)


def list_secrets(folder, token):
    text = _vault_call("list_secrets", {"folder": folder}, token)
    try:
        data = json.loads(text)
    except json.JSONDecodeError:
        data = {}
    items = data.get("items") if isinstance(data, dict) else None
    if not isinstance(items, list):
        raise PassageError("list_secrets returned an unexpected shape")
    return [item["name"] for item in items if isinstance(item, dict) and item.get("name")]


def parse_run_args(args):
    """Split `run` arguments into [(NAME, folder, item)] and the command."""
    mappings = []
    rest = list(args)
    while rest:
        head = rest.pop(0)
        if head == "--":
            break
        if head == "--env":
            if not rest:
                raise PassageError("--env needs NAME=folder/item")
            spec = rest.pop(0)
        elif head.startswith("--env="):
            spec = head[len("--env="):]
        else:
            raise PassageError(f"unexpected argument before --: {head}")
        name, sep, path = spec.partition("=")
        folder, slash, item = path.partition("/")
        if not (name and sep and folder and slash and item):
            raise PassageError(f"bad --env mapping (want NAME=folder/item): {spec}")
        mappings.append((name, folder, item))
    else:
        raise PassageError("run needs `--` before the command")
    if not rest:
        raise PassageError("run needs a command after --")
    return mappings, rest


def cmd_run(args):
    mappings, command = parse_run_args(args)
    env = dict(os.environ)
    # An existing value (CI secret, manual export) wins over the vault.
    needed = [(name, folder, item) for name, folder, item in mappings if not env.get(name)]
    if needed:
        token = _bearer()
        for name, folder, item in needed:
            env[name] = get_secret(folder, item, token)
    try:
        os.execvpe(command[0], command, env)
    except OSError as exc:
        raise PassageError(f"cannot exec {command[0]}: {exc.strerror}") from exc


def main():
    args = sys.argv[1:]
    if len(args) == 3 and args[0] == "get":
        print(get_secret(args[1], args[2], _bearer()))
        return 0
    if len(args) == 2 and args[0] == "list":
        for name in list_secrets(args[1], _bearer()):
            print(name)
        return 0
    if args and args[0] == "run":
        cmd_run(args[1:])
        return 0
    if args in (["help"], ["--help"], ["-h"]):
        print(USAGE)
        return 0
    print(USAGE, file=sys.stderr)
    return 2


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except PassageError as exc:
        print(f"passage: {exc}", file=sys.stderr)
        raise SystemExit(1)
