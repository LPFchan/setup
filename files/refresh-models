def _env_name(provider):
    return f"{provider.replace('-', '_').upper()}_API_KEY"


def _get_key(provider):
    key = os.environ.get(_env_name(provider), "")
    if not key:
        key = _read_env_block().get(_env_name(provider), "")
    if not key:
        key = _fallback_auth_json(provider)
    return key


def _load_servers():
    """Load OpenAI-compatible providers from the canonical Claudex registry."""
    try:
        registry = _validate_registry(load_json(REGISTRY_PATH))
    except (OSError, json.JSONDecodeError, ValueError) as exc:
        print(f"Cannot read provider registry {REGISTRY_PATH}: {exc}", file=sys.stderr)
        return None
    profiles = registry.get("profiles") if isinstance(registry, dict) else None
    if not isinstance(registry, dict) or registry.get("version") != 1 or not isinstance(profiles, list):
        print(f"Invalid provider registry: {REGISTRY_PATH}", file=sys.stderr)
        return None
    providers = registry.get("providers")
    entries = providers.items() if isinstance(providers, dict) else (
        (profile.get("name"), profile) for profile in profiles if isinstance(profile, dict)
    )
    servers = {}
    for name, profile in entries:
        if not isinstance(profile, dict):
            continue
        auth = profile.get("auth", {})
        if profile.get("provider_type") != "OpenAICompatible":
            continue
        if not isinstance(auth, dict) or auth.get("type") != "api-key":
            continue
        base_url = profile.get("base_url")
        auth_key = auth.get("key")
        if not all(isinstance(value, str) and value for value in (name, base_url, auth_key)):
            continue
        servers[name] = {
            "baseURL": base_url,
            "api_format": profile.get("api_format", "openai"),
            "npm": profile.get("npm", "@ai-sdk/openai-compatible"),
            "auth": {"type": "auth_json", "provider": auth_key},
            "registry_enabled": profile.get("enabled") is True,
        }
    return servers


def _load_provider_state():
    if not os.path.exists(STATE_PATH):
        return _migrate_legacy_provider_state()
    try:
        data = load_json(STATE_PATH)
    except (OSError, json.JSONDecodeError) as exc:
        print(f"Cannot read provider state {STATE_PATH}; all providers are disabled: {exc}", file=sys.stderr)
        return None
    if not isinstance(data, dict):
        print(f"Invalid provider state {STATE_PATH}; all providers are disabled", file=sys.stderr)
        return None
    if isinstance(data.get("providers"), dict):
        if os.path.exists(LEGACY_CONFIG_PATH):
            os.remove(LEGACY_CONFIG_PATH)
            print(f"Removed obsolete provider registry {LEGACY_CONFIG_PATH}")
        return data
    print(f"Invalid provider state {STATE_PATH}; all providers are disabled", file=sys.stderr)
    return None


def _migrate_legacy_provider_state():
    if not os.path.exists(LEGACY_CONFIG_PATH):
        return {"providers": {}}
    try:
        data = load_json(LEGACY_CONFIG_PATH)
    except (OSError, json.JSONDecodeError) as exc:
        print(
            f"Cannot migrate obsolete provider registry {LEGACY_CONFIG_PATH}; all providers are disabled: {exc}",
            file=sys.stderr,
        )
        return None
    legacy_servers = data.get("servers", {}) if isinstance(data, dict) else None
    if not isinstance(legacy_servers, dict):
        print(
            f"Cannot migrate obsolete provider registry {LEGACY_CONFIG_PATH}; all providers are disabled",
            file=sys.stderr,
        )
        return None
    shared_servers = _load_servers()
    if shared_servers is None:
        return None
    local_only = sorted(set(legacy_servers) - set(shared_servers))
    if local_only:
        print(
            f"Dropping obsolete local-only provider definitions: {', '.join(local_only)}",
            file=sys.stderr,
        )
    providers = {}
    for name, cfg in legacy_servers.items():
        if name in shared_servers and isinstance(cfg, dict) and isinstance(cfg.get("enabled"), bool):
            providers[name] = {"enabled": cfg["enabled"]}
    migrated = {"providers": providers}
    save_json_atomic(STATE_PATH, migrated)
    os.remove(LEGACY_CONFIG_PATH)
    print(f"Migrated provider state to {STATE_PATH} and removed {LEGACY_CONFIG_PATH}")
    return migrated


def _auth_provider(name, cfg):
    auth = cfg.get("auth", {})
    return auth.get("provider", name) if isinstance(auth, dict) else name


def _provider_enabled(name, cfg):
    provider_state = _load_provider_state()
    if provider_state is None:
        return False
    state = provider_state.get("providers", {}).get(name, {})
    if isinstance(state, dict) and "enabled" in state:
        return state["enabled"] is True
    return cfg.get("registry_enabled") is True and bool(_get_key(_auth_provider(name, cfg)))


def _sync_opencode_provider_statuses(servers):
    """Mirror managed provider status without changing unrelated providers."""
    opencode = load_json(OPENCODE_PATH) if os.path.exists(OPENCODE_PATH) else {}
    configured_disabled = opencode.get("disabled_providers", [])
    if not isinstance(configured_disabled, list):
        configured_disabled = []
    managed = set(servers)
    disabled = [name for name in configured_disabled if name not in managed]
    disabled.extend(
        name for name, cfg in servers.items() if not _provider_enabled(name, cfg)
    )
    if disabled:
        opencode["disabled_providers"] = disabled
    else:
        opencode.pop("disabled_providers", None)
    pathlib.Path(os.path.dirname(OPENCODE_PATH)).mkdir(parents=True, exist_ok=True)
    save_json(OPENCODE_PATH, opencode)


def _set_provider_enabled(provider, enabled):
    servers = _load_servers()
    if servers is None:
        return False
    if provider not in servers:
        print(f"Unknown provider: {provider}", file=sys.stderr)
        print(f"Known: {', '.join(servers.keys())}", file=sys.stderr)
        return False
    auth_provider = _auth_provider(provider, servers[provider])
    if enabled and not _get_key(auth_provider):
        print(
            f"Cannot enable {provider}: no API key. "
            f"Run: refresh-models auth {provider} <key>",
            file=sys.stderr,
        )
        return False
    state = _load_provider_state()
    if state is None:
        return False
    state.setdefault("providers", {}).setdefault(provider, {})["enabled"] = enabled
    save_json_atomic(STATE_PATH, state)
    _sync_opencode_provider_statuses(servers)
    print(f"{provider}: {'enabled' if enabled else 'disabled'}")
    return True


def _set_key(provider, key):
    block = _read_env_block()
    block[_env_name(provider)] = key
    lines = [f"export {k}={v}" for k, v in block.items()]
    _write_env_block(lines)
    _sync_zsenv_to_auth()
    print(f"Saved {_env_name(provider)} to {ZSENV_PATH} and {OLD_AUTH_PATH}")


def cmd_auth():
    """Interactive or direct API key onboarding.

    refresh-models auth                     → interactive prompt for all missing keys
    refresh-models auth <provider> <key>    → write key directly (agent-friendly)
    """
    _export_auth_to_zsenv()

    servers = _load_servers()
    if servers is None:
        sys.exit(1)

    if len(sys.argv) >= 4:
        provider = sys.argv[2]
        key = sys.argv[3]
        if provider not in servers:
            print(f"Unknown provider: {provider}", file=sys.stderr)
            print(f"Known: {', '.join(servers.keys())}", file=sys.stderr)
            sys.exit(1)
        _set_key(_auth_provider(provider, servers[provider]), key)
        if not _set_provider_enabled(provider, True):
            sys.exit(1)
        return

    existing_keys = _read_env_block()
    missing = [s for s, cfg in servers.items() if _env_name(_auth_provider(s, cfg)) not in existing_keys]
    configured = [s for s, cfg in servers.items() if _env_name(_auth_provider(s, cfg)) in existing_keys]

    if configured:
        print("Configured:")
        for s in configured:
            print(f"  {s}: ✓")
        print()

    if not missing:
        _sync_opencode_provider_statuses(servers)
        print("All provider API keys are already stored in ~/.zshenv.")
        return

    print("Providers available to enable:")
    for s in missing:
        url = PROVIDER_URLS.get(s, "")
        print(f"  {s}" + (f"  — {url}" if url else ""))
    print()

    enabled = []
    for s in missing:
        url = PROVIDER_URLS.get(s, "")
        prompt = f"  {s} API key" + (f" ({url})" if url else "") + ": "
        try:
            key = getpass.getpass(prompt)
        except (EOFError, KeyboardInterrupt):
            print()
            break
        if key.strip():
            existing_keys[_env_name(_auth_provider(s, servers[s]))] = key.strip()
            enabled.append(s)

    if enabled:
        lines = [f"export {k}={v}" for k, v in existing_keys.items()]
        _write_env_block(lines)
        _sync_zsenv_to_auth()
        state = _load_provider_state()
        if state is None:
            print("Provider state is invalid; keys were saved but enablement was not changed.", file=sys.stderr)
            return
        for name in enabled:
            state.setdefault("providers", {}).setdefault(name, {})["enabled"] = True
        save_json_atomic(STATE_PATH, state)
        _sync_opencode_provider_statuses(servers)
        print(f"\nSaved to {ZSENV_PATH}")
    else:
        print("\nNo keys entered.")


def cmd_enable():
    _export_auth_to_zsenv()

    script_path = os.path.abspath(sys.argv[0])
    cfg_dir = os.path.dirname(STATE_PATH)
    pathlib.Path(cfg_dir).mkdir(parents=True, exist_ok=True)

    if _is_macos():
        pathlib.Path(LAUNCHD_DIR).mkdir(parents=True, exist_ok=True)
        plist_path = os.path.join(LAUNCHD_DIR, f"{PLIST_NAME}.plist")
        plist = f"""<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>{PLIST_NAME}</string>
    <key>ProgramArguments</key>
    <array>
        <string>{script_path}</string>
    </array>
    <key>StartCalendarInterval</key>
    <dict>
        <key>Minute</key><integer>0</integer>
    </dict>
    <key>StandardOutPath</key>
    <string>/tmp/refresh-models.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/refresh-models.log</string>
</dict>
</plist>"""
        with open(plist_path, "w") as f:
            f.write(plist)
        _uid = os.getuid()
        subprocess.run(["launchctl", "bootout", f"gui/{_uid}/{PLIST_NAME}"],
                       capture_output=True)
        r = subprocess.run(["launchctl", "bootstrap", f"gui/{_uid}", plist_path],
                           capture_output=True)
        if r.returncode == 0:
            print("refresh-models launchd agent enabled (hourly)")
        else:
            if r.returncode == 125:
                print("no GUI session — log in on the Mac's screen first", file=sys.stderr)
            else:
                print(f"refresh-models installed but launchd enable failed (rc={r.returncode})", file=sys.stderr)
            if r.stderr:
                print(r.stderr.decode().rstrip(), file=sys.stderr)
    else:
        pathlib.Path(SERVICE_DIR).mkdir(parents=True, exist_ok=True)
        with open(os.path.join(SERVICE_DIR, "refresh-models.service"), "w") as f:
            f.write(SERVICE_UNIT % script_path)
        with open(os.path.join(SERVICE_DIR, "refresh-models.timer"), "w") as f:
            f.write(TIMER_UNIT)
        subprocess.run(["systemctl", "--user", "daemon-reload"], check=True)
        subprocess.run(
            ["systemctl", "--user", "enable", "--now", "refresh-models.timer"], check=True
        )
        print("refresh-models timer enabled (hourly)")

    # --- provider onboarding ---

    servers = _load_servers()
    if servers is None:
        raise SystemExit(1)
    _load_provider_state()
    _sync_opencode_provider_statuses(servers)
    enabled = [
        name for name, provider in servers.items()
        if _provider_enabled(name, provider)
    ]
    print(f"  Enabled providers: {', '.join(enabled) if enabled else 'none'}")
    available = [
        name for name, provider in servers.items()
        if not _get_key(_auth_provider(name, provider))
    ]
    if available:
        if sys.stdin.isatty():
            print("\n  Configure optional providers; leave a key blank to keep it disabled.\n")
            cmd_auth()
        else:
            state_home = os.environ.get(
                "XDG_STATE_HOME", os.path.expanduser("~/.local/state")
            )
            marker = os.path.join(
                state_home, "setup", "refresh-models.needs-provider-setup"
            )
            pathlib.Path(os.path.dirname(marker)).mkdir(parents=True, exist_ok=True)
            with open(marker, "w") as f:
                f.write("\n".join(available) + "\n")


def _valid_base_url(value):
    parsed = urllib.parse.urlsplit(value)
    return (
        parsed.scheme in {"http", "https"}
        and bool(parsed.hostname)
        and parsed.username is None
        and parsed.password is None
        and not parsed.query
        and not parsed.fragment
        and not any(character.isspace() for character in value)
    )


def _validate_registry(data):
    if not isinstance(data, dict) or data.get("version") != 1:
        raise ValueError("registry version must be 1")
    profiles = data.get("profiles")
    if not isinstance(profiles, list) or not profiles:
        raise ValueError("registry profiles must be a non-empty list")
    providers = data.get("providers", {})
    if providers and not isinstance(providers, dict):
        raise ValueError("registry providers must be an object")
    for provider_name, provider in providers.items():
        if not NAME_RE.fullmatch(provider_name) or not isinstance(provider, dict):
            raise ValueError(f"invalid provider: {provider_name}")
        if provider.get("provider_type") not in {"OpenAICompatible", "OpenAIResponses"}:
            raise ValueError(f"invalid provider_type for {provider_name}")
        if not isinstance(provider.get("base_url"), str) or not _valid_base_url(provider["base_url"]):
            raise ValueError(f"invalid base_url for {provider_name}")
        auth = provider.get("auth")
        if not isinstance(auth, dict):
            raise ValueError(f"invalid auth descriptor for {provider_name}")
        if provider["provider_type"] == "OpenAICompatible":
            if auth.get("type") != "api-key" or auth.get("store") != "opencode":
                raise ValueError(f"invalid API-key auth descriptor for {provider_name}")
            if not NAME_RE.fullmatch(auth.get("key", "")):
                raise ValueError(f"invalid API-key auth descriptor for {provider_name}")
            if not isinstance(provider.get("enabled"), bool):
                raise ValueError(f"enabled for {provider_name} must be a boolean")
            if provider.get("api_format") not in FORMAT_HANDLERS:
                raise ValueError(f"invalid api_format for {provider_name}")
            if not isinstance(provider.get("npm"), str) or not provider["npm"]:
                raise ValueError(f"invalid npm package for {provider_name}")
        elif auth.get("type") != "oauth" or not isinstance(auth.get("provider"), str):
            raise ValueError(f"invalid OAuth descriptor for {provider_name}")
    seen = set()
    for profile in profiles:
        if not isinstance(profile, dict):
            raise ValueError("each profile must be an object")
        name = profile.get("name")
        if not isinstance(name, str) or not NAME_RE.fullmatch(name) or name in seen:
            raise ValueError(f"invalid or duplicate profile name: {name}")
        seen.add(name)
        provider_name = profile.get("provider")
        if provider_name is not None and providers and provider_name not in providers:
            raise ValueError(f"unknown provider for {name}: {provider_name}")
        if provider_name in providers:
            provider = providers[provider_name]
            for field in ("provider_type", "base_url", "auth"):
                if profile.get(field) != provider.get(field):
                    raise ValueError(f"{field} for {name} disagrees with provider {provider_name}")
        if profile.get("provider_type") not in {"OpenAICompatible", "OpenAIResponses"}:
            raise ValueError(f"invalid provider_type for {name}")
        if not isinstance(profile.get("base_url"), str) or not _valid_base_url(profile["base_url"]):
            raise ValueError(f"invalid base_url for {name}")
        auth = profile.get("auth")
        if not isinstance(auth, dict) or auth.get("type") not in {"api-key", "oauth"}:
            raise ValueError(f"invalid auth descriptor for {name}")
        if auth["type"] == "api-key" and (
            auth.get("store") != "opencode" or not NAME_RE.fullmatch(auth.get("key", ""))
        ):
            raise ValueError(f"invalid API-key auth descriptor for {name}")
        models = profile.get("models")
        if not isinstance(models, dict) or set(models) != {"haiku", "sonnet", "opus"}:
            raise ValueError(f"invalid model mapping for {name}")
    return data


def _choose(prompt, options):
    if shutil.which("fzf") and sys.stdin.isatty():
        proc = subprocess.run(
            ["fzf", "--prompt", f"{prompt} > ", "--height=50%", "--reverse"],
            input="\n".join(options) + "\n",
            text=True,
            stdout=subprocess.PIPE,
        )
        return proc.stdout.rstrip("\n") if proc.returncode == 0 else None
    if not sys.stdin.isatty():
        raise ValueError("interactive provider creation requires a TTY")
    print(prompt)
    for index, option in enumerate(options, 1):
        print(f"  {index}. {option}")
    print("  0. Cancel")
    while True:
        raw = input("Select: ").strip()
        if raw == "0":
            return None
        if raw.isdigit() and 1 <= int(raw) <= len(options):
            return options[int(raw) - 1]
        print("Enter a listed number.", file=sys.stderr)


def _run_git(args, cwd=None, capture=False):
    proc = subprocess.run(
        ["git", *args],
        cwd=cwd,
        text=True,
        stdout=subprocess.PIPE if capture else None,
        stderr=subprocess.PIPE,
    )
    if proc.returncode:
        raise ValueError(proc.stderr.strip() if proc.stderr else "git command failed")
    return proc.stdout.rstrip("\r\n") if capture and proc.stdout else ""


def _load_auth_strict():
    if not os.path.exists(OLD_AUTH_PATH):
        return {}
    try:
        data = load_json(OLD_AUTH_PATH)
    except (OSError, json.JSONDecodeError) as exc:
        raise ValueError(f"cannot read local auth store {OLD_AUTH_PATH}: {exc}") from exc
    if not isinstance(data, dict):
        raise ValueError(f"local auth store {OLD_AUTH_PATH} must contain a JSON object")
    return data


def _store_token(name, token):
    data = _load_auth_strict()
    if name in data:
        raise ValueError(f"the local auth store already contains an entry named {name}")
    data[name] = {"type": "api", "key": token}
    pathlib.Path(os.path.dirname(OLD_AUTH_PATH)).mkdir(parents=True, exist_ok=True)
    fd, tmp_name = tempfile.mkstemp(prefix=".auth.", dir=os.path.dirname(OLD_AUTH_PATH))
    try:
        os.fchmod(fd, 0o600)
        with os.fdopen(fd, "w") as handle:
            json.dump(data, handle, indent=2, sort_keys=True)
            handle.write("\n")
        os.replace(tmp_name, OLD_AUTH_PATH)
    finally:
        try:
            os.unlink(tmp_name)
        except FileNotFoundError:
            pass


def _provider_consumer_modules():
    modules = ["refresh-models"]
    if os.path.isfile(OPENCODEX_BIN) and os.access(OPENCODEX_BIN, os.X_OK):
        modules.insert(0, "opencodex")
    if os.path.isfile(CLAUDEX_BIN) and os.access(CLAUDEX_BIN, os.X_OK):
        modules.insert(0, "claudex")
    return modules


def _provision_provider(profile, token):
    auth_data = _load_auth_strict()
    if profile["name"] in auth_data:
        raise ValueError(
            f"the local auth store already contains an entry named {profile['name']}"
        )
    with tempfile.TemporaryDirectory(prefix="refresh-models-provider-") as temp:
        clone = pathlib.Path(temp) / "setup"
        _run_git(["clone", "--quiet", "--branch", "main", "--single-branch", SETUP_REPO, str(clone)])
        registry_path = clone / "files/claudex-profiles.json"
        data = _validate_registry(load_json(registry_path))
        if any(item["name"] == profile["name"] for item in data["profiles"]):
            raise ValueError(f"provider {profile['name']} already exists in the setup repository")
        if profile["name"] in data.get("providers", {}):
            raise ValueError(f"provider {profile['name']} already exists in the setup repository")
        data.setdefault("providers", {})[profile["name"]] = {
            "provider_type": profile["provider_type"],
            "base_url": profile["base_url"],
            "api_format": "openai",
            "npm": "@ai-sdk/openai-compatible",
            "auth": profile["auth"],
            "enabled": True,
        }
        data["profiles"].append(profile)
        _validate_registry(data)
        registry_path.write_text(json.dumps(data, indent=2, ensure_ascii=False) + "\n")
        changed = _run_git(["status", "--porcelain"], cwd=clone, capture=True).splitlines()
        if not changed or any(line[3:] != "files/claudex-profiles.json" for line in changed):
            raise ValueError("temporary clone contains changes outside the provider registry")
        _run_git(["diff", "--check"], cwd=clone)
        _run_git(["add", "--", "files/claudex-profiles.json"], cwd=clone)
        _run_git(
            [
                "-c", "user.name=refresh-models",
                "-c", "user.email=refresh-models@localhost",
                "commit", "--quiet", "-m", f"Add provider {profile['name']}",
            ],
            cwd=clone,
        )
        _run_git(["push", "--quiet", "origin", "HEAD:main"], cwd=clone)
        commit = _run_git(["rev-parse", "HEAD"], cwd=clone, capture=True)
    _store_token(profile["name"], token)
    env = os.environ.copy()
    env["LINUX_SETUP_SOURCE_URL"] = RAW_REPO.rstrip("/") + "/" + commit
    modules = _provider_consumer_modules()
    proc = subprocess.run([SETUP_BIN, "update", *modules], env=env)
    if proc.returncode:
        raise ValueError(
            "the provider was pushed and its token was stored, but setup provisioning failed; rerun setup update"
        )


def _add_provider():
    registry = _validate_registry(load_json(REGISTRY_PATH))
    existing = {profile["name"] for profile in registry["profiles"]}
    existing.update(registry.get("providers", {}))
    name = input("Provider name: ").strip()
    if not NAME_RE.fullmatch(name) or name in existing:
        raise ValueError("provider names must be unique lowercase letters, digits, or hyphens")
    if name in _load_auth_strict():
        raise ValueError("the local auth store already uses that name")
    base_url = input("OpenAI-compatible API base URL: ").strip().rstrip("/")
    if not _valid_base_url(base_url):
        raise ValueError("the API base URL must be an HTTP(S) URL")
    token = getpass.getpass("API token: ")
    if not token:
        raise ValueError("the API token cannot be empty")
    payload = fetch_models(base_url, {"type": "bearer", "key": token})
    rows = payload.get("data", payload.get("models", [])) if isinstance(payload, dict) else []
    models = sorted({row.get("id") for row in rows if isinstance(row, dict) and row.get("id")})
    if not models:
        raise ValueError("the endpoint returned no model IDs")
    mappings = {}
    for alias in ("opus", "sonnet", "haiku"):
        selected = _choose(f"Map {alias}", models)
        if selected is None:
            return
        mappings[alias] = selected
    profile = {
        "name": name,
        "provider": name,
        "provider_type": "OpenAICompatible",
        "base_url": base_url,
        "auth": {"type": "api-key", "store": "opencode", "key": name},
        "default_model": mappings["opus"],
        "priority": max(0, 80 - len(existing)),
        "enabled": True,
        "strip_params": "Auto",
        "models": {
            "haiku": mappings["haiku"],
            "sonnet": mappings["sonnet"],
            "opus": mappings["opus"],
        },
    }
    _validate_registry({"version": 1, "profiles": [profile]})
    print("\nProvider to publish:")
    print(f"  name: {name}")
    print(f"  endpoint: {base_url}")
    for alias in ("opus", "sonnet", "haiku"):
        print(f"  {alias}: {mappings[alias]}")
    print("  token: [stored locally]")
    if input("Commit to LPFchan/setup main and provision this machine? [y/N] ").strip().lower() != "y":
        return
    _provision_provider(profile, token)
    print(f"refresh-models: provider {name} added and provisioned")


def cmd_provider():
    if len(sys.argv) == 3 and sys.argv[2] == "add":
        try:
            _add_provider()
        except (OSError, json.JSONDecodeError, ValueError) as exc:
            print(f"refresh-models: {exc}", file=sys.stderr)
            sys.exit(1)
        return
    if len(sys.argv) != 4 or sys.argv[2] not in ("enable", "disable"):
        print(
            "Usage: refresh-models provider add | [enable|disable] <provider>",
            file=sys.stderr,
        )
        sys.exit(1)
    if not _set_provider_enabled(sys.argv[3], sys.argv[2] == "enable"):
        sys.exit(1)


def cmd_disable():
    if _is_macos():
        plist_path = os.path.join(LAUNCHD_DIR, f"{PLIST_NAME}.plist")
        if os.path.exists(plist_path):
            _uid = os.getuid()
            subprocess.run(["launchctl", "bootout", f"gui/{_uid}/{PLIST_NAME}"],
                           capture_output=True)
            os.remove(plist_path)
        print("refresh-models launchd agent disabled")
    else:
        subprocess.run(
            ["systemctl", "--user", "disable", "--now", "refresh-models.timer"],
            capture_output=True,
        )
        for f in ["refresh-models.service", "refresh-models.timer"]:
            p = os.path.join(SERVICE_DIR, f)
            if os.path.exists(p):
                os.remove(p)
        subprocess.run(["systemctl", "--user", "daemon-reload"], check=True)
        print("refresh-models timer disabled")


def cmd_status():
    if _is_macos():
        plist_path = os.path.join(LAUNCHD_DIR, f"{PLIST_NAME}.plist")
        if os.path.exists(plist_path):
            result = subprocess.run(
                ["launchctl", "print", f"gui/{os.getuid()}/{PLIST_NAME}"],
                capture_output=True, text=True,
            )
            if result.returncode == 0:
                print("timer: active (launchd hourly)")
            else:
                print("timer: not loaded")
        else:
            print("timer: not installed")
    else:
        result = subprocess.run(
            ["systemctl", "--user", "is-active", "refresh-models.timer"],
            capture_output=True, text=True,
        )
        state = result.stdout.strip()
        if state == "active":
            next_run = subprocess.run(
                ["systemctl", "--user", "show", "-p", "NextElapseUSecRealtime", "refresh-models.timer"],
                capture_output=True, text=True,
            ).stdout.strip().split("=")[-1]
            print(f"timer: active (next: {next_run})")
        else:
            print(f"timer: {state}")
    servers = _load_servers() or {}
    print(f"servers configured: {len(servers)}")
    for name, provider in servers.items():
        state = "enabled" if _provider_enabled(name, provider) else "disabled"
        key_status = "key: ✓" if _get_key(_auth_provider(name, provider)) else "key: ✗"
        print(f"  {name}: {state}  {provider.get('baseURL')}  {key_status}")


# --- main -------------------------------------------------------------


def main():
    args = sys.argv[1:]

    if args and args[0] == "__validate":
        try:
            _validate_registry(load_json(args[1]))
        except (IndexError, OSError, json.JSONDecodeError, ValueError) as exc:
            print(f"refresh-models: {exc}", file=sys.stderr)
            sys.exit(1)
        return

    if args and args[0] == "__migrate-state":
        if _load_provider_state() is None:
            sys.exit(1)
        return

    if not args:
        _source_zsenv()
        _export_auth_to_zsenv()
        _sync_zsenv_to_auth()
        servers = _load_servers()
        if servers is None:
            sys.exit(1)
        _sync_opencode_provider_statuses(servers)
        for name, srv_cfg in servers.items():
            if not _provider_enabled(name, srv_cfg):
                continue
            refresh_server(name, srv_cfg)
        return

    cmd = args[0]

    if cmd == "--list":
        servers = _load_servers()
        if servers is None:
            sys.exit(1)
        for name in servers:
            print(name)
        return

    if cmd == "enable":
        cmd_enable()
        return

    if cmd == "disable":
        cmd_disable()
        return

    if cmd == "status":
        cmd_status()
        return

    if cmd == "auth":
        cmd_auth()
        return

    if cmd == "provider":
        cmd_provider()
        return

    if cmd in ("--help", "-h", "help"):
        print("refresh-models — probe /v1/models and update opencode.json")
        print()
        print("Usage:")
        print("  refresh-models              Refresh all enabled providers")
        print("  refresh-models <provider>   Refresh a single enabled provider")
        print("  refresh-models --list       List configured provider names")
        print("  refresh-models enable       Install systemd/launchd timer (hourly)")
        print("  refresh-models disable      Remove timer")
        print("  refresh-models status       Show timer state and next run")
        print("  refresh-models auth         Interactive API key setup")
        print("  refresh-models auth <p> <k> Write key directly (agent-friendly)")
        print("  refresh-models provider add          Add a shared provider")
        print("  refresh-models provider enable <p>   Enable a keyed provider")
        print("  refresh-models provider disable <p>  Disable a provider")
        print("  refresh-models --help       Show this message")
        return

    servers = _load_servers()
    if servers is None:
        sys.exit(1)
    if cmd in servers:
        if not _provider_enabled(cmd, servers[cmd]):
            print(
                f"{cmd} is disabled. Run: refresh-models provider enable {cmd}",
                file=sys.stderr,
            )
            sys.exit(1)
        _sync_opencode_provider_statuses(servers)
        refresh_server(cmd, servers[cmd])
        return

    print(f"Unknown: {cmd}", file=sys.stderr)
    print(f"Usage: refresh-models [enable|disable|status|auth|provider|--list|<provider>]", file=sys.stderr)
    sys.exit(1)


if __name__ == "__main__":
    main()
