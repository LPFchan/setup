CONSUMER_SYNC_LOCK = HOME/".config/auth/consumer-sync.lock"

def eprint(*a): print(*a, file=sys.stderr)

def _claude_maintenance_env(base=None):
    """Manage MCP config and the CLI without refreshing the user's login.

    Claude's normal startup refreshes OAuth even for `mcp get` and `update`.
    A rejected refresh can erase the shared login used by running T3 sessions.
    Minimal mode skips OAuth reads while retaining these maintenance commands.
    Keep it confined to child processes; interactive sessions need normal auth.
    """
    env = dict(os.environ if base is None else base)
    env["CLAUDE_CODE_SIMPLE"] = "1"
    return env

@contextlib.contextmanager
def _consumer_sync_lock():
    CONSUMER_SYNC_LOCK.parent.mkdir(parents=True, exist_ok=True)
    with open(CONSUMER_SYNC_LOCK, "a+") as handle:
        os.chmod(CONSUMER_SYNC_LOCK, 0o600)
        fcntl.flock(handle.fileno(), fcntl.LOCK_EX)
        try:
            yield
        finally:
            fcntl.flock(handle.fileno(), fcntl.LOCK_UN)

def load_json(path):
    if not os.path.exists(path): return {}
    try:
        with open(path) as f: return json.load(f)
    except json.JSONDecodeError as exc:
        q = str(path)+".corrupt"; os.replace(path, q)
        eprint("  %s was corrupt (%s); moved aside and rebuilding" % (path, exc))
        return {}

def save_text_atomic(path, text):
    """Replace the file in one rename, so a reader never sees it half written.
    The target is resolved first: replacing a symlink would cut it loose."""
    path = os.path.realpath(path)
    directory = os.path.dirname(path)
    pathlib.Path(directory).mkdir(parents=True, exist_ok=True)
    try: mode = os.stat(path).st_mode & 0o777
    except FileNotFoundError: mode = 0o600
    fd, tmp = tempfile.mkstemp(prefix=".harnesses.", dir=directory)
    try:
        with os.fdopen(fd, "w") as h:
            h.write(text); h.flush(); os.fsync(h.fileno())
        os.chmod(tmp, mode); os.replace(tmp, path)
    finally:
        try: os.unlink(tmp)
        except FileNotFoundError: pass

def save_json_atomic(path, data):
    save_text_atomic(path, json.dumps(data, indent=2) + "\n")

def deep_merge(base, overlay):
    out = dict(base)
    for k, v in overlay.items():
        if k in out and isinstance(out[k], dict) and isinstance(v, dict):
            out[k] = deep_merge(out[k], v)
        else:
            out[k] = v
    return out

class VaultError(RuntimeError): pass
class CommonAuthError(RuntimeError):
    def __init__(self, message, authoritative=False):
        super().__init__(message)
        self.authoritative = authoritative

class CommonAuthContextChanged(CommonAuthError): pass

def common_auth_token(scope, context=None):
    if not os.access(AUTH_BIN, os.X_OK):
        raise CommonAuthError("auth module not installed; run: setup install auth")
    try:
        command = [AUTH_BIN, "token", scope]
        if context is not None:
            command.extend(["--expect-context", json.dumps(
                context, sort_keys=True, separators=(",", ":"))])
        result = subprocess.run(command, capture_output=True, text=True, timeout=45)
    except subprocess.TimeoutExpired as exc:
        raise CommonAuthError("credential refresh timed out") from exc
    token = result.stdout.strip()
    if result.returncode == 5:
        raise CommonAuthContextChanged("setup login changed during sync")
    if result.returncode or not token:
        raise CommonAuthError(
            result.stderr.strip() or "credential unavailable",
            authoritative=result.returncode in (3, 4),
        )
    return token

def common_auth_context():
    """Return the non-secret Auth origin/account binding for managed copies."""
    if not os.access(AUTH_BIN, os.X_OK):
        raise CommonAuthError("auth module not installed; run: setup install auth")
    try:
        result = subprocess.run([AUTH_BIN, "context"], capture_output=True,
                                text=True, timeout=10)
    except subprocess.TimeoutExpired as exc:
        raise CommonAuthError("Auth context lookup timed out") from exc
    if result.returncode:
        raise CommonAuthError(result.stderr.strip() or "Auth context unavailable")
    try:
        context = json.loads(result.stdout)
    except json.JSONDecodeError as exc:
        raise CommonAuthError("Auth returned an invalid account context") from exc
    if (not isinstance(context, dict)
            or not isinstance(context.get("origin"), str) or not context["origin"]
            or not isinstance(context.get("subject"), str) or not context["subject"]):
        raise CommonAuthError("Auth returned an invalid account context")
    return {"origin": context["origin"], "subject": context["subject"]}

HUB_SERVICES_PATH = "/api/services"
HUB_SUFFIX = ".lost.plus"

def hub_services(context):
    """Registry rows the signed-in account is admitted to, from the hub.

    The credential is the account's global machine token, fetched through the
    auth module like every other Common Auth credential: the hub accepts it on
    this route without a service key because a global token is already valid
    for every service. A per-service login holds no such token, and the hub
    refuses a scoped one here, so that login cannot enumerate the registry --
    it fails with a clear message rather than enrolling a partial set.
    """
    try:
        token = common_auth_token("*", context)
    except CommonAuthContextChanged:
        raise
    except CommonAuthError as exc:
        raise CommonAuthError(
            "no global machine token to read the service registry with (%s)" % exc,
            authoritative=exc.authoritative) from exc
    request = urllib.request.Request(context["origin"] + HUB_SERVICES_PATH, headers={
        "Authorization": "Bearer " + token, "Accept": "application/json",
        "User-Agent": "harnesses/1.0"})
    try:
        with urllib.request.urlopen(request, timeout=15) as response:
            rows = json.loads(response.read())
    except urllib.error.HTTPError as exc:
        raise CommonAuthError("service registry returned HTTP %d" % exc.code,
                              authoritative=exc.code in (401, 403)) from exc
    except (OSError, urllib.error.URLError, json.JSONDecodeError) as exc:
        raise CommonAuthError("service registry unreachable: %s" % exc) from exc
    if not isinstance(rows, list) or not all(
            isinstance(row, dict) and all(isinstance(row.get(k), str) for k in ("key", "mcp_url", "token_key"))
            for row in rows):
        raise CommonAuthError("service registry returned an invalid row list")
    return rows


def hub_mcp_servers(context):
    """The lost.plus MCP set, in the shape a manifest entry has.

    Every admitted row with an mcp_url is one server. The name is the registry
    key with .lost.plus stripped, so okdam.lost.plus enrolls as okdam beside
    the third-party names. A row with a token_key is a bearer server under
    that scope; one without is anonymous. Rows without an mcp_url are apps,
    not MCPs, and are skipped.
    """
    servers = []
    for row in hub_services(context):
        if not row["mcp_url"]:
            continue
        key = row["key"]
        name = key[:-len(HUB_SUFFIX)] if key.endswith(HUB_SUFFIX) else key
        if row["token_key"]:
            servers.append({"name": name, "url": row["mcp_url"], "auth": "bearer",
                            "credentialSource": "common-auth", "scope": row["token_key"]})
        else:
            servers.append({"name": name, "url": row["mcp_url"], "auth": "none"})
    return servers


def local_plugin_mcp_servers():
    """Import machine-local Codex plugin launch settings for Claude on Macs."""
    if not _is_macos():
        return []
    codex_home = HOME/".codex"
    servers = []
    for spec in MANIFEST.get("localPluginMcpServers", []):
        root = codex_home/"plugins/cache/openai-bundled"/spec["plugin"]
        versions = [p for p in root.glob("*")
                    if p.is_dir() and re.fullmatch(r"\d+(?:\.\d+)*", p.name)]
        if not versions:
            print("  %s: Codex plugin not installed; skipped" % spec["name"])
            continue
        latest = max(versions, key=lambda p: tuple(int(n) for n in p.name.split(".")))
        try:
            entry = json.loads((latest/".mcp.json").read_text())["mcpServers"][spec["server"]]
            command = entry["command"]
            args, env = entry.get("args", []), entry.get("env", {})
            if (not isinstance(command, str) or not pathlib.Path(command).is_absolute()
                    or not os.access(command, os.X_OK)
                    or not isinstance(args, list) or not all(isinstance(a, str) for a in args)
                    or not isinstance(env, dict)
                    or not all(isinstance(k, str) and isinstance(v, str) for k, v in env.items())
                    or entry.get("enabled") is False or entry.get("env_vars")):
                raise ValueError("unsupported or unavailable plugin launch configuration")
            env = {**env, **spec.get("env", {})}
            if not all(isinstance(k, str) and isinstance(v, str) for k, v in env.items()):
                raise ValueError("invalid plugin environment overrides")
            if any("${" in value for value in [command, *args, *env.values()]):
                raise ValueError("unresolved plugin placeholders")
        except (OSError, ValueError, KeyError, TypeError) as exc:
            eprint("  %s: cannot import %s: %s; existing Claude registration preserved" %
                   (spec["name"], latest/".mcp.json", exc))
            continue
        servers.append({"name": spec["name"], "auth": "none", "surfaces": ["claude"],
                        "stdio": {"type": "stdio", "command": command, "args": args, "env": env}})
    return servers


def all_mcp_servers(context):
    """Hub servers, manifest third-party servers, and available local plugins."""
    hub = hub_mcp_servers(context)
    taken = {s["name"] for s in hub}
    external = list(MANIFEST["mcpServers"]) + local_plugin_mcp_servers()
    clash = sorted(taken & {s["name"] for s in external})
    if clash:
        raise CommonAuthError("manifest names servers the registry already provides: %s"
                              % ", ".join(clash))
    return hub + external


def mcp_grants(servers):
    """The claude permission namespace each enrolled server needs."""
    return ["mcp__%s__*" % s["name"] for s in servers if "claude" in mcp_surfaces(s)]

def _vault_call(tool, arguments):
    if not VAULT_TOKEN: raise VaultError("vault token not set")
    body = {"jsonrpc":"2.0","id":id(arguments),"method":"tools/call","params":{"name":tool,"arguments":arguments}}
    req = urllib.request.Request(VAULT_URL, data=json.dumps(body).encode(), headers={
        "Authorization": "Bearer "+VAULT_TOKEN, "Content-Type":"application/json",
        "Accept":"application/json, text/event-stream", "User-Agent":"harnesses/1.0"}, method="POST")
    try:
        with urllib.request.urlopen(req, timeout=10) as resp:
            payload = json.loads(resp.read())
    except (OSError, urllib.error.URLError, json.JSONDecodeError) as exc:
        raise VaultError("vault unreachable: %s" % exc) from exc
    result = payload.get("result", {})
    if result.get("isError"): raise VaultError(str(result))
    content = result.get("content", [])
    return content[0].get("text","") if content else ""

def vault_get(item_name):
    text = _vault_call("get_secret", {"folder":VAULT_FOLDER,"item_name":item_name})
    if not text: raise VaultError("empty secret for "+item_name)
    return text.strip()

def _expand(p): return os.path.expanduser(p)

def _version_key(path):
    return [int(x) if x.isdigit() else x for x in re.split(r"(\d+)", path)]

def _expand_candidates(patterns):
    """Expand ~ and globs; a glob yields its matches newest-version first.

    t3 installed through npx (the older Linux route) leaves no ~/.local/bin/t3,
    only ~/.t3/runtime/versions/<v>/t3, so the newest of those is the copy to
    run `t3 update` with.
    """
    out = []
    for p in patterns:
        p = _expand(p)
        if any(ch in p for ch in "*?["):
            out.extend(sorted(glob.glob(p), key=_version_key, reverse=True))
        else:
            out.append(p)
    return out

def _node_bin_dirs():
    dirs = []
    nvm = os.environ.get("NVM_BIN")
    if nvm and os.path.isdir(nvm): dirs.append(nvm)
    if os.path.isdir("/opt/node/bin"): dirs.append("/opt/node/bin")
    for base in (HOME/".nvm/versions/node", pathlib.Path("/opt")):
        if base.exists():
            for d in sorted(base.glob("*/bin"), reverse=True): dirs.append(str(d))
    return dirs

def _owning_node_bin(binpath):
    """The bin/ of the node install that npm put `binpath` under, or None.

    ~/.local/bin/codex is a symlink into one node install's node_modules, and
    its own directory holds neither node nor npm. codex and claude self-update
    by shelling out to `npm install -g`, so the npm first on PATH decides which
    install the new version lands in: read the harness on one node, rewrite it
    on another, and the copy in use never moves. Handing the updater the bin/
    of its own install keeps both sides on one node.
    """
    for parent in pathlib.Path(os.path.realpath(binpath)).parents:
        if parent.name == "node_modules" and parent.parent.name == "lib":
            candidate = parent.parent.parent/"bin"
            if (candidate/"npm").exists(): return str(candidate)
    return None

HARNESS_VERSION_TIMEOUT_SECONDS = 20

def harness_version(binpath):
    """The harness's own `--version`, first line, or None if it will not say.

    An updater that exits 0 is not evidence that it updated anything: a
    Homebrew-managed opencode answers `opencode upgrade` with "already
    installed" and exits 0 while a newer release sits in the tap. Reading the
    version on both sides of the run is what turns that silent no-op into a
    line the operator can see.
    """
    try:
        r = subprocess.run([binpath, "--version"], capture_output=True, text=True,
                           stdin=subprocess.DEVNULL,
                           timeout=HARNESS_VERSION_TIMEOUT_SECONDS)
    except (OSError, subprocess.SubprocessError):
        return None
    if r.returncode != 0:
        return None
    line = (r.stdout or r.stderr or "").strip().splitlines()
    return line[0].strip() if line else None

def harness_resolve(name, spec):
    c = shutil.which(name)
    if c: return c
    candidates = _expand_candidates(spec.get("candidates", []))
    if name in ("claude","codex"):
        try:
            prefix = subprocess.run(["npm","config","get","prefix"], capture_output=True, text=True, timeout=5).stdout.strip()
            if prefix and prefix != "undefined": candidates.append(os.path.join(prefix,"bin",name))
        except Exception: pass
        for d in _node_bin_dirs(): candidates.append(os.path.join(d,name))
    for c in candidates:
        if os.path.isfile(c) and os.access(c, os.X_OK): return c
    return None

def harnesses(): return [(h["name"], h) for h in MANIFEST["harnesses"]]

def cmd_install(names):
    specs = dict(harnesses())
    # Bare `harnesses install` only installs the harnesses marked default;
    # name any other harness to install it on this machine.
    targets = names or [n for n,s in harnesses() if s.get("default")]
    needs_node = [n for n in targets if specs.get(n, {}).get("needsNode")]
    if needs_node and not shutil.which("node"):
        print("node is required for %s but not found." % "/".join(needs_node))
        print("  Install node via nvm (https://github.com/nvm-sh/nvm) or /opt/node, then re-run.")
    rc = 0
    for name in targets:
        spec = specs.get(name)
        if not spec:
            eprint("  unknown harness: "+name); rc = 1; continue
        cmd = spec.get("install","").strip()
        if not cmd:
            print("  %s: no first-party installer registered; skipping." % name); continue
        # A rerunnable installer repairs a partial install itself (t3: CLI
        # present but its background service missing), so it runs anyway.
        if harness_resolve(name, spec) and not spec.get("rerunWhenInstalled"):
            print("  %s: already installed; skipping." % name); continue
        print("  installing %s: %s" % (name, cmd))
        # Installers are `curl ... | sh` pipelines. Without pipefail a failed
        # download feeds the shell empty input, which exits 0 and reports an
        # install that never happened.
        if subprocess.run(["bash","-o","pipefail","-c",cmd]).returncode != 0:
            eprint("  %s: install failed" % name); rc = 1
    return rc

def cmd_update(names):
    specs = dict(harnesses())
    targets = names or list(specs)
    present = 0; missing = []; failed = []; unchanged = []
    for name in targets:
        spec = specs.get(name)
        if not spec:
            eprint("  unknown harness: "+name); failed.append(name); continue
        binpath = harness_resolve(name, spec)
        if not binpath:
            missing.append(name); continue
        present += 1
        argv = [binpath] + spec.get("updateArgs","update").split()
        if spec.get("updateEnv"): argv = ["env", spec["updateEnv"]] + argv
        print("Updating harness %s (%s)" % (name, binpath))
        env = dict(os.environ)
        lead = [os.path.dirname(binpath)]
        owner = _owning_node_bin(binpath)
        if owner and owner not in lead: lead.insert(0, owner)
        env["PATH"] = os.pathsep.join(lead+[env.get("PATH","")])
        if name == "claude":
            env = _claude_maintenance_env(env)
        # A version probe is the only thing that distinguishes "already
        # current" from "the updater did nothing and said nothing".
        before = harness_version(binpath)
        try:
            r = subprocess.run(argv, stdin=subprocess.DEVNULL, env=env,
                               timeout=int(os.environ.get("SETUP_HARNESS_TIMEOUT","900")))
            if r.returncode != 0:
                failed.append(name)
                continue
        except subprocess.TimeoutExpired:
            failed.append(name)
            continue
        after = harness_version(binpath)
        if before and after and before != after:
            print("  %s -> %s" % (before, after))
        elif before and after:
            print("  %s (unchanged)" % after)
            unchanged.append(name)
    if present == 0:
        print("No AI harnesses installed.")
    elif missing:
        print("Not installed, skipped: "+" ".join(missing))
    if unchanged:
        # Usually this just means the machine was already current. It is also
        # exactly what a broken updater looks like, so name the harnesses
        # rather than leaving a clean run indistinguishable from a stuck one.
        print("Already current, or the updater did nothing: "+" ".join(unchanged))
    if failed:
        eprint("harness(es) could not be updated: "+" ".join(failed))
    return 0 if not failed else 1

def _write_claude_settings(servers):
    spec = MANIFEST["settings"]["claude"]
    overlay = spec["json"]
    current = load_json(CLAUDE_SETTINGS)
    merged = deep_merge(current, overlay)
    # permissions.allow is union-merged, never replaced, so the module cannot
    # clobber an operator's existing (often longer) allow list. The MCP tool
    # namespaces are derived from the servers being enrolled rather than listed
    # by hand, so a server cannot enroll under a name the allow-list does not
    # grant.
    allow_add = list(spec.get("permissionsAllowAdd", [])) + mcp_grants(servers)
    if allow_add:
        existing = merged.setdefault("permissions", {}).get("allow", [])
        seen = set(existing)
        for entry in allow_add:
            if entry not in seen:
                existing.append(entry)
        # Union-merging alone can add a grant but never drop one, so a name that
        # changed -- or a connector that was switched off -- keeps its grants
        # permanently. Match the whole mcp__<name>__ namespace, not just the
        # wildcard entry: a connector granted per tool leaves fifteen rows, and
        # dropping only "mcp__<name>__*" would miss every one of them.
        retired = tuple(
            "mcp__%s__" % n
            for n in ((MANIFEST.get("retiredMcpServers") or [])
                      + (MANIFEST.get("retiredMcpGrants") or []))
        )
        merged["permissions"]["allow"] = [
            e for e in existing if not (retired and e.startswith(retired))
        ]
    save_json_atomic(CLAUDE_SETTINGS, merged)
    print("  wrote %s" % CLAUDE_SETTINGS)

def _effort_descriptors_by_slug():
    """Model slug -> a t3 'effort' option descriptor, from the proxy's catalog.

    t3 only renders a reasoning selector for a custom model that declares its
    own option descriptors; a bare {slug,name} entry gets none. The levels a
    model accepts are not ours to know -- the provider publishes them and the
    proxy republishes them as reasoning_efforts -- so read them rather than
    keeping a table that drifts the first time a model is swapped.

    A model the proxy cannot describe is simply left without a selector, which
    is the honest state: guessing a level the model rejects is how the request
    fails.
    """
    try:
        with urllib.request.urlopen(
            "http://127.0.0.1:%d/v1/models" % _proxy_port(),
            timeout=T3_MODEL_CATALOG_TIMEOUT_SECONDS,
        ) as resp:
            payload = json.load(resp)
    except (OSError, urllib.error.URLError, json.JSONDecodeError):
        return {}
    out = {}
    for row in (payload.get("data") or []) if isinstance(payload, dict) else []:
        if not isinstance(row, dict) or not isinstance(row.get("id"), str):
            continue
        levels = row.get("reasoning_efforts")
        if not isinstance(levels, list):
            continue
        options = []
        for level in levels:
            if not isinstance(level, dict) or not isinstance(level.get("value"), str):
                continue
            label = level.get("label")
            if not isinstance(label, str) or not label:
                label = level["value"]
            # The proxy labels every rung "<Level> Effort"; the column it lands
            # in is already called Reasoning, so drop the repeat.
            if label.endswith(" Effort"):
                label = label[: -len(" Effort")]
            option = {"id": level["value"], "label": label}
            if level.get("default") is True:
                option["isDefault"] = True
            options.append(option)
        if options:
            out[row["id"]] = {
                "id": "effort",
                "label": "Reasoning",
                "type": "select",
                "options": options,
            }
    return out


# T3 launches this shim with the selected --model on every session start.
CLAUDE_GPT_CONTEXT_LAUNCHER = """#!/usr/bin/env python3
import os
import sys

args = sys.argv[1:]
model = os.environ.get("ANTHROPIC_MODEL", "")
for index, arg in enumerate(args):
    if arg == "--model" and index + 1 < len(args):
        model = args[index + 1]
    elif arg.startswith("--model="):
        model = arg.split("=", 1)[1]
if model in ("gpt-6.1-sol", "gpt-6-luna"):
    os.environ["CLAUDE_CODE_MAX_CONTEXT_TOKENS"] = "272000"
os.execvp("claude", ["claude", *args])
"""


def _write_t3_settings():
    models = MANIFEST["settings"]["t3"]["claudeCustomModels"]
    current = load_json(T3_SETTINGS)
    inst = current.setdefault("providerInstances", {})
    claude = inst.setdefault("claudeAgent", {"driver":"claudeAgent","enabled":True,"config":{}})
    config = claude.setdefault("config", {})
    launcher = HOME / ".local/bin/claude-gpt-context"
    if config.get("binaryPath", "claude") in ("claude", str(launcher)):
        launcher.parent.mkdir(parents=True, exist_ok=True)
        save_text_atomic(launcher, CLAUDE_GPT_CONTEXT_LAUNCHER)
        launcher.chmod(0o755)
        config["binaryPath"] = str(launcher)
    existing = config.get("customModels", [])
    # Append what is missing, and refresh the fields the manifest owns on rows
    # that are already there -- an entry added before the manifest grew a
    # 'capabilities' block would otherwise keep its bare shape forever, and t3
    # shows no reasoning selector for a model without option descriptors.
    # Operator-added slugs the manifest does not name are left untouched.
    descriptors = _effort_descriptors_by_slug()
    by_slug = {}
    for m in models:
        entry = dict(m)
        # A model the proxy routes before it lists (gpt-6.1-sol) borrows a
        # sibling's ladder until the catalog publishes its own.
        sibling = entry.pop("effortsFrom", None)
        descriptor = descriptors.get(entry["slug"]) or (descriptors.get(sibling) if sibling else None)
        if descriptor is not None:
            entry["capabilities"] = {"optionDescriptors": [descriptor]}
        by_slug[entry["slug"]] = entry
    retired = set(MANIFEST["settings"]["t3"].get("retiredClaudeCustomModels") or [])
    out = []
    for row in existing:
        slug = row.get("slug") if isinstance(row, dict) else row
        if slug in retired:
            continue
        want = by_slug.get(slug)
        if want is None:
            out.append(row)
            continue
        merged = dict(row) if isinstance(row, dict) else {"slug": slug}
        merged.update(want)
        out.append(merged)
    for slug, m in by_slug.items():
        if slug not in { (r.get("slug") if isinstance(r,dict) else r) for r in out }:
            out.append(m)
    existing = out
    config["customModels"] = existing
    save_json_atomic(T3_SETTINGS, current)
    print("  wrote %s (%d claude customModels)" % (T3_SETTINGS, len(existing)))

def cmd_settings(names):
    # The MCP grants need the enrolled set, which needs the hub. Without it the
    # rest of the settings still render -- grants are additive, so none is
    # lost -- but the run is reported as failed so the gap is not silent.
    rc = 0
    try:
        servers = all_mcp_servers(common_auth_context())
    except CommonAuthError as exc:
        eprint("  cannot read the lost.plus service registry from Common Auth: %s; "
               "MCP permission grants not rendered" % exc)
        servers, rc = [], 1
    # harnesses proxy also rewrites this file (its env block) under the same
    # lock; without it an overlapping pass could drop the other's change.
    with _consumer_sync_lock():
        _write_claude_settings(servers)
    _write_t3_settings()
    print("settings applied. t3 custom models appear in the picker; routing them")
    print("requires ANTHROPIC_BASE_URL=http://127.0.0.1:%d (a local opencodex proxy)." % _proxy_port())
    return rc

def mcp_token_value(raw):
    """The bare token from a vault item that may also record how to send it.

    Two items are stored as "<url> | <Header>: <token>" -- a note to the
    operator about the shape, not something usable verbatim. Exported whole it
    is a credential no server accepts, and unquoted it broke every shell. Take
    the last field, drop a leading header name and any Bearer prefix, and leave
    an ordinary token untouched.
    """
    value = (raw or "").strip().split("|")[-1].strip()
    if not value.lower().startswith(("http://", "https://")):
        match = re.match(r"^([A-Za-z][A-Za-z0-9-]*)\s*:\s*(.+)$", value, re.S)
        if match:
            value = match.group(2).strip()
    if value.lower().startswith("bearer "):
        value = value[len("bearer "):].strip()
    return value


def mcp_env_var(server):
    """Env var holding this server's token: {NAME}_MCP_TOKEN, derived.

    An explicit envVar overrides the derived name. providers consumes the
    passage server's PASSAGE_MCP_TOKEN under the same Common Auth scope.
    """
    override = server.get("envVar")
    if override:
        return override
    return re.sub(r"[^A-Za-z0-9]+", "_", server["name"]).upper() + "_MCP_TOKEN"


def mcp_vault_item(server):
    return server.get("vaultItem") or mcp_env_var(server)


def mcp_surfaces(server):
    """Which harnesses get this server. All three unless the manifest narrows
    it; hermes only matters where ~/.hermes/config.yaml exists."""
    return server.get("surfaces") or ["claude", "codex", "hermes"]


def _claude_mcp_entry(s):
    """The user-scope ~/.claude.json entry for a server.

    A token server gets a headersHelper, not a ${VAR} header. claude expands
    ${VAR} from its own environment, and a claude started by a service or a
    GUI app (T3 Code under systemd or launchd) never read .zshenv, so every
    token server answered 401. The helper reads the managed block itself at
    each connect, so the secret stays in .zshenv alone and a rotation lands
    on the next reconnect.
    """
    if "stdio" in s:
        return dict(s["stdio"])
    entry = {"type": "http", "url": s["url"]}
    if s["auth"] != "none":
        # An OAuth server lands in "none" too: claude negotiates it itself.
        entry["headersHelper"] = "%s mcp-headers %s %s" % (
            shlex.quote(_self_path()), s["auth"], mcp_env_var(s))
    return entry

def _codex_mcp_block(s):
    lines = ["[mcp_servers.%s]" % s["name"], "url = \"%s\"" % s["url"]]
    if s["auth"] == "bearer":
        lines.append("bearer_token_env_var = \"%s\"" % mcp_env_var(s))
    elif s["auth"] == "x-api-key":
        lines.append("env_http_headers = { \"X-API-Key\" = \"%s\" }" % mcp_env_var(s))
    # auth "none": a url-only block, which codex accepts.
    return "\n".join(lines)+"\n"

def cmd_mcp(names):
    with _consumer_sync_lock():
        for attempt in range(2):
            try:
                return _cmd_mcp_once(names)
            except CommonAuthContextChanged:
                if attempt:
                    eprint("  Common Auth login kept changing; MCP sync deferred")
                    return 0


def _cmd_mcp_once(names):
    global VAULT_TOKEN
    VAULT_TOKEN = ""
    # The account context binds every read that follows, and the hub's
    # registry is the lost.plus server set. Without either there is nothing
    # correct to reconcile against: the codex region is rewritten wholesale
    # and a short list would drop live servers from it. Stop here, loudly,
    # and leave the last reconciliation on disk.
    try:
        auth_context = common_auth_context()
        all_servers = all_mcp_servers(auth_context)
    except CommonAuthContextChanged:
        raise
    except CommonAuthError as exc:
        eprint("  cannot read the lost.plus service registry from Common Auth: %s; "
               "MCP enrollment not run" % exc)
        return 1
    servers = all_servers
    if names: servers = [s for s in servers if s["name"] in names]
    bound_existing = _managed_zshenv_exports()
    existing = {name: value for name, value in os.environ.items() if value}
    # The managed file is the durable last-known-good snapshot. A shell that
    # was opened before the latest reconciliation may still carry older
    # exported values, so the on-disk snapshot wins when both exist.
    existing.update(bound_existing)
    common_tokens = {}
    authoritative_missing = set()
    previous_context = _existing_common_auth_context()
    VAULT_TOKEN = bound_existing.get("PASSAGE_MCP_TOKEN", "")
    if previous_context != auth_context:
        VAULT_TOKEN = ""
        authoritative_missing.update(
            mcp_env_var(server)
            for server in all_servers
            if server.get("credentialSource") == "common-auth"
        )
        for envvar in authoritative_missing:
            existing.pop(envvar, None)
            bound_existing.pop(envvar, None)

    def resolve_common(scope):
        if scope not in common_tokens:
            common_tokens[scope] = common_auth_token(scope, auth_context)
        return common_tokens[scope]

    # External credentials still live in passage, but the credential used
    # to reach passage is itself Common Auth-owned. Refresh it before any
    # vault reads so a pre-migration environment value cannot remain the
    # authority after Auth is available.
    if any(s.get("credentialSource") == "passage" for s in servers):
        try:
            VAULT_TOKEN = resolve_common("passage")
        except CommonAuthContextChanged:
            raise
        except CommonAuthError as exc:
            if exc.authoritative:
                VAULT_TOKEN = ""
                authoritative_missing.add("PASSAGE_MCP_TOKEN")
            detail = "removing managed access" if exc.authoritative else "using existing access if available"
            eprint("  could not refresh passage access from Common Auth: %s; %s" % (exc, detail))

    exports = []
    for s in servers:
        if s["auth"] == "none":
            continue
        envvar, item = mcp_env_var(s), mcp_vault_item(s)
        val = None
        if s.get("credentialSource") == "common-auth":
            try:
                val = resolve_common(s["scope"])
                print("  resolved %s from Common Auth scope %s" % (envvar, s["scope"]))
            except CommonAuthContextChanged:
                raise
            except CommonAuthError as exc:
                val = None if exc.authoritative else bound_existing.get(envvar)
                if exc.authoritative:
                    authoritative_missing.add(envvar)
                detail = "keeping existing value" if val else "no existing value available"
                eprint("  could not resolve %s (Common Auth %s): %s; %s" %
                       (envvar, s["scope"], exc, detail))
        else:
            try:
                val = vault_get(item)
                print("  pulled %s from vault item mcp/%s" % (envvar, item))
            except VaultError as exc:
                val = existing.get(envvar)
                detail = "keeping existing value" if val else "no existing value available"
                eprint("  could not resolve %s (mcp/%s): %s; %s" %
                       (envvar, item, exc, detail))
        # Quote it. A secret is arbitrary bytes: the values adopted with the new
        # servers carry spaces and newlines (they are stored header-shaped), and
        # unquoted they split across lines and left .zshenv unparseable on every
        # machine, which zsh then reports on every new shell.
        val = mcp_token_value(val)
        if val: exports.append("export %s=%s" % (envvar, shlex.quote(val)))
    _mirror_zshenv(exports, authoritative_missing, auth_context)
    if shutil.which("claude"):
        for name in MANIFEST.get("retiredMcpServers") or []:
            if _claude_mcp_scope(name) is not None:
                print("  unregistering retired MCP server %s" % name)
                # No -s: the CLI then removes it from whichever scope holds it.
                # Passing user silently missed the local-scope copies.
                subprocess.run(["claude", "mcp", "remove", name],
                               capture_output=True, env=_claude_maintenance_env())
        for s in servers:
            if "claude" in mcp_surfaces(s):
                _claude_mcp_reconcile(s)
        print("  claude MCP servers enrolled")
    else:
        print("  claude not installed; skipped claude MCP enrollment")
    _write_codex_mcp([s for s in servers if "codex" in mcp_surfaces(s)])
    if CODEX_CONFIG.parent.exists():
        # A codex started by T3 or another GUI app never read .zshenv, so its
        # bearer_token_env_var servers failed with "is not set". codex loads
        # ~/.codex/.env itself at startup, however it was launched. Temporary:
        # once an installed codex has http_headers_helper, point it at
        # 'harnesses mcp-headers' like claude and drop this copy.
        _mirror_dotenv(CODEX_CONFIG.parent/".env", exports, authoritative_missing)
    _write_hermes_mcp([s for s in servers if "hermes" in mcp_surfaces(s)],
                      exports, authoritative_missing)
    return 0

def _claude_mcp_scope(name):
    """The scope claude has the server registered at ("" when it does not
    say), or None when it is not registered.

    'claude mcp list' was the wrong source: it prints every server including the
    claude.ai connectors, and the old membership test was a substring search over
    that whole blob. A manifest name that happens to be a prefix of some unrelated
    connector -- 'obsidian' inside 'obsidian-direct', 'tweet-fetch' inside
    'claude.ai tweet-fetch-mcp' -- read as already enrolled and was skipped on
    every run. 'get' names one server and cannot collide.
    """
    r = subprocess.run(["claude","mcp","get",name], capture_output=True, text=True,
                       env=_claude_maintenance_env())
    if r.returncode != 0 or "No MCP server named" in (r.stdout + r.stderr):
        return None
    for line in r.stdout.splitlines():
        stripped = line.strip()
        if stripped.startswith("Scope:"):
            return stripped[6:].strip().split()[0].lower()
    return ""


def _claude_user_mcp_entry(name):
    """The server's stored user-scope entry. Read from the file because
    'claude mcp get' does not print a headersHelper at all."""
    path = pathlib.Path(os.environ.get("CLAUDE_CONFIG_DIR") or HOME)/".claude.json"
    try:
        return (json.loads(path.read_text()).get("mcpServers") or {}).get(name)
    except (OSError, ValueError, AttributeError):
        return None


def _claude_mcp_reconcile(s):
    """Enroll a server, or re-enroll one whose stored entry has drifted from
    what the manifest asks for: a url change, an auth switch, or an entry from
    before headersHelper that still carries a ${VAR} header."""
    want = _claude_mcp_entry(s)
    argv = ["claude","mcp","add-json","--scope","user",s["name"],json.dumps(want)]
    scope = _claude_mcp_scope(s["name"])
    if scope is None:
        subprocess.run(argv, env=_claude_maintenance_env())
        return
    if scope not in ("", "user"):
        # We only ever write user scope. A local or project registration is the
        # operator's, it takes precedence over ours, and rewriting it at user
        # scope would not replace it -- it would sit underneath, shadowed.
        print("  %s is registered at %s scope; leaving it alone" % (s["name"], scope))
        return
    if _claude_user_mcp_entry(s["name"]) == want:
        return
    print("  re-enrolling %s (stored config differs from the manifest)" % s["name"])
    subprocess.run(["claude","mcp","remove",s["name"],"-s","user"],
                   capture_output=True, env=_claude_maintenance_env())
    subprocess.run(argv, env=_claude_maintenance_env())


CODEX_MCP_BEGIN = "# BEGIN harnesses:mcp-servers"
CODEX_MCP_END = "# END harnesses:mcp-servers"


def _codex_toml_error(text):
    """The parse error in `text`, or None. None also when we cannot parse at all."""
    try:
        import tomllib
    except ImportError:
        return None
    try:
        tomllib.loads(text)
    except Exception as exc:
        return str(exc)
    return None


def _codex_managed_region(text):
    return re.search(
        re.escape(CODEX_MCP_BEGIN) + r".*?" + re.escape(CODEX_MCP_END) + r"\n?",
        text, re.S,
    )


def _codex_declared_servers(text):
    """{name: table} for every declared mcp_server, however it is spelled.

    Read by the TOML parser rather than by matching headers. [mcp_servers.x] and
    [mcp_servers."x"] are the same key to TOML but not to a regex, and taking
    the regex's word for it is what produced a duplicate declaration on oci --
    the quoted spelling was invisible, so a second bare one got emitted. Dotted
    and inline forms would have failed the same way.
    """
    try:
        import tomllib
    except ImportError:
        return {}
    try:
        data = tomllib.loads(text)
    except Exception:
        return {}
    servers = data.get("mcp_servers")
    return servers if isinstance(servers, dict) else {}


def _codex_sections(text):
    """[(name, body_including_header)] for each top-level mcp_servers table.

    Text surgery still needs byte offsets, so this locates headers -- but the
    name is unquoted so it lines up with what the parser reports.
    """
    out = []
    for match in re.finditer(r"^\[mcp_servers\.([^.\]]+)\]\s*$", text, re.M):
        nxt = re.search(r"^\[", text[match.end():], re.M)
        end = match.end() + (nxt.start() if nxt else len(text) - match.end())
        out.append((match.group(1).strip('"\''), text[match.start():end]))
    return out


def _write_codex_mcp(servers):
    """Render our servers into one replaceable region, never appending blindly.

    The old writer appended a block whenever the name was absent and had no way
    to mark its own output. Renaming a server in the manifest therefore left the
    previous name behind as a second entry pointing at the same URL, and a name
    the operator had already configured by hand got a second top-level table --
    which is not merely untidy, it is invalid TOML, and codex refuses to start
    at all rather than ignoring the file.

    So: keep our output inside markers and replace it wholesale, reclaim blocks
    an older release appended that are still byte-identical to ours, and never
    emit a name the operator declares outside the region -- their version wins,
    including any [.tools.*] approval rules hanging off it. Then parse the
    result before it reaches disk, because the cost of being wrong here is a
    harness that will not launch.
    """
    original = CODEX_CONFIG.read_text() if CODEX_CONFIG.exists() else ""
    if original.strip():
        broken = _codex_toml_error(original)
        if broken:
            eprint("  %s does not parse; refusing to edit it: %s"
                   % (CODEX_CONFIG, broken))
            return

    region_match = _codex_managed_region(original)
    text = original[:region_match.start()] + original[region_match.end():] \
        if region_match else original

    # Reclaim what an older release appended. Match on the body rather than the
    # name: a rename in the manifest leaves the previous name behind pointing at
    # the same url with the same env var, and that orphan is ours to remove
    # whatever it is called. A retired name goes too even when its body no
    # longer matches: a rename that also changed the env var leaves a block
    # the body match cannot see. A block with [.tools.*] children is never
    # ours -- we have never emitted one -- so those stay, and their rules
    # with them.
    ours = {_codex_mcp_block(s).strip().split("\n", 1)[1] for s in servers}
    retired_names = set(MANIFEST.get("retiredMcpServers") or [])
    for name, body in _codex_sections(text):
        table = _codex_declared_servers(text).get(name)
        if isinstance(table, dict) and any(isinstance(v, dict) for v in table.values()):
            continue  # carries [.tools.*] rules, so it was never ours to remove
        rest = body.strip().split("\n", 1)
        if name in retired_names or (len(rest) == 2 and rest[1] in ours):
            text = text.replace(body, "", 1)

    # "Declared" means the operator gave the server settings of its own, not just
    # approval rules hanging off the name. A table holding only sub-tables --
    # [mcp_servers.x.tools.y] with no [mcp_servers.x] -- is rules for a server
    # whose address we still owe it. Treating that as declared silently dropped
    # the url and token and left codex with rules pointing at nothing.
    declared = {
        name for name, table in _codex_declared_servers(text).items()
        if not isinstance(table, dict) or any(
            not isinstance(value, dict) for value in table.values()
        )
    }
    emit = [s for s in servers if s["name"] not in declared]
    for s in servers:
        if s["name"] in declared:
            print("  %s is configured in %s already; leaving it alone"
                  % (s["name"], CODEX_CONFIG.name))

    body = "\n".join(_codex_mcp_block(s) for s in emit)
    region = CODEX_MCP_BEGIN + "\n" + body + CODEX_MCP_END + "\n" if emit else ""
    candidate = text.rstrip("\n")
    candidate = (candidate + "\n\n" + region) if region else candidate + "\n"

    invalid = _codex_toml_error(candidate)
    if invalid:
        eprint("  refusing to write %s: the result would not parse: %s"
               % (CODEX_CONFIG, invalid))
        return
    if candidate == original:
        return
    CODEX_CONFIG.parent.mkdir(parents=True, exist_ok=True)
    CODEX_CONFIG.write_text(candidate)
    print("  wrote %s (%d codex MCP server(s))" % (CODEX_CONFIG, len(emit)))

def _retired_env_vars():
    derived = {
        re.sub(r"[^A-Za-z0-9]+", "_", name).upper() + "_MCP_TOKEN"
        for name in (MANIFEST.get("retiredMcpServers") or [])
    }
    return derived | set(MANIFEST.get("retiredEnvVars") or [])


def _existing_block(text):
    begin, end = "# BEGIN harnesses:mcp-tokens", "# END harnesses:mcp-tokens"
    match = re.search(re.escape(begin)+r"(.*?)"+re.escape(end), text, re.S)
    return match.group(1) if match else ""


def _existing_common_auth_context():
    text = ZSHENV.read_text() if ZSHENV.exists() else ""
    match = re.search(r"^# common-auth-context (\{.*\})$", _existing_block(text), re.M)
    if not match:
        return None
    try:
        context = json.loads(match.group(1))
    except json.JSONDecodeError:
        return None
    if not isinstance(context, dict):
        return None
    return {"origin": context.get("origin"), "subject": context.get("subject")}


def _mirror_zshenv(exports, authoritative_missing=None, auth_context=None):
    authoritative_missing = authoritative_missing or set()
    begin, end = "# BEGIN harnesses:mcp-tokens", "# END harnesses:mcp-tokens"
    text = ZSHENV.read_text() if ZSHENV.exists() else ""
    existing_exports = {}
    for line in _existing_block(text).splitlines():
        match = re.match(r"^export\s+([A-Za-z_][A-Za-z0-9_]*)=", line)
        if match:
            existing_exports[match.group(1)] = line
    emitted_names = set()
    for line in exports:
        match = re.match(r"^export\s+([A-Za-z_][A-Za-z0-9_]*)=", line)
        if match:
            emitted_names.add(match.group(1))
    # A retired server's token is a dead credential: drop it from our block
    # and from anywhere else in the file an older release or module left it.
    retired_vars = _retired_env_vars()
    exports.extend(
        line for name, line in existing_exports.items()
        if name not in emitted_names and name not in authoritative_missing
        and name not in retired_vars
    )
    context_line = ""
    if auth_context is not None:
        context_line = "# common-auth-context " + json.dumps(
            auth_context, sort_keys=True, separators=(",", ":")
        ) + "\n"
    else:
        previous = _existing_common_auth_context()
        if previous is not None:
            context_line = "# common-auth-context " + json.dumps(
                previous, sort_keys=True, separators=(",", ":")
            ) + "\n"
    block = begin+"\n"+context_line+"\n".join(exports)+"\n"+end+"\n"
    if begin in text and end in text:
        text = re.sub(re.escape(begin)+r".*?"+re.escape(end)+r"\n?", block, text, flags=re.S)
    else:
        text = text.rstrip("\n")+("\n\n" if text.strip() else "")+block
    for name in retired_vars:
        text = re.sub(r"^export\s+%s=.*\n?" % re.escape(name), "", text, flags=re.M)
    # Atomic: claude's headersHelper reads this file at any moment.
    save_text_atomic(ZSHENV, text)
    print("  mirrored %d token(s) into %s" % (len(exports), ZSHENV))

# --- hermes -------------------------------------------------------------
# Hermes reads MCP servers from ~/.hermes/config.yaml (mcp_servers:) and
# expands ${VAR} in headers from ~/.hermes/.env. Its gateway is a systemd
# user service that does not source .zshenv, so tokens must land in that
# .env. The block is edited line by line: entries the manifest does not name
# (notion, beeper, ...) are the operator's and stay byte for byte.

HERMES_CONFIG = pathlib.Path(os.environ.get("HERMES_CONFIG", str(HOME/".hermes/config.yaml")))
HERMES_ENV = pathlib.Path(os.environ.get("HERMES_ENV", str(HOME/".hermes/.env")))


def _hermes_mcp_entry(s):
    var = mcp_env_var(s)
    lines = ["  %s:" % s["name"], "    type: remote", "    url: %s" % s["url"], "    oauth: false"]
    if s["auth"] == "bearer":
        lines += ["    headers:", "      Authorization: Bearer ${%s}" % var]
    elif s["auth"] == "x-api-key":
        lines += ["    headers:", "      X-API-Key: ${%s}" % var]
    return lines


def _hermes_mcp_block(lines):
    """(start, end) line indexes of the top-level mcp_servers block, end
    exclusive; (None, None) when the file has no such block."""
    for i, line in enumerate(lines):
        if re.match(r"^mcp_servers:\s*(#.*)?$", line):
            j = i + 1
            while j < len(lines) and (lines[j].strip() == "" or lines[j][0] in " \t"
                                      or lines[j].startswith("#")):
                j += 1
            return i, j
    return None, None


def _hermes_entries(lines, start, end):
    """[(name, first, stop)] for each two-space-indented entry in the block.
    Blank separator lines are left outside every span."""
    heads = [k for k in range(start + 1, end) if re.match(r"^  [^\s#][^:]*:\s*$", lines[k])]
    out = []
    for n, k in enumerate(heads):
        stop = heads[n + 1] if n + 1 < len(heads) else end
        while stop > k + 1 and lines[stop - 1].strip() == "":
            stop -= 1
        out.append((lines[k].strip()[:-1], k, stop))
    return out


def _write_hermes_mcp(servers, exports, authoritative_missing=None):
    if not HERMES_CONFIG.exists():
        return
    original = HERMES_CONFIG.read_text()
    lines = original.split("\n")
    start, end = _hermes_mcp_block(lines)
    if start is None:
        if lines and lines[-1].strip() != "":
            lines.append("")
        lines.append("mcp_servers:")
        start, end = len(lines) - 1, len(lines)
    retired = set(MANIFEST.get("retiredMcpServers") or [])
    wanted = {s["name"]: _hermes_mcp_entry(s) for s in servers}
    urls = {s["name"]: "    url: %s" % s["url"] for s in servers}
    seen = set()
    # Walk bottom-up so earlier spans keep their indexes through edits.
    for name, k, stop in reversed(_hermes_entries(lines, start, end)):
        if name in retired:
            print("  hermes: removing retired MCP server %s" % name)
            del lines[k:stop]
            continue
        if name not in wanted:
            continue  # the operator's own server; never ours to touch
        seen.add(name)
        body = lines[k:stop]
        if body == wanted[name]:
            continue
        if urls[name] not in body:
            print("  hermes: %s points somewhere else; leaving it alone" % name)
            continue
        lines[k:stop] = wanted[name]
    start, end = _hermes_mcp_block(lines)
    insert_at = end
    while insert_at > start + 1 and lines[insert_at - 1].strip() == "":
        insert_at -= 1
    lines[insert_at:insert_at] = [l for s in servers if s["name"] not in seen for l in wanted[s["name"]]]
    text = "\n".join(lines)
    changed = text != original
    if changed:
        HERMES_CONFIG.write_text(text)
        print("  wrote %s (%d hermes MCP server(s))" % (HERMES_CONFIG, len(servers)))
    if _mirror_dotenv(HERMES_ENV, exports, authoritative_missing) or changed:
        _restart_hermes()


def _dotenv_value(value):
    if re.fullmatch(r"[A-Za-z0-9_./:=+@,-]+", value):
        return value
    return "'" + value.replace("'", "'\\''") + "'"


def _mirror_dotenv(path, exports, authoritative_missing=None):
    """Managed NAME=value block in a .env file from the same exports the
    zshenv mirror gets. Retired and revoked names are stripped wherever an
    older release or a hand edit left them."""
    begin, end = "# BEGIN harnesses:mcp-tokens", "# END harnesses:mcp-tokens"
    original = path.read_text() if path.exists() else ""
    body = []
    for line in exports:
        match = re.match(r"^export\s+([A-Za-z_][A-Za-z0-9_]*)=(.*)$", line)
        if not match:
            continue
        parts = shlex.split(match.group(2))
        body.append("%s=%s" % (match.group(1), _dotenv_value(parts[0] if parts else "")))
    block = begin + "\n" + "\n".join(body) + "\n" + end + "\n"
    text = original
    if begin in text and end in text:
        text = re.sub(re.escape(begin) + r".*?" + re.escape(end) + r"\n?", block, text, flags=re.S)
    else:
        text = text.rstrip("\n") + ("\n\n" if text.strip() else "") + block
    for name in _retired_env_vars() | set(authoritative_missing or ()):
        text = re.sub(r"^%s=.*\n?" % re.escape(name), "", text, flags=re.M)
    if text == original:
        return False
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(text)
    os.chmod(path, 0o600)
    print("  mirrored %d token(s) into %s" % (len(body), path))
    return True


def _restart_hermes():
    if shutil.which("systemctl"):
        r = subprocess.run(["systemctl", "--user", "try-restart", "hermes-gateway.service"],
                           capture_output=True, text=True)
        if r.returncode == 0:
            print("  hermes gateway restarted")
            return
    print("  hermes config changed; restart hermes to pick it up")


PROXY_DEFAULT_PORT = 10100
PROXY_UNIT = "opencodex-proxy.service"
# `ocx service` registers a systemd user unit on Linux and this launchd agent
# on macOS, so "is the proxy up" is a different question per platform.
PROXY_LAUNCHD_LABEL = "com.opencodex.proxy"


def _proxy_service_active():
    try:
        if _is_macos():
            r = subprocess.run(["launchctl", "list"],
                               capture_output=True, text=True, timeout=10)
            for line in r.stdout.splitlines():
                fields = line.split()
                # "<pid>\t<status>\t<label>"; a loaded-but-stopped agent
                # carries "-" where the pid would be.
                if len(fields) == 3 and fields[2] == PROXY_LAUNCHD_LABEL:
                    return fields[0].isdigit()
            return False
        r = subprocess.run(["systemctl", "--user", "is-active", PROXY_UNIT],
                           capture_output=True, text=True, timeout=10)
        return r.stdout.strip() == "active"
    except Exception:
        return False


def _proxy_service_name():
    return PROXY_LAUNCHD_LABEL if _is_macos() else PROXY_UNIT


def _port_answers(port):
    """True when an unauthenticated /v1/models on this port is served."""
    try:
        with urllib.request.urlopen(
            "http://127.0.0.1:%d/v1/models" % port, timeout=5
        ) as r:
            return r.status == 200
    except Exception:
        return False


def _proxy_port():
    """The port a token-less local client should point ANTHROPIC_BASE_URL at.

    ocx serves its main port from runtime-port.json. Where that port requires
    an API token it also opens a second, unauthenticated loopback listener one
    port up — grimoire runs that way, the other machines do not. Claude Code
    sends no token, so prefer the unauthenticated listener when it exists and
    fall back to the main port rather than hardcoding either.
    """
    override = os.environ.get("HARNESSES_PROXY_PORT")
    if override:
        return int(override)
    port = PROXY_DEFAULT_PORT
    try:
        port = int(json.loads((HOME/".opencodex/runtime-port.json").read_text())["port"])
    except Exception:
        pass
    for candidate in (port + 1, port):
        if _port_answers(candidate):
            return candidate
    return port


def _write_base_url_export():
    with _consumer_sync_lock():
        _write_base_url_export_locked()


def _write_base_url_export_locked():
    port = _proxy_port()
    begin, end = "# BEGIN harnesses:anthropic-base-url", "# END harnesses:anthropic-base-url"
    block = (begin + "\n"
             + "export ANTHROPIC_BASE_URL=http://127.0.0.1:%d\n" % port
             + end + "\n")
    text = ZSHENV.read_text() if ZSHENV.exists() else ""
    if begin in text and end in text:
        text = re.sub(re.escape(begin) + r".*?" + re.escape(end) + r"\n?", block, text, flags=re.S)
    else:
        text = text.rstrip("\n") + ("\n\n" if text.strip() else "") + block
    save_text_atomic(ZSHENV, text)
    print("  exported ANTHROPIC_BASE_URL=http://127.0.0.1:%d in %s" % (port, ZSHENV))

    # .zshenv only reaches shells. A claude spawned by a GUI app or a service
    # (T3 Code's claudeAgent is one) never reads it, so it would still talk to
    # api.anthropic.com and reject every fleet model. Claude Code applies the
    # env block of its own settings file on every launch, however it started,
    # and that survives a reboot where launchctl setenv does not.
    settings = load_json(CLAUDE_SETTINGS)
    settings.setdefault("env", {})["ANTHROPIC_BASE_URL"] = "http://127.0.0.1:%d" % port
    save_json_atomic(CLAUDE_SETTINGS, settings)
    print("  set env.ANTHROPIC_BASE_URL in %s" % CLAUDE_SETTINGS)
    _remove_legacy_service_env()


def _remove_legacy_service_env():
    """Undo the launchctl / environment.d exports that settings.json replaced."""
    if _is_macos():
        subprocess.run(["launchctl", "unsetenv", "ANTHROPIC_BASE_URL"], check=False)
        return
    if ENVIRONMENT_D.exists():
        ENVIRONMENT_D.unlink()
        print("  removed %s" % ENVIRONMENT_D)
    subprocess.run(["systemctl", "--user", "unset-environment", "ANTHROPIC_BASE_URL"],
                   check=False)


def _remove_base_url_export():
    with _consumer_sync_lock():
        _remove_base_url_export_locked()


def _remove_base_url_export_locked():
    begin, end = "# BEGIN harnesses:anthropic-base-url", "# END harnesses:anthropic-base-url"
    _remove_legacy_service_env()
    settings = load_json(CLAUDE_SETTINGS)
    env = settings.get("env")
    if isinstance(env, dict) and "ANTHROPIC_BASE_URL" in env:
        del env["ANTHROPIC_BASE_URL"]
        if not env:
            del settings["env"]
        save_json_atomic(CLAUDE_SETTINGS, settings)
        print("  removed env.ANTHROPIC_BASE_URL from %s" % CLAUDE_SETTINGS)
    if not ZSHENV.exists():
        return
    text = ZSHENV.read_text()
    if begin not in text:
        return
    text = re.sub(re.escape(begin) + r".*?" + re.escape(end) + r"\n?", "", text, flags=re.S)
    save_text_atomic(ZSHENV, text)
    print("  removed ANTHROPIC_BASE_URL block from %s" % ZSHENV)


def cmd_proxy(names):
    ocx = shutil.which("ocx") or str(HOME / ".local/bin/ocx")
    if not shutil.which("ocx") and not os.path.isfile(ocx):
        eprint("  opencodex (ocx) not installed; install it via the opencodex module first.")
        return 1
    # 'ocx service' installs when absent and repairs an existing service, so it
    # is the idempotent entry point regardless of current state.
    print("ensuring opencodex proxy service (%s) ..." % _proxy_service_name())
    if subprocess.run([ocx, "service"]).returncode != 0:
        eprint("  ocx service install/repair failed; see ~/.opencodex/service.log")
        return 1
    if not _proxy_service_active():
        eprint("  %s is not active after repair; not writing ANTHROPIC_BASE_URL."
               % _proxy_service_name())
        _remove_base_url_export()
        return 1
    print("  %s is active (auto-restarts on failure)." % _proxy_service_name())
    # The service auto-restarts, so an unconditional export is safe. It is only
    # written once the proxy is confirmed running, and removed if it is not.
    _write_base_url_export()
    print("opencodex proxy guaranteed up; custom claude models now route through it.")
    return 0

# --- schedule ---------------------------------------------------------
# The module owns its own update cadence: `harnesses schedule` installs a
# daily 11:00 timer that runs `harnesses refresh`. setup's 06:00 timer no
# longer touches the harnesses, so this is the only automatic path.
TIMER_NAME = "harnesses-update"
PLIST_NAME = "com.lost.plus.harnesses-update"
LAUNCHD_DIR = HOME/"Library/LaunchAgents"
SCHEDULE_HOUR = 11


def _is_macos():
    return sys.platform == "darwin"


def _schedule_bin():
    """Locate the shared schedule helper (sourced tree or installed)."""
    env = os.environ.get("SCHEDULE_BIN")
    if env:
        return env
    candidate = pathlib.Path(__file__).resolve().parent.parent/"bin"/"schedule"
    if candidate.exists():
        return str(candidate)
    return str(HOME/".local/bin/schedule")


def _run_schedule(*args):
    """Run the shared schedule helper, or explain how to install it."""
    path = _schedule_bin()
    if not os.access(path, os.X_OK):
        raise SystemExit(
            "schedule helper not found at %s; run: setup install schedule" % path
        )
    return os.spawnl(os.P_WAIT, path, "schedule", *args)


def _self_path():
    return os.path.abspath(sys.argv[0])


def _launchd_plist_path():
    return LAUNCHD_DIR/("%s.plist" % PLIST_NAME)


def _schedule_enable():
    if _is_macos():
        LAUNCHD_DIR.mkdir(parents=True, exist_ok=True)
        plist = """<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>%s</string>
    <key>ProgramArguments</key>
    <array>
        <string>%s</string>
        <string>refresh</string>
    </array>
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key><integer>%d</integer>
        <key>Minute</key><integer>0</integer>
    </dict>
    <key>StandardOutPath</key>
    <string>/tmp/harnesses-update.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/harnesses-update.log</string>
</dict>
</plist>
""" % (PLIST_NAME, _self_path(), SCHEDULE_HOUR)
        path = _launchd_plist_path()
        path.write_text(plist)
        uid = os.getuid()
        subprocess.run(["launchctl", "bootout", "gui/%d/%s" % (uid, PLIST_NAME)],
                       capture_output=True)
        r = subprocess.run(["launchctl", "bootstrap", "gui/%d" % uid, str(path)],
                           capture_output=True)
        if r.returncode != 0:
            # 125 means there is no GUI session to bootstrap into, which is
            # what happens over SSH. The agent is installed either way and
            # launchd loads it at the next login on the Mac's own screen.
            if r.returncode == 125:
                print("harnesses auto-update installed at %s" % path)
                print("  no GUI session — it loads at the next login on the Mac's screen")
                return 0
            eprint("  launchd enable failed (rc=%s)" % r.returncode)
            if r.stderr:
                eprint(r.stderr.decode(errors="replace").rstrip())
            return 1
        print("harnesses auto-update scheduled daily at %02d:00 (launchd)" % SCHEDULE_HOUR)
        return 0

    # setup's timer runs at 06:00 and providers refreshes hourly, including 11:00.
    # This pass can overlap provider refreshes and active sessions.
    # Persistent=true replays a run missed while off.
    with tempfile.NamedTemporaryFile("w", suffix=".lines", delete=False) as tf:
        tf.write("Persistent=true\n")
        timer_extra = tf.name
    try:
        rc = _run_schedule("install-timer", "user", TIMER_NAME,
                           "Daily AI harness maintenance",
                           "%h/.local/bin/harnesses refresh",
                           "*-*-* %02d:00:00" % SCHEDULE_HOUR, "", timer_extra)
    finally:
        os.unlink(timer_extra)
    if rc:
        return rc
    print("harnesses auto-update scheduled daily at %02d:00 (systemd)" % SCHEDULE_HOUR)
    return 0


def _schedule_disable():
    if _is_macos():
        path = _launchd_plist_path()
        subprocess.run(["launchctl", "bootout", "gui/%d/%s" % (os.getuid(), PLIST_NAME)],
                       capture_output=True)
        if path.exists():
            path.unlink()
        print("harnesses auto-update unscheduled")
        return 0
    rc = _run_schedule("uninstall-timer", "user", TIMER_NAME)
    if rc:
        return rc
    print("harnesses auto-update unscheduled")
    return 0


def _schedule_status():
    if _is_macos():
        print("schedule: %s" % ("installed" if _launchd_plist_path().exists()
                                else "not installed"))
        return 0
    return _run_schedule("status", "user", TIMER_NAME)


def _proxy_stop_budget():
    """Give the proxy unit long enough to drain before systemd kills it.

    OpenCodex drains in-flight turns on SIGTERM for shutdownTimeoutMs (the
    opencodex module sets 300s). systemd's default TimeoutStopSec is 90s, so
    without this the drain is cut short by SIGKILL and a live turn dies anyway
    -- along with the response-state flush that runs after the drain.
    """
    if _is_macos():
        return 0
    directory = HOME/(".config/systemd/user/%s.d" % PROXY_UNIT)
    directory.mkdir(parents=True, exist_ok=True)
    override = directory/"50-stop-timeout.conf"
    desired = "[Service]\nTimeoutStopSec=330\n"
    if override.exists() and override.read_text() == desired:
        return 0
    override.write_text(desired)
    subprocess.run(["systemctl", "--user", "daemon-reload"], capture_output=True)
    print("  raised %s stop timeout to 330s (drain budget)" % PROXY_UNIT)
    return 0


def cmd_refresh(names):
    """The scheduled pass: bring the proxy current, then render, then update.

    Order is the point. Settings are generated from what the proxy reports, so
    the proxy has to be serving current config before they are rendered, and
    the restart that gets it there belongs here, on a daily cadence, rather
    than in the hourly refresh that feeds it.

    mcp runs after settings: enrollment reconciles against the manifest, so a
    renamed or re-pointed server heals on the next pass instead of waiting for
    someone to notice it never enrolled.
    """
    failed = []
    _proxy_stop_budget()
    module = HOME/".local/bin/opencodex"
    if os.access(module, os.X_OK):
        if subprocess.run([sys.executable, str(module), "__apply"]).returncode:
            failed.append("opencodex apply")
    else:
        print("  opencodex module not installed; skipping proxy config apply")
    for name, fn in (("settings", cmd_settings), ("mcp", cmd_mcp), ("update", cmd_update)):
        try:
            if fn([]):
                failed.append(name)
        except Exception as exc:
            eprint("  %s failed: %s" % (name, exc))
            failed.append(name)
    # Keep the base-url export current on the scheduled path too, so a machine
    # nobody ran 'harnesses proxy' on still routes GUI-launched claude through
    # ocx. Only ever written here, never removed: a proxy caught mid-restart
    # must not strip the route. 'harnesses proxy' owns removal.
    if _proxy_service_active():
        _write_base_url_export()
    if failed:
        eprint("harnesses refresh: %s failed" % ", ".join(failed))
        return 1
    return 0


def cmd_schedule(names):
    action = names[0] if names else "enable"
    if action in ("enable", "on"):
        return _schedule_enable()
    if action in ("disable", "off"):
        return _schedule_disable()
    if action == "status":
        return _schedule_status()
    eprint("harnesses: schedule takes enable|disable|status")
    return 2

# --- mcp headers --------------------------------------------------------

def cmd_mcp_headers(args):
    """claude's headersHelper: print one server's auth header as JSON."""
    if len(args) != 2 or args[0] not in ("bearer", "x-api-key"):
        eprint("usage: harnesses mcp-headers bearer|x-api-key ENV_VAR")
        return 2
    auth, envvar = args
    token = _managed_zshenv_exports().get(envvar)
    if not token:
        eprint("harnesses: no %s in the harnesses:mcp-tokens block of %s; "
               "run 'harnesses mcp'" % (envvar, HOME/".zshenv"))
        return 1
    print(json.dumps({"Authorization": "Bearer " + token} if auth == "bearer"
                     else {"X-API-Key": token}))
    return 0


