#!/usr/bin/env python3
"""harnesses — fzf client to install, update, and configure AI coding harnesses.

Absorbs the harness self-update logic formerly bolted onto "setup update"
(bin/setup) and the retired linux-setup/01-harnesses.md Obsidian doc.

Actions: install | update | settings | mcp. With no argument an fzf menu is
shown when attached to a terminal.

The lost.plus MCP set is read from the Common Auth hub (GET /api/services:
every registry row the account is admitted to that carries an mcp_url), so
a service goes live for every harness by being registered there. The manifest
lists only third-party MCPs. Operated lost.plus credentials resolve through
the shared auth module; external service credentials remain in the passage
MCP, folder=mcp.
"""

from __future__ import annotations
import contextlib, fcntl, glob, json, os, pathlib, re, shutil, subprocess, sys, tempfile
import urllib.error, urllib.request
import shlex

HOME = pathlib.Path.home()
HERE = pathlib.Path(__file__).resolve().parent

def _find_manifest():
    env = os.environ.get("HARNESSES_MANIFEST")
    candidates = [env, str(HOME/".config/harnesses/manifest.json"),
                  str(HERE/"harnesses-manifest.json"),
                  str(HERE.parent/"files/harnesses-manifest.json")]
    for c in candidates:
        if c and os.path.exists(c):
            return pathlib.Path(c)
    raise SystemExit("harnesses: manifest not found (looked in: %s)" % ", ".join(candidates))

MANIFEST_PATH = _find_manifest()
MANIFEST = json.loads(MANIFEST_PATH.read_text())
AUTH_BIN = os.environ.get("AUTH_BIN", str(HOME/".local/bin/auth"))
T3_MODEL_CATALOG_TIMEOUT_SECONDS = 15

for _server in MANIFEST.get("mcpServers", []):
    if _server.get("auth") == "none":
        continue
    _source = _server.get("credentialSource")
    if _source not in ("common-auth", "passage"):
        raise SystemExit("harnesses: %s has no valid credentialSource" % _server.get("name", "server"))
    if _source == "common-auth":
        # lost.plus MCPs come from the hub's registry now; a hand-written copy
        # would be the drift this module stopped carrying.
        raise SystemExit("harnesses: %s is a lost.plus MCP; register it in Common Auth, not the manifest"
                         % _server.get("name", "server"))
VAULT_URL = os.environ.get("PASSAGE_MCP_URL", "https://passage.lost.plus/mcp")
VAULT_FOLDER = "mcp"
def _zshenv_exports():
    """export NAME=VALUE pairs from ~/.zshenv, whichever block they sit in.

    A timer unit gets the user manager's environment, which has none of this:
    no vault token, and a PATH without ~/.local/bin. providers already reads
    the token off disk for the same reason (_read_env_block). Without it the
    scheduled run resolved no tokens at all and mirrored an empty block over
    the working one.
    """
    path = HOME/".zshenv"
    if not path.exists():
        return {}
    found = {}
    for line in path.read_text().splitlines():
        line = line.strip()
        if not line.startswith("export ") or "=" not in line:
            continue
        name, _, value = line[len("export "):].partition("=")
        found[name.strip()] = value.strip().strip('"\'')
    return found


def _managed_zshenv_exports():
    """Exports from the account-bound harnesses block only, read the way zsh
    would. A secret with a newline is one multiline single-quoted value, so
    lines are joined until the quotes close; and a '#' only starts a comment
    at the head of a line, never inside an unquoted value such as abc#def."""
    path = HOME/".zshenv"
    if not path.exists():
        return {}
    match = re.search(r"^# BEGIN harnesses:mcp-tokens\n(.*?)^# END harnesses:mcp-tokens$",
                      path.read_text(), re.S | re.M)
    if not match:
        return {}
    found, pending = {}, ""
    for line in match.group(1).splitlines(keepends=True):
        if not pending and line.lstrip().startswith("#"):
            continue
        pending += line
        try:
            words = shlex.split(pending)
        except ValueError:
            continue  # quote still open: the value runs onto the next line
        pending = ""
        for word in words:
            name, eq, value = word.partition("=")
            if eq and re.match(r"^[A-Za-z_][A-Za-z0-9_]*$", name):
                found[name] = value
    if pending:
        eprint("  cannot parse the harnesses:mcp-tokens block in %s" % path)
    return found


def _vault_token():
    for source in (os.environ, _zshenv_exports()):
        if source.get("PASSAGE_MCP_TOKEN"):
            return source["PASSAGE_MCP_TOKEN"]
    return ""


def _heal_path():
    """Put the user's own bin directories back on PATH.

    systemd and launchd start us with a login-less PATH, so claude, codex, npm
    and ocx are all invisible: the scheduled run reported "claude not installed"
    and skipped MCP enrolment entirely, and claude's self-update failed with a
    permissions error that was really npm not being found.

    The operator's own bin directories lead, promoted there even when the
    caller had them behind a system one: they hold nothing but the operator's
    own tools, so a system-wide copy of a harness under /usr/local/bin must
    never outrank them. The toolchains go on the end, because they are there to
    be found, not to win -- putting every nvm version the machine still keeps
    in front, newest first, is what made `harnesses update codex` read and
    upgrade a stale copy under an unused node while ~/.local/bin/codex, the
    copy the operator actually runs, sat untouched at an older version.
    """
    mine = [HOME/".local/bin", HOME/".opencode/bin", HOME/".kimi-code/bin"]
    toolchains = sorted((HOME/".nvm/versions/node").glob("*/bin"), reverse=True)
    # macOS keeps node and npm under Homebrew, which a launchd agent does not
    # see either: without these the Macs found claude but not npm, so claude's
    # self-update kept failing for the very reason this function exists.
    toolchains += [pathlib.Path("/opt/homebrew/bin"), pathlib.Path("/usr/local/bin")]
    current = os.environ.get("PATH", "").split(os.pathsep)
    owned = [str(d) for d in mine if d.is_dir()]
    front = owned + [entry for entry in current if entry not in owned]
    os.environ["PATH"] = os.pathsep.join(
        front + [str(d) for d in toolchains if d.is_dir() and str(d) not in front])


_heal_path()
