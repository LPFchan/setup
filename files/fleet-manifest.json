{
  "comment": "What every machine on every account gets from fleet. Personal settings live in the account's ~/.agents tree (settings/*.json, mcp.json); lost.plus MCPs come from Auth's /api/services. The retired* lists are removed wherever fleet finds them. A harness's windows block replaces its other keys on Windows; one without it is not offered there.",
  "harnesses": [
    {
      "name": "claude",
      "install": "curl -fsSL https://claude.ai/install.sh | bash",
      "updateArgs": "update",
      "candidates": [
        "~/.local/bin/claude",
        "~/.claude/local/claude"
      ],
      "windows": {
        "install": "irm https://claude.ai/install.ps1 | iex",
        "updateArgs": "update",
        "candidates": [
          "~/.local/bin/claude.exe"
        ]
      }
    },
    {
      "name": "codex",
      "install": "curl -fsSL https://chatgpt.com/codex/install.sh | sh",
      "updateArgs": "update",
      "windows": {
        "install": "$env:CODEX_NON_INTERACTIVE = '1'; irm https://chatgpt.com/codex/install.ps1 | iex",
        "update": "$env:CODEX_NON_INTERACTIVE = '1'; irm https://chatgpt.com/codex/install.ps1 | iex",
        "candidates": [
          "~/AppData/Local/Programs/OpenAI/Codex/bin/codex.exe"
        ]
      }
    },
    {
      "name": "opencode",
      "install": "curl -fsSL https://opencode.ai/install | bash",
      "updateArgs": "upgrade",
      "candidates": [
        "~/.opencode/bin/opencode"
      ],
      "windows": {
        "install": "npm install -g opencode-ai",
        "updateArgs": "upgrade"
      }
    },
    {
      "name": "hermes",
      "install": "curl -fsSL https://hermes-agent.nousresearch.com/install.sh | bash -s -- --non-interactive",
      "updateArgs": "update --yes",
      "candidates": [
        "~/.local/bin/hermes"
      ],
      "windows": {
        "install": "& ([scriptblock]::Create((irm https://hermes-agent.nousresearch.com/install.ps1).TrimStart([char]0xFEFF))) -NonInteractive",
        "updateArgs": "update --yes",
        "candidates": [
          "~/AppData/Local/hermes/bin/hermes.exe"
        ]
      }
    },
    {
      "name": "t3",
      "install": "set -e; t3=\"$HOME/.local/bin/t3\"; [ -x \"$t3\" ] || curl -fsSL https://t3.codes/install.sh | sh; case \"$(\"$t3\" service status)\" in *\"Status: installed\"*) ;; *) \"$t3\" service install ;; esac",
      "rerunWhenInstalled": true,
      "updateArgs": "update --yes",
      "candidates": [
        "~/.local/bin/t3",
        "~/.t3/runtime/versions/*/t3"
      ]
    },
    {
      "name": "ocx",
      "comment": "The OpenCodex proxy. A bare `ocx service` installs its background service, or repairs one an earlier install left. The update swaps only the package, and fleet restarts the proxy once no turn is running; on Windows a running proxy locks its files, so fleet runs `ocx update`, which stops it, only while it is idle.",
      "install": "npm install -g --allow-scripts=bun @bitkyc08/opencodex && \"$(npm prefix -g)/bin/ocx\" service",
      "update": "npm install -g --allow-scripts=bun @bitkyc08/opencodex@latest",
      "windows": {
        "install": "npm install -g --allow-scripts=bun @bitkyc08/opencodex; if ($LASTEXITCODE) { exit $LASTEXITCODE }; & \"$(npm prefix -g)\\ocx.cmd\" service; exit $LASTEXITCODE",
        "updateArgs": "update",
        "candidates": [
          "~/AppData/Roaming/npm/ocx.cmd"
        ]
      }
    },
    {
      "name": "miniharness",
      "install": "npm install -g miniharness",
      "update": "npm install -g miniharness@latest",
      "windows": {
        "install": "npm install -g miniharness",
        "update": "npm install -g miniharness@latest"
      }
    }
  ],
  "claude": {
    "attribution": {
      "commit": "",
      "pr": ""
    },
    "disableClaudeAiConnectors": true
  },
  "localPluginMcpServers": [
    {
      "name": "cua_repl",
      "plugin": "unified-computer-use",
      "server": "cua_repl",
      "env": {
        "CUA_REPL_ENABLED_SURFACES": "computer"
      }
    }
  ],
  "retiredMcpServers": [
    "obsidian-direct",
    "vaultwarden-secrets"
  ],
  "retiredMcpGrants": [
    "claude_ai_Obsidian_Vault",
    "claude_ai_Vaultwarden_Secrets",
    "claude_ai_tweet-fetch-mcp"
  ],
  "retiredEnvVars": [
    "VAULTWARDEN_MCP_TOKEN",
    "VAULTWARDEN_SECRETS_TOKEN"
  ],
  "retiredT3Models": [
    "codex/gpt-6-astra",
    "codex/gpt-5.6-sol",
    "codex/gpt-5.6-luna",
    "grimoire/qwen3.8-flash-next-uncensored-nvfp4",
    "kimicode/k3-256k",
    "gpt-6-astra",
    "gpt-5.6-sol",
    "gpt-5.6-luna"
  ]
}
