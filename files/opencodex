def desired_opencodex_config(
    registry: dict[str, Any], original: dict[str, Any], auth_data: dict[str, Any]
) -> tuple[dict[str, Any], set[str]]:
    config = json.loads(json.dumps(original or opencodex_seed()))
    providers = config.setdefault("providers", {})
    if not isinstance(providers, dict):
        raise UserError("OpenCodex providers must be an object")
    providers.setdefault("openai", opencodex_seed()["providers"]["openai"])
    config.setdefault("defaultProvider", "openai")

    managed = {
        name
        for name, provider in registry.get("providers", {}).items()
        if provider.get("provider_type") in {"DirectAnthropic", "OpenAICompatible"}
    }
    for stale in managed_provider_names() - managed:
        providers.pop(stale, None)

    # Machine-local enablement is provider-owned state, and OpenCodex's own
    # `disabled` flag is what `ocx sync` filters on when it rebuilds the Codex
    # model catalog. Mirroring it here is what keeps a disabled provider out of
    # the Codex model picker, not just out of launcher selection.
    state = load_provider_state()

    for name in sorted(managed):
        descriptor = registry["providers"][name]
        current = providers.get(name, {})
        provider = dict(current) if isinstance(current, dict) else {}
        if descriptor["provider_type"] == "DirectAnthropic":
            provider.update(
                {
                    "adapter": "anthropic",
                    "baseUrl": descriptor["base_url"],
                    "authMode": "oauth",
                }
            )
            for field in ("apiKey", "apiKeyPool", "disabled"):
                provider.pop(field, None)
        else:
            auth_name = descriptor["auth"]["key"]
            entry = auth_data.get(auth_name, {})
            key = entry.get("key", "") if isinstance(entry, dict) else ""
            override = state.get(name)
            enabled = (
                override["enabled"]
                if override is not None
                else descriptor.get("enabled") is True
            )
            provider.update(
                {
                    "adapter": "openai-chat",
                    "baseUrl": descriptor["base_url"],
                    "authMode": "key",
                    "apiKey": key,
                    "disabled": not enabled or not bool(key),
                    "liveModels": True,
                }
            )
        # Never pin a model: a launch names the one it wants, and with
        # liveModels the proxy serves each provider's full rotating fleet
        # rather than a profile-mapped subset. Popping rather than merely
        # not writing is what retires a pin an older release left behind.
        provider.pop("defaultModel", None)
        provider.pop("models", None)
        provider.pop("selectedModels", None)
        providers[name] = provider

    config["syncResumeHistory"] = sys.platform == "darwin"
    return config, managed


def proxy_health(port: int) -> dict[str, Any] | None:
    """/healthz payload of the proxy on `port`, or None when it is unreachable."""
    request = urllib.request.Request(
        f"http://127.0.0.1:{port}/healthz", headers={"Accept": "application/json"}
    )
    try:
        with urllib.request.urlopen(request, timeout=1.0) as response:
            payload = json.load(response)
    except (OSError, urllib.error.URLError, json.JSONDecodeError):
        return None
    return payload if isinstance(payload, dict) else None


def live_proxy_port() -> int | None:
    """Port of a healthy running proxy, or None when nothing is serving."""
    try:
        port = json.loads(RUNTIME_PORT.read_text())["port"]
    except (OSError, json.JSONDecodeError, KeyError, TypeError):
        return None
    if not isinstance(port, int):
        return None
    payload = proxy_health(port)
    return port if payload is not None and payload.get("status") == "ok" else None


def live_proxy_version(port: int) -> str | None:
    """Version the RUNNING proxy reports, or None when it does not report one."""
    payload = proxy_health(port) or {}
    version = payload.get("version")
    return version if isinstance(version, str) and version else None


def installed_ocx_version() -> str | None:
    """Version of the ocx build on disk, or None when it cannot be read.

    Taken from the package manifest beside the resolved binary: `ocx --version`
    pays a node startup on a path that runs before every launch. The manifest
    is only missing for a non-npm install, which falls back to the CLI.
    """
    try:
        resolved = OCX.resolve(strict=True)
    except (OSError, RuntimeError):
        return None
    for parent in list(resolved.parents)[:4]:
        try:
            manifest = json.loads((parent / "package.json").read_text())
        except (OSError, json.JSONDecodeError):
            continue
        version = manifest.get("version") if isinstance(manifest, dict) else None
        if isinstance(version, str) and version:
            return version
    try:
        proc = subprocess.run(
            [str(OCX), "--version"], capture_output=True, text=True, timeout=15
        )
    except (OSError, subprocess.SubprocessError):
        return None
    if proc.returncode:
        return None
    fields = (proc.stdout or "").split()
    return fields[-1] if fields else None


def live_provider_view(port: int) -> dict[str, dict[str, Any]] | None:
    """Provider name -> full row, as the RUNNING proxy sees it. None if unreadable.

    Rows are already URL-sanitized by the proxy (no userinfo/query/hash;
    trailing slash preserved). Missing optional fields are tolerated by
    callers, so the minimal rows the test fixtures serve never falsely flag.
    """
    try:
        token = ADMIN_TOKEN.read_text().strip()
    except OSError:
        return None
    request = urllib.request.Request(
        f"http://127.0.0.1:{port}/api/providers",
        headers={"Accept": "application/json", "Authorization": f"Bearer {token}"},
    )
    try:
        with urllib.request.urlopen(request, timeout=2.0) as response:
            # Model metadata the proxy echoes back can carry raw control
            # characters, which strict JSON rejects.
            payload = json.loads(response.read().decode("utf-8", "replace"), strict=False)
    except (OSError, urllib.error.URLError, UnicodeDecodeError, json.JSONDecodeError):
        return None
    if not isinstance(payload, list):
        return None
    return {
        row["name"]: row
        for row in payload
        if isinstance(row, dict) and isinstance(row.get("name"), str)
    }


def live_provider_disabled(port: int) -> dict[str, bool] | None:
    """Provider -> disabled, as the RUNNING proxy sees it. None if unreadable."""
    view = live_provider_view(port)
    if view is None:
        return None
    return {name: row.get("disabled") is True for name, row in view.items()}


def _normalized_base_url(value: str) -> str:
    """Routing-safe form of a base URL: no userinfo/query/fragment/trailing '/'.

    The proxy URL-sanitizes /api/providers rows (no userinfo, no query, no
    fragment) but keeps the trailing slash as stored, so both sides are
    reduced to the same shape before comparison.
    """
    parsed = urllib.parse.urlsplit(value)
    if not parsed.scheme or not parsed.hostname:
        return value.rstrip("/")
    port = f":{parsed.port}" if parsed.port else ""
    netloc = f"{parsed.hostname}{port}"
    return urllib.parse.urlunsplit((parsed.scheme, netloc, parsed.path, "", "")).rstrip("/")


def provider_config_diff(
    desired_providers: dict[str, Any], live_view: dict[str, dict[str, Any]]
) -> list[str]:
    """Human-readable reasons the RUNNING proxy's provider routing is stale.

    Direction is desired -> live: only stored-config providers are inspected,
    and a live-only provider (added out-of-band via ocx or the GUI) is never
    flagged. A field absent from a live row — or unset in the desired entry —
    is not compared, so minimal rows (the test fixtures) never falsely flag.
    """
    reasons: list[str] = []
    for name, desired in desired_providers.items():
        if not isinstance(desired, dict):
            continue
        live = live_view.get(name)
        if not isinstance(live, dict):
            reasons.append(f"provider '{name}' is not loaded by the running proxy")
            continue
        for field in ("adapter", "authMode"):
            if field in live and desired.get(field) is not None and desired[field] != live[field]:
                reasons.append(
                    f"provider '{name}' {field} differs "
                    f"(config: {desired[field]}, proxy: {live[field]})"
                )
        if "disabled" in live and (desired.get("disabled") is True) != (
            live["disabled"] is True
        ):
            reasons.append(
                f"provider '{name}' disabled differs "
                f"(config: {desired.get('disabled') is True}, proxy: {live['disabled'] is True})"
            )
        if "liveModels" in live and (
            desired.get("liveModels", True) is not False
        ) != (live["liveModels"] is not False):
            reasons.append(
                f"provider '{name}' liveModels differs "
                f"(config: {desired.get('liveModels', True) is not False}, "
                f"proxy: {live['liveModels'] is not False})"
            )
        if (
            "baseUrl" in live
            and "baseUrl" in desired
            and _normalized_base_url(str(desired["baseUrl"]))
            != _normalized_base_url(str(live["baseUrl"]))
        ):
            reasons.append(
                f"provider '{name}' baseUrl differs "
                f"(config: {desired['baseUrl']}, proxy: {live['baseUrl']})"
            )
        if "hasApiKey" in live and bool(desired.get("apiKey")) != (live["hasApiKey"] is True):
            reasons.append(
                f"provider '{name}' hasApiKey differs "
                f"(config: {bool(desired.get('apiKey'))}, proxy: {live['hasApiKey'] is True})"
            )
    return reasons


def proxy_version_drift(port: int) -> list[str]:
    """Reason the RUNNING proxy predates the ocx build on disk, else [].

    An update swaps the runtime root out from under the running process — the
    old code keeps serving until it is restarted — so a version mismatch is
    stale exactly like a config mismatch. Either side reporting no version
    (an older proxy, a manifest-less install) is never treated as drift.
    """
    running = live_proxy_version(port)
    installed = installed_ocx_version()
    if not running or not installed or running == installed:
        return []
    return [f"proxy is running ocx {running} but {installed} is installed"]


def proxy_stale_reasons(port: int, desired_providers: dict[str, Any]) -> list[str]:
    """Human-readable reasons the proxy on `port` must restart to be current.

    A healthy but unreadable provider view contributes no reasons, so callers
    never blind-restart on routing; version drift is read from /healthz and
    stands on its own.
    """
    reasons = proxy_version_drift(port)
    live = live_provider_view(port)
    if live is not None:
        reasons.extend(provider_config_diff(desired_providers, live))
    return reasons


def proxy_restart_status() -> tuple[bool, int | None, list[str]]:
    """(running, port, reasons) — is the live proxy stale against disk?"""
    port = live_proxy_port()
    if port is None:
        return False, None, []
    stored = load_json_object(OPENCODEX_CONFIG, "OpenCodex config")
    providers = stored.get("providers", {})
    if not isinstance(providers, dict):
        providers = {}
    return True, port, proxy_stale_reasons(port, providers)


def converge_live_proxy(desired: dict[str, Any]) -> None:
    """Restart a running proxy left stale by the apply that just ran.

    The server snapshots config.json at startup and never watches the file, so
    a provider we enable on disk keeps failing every request with
    `Provider is disabled: <name>` — or stays entirely absent from
    /api/providers (the reported deepseek case) — until the process restarts.
    An `_ensure_runtime` upgrade is the same shape: the new build is on disk
    while the old one keeps serving. Comparing the live view (not the disk
    diff) is what heals a proxy that went stale on an earlier apply.
    `ocx restart` is stop + ensure; ensure waits for health and resyncs the
    catalog.
    """
    port = live_proxy_port()
    if port is None:
        return
    if not proxy_stale_reasons(port, desired.get("providers", {})):
        return
    if not (OCX.is_file() and os.access(OCX, os.X_OK)):
        print(
            "opencodex: the running proxy is stale but ocx is missing; "
            "restart the proxy to apply it",
            file=sys.stderr,
        )
        return
    if subprocess.run([str(OCX), "restart"]).returncode:
        print("opencodex: proxy restart failed; run: ocx restart", file=sys.stderr)


def apply_opencodex_registry(registry_path: Path) -> None:
    registry = load_registry(registry_path)
    original = load_json_object(OPENCODEX_CONFIG, "OpenCodex config")
    desired, managed = desired_opencodex_config(registry, original, load_auth())
    if desired != original:
        write_json_atomic(OPENCODEX_CONFIG, desired)
    record = {"version": 1, "providers": sorted(managed)}
    if not OPENCODEX_MANAGED.exists() or load_json_object(
        OPENCODEX_MANAGED, "managed provider record"
    ) != record:
        write_json_atomic(OPENCODEX_MANAGED, record, 0o600)
    converge_live_proxy(desired)


def opencodex_config_status(registry_path: Path) -> bool:
    if not OPENCODEX_CONFIG.exists() or not OPENCODEX_MANAGED.exists():
        return False
    registry = load_registry(registry_path)
    original = load_json_object(OPENCODEX_CONFIG, "OpenCodex config")
    desired, managed = desired_opencodex_config(registry, original, load_auth())
    for config in (original, desired):
        providers = config.get("providers", {})
        for name in managed:
            if isinstance(providers.get(name), dict):
                providers[name]["apiKey"] = ""
                descriptor = registry["providers"][name]
                if descriptor.get("auth", {}).get("type") == "oauth":
                    for field in OAUTH_RECONCILE_FIELDS:
                        providers[name].pop(field, None)
    record = load_json_object(OPENCODEX_MANAGED, "managed provider record")
    return original == desired and record == {"version": 1, "providers": sorted(managed)}


def remove_opencodex_managed() -> None:
    if not OPENCODEX_CONFIG.exists():
        return
    config = load_json_object(OPENCODEX_CONFIG, "OpenCodex config")
    providers = config.get("providers", {})
    if isinstance(providers, dict):
        for name in managed_provider_names():
            providers.pop(name, None)
    config.pop("syncResumeHistory", None)
    write_json_atomic(OPENCODEX_CONFIG, config)
    try:
        OPENCODEX_MANAGED.unlink()
    except FileNotFoundError:
        pass


def choose(prompt: str, options: list[str], allow_cancel: bool = True) -> str | None:
    if shutil.which("fzf") and (sys.stdin.isatty() or not sys.stdout.isatty()):
        proc = subprocess.run(
            ["fzf", "--prompt", f"{prompt} > ", "--height=50%", "--reverse"],
            input="\n".join(options) + "\n",
            text=True,
            stdout=subprocess.PIPE,
        )
        return proc.stdout.rstrip("\n") if proc.returncode == 0 else None
    if not sys.stdin.isatty():
        raise UserError("interactive selection requires a TTY")
    print(prompt)
    for index, option in enumerate(options, 1):
        print(f"  {index}. {option}")
    if allow_cancel:
        print("  0. Cancel")
    while True:
        raw = input("Select: ").strip()
        if allow_cancel and raw == "0":
            return None
        if raw.isdigit() and 1 <= int(raw) <= len(options):
            return options[int(raw) - 1]
        print("Enter a listed number.", file=sys.stderr)


def session_files() -> dict[Path, int]:
    if not CLAUDE_PROJECTS.exists():
        return {}
    result: dict[Path, int] = {}
    for path in CLAUDE_PROJECTS.glob("*/*.jsonl"):
        try:
            result[path] = path.stat().st_mtime_ns
        except OSError:
            pass
    return result


def session_model(sid: str) -> str | None:
    """The model a recorded claude session last answered on.

    Transcripts reach tens of megabytes, so they are streamed a line at a time
    and only the lines that could carry a model are decoded. A transcript a
    crash left half-written is common enough that no single bad line may sink
    the read.
    """
    for path in sorted(CLAUDE_PROJECTS.glob(f"*/{sid}.jsonl")):
        found: str | None = None
        try:
            with path.open(encoding="utf-8", errors="replace") as stream:
                for line in stream:
                    if '"model"' not in line:
                        continue
                    try:
                        entry = json.loads(line)
                    except ValueError:
                        continue
                    message = entry.get("message") if isinstance(entry, dict) else None
                    if not isinstance(message, dict):
                        continue
                    if message.get("role") != "assistant":
                        continue
                    model = message.get("model")
                    # "<synthetic>" marks turns claude fabricated locally for
                    # interrupts and errors; no model ever served them.
                    if isinstance(model, str) and model and model != "<synthetic>":
                        found = model
        except OSError:
            continue
        if found is not None:
            return found
    return None


def write_session_mapping(provider: str, sid: str) -> None:
    SESSIONS.parent.mkdir(parents=True, exist_ok=True)
    entries: list[str] = []
    if SESSIONS.exists():
        entries = [
            line
            for line in SESSIONS.read_text().splitlines()
            if not line.startswith(sid + "\t")
        ]
    entries.append(f"{sid}\t{provider}")
    SESSIONS.write_text("\n".join(entries) + "\n")


def record_session(provider: str, before: dict[Path, int], sid: str | None) -> None:
    """Map the claude session a launch actually ran to its provider.

    Known session ids are claimed before launch so active sessions are
    immediately resumable through OpenCodex. The projects dir diff resolves
    selectors without an id, such as a bare --continue.
    """
    touched = [
        (mtime, path)
        for path, mtime in session_files().items()
        if before.get(path) != mtime
    ]
    if not touched:
        return
    path = None
    if sid is not None:
        for _, candidate in touched:
            if candidate.stem == sid:
                path = candidate
                break
    if path is None and sid is None:
        path = max(touched)[1]
    if path is None:
        return
    write_session_mapping(provider, path.stem)


def session_id_from_args(args: list[str]) -> str | None:
    for index, argument in enumerate(args):
        candidate = ""
        if argument in {"-r", "--resume", "--session-id"}:
            if index + 1 < len(args) and not args[index + 1].startswith("-"):
                candidate = args[index + 1]
        for prefix in ("--resume=", "--session-id="):
            if argument.startswith(prefix) and argument.removeprefix(prefix):
                candidate = argument.removeprefix(prefix)
        if candidate:
            try:
                uuid.UUID(candidate)
            except ValueError:
                continue
            return candidate
    return None


def routed_model(registry: dict[str, Any], provider: str, model: str) -> str:
    descriptor = registry.get("providers", {}).get(provider, {})
    auth = descriptor.get("auth", {})
    if descriptor.get("provider_type") == "OpenAIResponses" and auth.get("provider") == "chatgpt":
        return model
    if model.startswith(f"{provider}/"):
        return model
    return f"{provider}/{model}"


def resumed_model(
    registry: dict[str, Any], provider: str, harness: str, args: list[str]
) -> str | None:
    """The model a resumed claude session already ran, when this provider owns it.

    Continuing a conversation on anything else would swap models mid-thread
    without saying so, so the transcript is the only answer worth inferring;
    a resume that cannot be read from one asks for --model instead. Only
    claude writes the transcripts this reads.
    """
    if harness != "claude":
        return None
    sid = session_id_from_args(args)
    if sid is None:
        return None
    model = session_model(sid)
    # A transcript records the routed name its launch used, so anything that is
    # not already this provider's routed form was served by someone else — a
    # different provider, or native claude — and must not be re-prefixed here.
    if model is None or routed_model(registry, provider, model) != model:
        return None
    return model


EFFORT_ORDER = ("low", "medium", "high", "xhigh", "max", "ultra")
EFFORT_NONE = "none"      # model accepts reasoning but the user disables it
EFFORT_DEFAULT = "default"  # let the server/harness choose; launcher sends nothing
EFFORT_THINKING_TOKENS = {
    "low": "4000",
    "medium": "16000",
    "high": "48000",
    "xhigh": "96000",
    "max": "128000",
    "ultra": "128000",
}
OCX_MODELS_URL = os.environ.get(
    "OPENCODEX_MODELS_URL", "http://localhost:10100/v1/models"
)
# Per-provider capability probing hits each provider's own /v1/models. Tests
# disable it (and the live probe) so the catalog fixture is the only source.
OPENCODEX_CAPABILITY_PROBE = os.environ.get("OPENCODEX_CAPABILITY_PROBE", "1") != "0"


def model_efforts(info: dict[str, Any]) -> list[str]:
    """Effort choices for one model, from the server's reasoning support tier.

    The proxy strips per-model capability fields, so support is tiered from
    the catalog (discrete levels = full) and a per-provider capability probe
    (boolean/on-off = partial, absent = none):

      full    -> the real levels the server advertised
      partial -> reasoning exists but no level names: [none, default]
      none    -> no reasoning support advertised:     [default]
    """
    if info.get("efforts"):
        return list(info["efforts"])
    if info.get("support") == "partial":
        return [EFFORT_NONE, EFFORT_DEFAULT]
    return [EFFORT_DEFAULT]


def provider_enabled(
    name: str,
    descriptor: dict[str, Any],
    state: dict[str, dict[str, bool]] | None = None,
) -> bool:
    """Resolve registry defaults plus local overrides for API-key providers."""
    if descriptor.get("provider_type") != "OpenAICompatible":
        return descriptor.get("enabled") is not False
    if state is None:
        state = load_provider_state()
    entry = state.get(name)
    if entry is not None:
        return entry["enabled"]
    return descriptor.get("enabled") is not False


def enabled_providers(registry: dict[str, Any]) -> list[str]:
    """Effective provider names, including registry-governed OAuth providers."""
    providers = registry.get("providers", {})
    state = load_provider_state()
    names = [
        name
        for name, descriptor in providers.items()
        if provider_enabled(name, descriptor, state)
    ]
    # OAuth providers (codex) carry no 'enabled' flag; OpenAICompatible ones do.
    for name, descriptor in providers.items():
        if descriptor.get("provider_type") == "OpenAIResponses" and name not in names:
            names.append(name)
    return sorted(names)


def provider_uses_bare_ids(registry: dict[str, Any], provider: str) -> bool:
    descriptor = registry.get("providers", {}).get(provider, {})
    auth = descriptor.get("auth", {})
    return (
        descriptor.get("provider_type") == "OpenAIResponses"
        and auth.get("type") == "oauth"
        and auth.get("provider") == "chatgpt"
    )


def provider_model_index(registry: dict[str, Any]) -> dict[str, dict[str, Any]]:
    """Offline baseline: no model ids of its own (the registry's providers only
    know base_urls), so this simply returns an empty index. Model data comes
    from the catalog and the live proxy. Kept as a named seam for symmetry and
    so a future registry-carried model list has one obvious home."""
    return {}


def _restore_catalog_slug(slug: str, known_ids: set[str] | None) -> str:
    """Undo the catalog's provider/model joining when it hid a '/' in the id.

    Slugs are routable ids verbatim except when the model id itself contains
    '/': the catalog then rewrites the remainder's '/' to '-'
    (commandcode/moonshotai/Kimi-K3 -> commandcode/moonshotai-Kimi-K3). An
    explicitly encoded remainder ('_' for '/', '--' for a literal '-') is
    unambiguous — the catalog's own dash-joining never produces either — and
    is restored first. Otherwise the reverse mapping is found by replacing
    dashes left-to-right until a known id is produced.
    """
    if "/" not in slug:
        return slug
    provider, _, rest = slug.partition("/")
    if "_" in rest:
        return f"{provider}/{rest.replace('_', '/').replace('--', '-')}"
    known_ids = known_ids or set()
    chars = list(rest)
    for index, char in enumerate(chars):
        if char != "-":
            continue
        candidate = f"{provider}/{''.join(chars[:index] + ['/'] + chars[index + 1:])}"
        if candidate in known_ids:
            return candidate
    return slug


def catalog_model_index(
    path: Path = CODEX_CATALOG, known_ids: set[str] | None = None
) -> dict[str, dict[str, Any]]:
    """Model id -> info, from the ocx-generated Codex catalog."""
    try:
        data = json.loads(path.read_text())
    except (OSError, json.JSONDecodeError):
        return {}
    models = data.get("models")
    if not isinstance(models, list):
        return {}
    index: dict[str, dict[str, Any]] = {}
    for entry in models:
        if not isinstance(entry, dict):
            continue
        slug = entry.get("slug")
        if not isinstance(slug, str) or not slug:
            continue
        efforts = [
            level["effort"]
            for level in entry.get("supported_reasoning_levels", [])
            if isinstance(level, dict) and level.get("effort") in EFFORT_ORDER
        ]
        efforts.sort(key=EFFORT_ORDER.index)
        model_id = _restore_catalog_slug(slug, known_ids)
        info = index.setdefault(model_id, {"id": model_id, "efforts": efforts})
        if efforts and not info["efforts"]:
            info["efforts"] = efforts
    return index


def live_model_index(url: str = OCX_MODELS_URL, timeout: float = 0.75) -> dict[str, dict[str, Any]]:
    """Model id -> info, from the running ocx proxy's /v1/models (best effort)."""
    request = urllib.request.Request(url, headers={"Accept": "application/json"})
    try:
        with urllib.request.urlopen(request, timeout=timeout) as response:
            payload = json.load(response)
    except (OSError, urllib.error.URLError, json.JSONDecodeError):
        return {}
    rows = payload.get("data") if isinstance(payload, dict) else None
    index: dict[str, dict[str, Any]] = {}
    for row in rows or []:
        if isinstance(row, dict) and isinstance(row.get("id"), str) and row["id"]:
            index[row["id"]] = {"id": row["id"], "efforts": []}
    return index


def _probe_capability(row: dict[str, Any]) -> str:
    """Reasoning-support tier advertised by one upstream /v1/models row.

    'full' when the row lists discrete levels, 'partial' when it only flags
    reasoning as a boolean (crofai's `reasoning_effort`/`custom_reasoning`,
    kimicode's `supports_reasoning`), else 'none' — the provider serves the
    model but offers no reasoning control, so the picker must not invent
    low~ultra choices for it.
    """
    levels = row.get("supported_reasoning_levels")
    if isinstance(levels, list) and levels:
        return "full"
    think = row.get("think_efforts")
    if isinstance(think, dict) and think.get("values"):
        return "full"
    for key in ("reasoning_effort", "custom_reasoning", "supports_reasoning"):
        if row.get(key):
            return "partial"
    return "none"


def provider_support_index(
    registry: dict[str, Any], auth_data: dict[str, Any] | None = None, timeout: float = 0.9
) -> dict[str, str]:
    """Model id -> support tier, from each provider's own /v1/models capability
    fields. The proxy nulls these out, so the upstream endpoints are queried
    directly. Every visible model is recorded (including 'none'): an endpoint
    that omits reasoning metadata means no reasoning control, which must
    override the catalog's blanket level list. Disabled without an
    OPENCODEX_AUTH_JSON; failures yield {}."""
    if not OPENCODEX_CAPABILITY_PROBE:
        return {}
    if auth_data is None:
        try:
            auth_data = load_auth()
        except UserError:
            return {}
    support: dict[str, str] = {}
    state = load_provider_state()
    for name, descriptor in registry.get("providers", {}).items():
        if descriptor.get("provider_type") != "OpenAICompatible":
            continue
        if not provider_enabled(name, descriptor, state):
            continue
        base = (descriptor.get("base_url") or "").rstrip("/")
        auth = descriptor.get("auth") or {}
        entry = auth_data.get(auth.get("key", ""), {})
        key = entry.get("key", "") if isinstance(entry, dict) else ""
        if not base or not key:
            continue
        request = urllib.request.Request(
            f"{base}/models",
            headers={
                "Accept": "application/json",
                "Authorization": f"Bearer {key}",
                # Some edges (Cloudflare) 403 Python's default UA on /models.
                "User-Agent": "opencodex-launcher",
            },
        )
        try:
            with urllib.request.urlopen(request, timeout=timeout) as response:
                payload = json.load(response)
        except (OSError, urllib.error.URLError, json.JSONDecodeError):
            continue
        rows = payload.get("data") if isinstance(payload, dict) else None
        for row in rows or []:
            if not (isinstance(row, dict) and isinstance(row.get("id"), str) and row["id"]):
                continue
            support[f"{name}/{row['id']}"] = _probe_capability(row)
    return support


def merged_model_index(registry: dict[str, Any]) -> dict[str, dict[str, Any]]:
    """Codex catalog + live proxy + provider capability probe, merged. The
    live proxy is the freshness layer (always current when ocx runs); the
    catalog supplies discrete effort levels; the probe marks reasoning
    support the proxy strips. Models unknown to all three do not appear.

    The probe is authoritative for the providers it can see: whatever tier
    it reports overrides the catalog's blanket level list (which ocx writes
    for every model regardless). 'none' clears the list entirely — a provider
    with no reasoning metadata offers no reasoning control, so the picker
    shows only "default". The catalog still wins where the probe has no
    signal (codex, or a provider whose endpoint is unreachable)."""
    live = live_model_index()
    index: dict[str, dict[str, Any]] = {}
    known_ids = set(live)
    for source in (catalog_model_index(known_ids=known_ids), live):
        for model_id, info in source.items():
            current = index.setdefault(model_id, dict(info))
            if info["efforts"]:
                current["efforts"] = list(info["efforts"])
    for model_id, support in provider_support_index(registry).items():
        info = index.setdefault(model_id, {"id": model_id, "efforts": []})
        info["support"] = support
        if support != "full":
            info["efforts"] = []  # no discrete levels to offer
    return index


def ensure_opencodex() -> None:
    if not OCX.is_file() or not os.access(OCX, os.X_OK):
        raise UserError(f"OpenCodex is not installed at {OCX}; run setup update opencodex")
    proc = subprocess.run([str(OCX), "ensure"])
    if proc.returncode:
        raise UserError("OpenCodex could not be started")


def ensure_provider_auth(provider: str | None) -> bool:
    """Ensure provider-owned OAuth is usable; return whether login was new."""
    if provider != "anthropic":
        return False
    proc = subprocess.run(
        [str(OCX), "account", "list", provider, "--json", "--all"],
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
    )
    try:
        payload = json.loads(proc.stdout) if proc.returncode == 0 else {}
    except json.JSONDecodeError:
        payload = {}
    accounts = payload.get("accounts") if isinstance(payload, dict) else None
    if isinstance(accounts, list) and any(
        isinstance(account, dict)
        and account.get("type") == "oauth"
        and account.get("needsReauth") is not True
        for account in accounts
    ):
        return False
    if subprocess.run([str(OCX), "login", provider]).returncode:
        raise UserError("Anthropic OAuth login failed; run ocx login anthropic")
    if subprocess.run([str(OCX), "sync"]).returncode:
        raise UserError("OpenCodex sync failed after Anthropic OAuth login; run ocx sync")
    return True


def ensure_discovery_auth(registry: dict[str, Any]) -> None:
    """Import/login managed Anthropic OAuth before discovering proxy models."""
    ensure_opencodex()
    state = load_provider_state()
    for provider, descriptor in registry.get("providers", {}).items():
        if not provider_enabled(provider, descriptor, state):
            continue
        auth = descriptor.get("auth") or {}
        if (
            descriptor.get("provider_type") == "DirectAnthropic"
            and auth.get("type") == "oauth"
            and auth.get("provider") == "anthropic"
        ):
            ensure_provider_auth(provider)


def launch(
    provider: str | None,
    harness: str,
    args: list[str],
    model: str | None = None,
    effort: str | None = None,
) -> int:
    running, port, reasons = proxy_restart_status()
    if running and reasons:
        # The proxy snapshots config.json at startup, never reloads it, and
        # keeps running the build that was on disk when it started, so a stale
        # process would serve old routing — or an old runtime — to every
        # harness the moment it launches. `ocx restart` is stop + ensure, so
        # the plain ensure below is skipped (restart covers it and resyncs the
        # catalog).
        print(
            "opencodex: the running proxy is stale; "
            "running `ocx restart` to refresh it",
            file=sys.stderr,
        )
        for reason in reasons:
            print(f"  - {reason}", file=sys.stderr)
        if not (OCX.is_file() and os.access(OCX, os.X_OK)):
            print(
                "opencodex: the running proxy is stale but ocx is missing; "
                "restart the proxy to refresh it",
                file=sys.stderr,
            )
        elif subprocess.run([str(OCX), "restart"]).returncode:
            print("opencodex: proxy restart failed; run: ocx restart", file=sys.stderr)
    else:
        ensure_opencodex()
    ensure_provider_auth(provider)
    if model is None:
        raise UserError("a model is required to launch")
    if effort is not None and effort not in EFFORT_ORDER + (EFFORT_NONE, EFFORT_DEFAULT):
        raise UserError(f"unknown reasoning effort: {effort}")
    # "default"/"none" are pass-throughs: send no explicit effort so the
    # server/harness applies its own. Only real levels are forwarded.
    explicit = effort if effort in EFFORT_ORDER else None
    routed = model
    if harness == "codex":
        overrides = [
            f"model_catalog_json={json.dumps(str(CODEX_CATALOG), ensure_ascii=False)}"
        ]
        if explicit is not None:
            overrides.append(f"model_reasoning_effort={json.dumps(explicit)}")
        command = ["codex"]
        for override in overrides:
            command.extend(["-c", override])
        command.extend(["-m", routed, *args])
        if provider is not None:
            record_picker_state(provider, routed, effort, harness)
        return subprocess.run(command).returncode
    if harness == "grok":
        # Grok Build routes through the proxy's OpenAI-compatible
        # /v1/chat/completions endpoint. The model reel already holds the full
        # provider/model route, which ocx auto-registers as an ocx-* alias, so
        # the route is passed straight through. Grok has no per-request effort
        # flag; reasoning stays at the server's default for the route.
        if provider is not None:
            record_picker_state(provider, routed, effort, harness)
        return subprocess.run(["grok", "-m", routed, *args]).returncode
    if harness == "kimi":
        # Kimi Code takes a model alias via -m; the route is passed straight
        # through like the Grok branch. The alias must exist in kimi's own
        # config.toml ([models."<alias>"]) — ocx does not write kimi config.
        # Kimi has no per-request effort flag; reasoning stays at the model's
        # configured default_effort.
        if provider is not None:
            record_picker_state(provider, routed, effort, harness)
        kimi = kimi_executable()
        if kimi is None:
            raise UserError(
                f"Kimi executable not found on PATH or at {KIMI_HOME / 'bin/kimi'}"
            )
        return subprocess.run([kimi, "-m", routed, *args]).returncode
    if harness != "claude":
        raise UserError(f"unknown harness: {harness}")
    env = os.environ.copy()
    env["ANTHROPIC_MODEL"] = routed
    if explicit is not None:
        env["MAX_THINKING_TOKENS"] = EFFORT_THINKING_TOKENS[explicit]
    command = [str(OCX), "claude"]
    # A settings.json "model" pin outranks ANTHROPIC_MODEL in claude's
    # precedence; the --model flag is the only override that always wins.
    command.extend(["--model", routed])
    if "--dangerously-skip-permissions" not in args:
        command.append("--dangerously-skip-permissions")
    sid = session_id_from_args(args)
    has_implicit_selector = any(
        argument in {"--continue", "-c", "--resume", "-r"}
        or argument.startswith("--resume=")
        for argument in args
    )
    if sid is None and not has_implicit_selector:
        sid = str(uuid.uuid4())
        command.extend(["--session-id", sid])
    command.extend(args)
    if provider is not None:
        record_picker_state(provider, routed, effort, harness)
    before = session_files()
    if provider is not None and sid is not None:
        write_session_mapping(provider, sid)
    result = subprocess.run(command, env=env)
    if provider is not None:
        record_session(provider, before, sid)
    return result.returncode


OTHER_PROVIDER = "other"
HARNESSES = ("claude", "codex", "grok", "kimi")
REEL_TITLES = ("Provider", "Model", "Effort", "Harness")
MIN_PICKER_COLS = 70
MIN_PICKER_ROWS = 12
PICKER_STATE = Path(
    os.environ.get("OPENCODEX_PICKER_STATE", HOME / ".config/opencodex/picker-state.json")
)
PICKER_STATE_VERSION = 1


def kimi_executable() -> str | None:
    """Resolve Kimi from PATH or its native per-user installation directory."""
    command = shutil.which("kimi")
    if command is not None:
        return command
    private_command = KIMI_HOME / "bin/kimi"
    return str(private_command) if os.access(private_command, os.X_OK) else None


def available_harnesses() -> list[str]:
    """Harnesses whose subprocess entry points are executable on this machine."""
    return [
        harness
        for harness in HARNESSES
        if (kimi_executable() if harness == "kimi" else shutil.which(harness))
        is not None
    ]


def empty_picker_state() -> dict[str, Any]:
    return {
        "version": PICKER_STATE_VERSION,
        "provider": None,
        "harness": None,
        "models": {},
        "efforts": {},
    }


def load_picker_state() -> dict[str, Any]:
    """Load sanitized picker memory, migrating the legacy provider/model map."""
    try:
        data = json.loads(PICKER_STATE.read_text())
    except (OSError, json.JSONDecodeError):
        return empty_picker_state()
    if not isinstance(data, dict):
        return empty_picker_state()
    if "version" not in data:
        state = empty_picker_state()
        state["models"] = {
            provider: model
            for provider, model in data.items()
            if isinstance(provider, str) and isinstance(model, str)
        }
        return state
    if data.get("version") != PICKER_STATE_VERSION:
        return empty_picker_state()
    state = empty_picker_state()
    if isinstance(data.get("provider"), str):
        state["provider"] = data["provider"]
    if isinstance(data.get("harness"), str):
        state["harness"] = data["harness"]
    for key in ("models", "efforts"):
        values = data.get(key)
        if isinstance(values, dict):
            state[key] = {
                name: value
                for name, value in values.items()
                if isinstance(name, str) and isinstance(value, str)
            }
    return state


def record_picker_state(
    provider: str, model: str, effort: str | None, harness: str
) -> None:
    state = load_picker_state()
    updated = dict(state)
    updated["provider"] = provider
    updated["harness"] = harness
    updated["models"] = dict(state["models"])
    updated["models"][provider] = model
    updated["efforts"] = dict(state["efforts"])
    if effort is not None:
        updated["efforts"][model] = effort
    if updated == state:
        return
    try:
        write_json_atomic(PICKER_STATE, updated)
    except OSError:
        pass  # remembering is best-effort; never block a launch on it


def provider_model_options(
    provider: str,
    registry: dict[str, Any],
    index: dict[str, dict[str, Any]],
) -> list[tuple[str, str, str | None]]:
    """(label, model id, default effort) triples for the model reel.

    Codex OAuth serves bare ids; routed providers, including Anthropic OAuth,
    serve '{provider}/'-prefixed ids; 'other' claims whatever remains. The prefix
    is routing metadata — the provider reel already names it — so labels
    drop it for readability while ids keep it.
    """
    providers = registry.get("providers", {})
    if provider == OTHER_PROVIDER:
        entries = [
            model_id
            for model_id in index
            if "/" in model_id and model_id.split("/", 1)[0] not in providers
        ]
        entries += [
            model_id
            for model_id in index
            if "/" not in model_id
            and not any(
                provider_uses_bare_ids(registry, name) for name in enabled_providers(registry)
            )
        ]
        entries = sorted(set(entries))
    elif provider_uses_bare_ids(registry, provider):
        entries = sorted(model_id for model_id in index if "/" not in model_id)
    else:
        prefix = f"{provider}/"
        entries = sorted(model_id for model_id in index if model_id.startswith(prefix))
    # The third tuple slot is unused; the effort reel derives its choices from
    # the model's support tier via model_efforts().
    prefix = f"{provider}/"
    return [
        (model[len(prefix):] if model.startswith(prefix) else model, model, None)
        for model in entries
    ]


class ReelState:
    """Pure picker state; mutated by handle_key, rendered by the curses layer."""

    def __init__(
        self,
        providers: list[str],
        registry: dict[str, Any],
        index: dict[str, dict[str, Any]],
        harnesses: list[str],
        remembered: dict[str, Any] | None = None,
    ) -> None:
        self.registry = registry
        self.index = index
        self.remembered = remembered or empty_picker_state()
        self.draft_models = dict(self.remembered.get("models", {}))
        self.draft_efforts = dict(self.remembered.get("efforts", {}))
        self.harnesses = list(harnesses)
        self.provider_names = list(providers)
        if provider_model_options(OTHER_PROVIDER, registry, index):
            self.provider_names.append(OTHER_PROVIDER)
        self.focus = 0
        self.cursors = [0, 0, 0, 0]
        remembered_provider = self.remembered.get("provider")
        if remembered_provider in self.provider_names:
            self.cursors[0] = self.provider_names.index(remembered_provider)
        remembered_harness = self.remembered.get("harness")
        if remembered_harness in self.harnesses:
            self.cursors[3] = self.harnesses.index(remembered_harness)
        self.models: list[tuple[str, str, str | None]] = []
        self._refresh_provider(initial=True)

    def swap_index(self, index: dict[str, dict[str, Any]]) -> None:
        """Replace the model index after a background fetch and rebuild the
        'other' row; the provider cursor stays put so the user's place is
        kept, and the remembered model is re-applied to the new list."""
        self.index = index
        has_other = OTHER_PROVIDER in self.provider_names
        if provider_model_options(OTHER_PROVIDER, self.registry, index):
            if not has_other:
                self.provider_names.append(OTHER_PROVIDER)
        elif has_other:
            self.provider_names.remove(OTHER_PROVIDER)
            self.cursors[0] = min(self.cursors[0], len(self.provider_names) - 1)
        self._refresh_provider()

    def _refresh_provider(self, initial: bool = False) -> None:
        provider = self.selected_provider()
        self.models = provider_model_options(provider, self.registry, self.index)
        cursor = 0
        draft = self.draft_models.get(provider)
        if draft is not None:
            for position, (_, model, _) in enumerate(self.models):
                if model == draft:
                    cursor = position
                    break
        self.cursors[1] = cursor
        self._refresh_efforts()

    def _refresh_efforts(self) -> None:
        efforts = self.efforts()
        model = self.selected_model()
        draft = self.draft_efforts.get(model)
        if draft in efforts:
            self.cursors[2] = efforts.index(draft)
            return
        # Prefer the server's neutral default, else the last entry (the
        # default tier's single choice, or the highest real level).
        if EFFORT_DEFAULT in efforts:
            self.cursors[2] = efforts.index(EFFORT_DEFAULT)
        else:
            self.cursors[2] = max(0, len(efforts) - 1)

    def selected_provider(self) -> str:
        return self.provider_names[self.cursors[0]]

    def efforts(self) -> list[str]:
        if not self.models:
            return []
        model_id = self.models[self.cursors[1]][1]
        return model_efforts(self.index.get(model_id, {}))

    def reel_entries(self, reel: int) -> list[str]:
        if reel == 0:
            return self.provider_names
        if reel == 1:
            return [label for label, _, _ in self.models]
        if reel == 2:
            return self.efforts()
        return self.harnesses

    def move_focus(self, delta: int) -> None:
        self.focus = (self.focus + delta) % len(REEL_TITLES)

    def remember_selection(self) -> None:
        """Keep unlaunched picker choices while navigating between reels."""
        model = self.selected_model()
        if model is None:
            return
        self.draft_models[self.selected_provider()] = model
        effort = self.selected_effort()
        if effort is not None:
            self.draft_efforts[model] = effort

    def select_cursor(self, reel: int, index: int) -> None:
        self.remember_selection()
        self.cursors[reel] = index
        if reel == 0:
            self._refresh_provider()
        elif reel == 1:
            self._refresh_efforts()
        self.remember_selection()

    def move_cursor(self, delta: int) -> None:
        length = len(self.reel_entries(self.focus))
        if not length:
            return
        self.select_cursor(
            self.focus, (self.cursors[self.focus] + delta) % length
        )

    def selected_model(self) -> str | None:
        return self.models[self.cursors[1]][1] if self.models else None

    def selected_effort(self) -> str | None:
        efforts = self.efforts()
        return efforts[self.cursors[2]] if efforts else None

    def selection(self) -> tuple[str, str, str | None, str | None]:
        return (
            self.selected_provider(),
            self.harnesses[self.cursors[3]],
            self.selected_model(),
            self.selected_effort(),
        )


PICKER_GAP = 2


def reel_geometry(cols: int) -> tuple[int, int]:
    """(reel width, gap) for the terminal width."""
    return (cols - PICKER_GAP * 3) // 4, PICKER_GAP


def reel_at(x: int, width: int, gap: int) -> int | None:
    """Reel index under the x coordinate, or None over a gap/padding."""
    if x < 0 or width <= 0:
        return None
    reel, offset = divmod(x, width + gap)
    if reel >= len(REEL_TITLES) or offset >= width:
        return None
    return reel


def handle_key(state: ReelState, action: str) -> str | None:
    """Returns 'launch', 'cancel', or None (state mutated in place)."""
    if action == "left":
        state.move_focus(-1)
    elif action == "right":
        state.move_focus(1)
    elif action == "up":
        state.move_cursor(-1)
    elif action == "down":
        state.move_cursor(1)
    elif action == "enter":
        if state.selected_model() is None:
            return None
        return "launch"
    elif action == "cancel":
        return "cancel"
    return None


def split_launch_args(args: list[str]) -> tuple[str | None, str | None, list[str]]:
    """Extract leading '--model X' / '--effort X' (or = forms) from run arguments.

    Only honored before the harness token; anything after it is forwarded.
    """
    model = None
    effort = None
    rest = list(args)
    while rest and rest[0].startswith(("--model", "--effort")):
        token = rest.pop(0)
        option, separator, inline = token.partition("=")
        if option not in ("--model", "--effort"):
            raise UserError(f"unknown run option: {option}")
        value = inline if separator else None
        if value is None:
            if not rest:
                raise UserError(f"{option} requires a value")
            value = rest.pop(0)
        if not value:
            raise UserError(f"{option} requires a value")
        if option == "--model":
            model = value
        else:
            if value not in EFFORT_ORDER + (EFFORT_NONE, EFFORT_DEFAULT):
                raise UserError(f"unknown reasoning effort: {value}")
            effort = value
    return model, effort, rest


def picker_available() -> bool:
    if not (sys.stdin.isatty() and sys.stdout.isatty()):
        return False
    try:
        import curses  # noqa: F401
    except ImportError:
        return False
    return True


def picker_layout(rows: int, cols: int) -> tuple[int, int, int, int, int, int]:
    """(width, gap, header_y, center_y, body, first_row) for the reels."""
    width, gap = reel_geometry(cols)
    header_y = 2
    center_y = rows // 2
    body = max(rows - header_y - 3, 3)  # all rows between the header and hint
    if body % 2 == 0:
        body -= 1  # keep a single unambiguous center row
    return width, gap, header_y, center_y, body, center_y - body // 2


def reel_row_at(
    state: "ReelState", reel: int, y: int, rows: int, cols: int
) -> int | None:
    """Model index under screen row y in the given reel, else None."""
    _, _, _, _, body, first_row = picker_layout(rows, cols)
    row = y - first_row
    if row < 0 or row >= body:
        return None
    index = state.cursors[reel] - body // 2 + row
    entries = state.reel_entries(reel)
    return index if 0 <= index < len(entries) else None


def select_row(state: "ReelState", reel: int, y: int, rows: int, cols: int) -> None:
    """Move the reel's selection to the entry under screen row y."""
    index = reel_row_at(state, reel, y, rows, cols)
    if index is None:
        return
    state.select_cursor(reel, index)


def handle_mouse(
    state: "ReelState", button: int, x: int, y: int, rows: int, cols: int
) -> str | None:
    """Map a mouse event to a picker action, or None when fully handled here."""
    import curses

    width, gap = reel_geometry(cols)
    reel = reel_at(x, width, gap)
    if button & getattr(curses, "BUTTON4_PRESSED", 0):
        if reel is not None:
            state.focus = reel
        return "up"
    if button & getattr(curses, "BUTTON5_PRESSED", 0):
        if reel is not None:
            state.focus = reel
        return "down"
    if button & getattr(curses, "BUTTON6_PRESSED", 0):
        return "left"
    if button & getattr(curses, "BUTTON7_PRESSED", 0):
        return "right"
    click_buttons = curses.BUTTON1_PRESSED | getattr(curses, "BUTTON1_REPEAT", 0)
    # xterm-family terminals report a quick click as CLICKED, not PRESSED.
    click_buttons |= getattr(curses, "BUTTON1_CLICKED", 0)
    if button & click_buttons:
        if reel is None:
            return None
        state.focus = reel  # clicking anywhere on a reel focuses it...
        select_row(state, reel, y, rows, cols)  # ...and selects if a row is hit
    return None


SPINNER_FRAMES = "⠋⠙⠹⠸⠼⠴⦠⦯⦿"


def picker_header(
    proxy: tuple[bool, int | None, list[str], str | None] | None,
) -> tuple[str, str]:
    """(text, style) for the picker's single title/status line.

    Title, runtime version and proxy state read as one banner —
    'opencodex · 2.10.1 · :10100 running' — rather than a stacked pair.
    `proxy` is None while the background probe is still in flight.
    """
    if proxy is None:
        return "opencodex · …", "dim"
    running, port, reasons, version = proxy
    parts = ["opencodex"]
    if version:
        parts.append(version)
    if not running:
        return " · ".join(parts + ["proxy stopped"]), "dim"
    parts.append(f":{port} running" if port else "running")
    if reasons:
        return " · ".join(parts + ["restart on launch"]), "warn"
    return " · ".join(parts), "title"


def run_reel_picker(
    providers: list[str], registry: dict[str, Any], harnesses: list[str]
) -> tuple[str, str, str | None, str | None] | str | None:
    """Four-reel provider/model/effort/harness picker. Returns a selection
    4-tuple or None when cancelled.

    The UI opens immediately with an empty model index; a background thread
    runs merged_model_index() and the model reel spins until it lands."""
    import curses
    import threading

    state = ReelState(providers, registry, {}, harnesses, load_picker_state())
    fetched: dict[str, Any] = {}

    def fetch() -> None:
        try:
            running, port, reasons = proxy_restart_status()
            live = live_proxy_version(port) if running and port else None
            fetched["proxy"] = (running, port, reasons, live or installed_ocx_version())
        except Exception:
            fetched["proxy"] = None
        try:
            fetched["index"] = merged_model_index(registry)
        except Exception:
            fetched["index"] = {}  # a failed fetch still ends the spinner
        finally:
            fetched["ready"] = True

    threading.Thread(target=fetch, daemon=True).start()

    def translate(key: int) -> str | None:
        if key in (curses.KEY_LEFT, ord("h")):
            return "left"
        if key in (curses.KEY_RIGHT, ord("l")):
            return "right"
        if key in (curses.KEY_UP, ord("k")):
            return "up"
        if key in (curses.KEY_DOWN, ord("j")):
            return "down"
        if key in (10, 13, curses.KEY_ENTER):
            return "enter"
        if key in (27, ord("q")):
            return "cancel"
        return None

    def draw(stdscr: Any, y: int, x: int, width: int, text: str, attr: int) -> None:
        try:
            stdscr.addnstr(y, x, text.ljust(width), width, attr)
        except curses.error:
            pass

    def render_reel(
        stdscr: Any, x: int, header_y: int, center_y: int, body: int, width: int,
        reel: int, entries: list[str], attrs: dict[str, int],
    ) -> None:
        focused = state.focus == reel
        cursor = state.cursors[reel]
        header = f"▸ {REEL_TITLES[reel]} ◂" if focused else f"  {REEL_TITLES[reel]}"
        draw(stdscr, header_y, x, width, header, attrs["header"] if focused else attrs["dim"])
        if reel == 1 and not fetched.get("ready"):
            frame = SPINNER_FRAMES[fetched.get("ticks", 0) % len(SPINNER_FRAMES)]
            draw(stdscr, center_y, x, width, f"{frame} fetching models…", attrs["dim"])
            return
        # The selected row is pinned to the reel's vertical center; the list
        # scrolls underneath it as the cursor moves.
        offset = cursor - body // 2
        for row in range(body):
            index = offset + row
            y = center_y - body // 2 + row
            if index < 0 or index >= len(entries):
                draw(stdscr, y, x, width, "", attrs["normal"])
                continue
            selected = index == cursor
            if selected and focused:
                attr = attrs["selected"]
            elif selected:
                attr = attrs["selected_dim"]
            else:
                attr = attrs["normal"]
            draw(stdscr, y, x, width, entries[index], attr)

    def render(stdscr: Any, attrs: dict[str, int]) -> None:
        stdscr.erase()
        if fetched.get("ready") and not fetched.get("applied"):
            fetched["applied"] = True
            state.swap_index(fetched["index"])
        rows, cols = stdscr.getmaxyx()
        if cols < MIN_PICKER_COLS or rows < MIN_PICKER_ROWS:
            message = f"terminal too small (need {MIN_PICKER_COLS}x{MIN_PICKER_ROWS})"
            draw(stdscr, rows // 2, 0, cols, message.center(cols - 1), attrs["dim"])
            stdscr.refresh()
            return
        banner, style = picker_header(fetched.get("proxy"))
        draw(stdscr, 0, 0, cols, f" {banner} ".center(cols - 1), attrs[style])
        width, gap, header_y, center_y, body, _ = picker_layout(rows, cols)
        for reel in range(4):
            render_reel(
                stdscr, reel * (width + gap), header_y, center_y, body, width,
                reel, state.reel_entries(reel), attrs,
            )
        hint = "←/→ column · ↑/↓ select · enter launch · q cancel"
        draw(stdscr, rows - 1, 0, cols, hint.center(cols - 1), attrs["dim"])
        stdscr.refresh()

    def loop(stdscr: Any) -> tuple[str, str, str | None] | str | None:
        curses.curs_set(0)
        stdscr.keypad(True)
        # BUTTON5 (wheel down) and the horizontal wheel are not in every
        # curses build — macOS ncurses stops at BUTTON4 — so every constant
        # is looked up defensively.
        mouse_events = 0
        for name in (
            "BUTTON1_PRESSED", "BUTTON1_RELEASED", "BUTTON4_PRESSED",
            "BUTTON5_PRESSED", "BUTTON6_PRESSED", "BUTTON7_PRESSED",
            "BUTTON1_REPEAT", "BUTTON1_CLICKED",
        ):
            mouse_events |= getattr(curses, name, 0)
        curses.mousemask(mouse_events)
        curses.mousemask(mouse_events)
        if curses.has_colors():
            curses.start_color()
            curses.use_default_colors()
            curses.init_pair(1, curses.COLOR_BLACK, curses.COLOR_CYAN)
            curses.init_pair(2, curses.COLOR_BLACK, curses.COLOR_WHITE)
            curses.init_pair(3, curses.COLOR_CYAN, -1)
            curses.init_pair(4, curses.COLOR_YELLOW, -1)
            attrs = {
                "selected": curses.color_pair(1) | curses.A_BOLD,
                "selected_dim": curses.color_pair(2),
                "header": curses.color_pair(3) | curses.A_BOLD,
                "title": curses.A_BOLD,
                "dim": curses.A_DIM,
                "warn": curses.color_pair(4) | curses.A_BOLD,
                "normal": curses.A_NORMAL,
            }
        else:
            attrs = {
                "selected": curses.A_REVERSE | curses.A_BOLD,
                "selected_dim": curses.A_REVERSE,
                "header": curses.A_BOLD,
                "title": curses.A_BOLD,
                "dim": curses.A_DIM,
                "warn": curses.A_BOLD,
                "normal": curses.A_NORMAL,
            }
        # Wake periodically so the spinner animates and the fetched index is
        # picked up even when the user isn't typing.
        stdscr.timeout(120)
        while True:
            render(stdscr, attrs)
            key = stdscr.getch()
            if key == -1:  # timeout, no input
                if not fetched.get("ready"):
                    fetched["ticks"] = fetched.get("ticks", 0) + 1
                continue
            if key == curses.KEY_MOUSE:
                try:
                    _, x, y, _, button = curses.getmouse()
                except curses.error:
                    continue
                if button & curses.BUTTON1_RELEASED:
                    continue
                rows, cols = stdscr.getmaxyx()
                action = handle_mouse(state, button, x, y, rows, cols)
                if action is None:
                    continue
            else:
                action = translate(key)
                if action is None:
                    continue
            result = handle_key(state, action)
            if result == "cancel":
                return None
            if result == "launch":
                return state.selection()

    return curses.wrapper(loop)


def _choose_launch_fallback(
    providers: list[str],
    registry: dict[str, Any],
    index: dict[str, dict[str, Any]],
    harnesses: list[str],
) -> tuple[str, str, str | None, str | None] | None:
    names = list(providers)
    if provider_model_options(OTHER_PROVIDER, registry, index):
        names.append(OTHER_PROVIDER)
    name = choose("opencodex provider", names)
    if name is None:
        return None
    options = provider_model_options(name, registry, index)
    chosen = choose("model", [label for label, _, _ in options])
    if chosen is None:
        return None
    model_id = next(model for label, model, _ in options if label == chosen)
    effort = choose("effort", model_efforts(index.get(model_id, {})))
    if effort is None:
        return None
    harness = choose("harness", harnesses)
    return None if harness is None else (name, harness, model_id, effort)


def choose_launch(
    registry: dict[str, Any],
) -> tuple[str, str, str | None, str | None] | None:
    providers = enabled_providers(registry)
    if not providers and not catalog_model_index():
        raise UserError("no enabled providers")
    ensure_discovery_auth(registry)
    harnesses = available_harnesses()
    if not harnesses:
        raise UserError("no supported harness is installed (claude, codex, grok, or kimi)")
    if picker_available():
        try:
            # The picker fetches the model index in the background so the UI
            # opens immediately.
            return run_reel_picker(providers, registry, harnesses)
        except Exception as exc:
            print(f"opencodex: picker unavailable ({exc}); using prompts", file=sys.stderr)
    return _choose_launch_fallback(
        providers, registry, merged_model_index(registry), harnesses
    )


LIST_USAGE = "usage: opencodex list [--provider NAME] [--json]"


def parse_list_args(argv: list[str]) -> tuple[str | None, bool]:
    """Flags for `list`: --provider NAME (or --provider=NAME) and --json."""
    provider: str | None = None
    as_json = False
    rest = list(argv)
    while rest:
        arg = rest.pop(0)
        if arg == "--json":
            as_json = True
        elif arg == "--provider":
            if not rest:
                raise UserError(f"--provider requires a value ({LIST_USAGE})")
            provider = rest.pop(0)
        elif arg.startswith("--provider="):
            provider = arg.split("=", 1)[1]
        else:
            raise UserError(f"unknown argument: {arg} ({LIST_USAGE})")
    if provider == "":
        raise UserError(f"--provider requires a value ({LIST_USAGE})")
    return provider, as_json


def catalogue(
    registry: dict[str, Any], provider_filter: str | None = None
) -> dict[str, Any]:
    """The four-reel picker's catalogue as plain data, for callers with no TTY.

    Reads exactly the sources the picker reads — enabled_providers() for
    disablement, merged_model_index() for models, model_efforts() for the
    effort reel, available_harnesses() for the harness reel — plus the live
    proxy's routing status, but nothing that can block, prompt, or start
    anything: no OAuth discovery, no proxy launch, no restart. The proxy
    status line is read-only (health + /api/providers HTTP). With the proxy
    down merged_model_index() narrows to the Codex catalog, which is the right
    answer here rather than an error.

    Model ids are routable verbatim (routed_model() is the identity on them:
    routed providers already carry their prefix, bare-id ChatGPT OAuth takes
    none), so each id can be passed straight to `run --model`.

    The 'other' pseudo-provider is included because the picker offers it, but
    it is not a registry provider and is flagged launchable=False — there is
    no `opencodex run other`.
    """
    providers = enabled_providers(registry)
    index = merged_model_index(registry)
    names = list(providers)
    if provider_model_options(OTHER_PROVIDER, registry, index):
        names.append(OTHER_PROVIDER)
    if provider_filter is not None:
        if provider_filter not in names:
            known = ", ".join(names) or "none"
            if provider_filter in registry.get("providers", {}):
                raise UserError(
                    f"provider is disabled: {provider_filter} (enabled: {known})"
                )
            raise UserError(f"unknown provider: {provider_filter} (enabled: {known})")
        names = [provider_filter]
    entries: list[dict[str, Any]] = []
    for name in names:
        launchable = name != OTHER_PROVIDER
        entries.append(
            {
                "name": name,
                "launchable": launchable,
                "models": [
                    {
                        "id": model_id,
                        "label": label,
                        "efforts": model_efforts(index.get(model_id, {})),
                        "support": index.get(model_id, {}).get("support"),
                    }
                    for label, model_id, _ in provider_model_options(
                        name, registry, index
                    )
                ],
            }
        )
    running, port, reasons = proxy_restart_status()
    return {
        "providers": entries,
        "harnesses": available_harnesses(),
        "proxy": {
            "running": running,
            "port": port,
            "restart_pending": bool(reasons),
            "reasons": reasons,
        },
    }


def render_catalogue(data: dict[str, Any]) -> str:
    """Tab-separated rows under '#' comment lines, for awk/cut/grep consumers.

    Every non-'#' line is one (provider, model) pair, so `grep -v '^#'` yields
    a clean table and column 4 tells a caller whether the row is launchable.
    """
    harnesses = ", ".join(data["harnesses"]) or "none"
    lines = [
        "# columns: provider\tmodel\tefforts\tstatus",
        "# launch: opencodex run <provider> --model <model> [--effort <effort>] [<harness>]",
        f"# harnesses: {harnesses}",
    ]
    proxy = data.get("proxy", {})
    if proxy.get("running"):
        lines.append(f"# proxy: running on {proxy.get('port')}")
        if proxy.get("restart_pending"):
            lines.append(
                "# warning: the running proxy is stale; "
                "invoking opencodex will run: ocx restart"
            )
            for reason in proxy.get("reasons", []):
                lines.append(f"#   - {reason}")
    else:
        lines.append("# proxy: stopped")
    if any(not entry["launchable"] for entry in data["providers"]):
        lines.append(
            "# status=unlaunchable: 'other' collects models no enabled provider"
            " claims; there is no 'opencodex run other'"
        )
    for entry in data["providers"]:
        status = "launchable" if entry["launchable"] else "unlaunchable"
        for model in entry["models"]:
            efforts = ",".join(model["efforts"])
            lines.append(f"{entry['name']}\t{model['id']}\t{efforts}\t{status}")
    return "\n".join(lines)


def main() -> int:
    if len(sys.argv) >= 2 and sys.argv[1].startswith("__"):
        command = sys.argv[1]
        if command == "__validate":
            load_registry(Path(sys.argv[2]))
        elif command == "__apply":
            # The registry path is optional so provider-state consumers can
            # re-apply enablement without knowing where the snapshot lives.
            apply_opencodex_registry(
                Path(sys.argv[2]) if len(sys.argv) > 2 else REGISTRY
            )
        elif command == "__remove":
            remove_opencodex_managed()
        elif command == "__status":
            return 0 if opencodex_config_status(Path(sys.argv[2])) else 1
        elif command == "__names":
            print("\n".join(load_registry(Path(sys.argv[2]))["providers"]))
        else:
            raise UserError("unknown internal command")
        return 0
    registry = load_registry()
    if len(sys.argv) >= 2 and sys.argv[1] == "run":
        if len(sys.argv) < 3:
            raise UserError(
                "usage: opencodex run <provider> [--model MODEL] [--effort EFFORT] [claude|codex|grok|kimi] [arguments]"
            )
        provider = sys.argv[2]
        effective_providers = enabled_providers(registry)
        if provider not in registry.get("providers", {}):
            names = ", ".join(effective_providers) or "none"
            raise UserError(f"unknown provider: {provider} (enabled: {names})")
        if provider not in effective_providers:
            names = ", ".join(effective_providers) or "none"
            raise UserError(f"provider is disabled: {provider} (enabled: {names})")
        model, effort, args = split_launch_args(sys.argv[3:])
        harness = "claude"
        if args and args[0] in HARNESSES:
            harness, args = args[0], args[1:]
        if model is None:
            model = resumed_model(registry, provider, harness, args)
            if model is None:
                raise UserError(
                    f"pass --model to launch {provider} "
                    f"(models: opencodex list --provider {provider})"
                )
        model = routed_model(registry, provider, model)
        return launch(provider, harness, args, model, effort)
    if len(sys.argv) >= 2 and sys.argv[1] == "list":
        provider_filter, as_json = parse_list_args(sys.argv[2:])
        # Same emptiness check choose_launch() makes, so both entry points
        # fail identically instead of one printing an empty catalogue.
        if not enabled_providers(registry) and not catalog_model_index():
            raise UserError("no enabled providers")
        data = catalogue(registry, provider_filter)
        print(json.dumps(data, indent=2) if as_json else render_catalogue(data))
        return 0
    if len(sys.argv) > 1:
        if not OCX.is_file() or not os.access(OCX, os.X_OK):
            raise UserError(f"OpenCodex is not installed at {OCX}; run setup update opencodex")
        return subprocess.run([str(OCX), *sys.argv[1:]]).returncode
    selection = choose_launch(registry)
    if selection is None:
        return 0
    provider, harness, model, effort = selection
    return launch(provider, harness, [], model, effort)


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except (UserError, KeyboardInterrupt) as exc:
        if str(exc):
            print(f"opencodex: {exc}", file=sys.stderr)
        raise SystemExit(1)
