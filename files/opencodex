HOME = Path.home()
OCX = Path(os.environ.get("OPENCODEX_BIN", HOME / ".local/bin/ocx"))
OPENCODEX_CONFIG = Path(
    os.environ.get("OPENCODEX_CONFIG", HOME / ".opencodex/config.json")
)
OPENCODEX_MANAGED = Path(
    os.environ.get(
        "OPENCODEX_MANAGED", HOME / ".opencodex/setup-managed-providers.json"
    )
)
REGISTRY = Path(
    os.environ.get(
        "OPENCODEX_REGISTRY", HOME / ".config/opencodex/managed-profiles.json"
    )
)
AUTH_JSON = Path(
    os.environ.get(
        "OPENCODEX_AUTH_JSON",
        os.environ.get("CLAUDEX_AUTH_JSON", HOME / ".local/share/opencode/auth.json"),
    )
)
SESSIONS = Path(
    os.environ.get("OPENCODEX_SESSIONS", HOME / ".config/opencodex/sessions.tsv")
)
SETUP_REPO = os.environ.get("OPENCODEX_SETUP_REPO", "git@github.com:LPFchan/setup.git")
