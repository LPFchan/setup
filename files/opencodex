def model_efforts(info: dict[str, Any]) -> list[str]:
    """Effort choices for one model, from the server's reasoning support tier.

    The proxy strips per-model capability fields, so support is tiered from
    the catalog (discrete levels = full) and a per-provider capability probe
    (boolean/on-off = partial, absent = none):

      full    -> the real levels the server advertised
      partial -> reasoning exists but no level names: [none, default]
      none    -> no reasoning support advertised:     [default]
    """
    if info.get("efforts"):
        return list(info["efforts"])
    if info.get("support") == "partial":
        return [EFFORT_NONE, EFFORT_DEFAULT]
    return [EFFORT_DEFAULT]


def enabled_providers(registry: dict[str, Any]) -> list[str]:
    """Enabled provider names from the registry, OAuth (codex) included."""
    providers = registry.get("providers", {})
    names = [
        name
        for name, descriptor in providers.items()
        if descriptor.get("enabled") is not False
    ]
    # OAuth providers (codex) carry no 'enabled' flag; OpenAICompatible ones do.
    for name, descriptor in providers.items():
        if descriptor.get("provider_type") == "OpenAIResponses" and name not in names:
            names.append(name)
    return sorted(names)


def provider_uses_bare_ids(registry: dict[str, Any], provider: str) -> bool:
    descriptor = registry.get("providers", {}).get(provider, {})
    return descriptor.get("provider_type") == "OpenAIResponses"


def provider_model_index(registry: dict[str, Any]) -> dict[str, dict[str, Any]]:
    """Offline baseline: no model ids of its own (the registry's providers only
    know base_urls), so this simply returns an empty index. Model data comes
    from the catalog and the live proxy. Kept as a named seam for symmetry and
    so a future registry-carried model list has one obvious home."""
    return {}


def _restore_catalog_slug(slug: str, known_ids: set[str] | None) -> str:
    """Undo the catalog's provider/model joining when it hid a '/' in the id.

    Slugs are routable ids verbatim except when the model id itself contains
    '/': the catalog then rewrites the remainder's '/' to '-'
    (commandcode/moonshotai/Kimi-K3 -> commandcode/moonshotai-Kimi-K3). An
    explicitly encoded remainder ('_' for '/', '--' for a literal '-') is
    unambiguous — the catalog's own dash-joining never produces either — and
    is restored first. Otherwise the reverse mapping is found by replacing
    dashes left-to-right until a known id is produced.
    """
    if "/" not in slug:
        return slug
    provider, _, rest = slug.partition("/")
    if "_" in rest:
        return f"{provider}/{rest.replace('_', '/').replace('--', '-')}"
    known_ids = known_ids or set()
    chars = list(rest)
    for index, char in enumerate(chars):
        if char != "-":
            continue
        candidate = f"{provider}/{''.join(chars[:index] + ['/'] + chars[index + 1:])}"
        if candidate in known_ids:
            return candidate
    return slug


def catalog_model_index(
    path: Path = CODEX_CATALOG, known_ids: set[str] | None = None
) -> dict[str, dict[str, Any]]:
    """Model id -> info, from the ocx-generated Codex catalog."""
    try:
        data = json.loads(path.read_text())
    except (OSError, json.JSONDecodeError):
        return {}
    models = data.get("models")
    if not isinstance(models, list):
        return {}
    index: dict[str, dict[str, Any]] = {}
    for entry in models:
        if not isinstance(entry, dict):
            continue
        slug = entry.get("slug")
        if not isinstance(slug, str) or not slug:
            continue
        efforts = [
            level["effort"]
            for level in entry.get("supported_reasoning_levels", [])
            if isinstance(level, dict) and level.get("effort") in EFFORT_ORDER
        ]
        efforts.sort(key=EFFORT_ORDER.index)
        model_id = _restore_catalog_slug(slug, known_ids)
        info = index.setdefault(model_id, {"id": model_id, "efforts": efforts})
        if efforts and not info["efforts"]:
            info["efforts"] = efforts
    return index


def live_model_index(url: str = OCX_MODELS_URL, timeout: float = 0.75) -> dict[str, dict[str, Any]]:
    """Model id -> info, from the running ocx proxy's /v1/models (best effort)."""
    request = urllib.request.Request(url, headers={"Accept": "application/json"})
    try:
        with urllib.request.urlopen(request, timeout=timeout) as response:
            payload = json.load(response)
    except (OSError, urllib.error.URLError, json.JSONDecodeError):
        return {}
    rows = payload.get("data") if isinstance(payload, dict) else None
    index: dict[str, dict[str, Any]] = {}
    for row in rows or []:
        if isinstance(row, dict) and isinstance(row.get("id"), str) and row["id"]:
            index[row["id"]] = {"id": row["id"], "efforts": []}
    return index


def _probe_capability(row: dict[str, Any]) -> str:
    """Reasoning-support tier advertised by one upstream /v1/models row.

    'full' when the row lists discrete levels, 'partial' when it only flags
    reasoning as a boolean (crofai's `reasoning_effort`/`custom_reasoning`,
    kimicode's `supports_reasoning`), else 'none' — the provider serves the
    model but offers no reasoning control, so the picker must not invent
    low~ultra choices for it.
    """
    levels = row.get("supported_reasoning_levels")
    if isinstance(levels, list) and levels:
        return "full"
    think = row.get("think_efforts")
    if isinstance(think, dict) and think.get("values"):
        return "full"
    for key in ("reasoning_effort", "custom_reasoning", "supports_reasoning"):
        if row.get(key):
            return "partial"
    return "none"


def provider_support_index(
    registry: dict[str, Any], auth_data: dict[str, Any] | None = None, timeout: float = 0.9
) -> dict[str, str]:
    """Model id -> support tier, from each provider's own /v1/models capability
    fields. The proxy nulls these out, so the upstream endpoints are queried
    directly. Every visible model is recorded (including 'none'): an endpoint
    that omits reasoning metadata means no reasoning control, which must
    override the catalog's blanket level list. Disabled without an
    OPENCODEX_AUTH_JSON; failures yield {}."""
    if not OPENCODEX_CAPABILITY_PROBE:
        return {}
    if auth_data is None:
        try:
            auth_data = load_auth()
        except UserError:
            return {}
    support: dict[str, str] = {}
    for name, descriptor in registry.get("providers", {}).items():
        if descriptor.get("provider_type") != "OpenAICompatible":
            continue
        if descriptor.get("enabled") is False:
            continue
        base = (descriptor.get("base_url") or "").rstrip("/")
        auth = descriptor.get("auth") or {}
        entry = auth_data.get(auth.get("key", ""), {})
        key = entry.get("key", "") if isinstance(entry, dict) else ""
        if not base or not key:
            continue
        request = urllib.request.Request(
            f"{base}/models",
            headers={
                "Accept": "application/json",
                "Authorization": f"Bearer {key}",
                # Some edges (Cloudflare) 403 Python's default UA on /models.
                "User-Agent": "opencodex-launcher",
            },
        )
        try:
            with urllib.request.urlopen(request, timeout=timeout) as response:
                payload = json.load(response)
        except (OSError, urllib.error.URLError, json.JSONDecodeError):
            continue
        rows = payload.get("data") if isinstance(payload, dict) else None
        for row in rows or []:
            if not (isinstance(row, dict) and isinstance(row.get("id"), str) and row["id"]):
                continue
            support[f"{name}/{row['id']}"] = _probe_capability(row)
    return support


def merged_model_index(registry: dict[str, Any]) -> dict[str, dict[str, Any]]:
    """Codex catalog + live proxy + provider capability probe, merged. The
    live proxy is the freshness layer (always current when ocx runs); the
    catalog supplies discrete effort levels; the probe marks reasoning
    support the proxy strips. Models unknown to all three do not appear.

    The probe is authoritative for the providers it can see: whatever tier
    it reports overrides the catalog's blanket level list (which ocx writes
    for every model regardless). 'none' clears the list entirely — a provider
    with no reasoning metadata offers no reasoning control, so the picker
    shows only "default". The catalog still wins where the probe has no
    signal (codex, or a provider whose endpoint is unreachable)."""
    live = live_model_index()
    index: dict[str, dict[str, Any]] = {}
    known_ids = set(live)
    for source in (catalog_model_index(known_ids=known_ids), live):
        for model_id, info in source.items():
            current = index.setdefault(model_id, dict(info))
            if info["efforts"]:
                current["efforts"] = list(info["efforts"])
    for model_id, support in provider_support_index(registry).items():
        info = index.setdefault(model_id, {"id": model_id, "efforts": []})
        info["support"] = support
        if support != "full":
            info["efforts"] = []  # no discrete levels to offer
    return index


def ensure_opencodex() -> None:
    if not OCX.is_file() or not os.access(OCX, os.X_OK):
        raise UserError(f"OpenCodex is not installed at {OCX}; run setup update opencodex")
    proc = subprocess.run([str(OCX), "ensure"])
    if proc.returncode:
        raise UserError("OpenCodex could not be started")


def launch(
    provider: str | None,
    harness: str,
    args: list[str],
    model: str | None = None,
    effort: str | None = None,
    record: str | None = None,
) -> int:
    ensure_opencodex()
    if model is None:
        raise UserError("a model is required to launch")
    if effort is not None and effort not in EFFORT_ORDER + (EFFORT_NONE, EFFORT_DEFAULT):
        raise UserError(f"unknown reasoning effort: {effort}")
    # "default"/"none" are pass-throughs: send no explicit effort so the
    # server/harness applies its own. Only real levels are forwarded.
    explicit = effort if effort in EFFORT_ORDER else None
    routed = model
    if harness == "codex":
        overrides = [
            f"model_catalog_json={json.dumps(str(CODEX_CATALOG), ensure_ascii=False)}"
        ]
        if explicit is not None:
            overrides.append(f"model_reasoning_effort={json.dumps(explicit)}")
        command = ["codex"]
        for override in overrides:
            command.extend(["-c", override])
        command.extend(["-m", routed, *args])
        if provider is not None:
            record_picker_state(provider, routed)
        return subprocess.run(command).returncode
    if harness == "grok":
        # Grok Build routes through the proxy's OpenAI-compatible
        # /v1/chat/completions endpoint. The model reel already holds the full
        # provider/model route, which ocx auto-registers as an ocx-* alias, so
        # the route is passed straight through. Grok has no per-request effort
        # flag; reasoning stays at the server's default for the route.
        if provider is not None:
            record_picker_state(provider, routed)
        return subprocess.run(["grok", "-m", routed, *args]).returncode
    if harness != "claude":
        raise UserError(f"unknown harness: {harness}")
    env = os.environ.copy()
    env["ANTHROPIC_MODEL"] = routed
    if explicit is not None:
        env["MAX_THINKING_TOKENS"] = EFFORT_THINKING_TOKENS[explicit]
    command = [str(OCX), "claude"]
    # A settings.json "model" pin outranks ANTHROPIC_MODEL in claude's
    # precedence; the --model flag is the only override that always wins.
    command.extend(["--model", routed])
    if "--dangerously-skip-permissions" not in args:
        command.append("--dangerously-skip-permissions")
    sid = session_id_from_args(args)
    has_implicit_selector = any(
        argument in {"--continue", "-c", "--resume", "-r"}
        or argument.startswith("--resume=")
        for argument in args
    )
    if sid is None and not has_implicit_selector:
        sid = str(uuid.uuid4())
        command.extend(["--session-id", sid])
    command.extend(args)
    if provider is not None:
        record_picker_state(provider, routed)
    result = subprocess.run(command, env=env)
    if sid is not None:
        record_session_id(record or provider or "custom", sid)
    return result.returncode


ADD_PROFILE = "Add profile…"
OTHER_PROVIDER = "other"
HARNESSES = ("claude", "codex", "grok")
REEL_TITLES = ("Provider", "Model", "Effort", "Harness")
MIN_PICKER_COLS = 70
MIN_PICKER_ROWS = 12
PICKER_STATE = Path(
    os.environ.get("OPENCODEX_PICKER_STATE", HOME / ".config/opencodex/picker-state.json")
)


def load_picker_state() -> dict[str, str]:
    """Last-used model per provider, tolerating a missing/corrupt state file."""
    try:
        data = json.loads(PICKER_STATE.read_text())
    except (OSError, json.JSONDecodeError):
        return {}
    if not isinstance(data, dict):
        return {}
    return {
        provider: model
        for provider, model in data.items()
        if isinstance(provider, str) and isinstance(model, str)
    }


def record_picker_state(provider: str, model: str) -> None:
    state = load_picker_state()
    if state.get(provider) == model:
        return
    state[provider] = model
    try:
        write_json_atomic(PICKER_STATE, state)
    except OSError:
        pass  # remembering is best-effort; never block a launch on it


def provider_model_options(
    provider: str,
    registry: dict[str, Any],
    index: dict[str, dict[str, Any]],
) -> list[tuple[str, str, str | None]]:
    """(label, model id, default effort) triples for the model reel.

    OAuth providers (codex) serve bare ids; OpenAICompatible providers serve
    '{provider}/'-prefixed ids; 'other' claims whatever remains. The prefix
    is routing metadata — the provider reel already names it — so labels
    drop it for readability while ids keep it.
    """
    providers = registry.get("providers", {})
    if provider == OTHER_PROVIDER:
        entries = [
            model_id
            for model_id in index
            if "/" in model_id and model_id.split("/", 1)[0] not in providers
        ]
        entries += [
            model_id
            for model_id in index
            if "/" not in model_id
            and not any(
                provider_uses_bare_ids(registry, name) for name in enabled_providers(registry)
            )
        ]
        entries = sorted(set(entries))
    elif provider_uses_bare_ids(registry, provider):
        entries = sorted(model_id for model_id in index if "/" not in model_id)
    else:
        prefix = f"{provider}/"
        entries = sorted(model_id for model_id in index if model_id.startswith(prefix))
    # The third tuple slot is unused; the effort reel derives its choices from
    # the model's support tier via model_efforts().
    prefix = f"{provider}/"
    return [
        (model[len(prefix):] if model.startswith(prefix) else model, model, None)
        for model in entries
    ]


class ReelState:
    """Pure picker state; mutated by handle_key, rendered by the curses layer."""

    def __init__(
        self,
        providers: list[str],
        registry: dict[str, Any],
        index: dict[str, dict[str, Any]],
        remembered: dict[str, str] | None = None,
    ) -> None:
        self.registry = registry
        self.index = index
        self.remembered = remembered or {}
        self.provider_names = list(providers)
        if provider_model_options(OTHER_PROVIDER, registry, index):
            self.provider_names.append(OTHER_PROVIDER)
        self.provider_names.append(ADD_PROFILE)
        self.focus = 0
        self.cursors = [0, 0, 0, 0]
        self.models: list[tuple[str, str, str | None]] = []
        self._refresh_provider(initial=True)

    def swap_index(self, index: dict[str, dict[str, Any]]) -> None:
        """Replace the model index after a background fetch and rebuild the
        'other' row; the provider cursor stays put so the user's place is
        kept, and the remembered model is re-applied to the new list."""
        self.index = index
        has_other = OTHER_PROVIDER in self.provider_names
        if provider_model_options(OTHER_PROVIDER, self.registry, index):
            if not has_other:
                self.provider_names.insert(-1, OTHER_PROVIDER)  # before Add profile
        elif has_other:
            self.provider_names.remove(OTHER_PROVIDER)
            self.cursors[0] = min(self.cursors[0], len(self.provider_names) - 1)
        self._refresh_provider()

    def _refresh_provider(self, initial: bool = False) -> None:
        provider = self.selected_provider()
        if provider == ADD_PROFILE:
            self.models = []
        else:
            self.models = provider_model_options(provider, self.registry, self.index)
        cursor = 0
        remembered = self.remembered.get(provider)
        if remembered is not None:
            for position, (_, model, _) in enumerate(self.models):
                if model == remembered:
                    cursor = position
                    break
        self.cursors[1] = cursor
        self._refresh_efforts()

    def _refresh_efforts(self) -> None:
        efforts = self.efforts()
        # Prefer the server's neutral default, else the last entry (the
        # default tier's single choice, or the highest real level).
        if EFFORT_DEFAULT in efforts:
            self.cursors[2] = efforts.index(EFFORT_DEFAULT)
        else:
            self.cursors[2] = max(0, len(efforts) - 1)

    def selected_provider(self) -> str:
        return self.provider_names[self.cursors[0]]

    def efforts(self) -> list[str]:
        if not self.models:
            return []
        model_id = self.models[self.cursors[1]][1]
        return model_efforts(self.index.get(model_id, {}))

    def reel_entries(self, reel: int) -> list[str]:
        if reel == 0:
            return self.provider_names
        if reel == 1:
            return [label for label, _, _ in self.models]
        if reel == 2:
            return self.efforts()
        return list(HARNESSES)

    def move_focus(self, delta: int) -> None:
        self.focus = (self.focus + delta) % len(REEL_TITLES)

    def move_cursor(self, delta: int) -> None:
        length = len(self.reel_entries(self.focus))
        if not length:
            return
        self.cursors[self.focus] = (self.cursors[self.focus] + delta) % length
        if self.focus == 0:
            self._refresh_provider()
        elif self.focus == 1:
            self._refresh_efforts()

    def selected_model(self) -> str | None:
        return self.models[self.cursors[1]][1] if self.models else None

    def selected_effort(self) -> str | None:
        efforts = self.efforts()
        return efforts[self.cursors[2]] if efforts else None

    def selection(self) -> tuple[str, str, str | None, str | None]:
        return (
            self.selected_provider(),
            HARNESSES[self.cursors[3]],
            self.selected_model(),
            self.selected_effort(),
        )


PICKER_GAP = 2


def reel_geometry(cols: int) -> tuple[int, int]:
    """(reel width, gap) for the terminal width."""
    return (cols - PICKER_GAP * 3) // 4, PICKER_GAP


def reel_at(x: int, width: int, gap: int) -> int | None:
    """Reel index under the x coordinate, or None over a gap/padding."""
    if x < 0 or width <= 0:
        return None
    reel, offset = divmod(x, width + gap)
    if reel >= len(REEL_TITLES) or offset >= width:
        return None
    return reel


def handle_key(state: ReelState, action: str) -> str | None:
    """Returns 'launch', 'add', 'cancel', or None (state mutated in place)."""
    if action == "left":
        state.move_focus(-1)
    elif action == "right":
        state.move_focus(1)
    elif action == "up":
        state.move_cursor(-1)
    elif action == "down":
        state.move_cursor(1)
    elif action == "enter":
        if state.selected_provider() == ADD_PROFILE:
            return "add"
        if state.selected_model() is None:
            return None
        return "launch"
    elif action == "cancel":
        return "cancel"
    return None


def split_launch_args(args: list[str]) -> tuple[str | None, str | None, list[str]]:
    """Extract leading '--model X' / '--effort X' (or = forms) from run arguments.

    Only honored before the harness token; anything after it is forwarded.
    """
    model = None
    effort = None
    rest = list(args)
    while rest and rest[0].startswith(("--model", "--effort")):
        token = rest.pop(0)
        option, separator, inline = token.partition("=")
        if option not in ("--model", "--effort"):
            raise UserError(f"unknown run option: {option}")
        value = inline if separator else None
        if value is None:
            if not rest:
                raise UserError(f"{option} requires a value")
            value = rest.pop(0)
        if not value:
            raise UserError(f"{option} requires a value")
        if option == "--model":
            model = value
        else:
            if value not in EFFORT_ORDER + (EFFORT_NONE, EFFORT_DEFAULT):
                raise UserError(f"unknown reasoning effort: {value}")
            effort = value
    return model, effort, rest


def picker_available() -> bool:
    if not (sys.stdin.isatty() and sys.stdout.isatty()):
        return False
    try:
        import curses  # noqa: F401
    except ImportError:
        return False
    return True


def picker_layout(rows: int, cols: int) -> tuple[int, int, int, int, int, int]:
    """(width, gap, header_y, center_y, body, first_row) for the reels."""
    width, gap = reel_geometry(cols)
    header_y = 2
    center_y = rows // 2
    body = max(rows - header_y - 3, 3)  # all rows between the header and hint
    if body % 2 == 0:
        body -= 1  # keep a single unambiguous center row
    return width, gap, header_y, center_y, body, center_y - body // 2


def reel_row_at(
    state: "ReelState", reel: int, y: int, rows: int, cols: int
) -> int | None:
    """Model index under screen row y in the given reel, else None."""
    _, _, _, _, body, first_row = picker_layout(rows, cols)
    row = y - first_row
    if row < 0 or row >= body:
        return None
    index = state.cursors[reel] - body // 2 + row
    entries = state.reel_entries(reel)
    return index if 0 <= index < len(entries) else None


def select_row(state: "ReelState", reel: int, y: int, rows: int, cols: int) -> None:
    """Move the reel's selection to the entry under screen row y."""
    index = reel_row_at(state, reel, y, rows, cols)
    if index is None:
        return
    state.cursors[reel] = index
    if reel == 0:
        state._refresh_provider()
    elif reel == 1:
        state._refresh_efforts()


def handle_mouse(
    state: "ReelState", button: int, x: int, y: int, rows: int, cols: int
) -> str | None:
    """Map a mouse event to a picker action, or None when fully handled here."""
    import curses

    width, gap = reel_geometry(cols)
    reel = reel_at(x, width, gap)
    if button & getattr(curses, "BUTTON4_PRESSED", 0):
        if reel is not None:
            state.focus = reel
        return "up"
    if button & getattr(curses, "BUTTON5_PRESSED", 0):
        if reel is not None:
            state.focus = reel
        return "down"
    if button & getattr(curses, "BUTTON6_PRESSED", 0):
        return "left"
    if button & getattr(curses, "BUTTON7_PRESSED", 0):
        return "right"
    click_buttons = curses.BUTTON1_PRESSED | getattr(curses, "BUTTON1_REPEAT", 0)
    # xterm-family terminals report a quick click as CLICKED, not PRESSED.
    click_buttons |= getattr(curses, "BUTTON1_CLICKED", 0)
    if button & click_buttons:
        if reel is None:
            return None
        state.focus = reel  # clicking anywhere on a reel focuses it...
        select_row(state, reel, y, rows, cols)  # ...and selects if a row is hit
    return None


SPINNER_FRAMES = "⠋⠙⠹⠸⠼⠴⦠⦯⦿"


def run_reel_picker(
    providers: list[str], registry: dict[str, Any]
) -> tuple[str, str, str | None, str | None] | str | None:
    """Four-reel provider/model/effort/harness picker. Returns a selection
    4-tuple, 'add' for the Add-profile flow, or None when cancelled.

    The UI opens immediately with an empty model index; a background thread
    runs merged_model_index() and the model reel spins until it lands."""
    import curses
    import threading

    state = ReelState(providers, registry, {}, load_picker_state())
    fetched: dict[str, Any] = {}

    def fetch() -> None:
        try:
            fetched["index"] = merged_model_index(registry)
        except Exception:
            fetched["index"] = {}  # a failed fetch still ends the spinner
        finally:
            fetched["ready"] = True

    threading.Thread(target=fetch, daemon=True).start()

    def translate(key: int) -> str | None:
        if key in (curses.KEY_LEFT, ord("h")):
            return "left"
        if key in (curses.KEY_RIGHT, ord("l")):
            return "right"
        if key in (curses.KEY_UP, ord("k")):
            return "up"
        if key in (curses.KEY_DOWN, ord("j")):
            return "down"
        if key in (10, 13, curses.KEY_ENTER):
            return "enter"
        if key in (27, ord("q")):
            return "cancel"
        return None

    def draw(stdscr: Any, y: int, x: int, width: int, text: str, attr: int) -> None:
        try:
            stdscr.addnstr(y, x, text.ljust(width), width, attr)
        except curses.error:
            pass

    def render_reel(
        stdscr: Any, x: int, header_y: int, center_y: int, body: int, width: int,
        reel: int, entries: list[str], attrs: dict[str, int],
    ) -> None:
        focused = state.focus == reel
        cursor = state.cursors[reel]
        header = f"▸ {REEL_TITLES[reel]} ◂" if focused else f"  {REEL_TITLES[reel]}"
        draw(stdscr, header_y, x, width, header, attrs["header"] if focused else attrs["dim"])
        if reel == 1 and not fetched.get("ready"):
            frame = SPINNER_FRAMES[fetched.get("ticks", 0) % len(SPINNER_FRAMES)]
            draw(stdscr, center_y, x, width, f"{frame} fetching models…", attrs["dim"])
            return
        # The selected row is pinned to the reel's vertical center; the list
        # scrolls underneath it as the cursor moves.
        offset = cursor - body // 2
        for row in range(body):
            index = offset + row
            y = center_y - body // 2 + row
            if index < 0 or index >= len(entries):
                draw(stdscr, y, x, width, "", attrs["normal"])
                continue
            selected = index == cursor
            if selected and focused:
                attr = attrs["selected"]
            elif selected:
                attr = attrs["selected_dim"]
            else:
                attr = attrs["normal"]
            draw(stdscr, y, x, width, entries[index], attr)

    def render(stdscr: Any, attrs: dict[str, int]) -> None:
        stdscr.erase()
        if fetched.get("ready") and not fetched.get("applied"):
            fetched["applied"] = True
            state.swap_index(fetched["index"])
        rows, cols = stdscr.getmaxyx()
        if cols < MIN_PICKER_COLS or rows < MIN_PICKER_ROWS:
            message = f"terminal too small (need {MIN_PICKER_COLS}x{MIN_PICKER_ROWS})"
            draw(stdscr, rows // 2, 0, cols, message.center(cols - 1), attrs["dim"])
            stdscr.refresh()
            return
        draw(stdscr, 0, 0, cols, " opencodex ".center(cols - 1), attrs["title"])
        width, gap, header_y, center_y, body, _ = picker_layout(rows, cols)
        for reel in range(4):
            render_reel(
                stdscr, reel * (width + gap), header_y, center_y, body, width,
                reel, state.reel_entries(reel), attrs,
            )
        hint = "←/→ column · ↑/↓ select · enter launch · q cancel"
        draw(stdscr, rows - 1, 0, cols, hint.center(cols - 1), attrs["dim"])
        stdscr.refresh()

    def loop(stdscr: Any) -> tuple[str, str, str | None] | str | None:
        curses.curs_set(0)
        stdscr.keypad(True)
        # BUTTON5 (wheel down) and the horizontal wheel are not in every
        # curses build — macOS ncurses stops at BUTTON4 — so every constant
        # is looked up defensively.
        mouse_events = 0
        for name in (
            "BUTTON1_PRESSED", "BUTTON1_RELEASED", "BUTTON4_PRESSED",
            "BUTTON5_PRESSED", "BUTTON6_PRESSED", "BUTTON7_PRESSED",
            "BUTTON1_REPEAT", "BUTTON1_CLICKED",
        ):
            mouse_events |= getattr(curses, name, 0)
        curses.mousemask(mouse_events)
        curses.mousemask(mouse_events)
        if curses.has_colors():
            curses.start_color()
            curses.use_default_colors()
            curses.init_pair(1, curses.COLOR_BLACK, curses.COLOR_CYAN)
            curses.init_pair(2, curses.COLOR_BLACK, curses.COLOR_WHITE)
            curses.init_pair(3, curses.COLOR_CYAN, -1)
            attrs = {
                "selected": curses.color_pair(1) | curses.A_BOLD,
                "selected_dim": curses.color_pair(2),
                "header": curses.color_pair(3) | curses.A_BOLD,
                "title": curses.A_BOLD,
                "dim": curses.A_DIM,
                "normal": curses.A_NORMAL,
            }
        else:
            attrs = {
                "selected": curses.A_REVERSE | curses.A_BOLD,
                "selected_dim": curses.A_REVERSE,
                "header": curses.A_BOLD,
                "title": curses.A_BOLD,
                "dim": curses.A_DIM,
                "normal": curses.A_NORMAL,
            }
        # Wake periodically so the spinner animates and the fetched index is
        # picked up even when the user isn't typing.
        stdscr.timeout(120)
        while True:
            render(stdscr, attrs)
            key = stdscr.getch()
            if key == -1:  # timeout, no input
                if not fetched.get("ready"):
                    fetched["ticks"] = fetched.get("ticks", 0) + 1
                continue
            if key == curses.KEY_MOUSE:
                try:
                    _, x, y, _, button = curses.getmouse()
                except curses.error:
                    continue
                if button & curses.BUTTON1_RELEASED:
                    continue
                rows, cols = stdscr.getmaxyx()
                action = handle_mouse(state, button, x, y, rows, cols)
                if action is None:
                    continue
            else:
                action = translate(key)
                if action is None:
                    continue
            result = handle_key(state, action)
            if result == "cancel":
                return None
            if result == "add":
                return "add"
            if result == "launch":
                return state.selection()

    return curses.wrapper(loop)


def _choose_launch_fallback(
    providers: list[str], registry: dict[str, Any], index: dict[str, dict[str, Any]]
) -> tuple[str, str, str | None, str | None] | str | None:
    names = list(providers)
    if provider_model_options(OTHER_PROVIDER, registry, index):
        names.append(OTHER_PROVIDER)
    names.append(ADD_PROFILE)
    name = choose("opencodex provider", names)
    if name is None:
        return None
    if name == ADD_PROFILE:
        return "add"
    options = provider_model_options(name, registry, index)
    chosen = choose("model", [label for label, _, _ in options])
    if chosen is None:
        return None
    model_id = next(model for label, model, _ in options if label == chosen)
    effort = choose("effort", model_efforts(index.get(model_id, {})))
    if effort is None:
        return None
    harness = choose("harness", list(HARNESSES))
    return None if harness is None else (name, harness, model_id, effort)


def choose_launch(
    registry: dict[str, Any],
) -> tuple[str, str, str | None, str | None] | str | None:
    providers = enabled_providers(registry)
    if not providers and not catalog_model_index():
        raise UserError("no enabled providers in the registry")
    if picker_available():
        try:
            # The picker fetches the model index in the background so the UI
            # opens immediately.
            return run_reel_picker(providers, registry)
        except Exception as exc:
            print(f"opencodex: picker unavailable ({exc}); using prompts", file=sys.stderr)
    return _choose_launch_fallback(providers, registry, merged_model_index(registry))


def main() -> int:
    if len(sys.argv) >= 2 and sys.argv[1].startswith("__"):
        command = sys.argv[1]
        if command == "__validate":
            load_registry(Path(sys.argv[2]))
        elif command == "__apply":
            apply_opencodex_registry(Path(sys.argv[2]))
        elif command == "__remove":
            remove_opencodex_managed()
        elif command == "__status":
            return 0 if opencodex_config_status(Path(sys.argv[2])) else 1
        elif command == "__names":
            print("\n".join(item["name"] for item in load_registry(Path(sys.argv[2]))["profiles"]))
        else:
            raise UserError("unknown internal command")
        return 0
    registry = load_registry()
    if len(sys.argv) >= 2 and sys.argv[1] == "run":
        if len(sys.argv) < 3:
            raise UserError(
                "usage: opencodex run <profile> [--model MODEL] [--effort EFFORT] [claude|codex] [arguments]"
            )
        profile = profile_by_name(registry, sys.argv[2])
        model, effort, args = split_launch_args(sys.argv[3:])
        harness = "claude"
        if args and args[0] in HARNESSES:
            harness, args = args[0], args[1:]
        provider = profile["provider"]
        model = routed_model(profile, profile["default_model"] if model is None else model)
        return launch(provider, harness, args, model, effort, record=profile["name"])
    if len(sys.argv) > 1:
        if not OCX.is_file() or not os.access(OCX, os.X_OK):
            raise UserError(f"OpenCodex is not installed at {OCX}; run setup update opencodex")
        return subprocess.run([str(OCX), *sys.argv[1:]]).returncode
    selection = choose_launch(registry)
    if selection is None:
        return 0
    if selection == "add":
        add_profile(registry)
        return 0
    provider, harness, model, effort = selection
    return launch(provider, harness, [], model, effort)


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except (UserError, KeyboardInterrupt) as exc:
        if str(exc):
            print(f"opencodex: {exc}", file=sys.stderr)
        raise SystemExit(1)
