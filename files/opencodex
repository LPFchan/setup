def provider_profiles(registry: dict[str, Any], provider_name: str) -> list[dict[str, Any]]:
    return sorted(
        [
            profile
            for profile in registry["profiles"]
            if profile.get("provider") == provider_name
        ],
        key=lambda profile: profile["priority"],
        reverse=True,
    )


def desired_opencodex_config(
    registry: dict[str, Any], original: dict[str, Any], auth_data: dict[str, Any]
) -> tuple[dict[str, Any], set[str]]:
    config = json.loads(json.dumps(original or opencodex_seed()))
    providers = config.setdefault("providers", {})
    if not isinstance(providers, dict):
        raise UserError("OpenCodex providers must be an object")
    providers.setdefault("openai", opencodex_seed()["providers"]["openai"])
    config.setdefault("defaultProvider", "openai")

    managed = {
        name
        for name, provider in registry.get("providers", {}).items()
        if provider.get("provider_type") == "OpenAICompatible"
    }
    for stale in managed_provider_names() - managed:
        providers.pop(stale, None)

    for name in sorted(managed):
        descriptor = registry["providers"][name]
        profiles = provider_profiles(registry, name)
        auth_name = descriptor["auth"]["key"]
        entry = auth_data.get(auth_name, {})
        key = entry.get("key", "") if isinstance(entry, dict) else ""
        current = providers.get(name, {})
        provider = dict(current) if isinstance(current, dict) else {}
        provider.update(
            {
                "adapter": "openai-chat",
                "baseUrl": descriptor["base_url"],
                "authMode": "key",
                "apiKey": key,
                "disabled": descriptor.get("enabled") is not True or not bool(key),
                "liveModels": True,
            }
        )
        if profiles:
            provider["defaultModel"] = profiles[0]["default_model"]
        else:
            provider.pop("defaultModel", None)
        # Never pin models/selectedModels: with liveModels the proxy serves
        # each provider's full rotating fleet, not a profile-mapped subset.
        provider.pop("models", None)
        provider.pop("selectedModels", None)
        providers[name] = provider

    config["syncResumeHistory"] = sys.platform == "darwin"
    return config, managed


def apply_opencodex_registry(registry_path: Path) -> None:
    registry = load_registry(registry_path)
    original = load_json_object(OPENCODEX_CONFIG, "OpenCodex config")
    desired, managed = desired_opencodex_config(registry, original, load_auth())
    if desired != original:
        write_json_atomic(OPENCODEX_CONFIG, desired)
    record = {"version": 1, "providers": sorted(managed)}
    if not OPENCODEX_MANAGED.exists() or load_json_object(
        OPENCODEX_MANAGED, "managed provider record"
    ) != record:
        write_json_atomic(OPENCODEX_MANAGED, record, 0o600)


def opencodex_config_status(registry_path: Path) -> bool:
    if not OPENCODEX_CONFIG.exists() or not OPENCODEX_MANAGED.exists():
        return False
    registry = load_registry(registry_path)
    original = load_json_object(OPENCODEX_CONFIG, "OpenCodex config")
    desired, managed = desired_opencodex_config(registry, original, load_auth())
    for config in (original, desired):
        providers = config.get("providers", {})
        for name in managed:
            if isinstance(providers.get(name), dict):
                providers[name]["apiKey"] = ""
    record = load_json_object(OPENCODEX_MANAGED, "managed provider record")
    return original == desired and record == {"version": 1, "providers": sorted(managed)}


def remove_opencodex_managed() -> None:
    if not OPENCODEX_CONFIG.exists():
        return
    config = load_json_object(OPENCODEX_CONFIG, "OpenCodex config")
    providers = config.get("providers", {})
    if isinstance(providers, dict):
        for name in managed_provider_names():
            providers.pop(name, None)
    config.pop("syncResumeHistory", None)
    write_json_atomic(OPENCODEX_CONFIG, config)
    try:
        OPENCODEX_MANAGED.unlink()
    except FileNotFoundError:
        pass


def choose(prompt: str, options: list[str], allow_cancel: bool = True) -> str | None:
    if shutil.which("fzf") and (sys.stdin.isatty() or not sys.stdout.isatty()):
        proc = subprocess.run(
            ["fzf", "--prompt", f"{prompt} > ", "--height=50%", "--reverse"],
            input="\n".join(options) + "\n",
            text=True,
            stdout=subprocess.PIPE,
        )
        return proc.stdout.rstrip("\n") if proc.returncode == 0 else None
    if not sys.stdin.isatty():
        raise UserError("interactive profile selection requires a TTY")
    print(prompt)
    for index, option in enumerate(options, 1):
        print(f"  {index}. {option}")
    if allow_cancel:
        print("  0. Cancel")
    while True:
        raw = input("Select: ").strip()
        if allow_cancel and raw == "0":
            return None
        if raw.isdigit() and 1 <= int(raw) <= len(options):
            return options[int(raw) - 1]
        print("Enter a listed number.", file=sys.stderr)


def discover_models(base_url: str, token: str) -> list[str]:
    request = urllib.request.Request(
        base_url.rstrip("/") + "/models",
        headers={"Authorization": "Bearer " + token, "Accept": "application/json"},
    )
    try:
        with urllib.request.urlopen(request, timeout=15) as response:
            payload = json.load(response)
    except (OSError, urllib.error.URLError, json.JSONDecodeError) as exc:
        raise UserError(f"model discovery failed: {exc}") from exc
    rows = payload.get("data") if isinstance(payload, dict) else None
    models = sorted(
        {row.get("id") for row in rows or [] if isinstance(row, dict) and isinstance(row.get("id"), str) and row["id"]}
    )
    if not models:
        raise UserError("the endpoint returned no model IDs")
    return models


def run_git(args: list[str], cwd: Path | None = None, capture: bool = False) -> str:
    proc = subprocess.run(
        ["git", *args],
        cwd=cwd,
        text=True,
        stdout=subprocess.PIPE if capture else None,
        stderr=subprocess.PIPE,
    )
    if proc.returncode:
        detail = proc.stderr.strip() if proc.stderr else "git command failed"
        raise UserError(detail)
    return proc.stdout.rstrip("\r\n") if capture and proc.stdout else ""


def store_token(name: str, token: str) -> None:
    data = load_auth_strict()
    if name in data:
        raise UserError(f"the local auth store already contains an entry named {name}")
    data[name] = {"type": "api", "key": token}
    AUTH_JSON.parent.mkdir(parents=True, exist_ok=True)
    fd, tmp_name = tempfile.mkstemp(prefix=".auth.", dir=AUTH_JSON.parent)
    try:
        os.fchmod(fd, 0o600)
        with os.fdopen(fd, "w") as handle:
            json.dump(data, handle, indent=2, sort_keys=True)
            handle.write("\n")
        os.replace(tmp_name, AUTH_JSON)
    finally:
        try:
            os.unlink(tmp_name)
        except FileNotFoundError:
            pass


def provision_profile(profile: dict[str, Any], token: str) -> None:
    auth_data = load_auth_strict()
    if profile["name"] in auth_data:
        raise UserError(
            f"the local auth store already contains an entry named {profile['name']}"
        )
    with tempfile.TemporaryDirectory(prefix="opencodex-profile-") as temp:
        clone = Path(temp) / "setup"
        run_git(["clone", "--quiet", "--branch", "main", "--single-branch", SETUP_REPO, str(clone)])
        registry_path = clone / "files/claudex-profiles.json"
        data = load_registry(registry_path)
        if any(item["name"] == profile["name"] for item in data["profiles"]):
            raise UserError(f"profile {profile['name']} already exists in the setup repository")
        if profile["name"] in data.get("providers", {}):
            raise UserError(f"provider {profile['name']} already exists in the setup repository")
        data.setdefault("providers", {})[profile["name"]] = {
            "provider_type": profile["provider_type"],
            "base_url": profile["base_url"],
            "api_format": "openai",
            "npm": "@ai-sdk/openai-compatible",
            "auth": profile["auth"],
            "enabled": True,
        }
        data["profiles"].append(profile)
        validate_registry(data)
        registry_path.write_text(json.dumps(data, indent=2, ensure_ascii=False) + "\n")
        changed = run_git(["status", "--porcelain"], cwd=clone, capture=True).splitlines()
        if not changed or any(line[3:] != "files/claudex-profiles.json" for line in changed):
            raise UserError("temporary clone contains changes outside the profile registry")
        run_git(["diff", "--check"], cwd=clone)
        run_git(["add", "--", "files/claudex-profiles.json"], cwd=clone)
        run_git(
            [
                "-c", "user.name=opencodex launcher",
                "-c", "user.email=opencodex@localhost",
                "commit", "--quiet", "-m", f"Add opencodex profile {profile['name']}",
            ],
            cwd=clone,
        )
        run_git(["push", "--quiet", "origin", "HEAD:main"], cwd=clone)
        commit = run_git(["rev-parse", "HEAD"], cwd=clone, capture=True)
    store_token(profile["name"], token)
    env = os.environ.copy()
    env["LINUX_SETUP_SOURCE_URL"] = RAW_REPO.rstrip("/") + "/" + commit
    proc = subprocess.run([SETUP_BIN, "update", *PROVIDER_CONSUMER_MODULES], env=env)
    if proc.returncode:
        raise UserError(
            "the profile was pushed and its token was stored, but setup provisioning failed; run setup update claudex opencodex refresh-models"
        )


def add_profile(registry: dict[str, Any]) -> None:
    existing = {profile["name"] for profile in registry["profiles"]}
    existing.update(registry.get("providers", {}))
    name = input("Profile name: ").strip()
    if not NAME_RE.fullmatch(name) or name in existing:
        raise UserError("profile names must be unique lowercase letters, digits, or hyphens")
    if name in load_auth_strict():
        raise UserError("the local auth store already uses that name; choose another profile name")
    base_url = input("OpenAI-compatible API base URL: ").strip().rstrip("/")
    if not valid_base_url(base_url):
        raise UserError("the API base URL must be an HTTP(S) URL")
    token = getpass.getpass("API token: ")
    if not token:
        raise UserError("the API token cannot be empty")
    models = discover_models(base_url, token)
    mappings: dict[str, str] = {}
    for alias in ("opus", "sonnet", "haiku"):
        selected = choose(f"Map {alias}", models)
        if selected is None:
            return
        mappings[alias] = selected
    profile = {
        "name": name,
        "provider": name,
        "provider_type": "OpenAICompatible",
        "base_url": base_url,
        "auth": {"type": "api-key", "store": "opencode", "key": name},
        "default_model": mappings["opus"],
        "priority": max(0, 80 - len(existing)),
        "enabled": True,
        "strip_params": "Auto",
        "models": {"haiku": mappings["haiku"], "sonnet": mappings["sonnet"], "opus": mappings["opus"]},
    }
    validate_registry({"version": 1, "profiles": [profile]})
    print("\nProfile to publish:")
    print(f"  name: {name}")
    print(f"  endpoint: {base_url}")
    for alias in ("opus", "sonnet", "haiku"):
        print(f"  {alias}: {mappings[alias]}")
    print("  token: [stored locally]")
    if input("Commit to LPFchan/setup main and provision this machine? [y/N] ").strip().lower() != "y":
        return
    provision_profile(profile, token)
    print(f"opencodex: profile {name} added and provisioned")


def record_session_id(profile: str, sid: str) -> None:
    SESSIONS.parent.mkdir(parents=True, exist_ok=True)
    fd = os.open(SESSIONS, os.O_WRONLY | os.O_CREAT | os.O_APPEND, 0o600)
    try:
        os.write(fd, f"{sid}\t{profile}\n".encode())
    finally:
        os.close(fd)


def session_id_from_args(args: list[str]) -> str | None:
    for index, argument in enumerate(args):
        candidate = ""
        if argument in {"-r", "--resume", "--session-id"}:
            if index + 1 < len(args) and not args[index + 1].startswith("-"):
                candidate = args[index + 1]
        for prefix in ("--resume=", "--session-id="):
            if argument.startswith(prefix) and argument.removeprefix(prefix):
                candidate = argument.removeprefix(prefix)
        if candidate:
            try:
                uuid.UUID(candidate)
            except ValueError:
                continue
            return candidate
    return None


def profile_by_name(registry: dict[str, Any], name: str) -> dict[str, Any]:
    for profile in registry["profiles"]:
        if profile["name"] == name:
            return profile
    raise UserError(f"unknown managed profile: {name}")


def routed_model(profile: dict[str, Any], model: str) -> str:
    auth = profile["auth"]
    if profile["provider_type"] == "OpenAIResponses" and auth.get("provider") == "chatgpt":
        return model
    if model.startswith(f"{profile['provider']}/"):
        return model
    return f"{profile['provider']}/{model}"


