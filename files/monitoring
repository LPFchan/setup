#!/bin/bash
# setup-module: monitoring
# setup-source: files/monitoring
#
# Unified monitoring daemon — three parallel loops:
#   1. cgroup: container memory + nvidia-smi + health (polling)
#   2. events: Docker lifecycle events (blocking stream)
#   3. xid:    NVIDIA Xid GPU errors (polling)

set -eu

usage() {
    cat <<'EOF'
monitoring — unified container monitoring daemon

  Runs three parallel loops: cgroup polling (memory/nvidia-smi/health),
  Docker lifecycle events (blocking stream), and NVIDIA Xid error watch.

Usage:  monitoring             run in the foreground
        monitoring enable      install the systemd unit and start (root)
        monitoring disable     stop and remove the unit (root)
        monitoring status      show the unit state
        monitoring help

Environment:
  GRIMOIRE_CONTAINER    Container name (default: grimoire)
  GRIMOIRE_MONITOR_INTERVAL  Poll interval seconds (default: 60)
  GRIMOIRE_HEALTH_URL   Health endpoint (default: http://127.0.0.1:9001/health)
EOF
}

UNIT_NAME="monitoring.service"
UNIT_PATH="/etc/systemd/system/${UNIT_NAME}"
BIN_LINK="/usr/local/bin/monitoring"

require_root() {
    if [ "$(id -u)" -ne 0 ]; then
        echo "monitoring: $1 requires root — try sudo monitoring $1" >&2
        exit 1
    fi
}

# The unit runs the managed copy in the operator's ~/.local/bin through a
# stable /usr/local/bin symlink, so a `setup update` refreshes the daemon
# without rewriting the unit.
cmd_enable() {
    require_root enable
    src=$(readlink -f "$0")
    if [ "$src" != "$BIN_LINK" ]; then
        ln -sfn "$src" "$BIN_LINK"
    fi
    cat > "$UNIT_PATH" <<UNIT
[Unit]
Description=Unified container monitoring (cgroup + events + Xid)
After=docker.service
Requires=docker.service

[Service]
Type=simple
ExecStart=${BIN_LINK}
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=monitoring

[Install]
WantedBy=multi-user.target
UNIT
    systemctl daemon-reload
    systemctl enable --now "$UNIT_NAME"
    echo "monitoring: enabled"
}

cmd_disable() {
    require_root disable
    systemctl disable --now "$UNIT_NAME" 2>/dev/null || true
    rm -f "$UNIT_PATH" "$BIN_LINK"
    systemctl daemon-reload
    # Removing the unit file while it has a runtime state leaves systemd
    # reporting "failed"; clear it so status reads inactive.
    systemctl reset-failed "$UNIT_NAME" 2>/dev/null || true
    echo "monitoring: disabled"
}

cmd_status() {
    state=$(systemctl is-active "$UNIT_NAME" 2>/dev/null || echo not-installed)
    echo "monitoring: ${state}"
}

case "${1:-}" in
    help|--help|-h) usage; exit 0 ;;
    enable)  cmd_enable; exit 0 ;;
    disable) cmd_disable; exit 0 ;;
    status)  cmd_status; exit 0 ;;
    "") ;;
    *) echo "monitoring: unknown command '$1' — try 'help'" >&2; exit 1 ;;
esac

CONTAINER="${GRIMOIRE_CONTAINER:-grimoire}"
INTERVAL="${GRIMOIRE_MONITOR_INTERVAL:-60}"
HEALTH_URL="${GRIMOIRE_HEALTH_URL:-http://127.0.0.1:9001/health}"

CGROUP_PID=""; EVENTS_PID=""; XID_PID=""

cleanup() {
    kill "$CGROUP_PID" "$EVENTS_PID" "$XID_PID" 2>/dev/null || true
    wait 2>/dev/null || true
}
trap cleanup EXIT INT TERM

# --- cgroup ----------------------------------------------------------

cgroup_loop() {
    while :; do
        pid=$(docker inspect -f '{{.State.Pid}}' "$CONTAINER" 2>/dev/null || echo "")
        stats=$(docker stats --no-stream --format 'cpu={{.CPUPerc}} mem={{.MemUsage}} mem_pct={{.MemPerc}} pids={{.PIDs}}' "$CONTAINER" 2>/dev/null || echo "")
        health=$(curl -fsS --max-time 2 "$HEALTH_URL" 2>/dev/null | tr '\n' ' ' || echo "")
        gpu=$(nvidia-smi --query-compute-apps=pid,process_name,gpu_uuid,used_memory --format=csv,noheader,nounits 2>/dev/null | tr '\n' ';' || echo "")

        cgroup=""
        if [ -n "$pid" ] && [ "$pid" != "0" ] && [ -r "/proc/$pid/cgroup" ]; then
            rel=$(awk -F: '$1 == "0" && $2 == "" {print $3; exit}' "/proc/$pid/cgroup")
            cgroup="/sys/fs/cgroup$rel"
        fi

        if [ -n "$cgroup" ] && [ -r "$cgroup/memory.current" ]; then
            current=$(cat "$cgroup/memory.current")
            events=$(awk '{printf "%s=%s,", $1, $2}' "$cgroup/memory.events")
            memstat=$(awk '/^(anon|file|kernel|slab|sock|shmem|file_mapped|inactive_file|active_file|unevictable|swapcached|zswap|zswapped|pgscan|pgsteal|pgmajfault) / {printf "%s=%s,", $1, $2}' "$cgroup/memory.stat")
            echo "cgroup container=$CONTAINER pid=$pid cgroup=$cgroup memory.current=$current events=$events memstat=$memstat docker=\"$stats\" gpu=\"$gpu\" health=\"$health\""
        else
            echo "cgroup container=$CONTAINER pid=$pid cgroup_missing docker=\"$stats\" gpu=\"$gpu\" health=\"$health\""
        fi

        sleep "$INTERVAL"
    done
}

# --- docker events ---------------------------------------------------

events_loop() {
    while :; do
        docker events \
            --filter "container=$CONTAINER" \
            --format 'event time={{.Time}} type={{.Type}} action={{.Action}} id={{.Actor.ID}} name={{index .Actor.Attributes "name"}} image={{index .Actor.Attributes "image"}} exitCode={{index .Actor.Attributes "exitCode"}} oom={{index .Actor.Attributes "oom"}}'
        sleep 5
    done
}

# --- xid watch -------------------------------------------------------

xid_loop() {
    local known="/tmp/monitoring-xid-known"
    rm -f "$known"
    while :; do
        msg=$(journalctl -k --no-pager -n 200 2>/dev/null | grep 'NVRM: Xid' | tail -1)
        if [ -n "$msg" ]; then
            hash=$(echo "$msg" | md5sum | cut -d' ' -f1)
            if [ ! -f "$known" ] || ! grep -q "$hash" "$known" 2>/dev/null; then
                echo "$hash" >> "$known"
                echo "xid $msg"
            fi
        fi
        sleep 30
    done
}

# --- main ------------------------------------------------------------

cgroup_loop & CGROUP_PID=$!
events_loop & EVENTS_PID=$!
xid_loop & XID_PID=$!

wait
